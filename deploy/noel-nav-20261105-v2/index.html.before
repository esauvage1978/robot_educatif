<!DOCTYPE html><html lang="fr" data-astro-cid-l2epyrb4> <head><!-- Global Metadata --><meta charset="utf-8"><style data-build-extra="header-astro-fix">
/* Header+NavGuides Astro styles (manquants du build fusionné) */
.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 clamp(0.875rem, 3vw, 1.5rem);
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		box-shadow: 0 1px 3px rgba(11, 31, 42, 0.05);
		backdrop-filter: blur(10px);
	}

	.header-bar {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		max-width: 1280px;
		margin: 0 auto;
		min-height: 64px;
		min-width: 0;
	}

	.brand {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		text-decoration: none;
		padding: 0.35rem 0;
	}

	.brand img {
		height: 30px;
		width: auto;
		max-width: min(180px, 42vw);
		display: block;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		min-width: 0;
		flex: 1 1 auto;
		margin-left: 0.35rem;
	}

	.internal-links a,
	.nav-dropdown__trigger {
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		padding: 0.35rem 0.55rem;
		border-radius: 8px;
		white-space: nowrap;
	}

	.internal-links a:hover,
	.nav-dropdown__trigger:hover,
	.nav-dropdown__trigger[aria-expanded='true'] {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.internal-links a.active {
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		color: var(--primary);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		background: var(--primary);
		color: #fff !important;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.8125rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.header-cta:hover {
		background: var(--primary-light);
		color: #fff !important;
	}

	.header-cta:focus-visible {
		outline: 2px solid var(--accent-warm);
		outline-offset: 2px;
	}

	.header-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--surface-border);
		border-radius: 50%;
		background: var(--surface);
		cursor: pointer;
		color: var(--ink);
		padding: 0;
		flex-shrink: 0;
		font-size: 1.05rem;
		line-height: 1;
	}

	.header-icon-btn:focus-visible,
	.nav-dropdown__trigger:focus-visible,
	.lang-dropdown__trigger:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.theme-toggle svg {
		width: 18px;
		height: 18px;
	}

	.theme-toggle .moon-icon {
		display: none;
	}

	html[data-theme='dark'] .theme-toggle .sun-icon {
		display: none;
	}

	html[data-theme='dark'] .theme-toggle .moon-icon {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		html:not([data-theme='light']) .theme-toggle .sun-icon {
			display: none;
		}
		html:not([data-theme='light']) .theme-toggle .moon-icon {
			display: block;
		}
	}

	.nav-dropdown__trigger {
		border: none;
		background: transparent;
		cursor: pointer;
		font-family: inherit;
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
	}

	.nav-dropdown__caret {
		font-size: 0.65rem;
		opacity: 0.85;
	}

	.nav-outils {
		position: relative;
	}

	.nav-outils__panel[hidden] {
		display: none !important;
	}
	.nav-outils__panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		min-width: 260px;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
		padding: 0.35rem;
		z-index: 120;
	}

	.nav-outils__panel a {
		display: block;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
	}

	.nav-outils__panel a:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.nav-outils__panel a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

	.lang-dropdown {
		position: relative;
	}

	.lang-dropdown__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 1px solid var(--surface-border);
		background: var(--surface);
		border-radius: 999px;
		padding: 0.35rem 0.65rem;
		font-weight: 700;
		font-size: 0.8125rem;
		color: var(--primary);
		cursor: pointer;
		font-family: inherit;
		white-space: nowrap;
	}

	.lang-dropdown__menu[hidden] {
		display: none !important;
	}
	.lang-dropdown__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		min-width: 190px;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
		padding: 0.35rem;
		z-index: 130;
	}

	.lang-dropdown__menu a {
		display: block;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		text-decoration: none;
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.lang-dropdown__menu a:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.lang-dropdown__menu a.is-current,
	.lang-dropdown__menu a[aria-current='true'] {
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		color: var(--primary);
		font-weight: 700;
	}

	.lang-dropdown__menu a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

	.mobile-menu-toggle {
		display: none;
	}

	.mobile-menu {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		max-width: 1280px;
		margin: 0 auto;
	}

	.mobile-menu[hidden] {
		display: none !important;
	}

	.mobile-menu a {
		padding: 0.85rem clamp(0.875rem, 3vw, 1.5rem);
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1px solid var(--surface-border);
	}

	.mobile-menu a:hover {
		background: var(--surface-2);
		color: var(--primary);
	}

	.mobile-menu-cta {
		background: color-mix(in oklab, var(--primary) 10%, var(--surface)) !important;
		color: var(--primary) !important;
		font-weight: 700 !important;
	}

	.mobile-menu-section__title {
		margin: 0;
		padding: 0.65rem clamp(0.875rem, 3vw, 1.5rem) 0.25rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 768px) {
		.desktop-only {
			display: none !important;
		}

		.mobile-menu-toggle {
			display: inline-flex;
		}

		.brand img {
			height: 24px;
			max-width: min(130px, 34vw);
		}

		.header-bar {
			gap: 0.35rem;
		}

		.lang-dropdown__trigger {
			padding: 0.3rem 0.5rem;
			font-size: 0.75rem;
		}
	}

	@media (min-width: 769px) and (max-width: 1320px) {
		html[lang='de'] .internal-links a,
		html[lang='de'] .nav-dropdown__trigger {
			font-size: 0.82rem;
			padding-inline: 0.4rem;
		}
		html[lang='de'] .header-cta {
			font-size: 0.75rem;
			padding-inline: 0.65rem;
		}
	}

.nav-guides {
		position: relative;
	}
	.nav-guides__trigger {
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-weight: 600;
		font-size: 1rem;
		color: var(--ink);
		padding: 0.35rem 0.55rem;
		border-radius: 8px;
		border: none;
		background: transparent;
		font-family: inherit;
		line-height: 1.25;
	}
	.nav-guides__trigger:hover,
	.nav-guides__trigger[aria-expanded='true'] {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}
	.nav-guides__trigger:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.nav-guides__panel {
		position: absolute;
		top: calc(100% + 0.35rem);
		left: 0;
		z-index: 120;
		min-width: min(92vw, 720px);
		display: grid;
		grid-template-columns: repeat(var(--guide-cols, 3), minmax(0, 1fr));
		gap: 1rem 1.25rem;
		padding: 1rem 1.15rem;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		box-shadow: 0 8px 28px rgba(11, 31, 42, 0.12);
	}
	.nav-guides__panel[hidden] {
		display: none !important;
	}
	.nav-guides.is-section .nav-guides__panel {
		position: static;
		min-width: 0;
		box-shadow: none;
		border: none;
		border-radius: 0;
		padding: 0.5rem 0 0.75rem;
		grid-template-columns: 1fr;
	}
	.nav-guides.is-section {
		width: 100%;
		border-bottom: 1px solid var(--surface-border);
		padding: 0.75rem clamp(1rem, 5vw, 2rem);
	}
	.nav-guides.is-section .nav-guides__trigger {
		width: 100%;
		justify-content: space-between;
	}
	.nav-guides__title {
		margin: 0 0 0.4rem;
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray-dark));
	}
	.nav-guides__group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.nav-guides__group li {
		margin: 0.15rem 0;
	}
	.nav-guides__group a {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: baseline;
		text-decoration: none;
		color: var(--primary);
		font-weight: 600;
		font-size: 0.92rem;
		padding: 0.2rem 0;
		border-radius: 4px;
	}
	.nav-guides__group a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.nav-guides__group a:hover {
		color: var(--primary-light);
	}
	.nav-guides__hint {
		font-size: 0.78rem;
		font-weight: 500;
		color: rgb(var(--gray));
	}
	@media (max-width: 768px) {
		.nav-guides:not(.is-section) {
			display: none;
		}
	}


/* Fix mobile header alignment 2026-11-05 */
.site-header .header-bar {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  width: 100%;
  max-width: 1280px;
  box-sizing: border-box;
}
.site-header .header-actions {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  margin-left: auto !important;
  flex-shrink: 0 !important;
  gap: 0.35rem !important;
}
.site-header .brand {
  flex-shrink: 0 !important;
}
@media (max-width: 768px) {
  .site-header .desktop-only { display: none !important; }
  .site-header .mobile-menu-toggle { display: inline-flex !important; }
  .site-header .brand-logo,
  .site-header .brand img {
    height: 24px !important;
    width: auto !important;
    max-width: min(130px, 34vw) !important;
  }
}
.nav-guides__panel[hidden],
.nav-outils__panel[hidden],
.lang-dropdown__menu[hidden],
.mobile-menu[hidden] {
  display: none !important;
}

