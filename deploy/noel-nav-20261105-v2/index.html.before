display:none}html[data-theme=dark] .theme-toggle .moon-icon{display:block}.theme-toggle:hover{color:var(--primary);transform:translateY(-2px)}@media(prefers-color-scheme:dark){html:not([data-theme=light]) .theme-toggle .sun-icon{display:none}html:not([data-theme=light]) .theme-toggle .moon-icon{display:block}}.theme-toggle-mobile{display:flex;align-items:center;gap:.75rem;width:100%;padding:1rem clamp(1rem,5vw,2rem);background:none;border:none;border-bottom:1px solid var(--surface-border);text-align:left;font-weight:600;color:var(--ink);cursor:pointer;transition:background .2s ease}@media(prefers-color-scheme:dark){.theme-toggle-mobile{color:rgb(var(--gray-dark))}}.theme-toggle-mobile svg{width:20px;height:20px;flex-shrink:0}.theme-toggle-mobile .moon-icon,html[data-theme=dark] .theme-toggle-mobile .sun-icon{display:none}html[data-theme=dark] .theme-toggle-mobile .moon-icon{display:block}@media(prefers-color-scheme:dark){html:not([data-theme=light]) .theme-toggle-mobile .sun-icon{display:none}html:not([data-theme=light]) .theme-toggle-mobile .moon-icon{display:block}}.theme-toggle-mobile:hover{background:var(--surface-2);color:var(--primary)}@media(prefers-color-scheme:dark){.theme-toggle-mobile:hover{color:var(--primary-light)}}.theme-toggle-label{flex:1}@media(max-width:768px){.desktop-only{display:none}.mobile-menu-toggle{display:block;flex-shrink:0}.brand img{height:40px;max-width:min(200px,60vw)}.lang-switch a[hreflang=en-us],.lang-switch a[hreflang=en-gb],.lang-switch a[hreflang=en-ca]{display:none}nav{gap:.5rem;min-width:0}.lang-switch{margin-left:auto;max-width:min(100%,calc(100vw - 9.5rem))}}@media(max-width:480px){.brand img{height:30px;max-width:min(130px,32vw);object-fit:contain}.lang-switch a{padding:.25rem .32rem;font-size:.7rem}nav{gap:.4rem}.mobile-menu-toggle{padding:.35rem}}
.article-engagement{margin:2rem 0 0;padding:1rem 1.1rem;border-radius:10px;border:1px solid var(--surface-border);background:color-mix(in oklab,var(--accent) 6%,var(--surface));font-family:var(--font-body, system-ui);font-size:.95rem;color:rgb(var(--gray-dark))}.article-engagement--hero{margin:0;padding:.55rem .75rem;font-size:.82rem;border-radius:10px;flex:0 1 auto;max-width:min(100%,420px)}.article-engagement--hero .article-engagement__stats{margin-bottom:.45rem;font-size:.8rem}.article-engagement--hero .article-engagement__rate-label{margin:0 .5rem 0 0;display:inline;font-size:.78rem}.article-engagement--hero .article-engagement__rate{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .5rem}.article-engagement--hero .article-engagement__stars{display:inline-flex}.article-engagement--hero .article-engagement__star{font-size:1.1rem;padding:.15rem .35rem}.article-engagement--hero .article-engagement__thanks,.article-engagement--hero .article-engagement__err{margin-top:.4rem;font-size:.8rem}.article-engagement__stats{display:flex;flex-wrap:wrap;align-items:baseline;gap:.35rem .65rem;margin:0 0 .75rem;font-weight:600}.article-engagement__views-value{font-variant-numeric:tabular-nums;color:var(--accent)}.article-engagement__sep{color:rgb(var(--gray));font-weight:400}.article-engagement__muted{color:rgb(var(--gray));font-weight:500}.article-engagement__rate-label{margin:0 0 .4rem;font-size:.88rem;font-weight:600;color:rgb(var(--gray-dark))}.article-engagement__stars{display:flex;gap:.2rem;flex-wrap:wrap}.article-engagement__star{cursor:pointer;border:1px solid var(--surface-border);background:var(--surface);color:var(--accent);font-size:1.35rem;line-height:1;padding:.2rem .45rem;border-radius:6px;transition:background .12s ease,border-color .12s ease,transform .12s ease}.article-engagement__star:hover{background:color-mix(in oklab,var(--accent) 14%,transparent);border-color:color-mix(in oklab,var(--accent) 35%,var(--surface-border))}.article-engagement__star:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.article-engagement__thanks{margin:0;font-weight:600;color:var(--accent)}.article-engagement__err{margin:.5rem 0 0;font-size:.88rem;color:#c62828}@media(prefers-reduced-motion:reduce){.article-engagement__star{transition:none}}.tutorial-product-box{background:linear-gradient(135deg,color-mix(in oklab,var(--accent-warm) 12%,var(--surface-2)) 0%,var(--surface-2) 100%);border:2px solid color-mix(in oklab,var(--accent-warm) 28%,var(--surface-border));border-radius:12px;padding:1.5rem;margin:2rem 0;box-shadow:0 3px 12px #00000014}.tutorial-box-title{margin:0 0 1.25rem;font-size:1.2rem;font-weight:800;color:rgb(var(--black));text-align:center;padding:0;border:0;background:none}.tutorial-products{display:grid;gap:1rem;margin-bottom:1rem}.tutorial-product-card{display:flex;align-items:center;gap:1rem;padding:1rem;background:var(--page-bg);border:1px solid var(--surface-border);border-radius:8px;transition:transform .15s ease,box-shadow .15s ease}.tutorial-product-card:hover{transform:translate(3px);box-shadow:0 2px 8px #00000014}.tutorial-product-image-link{display:block;flex-shrink:0;width:60px;height:60px;transition:transform .15s ease}.tutorial-product-image-link:hover{transform:scale(1.05)}.tutorial-img{width:100%;height:100%;object-fit:contain;background:#fff;border-radius:4px;border:1px solid var(--surface-border)}.tutorial-product-info{display:flex;flex-direction:column;gap:.3rem;flex:1;min-width:0}.tutorial-product-name{font-size:1rem;font-weight:700;color:rgb(var(--black));line-height:1.3}.tutorial-product-price{font-size:.88rem;color:rgb(var(--gray-dark));font-weight:600}.tutorial-product-btn{display:inline-flex;align-items:center;padding:.6rem 1.1rem;background:linear-gradient(135deg,#f90,#f80);color:#0f172a;text-decoration:none;font-weight:700;font-size:.88rem;border-radius:6px;white-space:nowrap;flex-shrink:0;box-sizing:border-box;max-width:100%;justify-content:center;transition:transform .15s ease,box-shadow .15s ease;box-shadow:0 2px 6px #ff990040}.tutorial-product-btn:hover{transform:translateY(-1px);box-shadow:0 3px 10px #ff990059}.tutorial-guide-link{margin:1.25rem 0 1rem;text-align:center}.guide-link-btn{display:inline-flex;box-sizing:border-box;max-width:100%;justify-content:center;text-align:center;align-items:center;gap:.5rem;padding:.75rem 1.5rem;background:var(--accent-dark);color:#fff;text-decoration:none;font-weight:700;font-size:.95rem;border-radius:8px;transition:background .15s ease,transform .15s ease}.guide-link-btn:hover{background:var(--accent);transform:translateY(-1px)}.tutorial-box-note{margin:0;padding-top:1rem;border-top:1px solid var(--surface-border);font-size:.78rem;line-height:1.5;color:rgb(var(--gray));text-align:center}@media(max-width:640px){.tutorial-product-card{flex-direction:column;align-items:center;text-align:center}.tutorial-product-image-link{width:auto;height:auto;margin:0 auto}.tutorial-img{display:block;max-width:120px;width:auto;height:auto;margin:0 auto 14px}.tutorial-product-name{margin-top:8px;line-height:1.35;clear:both}.tutorial-product-btn{width:100%;justify-content:center}}.choose-robot-box{margin:2rem 0 1.5rem;padding:1rem 1.25rem;border-left:4px solid #14b8a6;background:#14b8a614;border-radius:8px}.choose-robot-title{margin:0 0 .5rem;font-weight:700;font-size:1.05rem;color:var(--accent)}.choose-robot-box ul{margin:0;padding-left:1.2rem}.choose-robot-box li{margin:.25rem 0}.choose-robot-box a{color:var(--accent);font-weight:600}.christmas-banner{background:linear-gradient(135deg,#165b33,#0b4222);border-bottom:3px solid #FFD700;color:#fff;box-shadow:0 4px 12px #00000026;position:relative;overflow:hidden}.christmas-banner:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 50%,rgba(255,215,0,.1) 0%,transparent 50%),radial-gradient(circle at 80% 50%,rgba(255,255,255,.05) 0%,transparent 50%);pointer-events:none}.christmas-banner-inner{position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:1rem 1.5rem;display:flex;align-items:center;gap:1rem}.christmas-icon{font-size:2rem;line-height:1;flex-shrink:0}.christmas-content{flex:1;min-width:0}.christmas-title{display:block;font-size:1.1rem;font-weight:700;margin:0 0 .25rem;color:gold;letter-spacing:.02em}.christmas-text{margin:0;font-size:.9rem;color:#ffffffe6;line-height:1.4}.christmas-cta{display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;background:linear-gradient(135deg,gold,#ffc700);color:#0b4222;font-weight:700;font-size:.95rem;text-decoration:none;border-radius:6px;white-space:nowrap;transition:transform .15s ease,box-shadow .15s ease;box-shadow:0 2px 8px #ffd7004d}.christmas-cta:hover{transform:translateY(-1px);box-shadow:0 4px 12px #ffd70066}@media(max-width:640px){.christmas-banner-inner{flex-direction:row;justify-content:space-between;align-items:center;gap:.4rem;padding:4px 10px;max-height:48px;min-height:0}.christmas-icon{font-size:1.2rem;line-height:1}.christmas-title{font-size:.85rem;margin-bottom:0;line-height:1.2}.christmas-text{display:none}.christmas-cta{font-size:.78rem;padding:.35rem .65rem;flex-shrink:0}}.pinterest-share{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;font-size:.9rem;font-weight:600;font-family:var(--font-body, system-ui);text-decoration:none;color:#fff;background:#e60023;border:none;border-radius:24px;cursor:pointer;transition:background .2s ease,transform .1s ease;white-space:nowrap}.pinterest-share:hover{background:#ad081b;transform:translateY(-1px)}.pinterest-share:active{transform:translateY(0)}.pinterest-share svg{width:18px;height:18px;flex-shrink:0}.pinterest-share--hover{position:absolute;top:.75rem;right:.75rem;opacity:0;pointer-events:none;transition:opacity .2s ease;z-index:10}@media(max-width:720px){.pinterest-share{padding:.4rem .85rem;font-size:.85rem}.pinterest-share svg{width:16px;height:16px}.pinterest-share--hover{opacity:1;pointer-events:auto}}.follow-block{margin:3rem 0 2rem;padding:2rem;background:linear-gradient(135deg,color-mix(in oklab,var(--accent) 8%,var(--surface-2)) 0%,var(--surface-2) 100%);border:2px solid color-mix(in oklab,var(--accent) 25%,var(--surface-border));border-radius:12px;text-align:center}.follow-title{margin:0 0 .75rem;font-size:1.35rem;font-weight:800;color:rgb(var(--black));font-family:var(--font-heading, system-ui)}.follow-text{margin:0 0 1.5rem;font-size:.95rem;line-height:1.5;color:rgb(var(--gray-dark));max-width:600px;margin-left:auto;margin-right:auto}.follow-links{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem}.follow-link{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.25rem;text-decoration:none;font-weight:700;font-size:.95rem;border-radius:8px;transition:transform .15s ease,box-shadow .15s ease;color:#fff}.follow-icon{width:20px;height:20px;flex-shrink:0}.follow-link:hover{transform:translateY(-2px)}.follow-link--youtube{background:red;box-shadow:0 2px 8px #ff00004d}.follow-link--youtube:hover{background:#c00;box-shadow:0 4px 12px #f006}.follow-link--pinterest{background:#e60023;box-shadow:0 2px 8px #e600234d}.follow-link--pinterest:hover{background:#ad081b;box-shadow:0 4px 12px #e6002366}.follow-link--facebook{background:#1877f2;box-shadow:0 2px 8px #1877f24d}.follow-link--facebook:hover{background:#0c63d4;box-shadow:0 4px 12px #1877f266}@media(max-width:640px){.follow-block{padding:1.5rem 1rem;margin:2rem 0 1.5rem}.follow-title{font-size:1.15rem}.follow-text{font-size:.88rem;margin-bottom:1.25rem}.follow-links{gap:.75rem}.follow-link{padding:.65rem 1rem;font-size:.88rem}.follow-icon{width:18px;height:18px}}#pr-widget{margin:1.6rem 0 1rem;padding:1rem 1.1rem;border-radius:12px;border:1px solid rgba(43,125,233,.22);background:linear-gradient(135deg,#2b7de912,#2b7de905);max-width:100%;box-sizing:border-box}#pr-title{margin:0 0 .55rem;font-size:1.05rem;line-height:1.35;font-weight:700}#pr-stars{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .5rem}.pr-star{font:inherit;cursor:pointer;border:1px solid rgba(0,0,0,.12);background:#fff;border-radius:8px;padding:.25rem .45rem;line-height:1;font-size:1.35rem;color:#c4c9d4;transition:transform .12s,color .12s}.pr-star.on{color:#f5b301;border-color:#f5b30173}.pr-star:focus-visible{outline:2px solid #2b7de9;outline-offset:2px}#pr-avg{font-size:.88rem;opacity:.85;margin-left:.25rem}#pr-thx,#pr-feed{margin-top:.65rem;font-size:.92rem}#pr-feed[hidden],#pr-thx[hidden],#pr-stars[hidden]{display:none!important}.pr-reasons{display:flex;flex-wrap:wrap;gap:.4rem;margin:.45rem 0}.pr-reasons button{font:inherit;font-size:.82rem;padding:.35rem .55rem;border-radius:999px;border:1px solid rgba(0,0,0,.14);background:#fff;cursor:pointer}.pr-reasons button.on{background:#2b7de9;color:#fff;border-color:#2b7de9}#pr-txt{width:100%;max-width:420px;margin:.45rem 0;padding:.45rem .55rem;border-radius:8px;border:1px solid rgba(0,0,0,.15);font:inherit;font-size:.88rem}#pr-send{font:inherit;font-size:.88rem;padding:.4rem .75rem;border-radius:8px;border:0;background:#2b7de9;color:#fff;cursor:pointer}@media(max-width:600px){.pr-star{font-size:1.55rem;padding:.35rem .55rem}#pr-txt{max-width:100%}}main{width:100%;padding-top:0}.hero-article{width:100vw;max-width:100vw;position:relative;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);margin-bottom:2rem;border-radius:0;overflow:hidden;border:none;border-bottom:1px solid var(--surface-border);background:var(--page-bg);box-shadow:none}.hero-article-media{max-width:900px;margin:0 auto;background:var(--page-bg-elevated)}.hero-article-media img{display:block;width:100%;height:auto;aspect-ratio:16 / 9;object-fit:contain;border-radius:0}@media(max-width:768px){.hero-article-media{max-width:100%}}.hero-article-content{width:min(1140px,calc(100% - 2.5rem));margin:0 auto;padding:1.75rem 0 2rem;background:transparent}.hero-article:not(:has(.hero-article-media)) .hero-article-content{padding-top:2.5rem}.hero-article-content h1{margin:0 0 .6rem;font-size:clamp(1.65rem,3.2vw,2.65re