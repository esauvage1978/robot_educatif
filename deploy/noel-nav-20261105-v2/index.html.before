</p> <div class="cookie-consent__actions" data-astro-cid-63or3yqa> <button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject" data-astro-cid-63or3yqa>Refuser</button> <button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept" data-astro-cid-63or3yqa>Accepter</button> </div>  </div> </div> <script>(function(){const COOKIE_CONSENT_STORAGE_KEY = "robot-educatif-cookie-consent";

	(function () {
		var banner = document.getElementById('cookie-consent-banner');
		var btnAccept = document.getElementById('cookie-consent-accept');
		var btnReject = document.getElementById('cookie-consent-reject');
		if (!banner || !btnAccept || !btnReject) return;

		function hide() {
			banner.hidden = true;
			banner.setAttribute('aria-hidden', 'true');
		}

		function show() {
			banner.hidden = false;
			banner.removeAttribute('aria-hidden');
		}

		try {
			if (localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY) === null) {
				show();
			} else {
				hide();
			}
		} catch (e) {
			show();
		}

		btnAccept.addEventListener('click', function () {
			window.dispatchEvent(new CustomEvent('robot-educatif-cookie-accept'));
			hide();
		});
		btnReject.addEventListener('click', function () {
			window.dispatchEvent(new CustomEvent('robot-educatif-cookie-reject'));
			hide();
		});
	})();
})();</script> <script>(function(){const GA_MEASUREMENT_ID = "G-PST9T1NFNX";
const COOKIE_CONSENT_STORAGE_KEY = "robot-educatif-cookie-consent";

	(function () {
		var loading = false;
		var loaded = false;

		function loadScript(onload) {
			var s = document.createElement('script');
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
			document.head.appendChild(s);
			s.onload = onload;
		}

		function configureGtag() {
			window.dataLayer = window.dataLayer || [];
			if (typeof window.gtag !== 'function') {
				window.gtag = function () {
					window.dataLayer.push(arguments);
				};
			}
			window.gtag('js', new Date());
			var consent = null;
			try {
				consent = localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY);
			} catch (e) {}
			if (consent === 'accepted') {
				window.gtag('consent', 'update', {
					analytics_storage: 'granted',
				});
			}
			window.gtag('config', GA_MEASUREMENT_ID);
		}

		function inject() {
			if (loaded || loading) return;
			try {
				if (localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY) === 'rejected') return;
			} catch (e) {}
			loading = true;
			loadScript(function () {
				loaded = true;
				loading = false;
				window.__ga4ScriptLoaded = true;
				configureGtag();
			});
		}

		window.addEventListener('robot-educatif-cookie-accept', function () {
			try {
				localStorage.setItem(COOKIE_CONSENT_STORAGE_KEY, 'accepted');
			} catch (e) {}
			if (window.__ga4ScriptLoaded && typeof window.gtag === 'function') {
				window.gtag('consent', 'update', { analytics_storage: 'granted' });
				return;
			}
			inject();
		});

		window.addEventListener('robot-educatif-cookie-reject', function () {
			try {
				localStorage.setItem(COOKIE_CONSENT_STORAGE_KEY, 'rejected');
			} catch (e) {}
			if (window.__ga4ScriptLoaded && typeof window.gtag === 'function') {
				window.gtag('consent', 'update', {
					analytics_storage: 'denied',
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
				});
			}
		});

		function scheduleInject() {
			var scheduled = false;
			function runAfterIdle() {
				if (scheduled) return;
				scheduled = true;
				function run() {
					inject();
				}
				if (typeof window.requestIdleCallback === 'function') {
					window.requestIdleCallback(run, { timeout: 4000 });
				} else {
					window.setTimeout(run, 500);
				}
			}
			/** Si LCP n’est jamais notifié (navigateur rare), charger GA quand même. */
			function armLongFallback() {
				window.setTimeout(runAfterIdle, 8000);
			}
			if (typeof PerformanceObserver !== 'undefined') {
				try {
					var po = new PerformanceObserver(function () {
						runAfterIdle();
						try {
							po.disconnect();
						} catch (e) {}
					});
					po.observe({ type: 'largest-contentful-paint', buffered: true });
					armLongFallback();
				} catch (e) {
					window.setTimeout(runAfterIdle, 3500);
					armLongFallback();
				}
			} else {
				window.setTimeout(runAfterIdle, 3500);
				armLongFallback();
			}
		}
		scheduleInject();
	})();
})();</script> <script>
	(function () {
		var MERCHANTS = [
