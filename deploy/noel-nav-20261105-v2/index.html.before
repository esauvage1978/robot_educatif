.subnav-scroll {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* En-tête mobile : le bouton menu ne doit pas dépasser le viewport (scrollWidth) */
@media (max-width: 720px) {
  body{
    max-width: 100%;
  }
  .cookie-consent,
  .cookie-consent__inner {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
    left: 0 !important;
    right: 0 !important;
    margin: 0 !important;
  }
  header nav,
  .site-header nav {
    padding-inline: 0.5rem !important;
    gap: 0.25rem !important;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }
  .brand img,
  .site-header .logo img,
  .brand-logo {
    max-width: 108px !important;
    height: auto !important;
  }
  .header-social .social-icon {
    display: none !important;
  }
  .mobile-menu-toggle {
    flex-shrink: 0;
    margin-inline-start: auto;
  }
}
@media (max-width: 400px) {
  header nav,
  .site-header nav {
    padding-inline: 0.45rem !important;
    gap: 0.25rem !important;
  }
  .brand img,
  .site-header .logo img,
  .brand-logo {
    max-width: 82px !important;
  }
  .header-actions .btn,
  .nav-cta .btn {
    display: none !important;
  }
  .mobile-menu-toggle {
    padding: 0.35rem !important;
    min-width: 2.25rem !important;
  }
}
.lang-switch a[hreflang=en-us],.lang-switch a[hreflang=en-gb],.lang-switch a[hreflang=en-ca]{display:none}
