.aqf{margin:2.5rem auto 1rem;padding:1.4rem 1.5rem;border-radius:14px;border:1px solid rgba(43,125,233,.25);background:linear-gradient(135deg,#2b7de912,#2b7de905);box-sizing:border-box;max-width:900px;width:100%}.aqf h2{margin:0 0 .35rem;font-size:1.25rem;line-height:1.3}.aqf-sub{margin:0 0 1rem;opacity:.8;font-size:.95rem}.aqf-form{display:grid;gap:.8rem}.aqf-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.aqf label{display:flex;flex-direction:column;gap:.3rem;font-size:.9rem;font-weight:600;min-width:0}.aqf input[type=text],.aqf input[type=email],.aqf textarea{width:100%;box-sizing:border-box;min-height:42px;padding:0 .75rem;border:1px solid #c9bba6;border-radius:10px;font:inherit;font-weight:400;background:#fff;color:#1f2430}.aqf textarea{resize:vertical;min-height:6rem}.aqf input:focus,.aqf textarea:focus{outline:2px solid #2b7de9;outline-offset:1px}.aqf .aqf-check{flex-direction:row;align-items:flex-start;gap:.5rem;font-weight:400;font-size:.85rem}.aqf-check input{margin-top:.2rem;flex:none}.aqf-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.aqf-btn{justify-self:start;padding:.65rem 1.3rem;border:0;border-radius:8px;background:#2b7de9;color:#fff;font:inherit;font-weight:700;cursor:pointer}.aqf-btn:hover{background:#1f68c9}.aqf-btn:disabled{opacity:.6;cursor:wait}.aqf-status{margin:0;font-size:.92rem}.aqf-status:empty{display:none}.aqf-status.is-ok{padding:.7rem .9rem;border-radius:8px;background:#e6f6ea;color:#17692e;border:1px solid #9fd8ad}.aqf-status.is-err{padding:.7rem .9rem;border-radius:8px;background:#fdecec;color:#a12a20;border:1px solid #f0b4ae}@media(max-width:600px){.aqf{padding:1rem}.aqf-row{grid-template-columns:1fr}.aqf-btn{justify-self:stretch}}
