# Apache — site statique Astro (build dans dist/, ce fichier est copié depuis public/)
# Compatible Apache 2.4+ / WAMP

<IfModule mod_rewrite.c>
	RewriteEngine On
	# publish: slashs-multiples
	RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/{2,}([^?\s]*)
	RewriteRule ^ https://robot-educatif.info/%1 [R=301,L,QSA]
	RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+((?:[^?\s]|/+)+?)/{2,}([^?\s]*)
	RewriteRule ^ https://robot-educatif.info/%1/%2 [R=301,L,QSA]

	# Production : https://robot-educatif.info (racine du vhost)
	# Si le site est dans un sous-dossier, décommentez et adaptez :
	# RewriteBase /site_vitrine/robot_educatif/

	# WWW vers non-WWW (https, évite chaînes de redirections)
	RewriteCond %{HTTP_HOST} ^www\.robot-educatif\.info$ [NC]
	RewriteRule ^ https://robot-educatif.info%{REQUEST_URI} [R=301,L]

	# HTTPS uniquement pour le domaine public (localhost / autres hôtes non concernés)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^robot-educatif\.info$ [NC]
	RewriteRule ^ https://robot-educatif.info%{REQUEST_URI} [R=301,L]
	# --- go-links v1 : liens affilies comptes cote serveur ---
	RewriteRule ^go/([a-z0-9-]{4,40})/?$ go.php?id=$1 [L,QSA,NC]
	RewriteRule ^go-table\.php$ - [F,L]
	RewriteRule ^go-data/ - [F,L]
	# --- fin go-links ---


	# ---------------------------------------------------------------------------
	# Anciennes URL WordPress datées : /AAAA/MM/JJ/<slug>/ → /<slug>/
	# (liens des anciens posts Facebook / backlinks 2020). Les slugs renommés
	# depuis sont traités juste avant la règle générique (une seule redirection).
	# ---------------------------------------------------------------------------
	RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/activite-mbot-mesure-des-distances(/.*)?$ /activite-mbot-mesurer-des-distances/ [R=301,L,NC]
	RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/activite-mbot-faire-colignoter-les-leds(/.*)?$ /activite-mbot-faire-clignoter-les-leds/ [R=301,L,NC]
	# Générique : on garde le slug, on ignore un éventuel suffixe (/amp/, /feed/, /comment-page-1/…)
	RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/([^/]+)(/.*)?$ /$1/ [R=301,L]
	# Archives WordPress par date (/2020/, /2020/04/, /2020/04/18/) et pagination → blog
	RewriteRule ^[0-9]{4}(/[0-9]{2}){0,2}/?$ /blog/ [R=301,L]
	RewriteRule ^page/[0-9]+/?$ /blog/ [R=301,L]
	# Pages WordPress auteur / contact
	RewriteRule ^author/[^/]+/?$ /about/ [R=301,L,NC]
	RewriteRule ^contact-us/?$ /contact/ [R=301,L,NC]

	# ---------------------------------------------------------------------------
	# Anciennes catégories WordPress /category/… : correspondances explicites
	# AVANT la règle générique (sinon /category/x → /categorie/x qui n'existe pas)
	# ---------------------------------------------------------------------------
	# Lot 2 (23/10/2026) : tags en doublon fusionnes
	RewriteRule ^categorie/cadeau/?$ /categorie/cadeaux/ [R=301,L,NC]
	RewriteRule ^categorie/marque/?$ /categorie/marques/ [R=301,L,NC]
	RewriteRule ^category/cadeau/?$ /categorie/cadeaux/ [R=301,L,NC]
	RewriteRule ^category/marque/?$ /categorie/marques/ [R=301,L,NC]
	RewriteRule ^category/matatalab/tale-bot/?$ /categorie/tale-bot/ [R=301,L,NC]
	RewriteRule ^category/makeblock/mbot/?$ /categorie/mbot/ [R=301,L,NC]
	RewriteRule ^category/makeblock/cyberpi/?$ /categorie/makeblock/ [R=301,L,NC]
	RewriteRule ^category/test/?$ /categorie/comparatif/ [R=301,L,NC]
	RewriteRule ^category/activity/?$ /categorie/activite/ [R=301,L,NC]
	RewriteRule ^category/developpement/?$ /programmation/ [R=301,L,NC]
	RewriteRule ^category/application/?$ /categorie/programmation/ [R=301,L,NC]
	RewriteRule ^category/rasp?berry-pi/?$ /categorie/raspberry-pi/ [R=301,L,NC]
	# Ancien segment anglais « category » (liens externes / Google) → « categorie »
	RewriteRule ^category/?$ /categorie/ [R=301,L,NC]
	RewriteRule ^category/(.*)$ /categorie/$1 [R=301,L,NC]

	RewriteRule ^privacy-policy/?$ /politique-de-confidentialite/ [R=301,L,NC]

	# Sitemap legacy
	RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

	# PDF renommé (projets mBot : corrigés)
	RewriteRule ^downloads/mbot/10-projets-mbot-corriges-diagrammes\.pdf$ /downloads/mbot/corriges-diagrammes.pdf [R=301,L,NC]

	# Ancien slug sans « r » (mesure → mesurer)
	RewriteRule ^activite-mbot-mesure-des-distances/?$ /activite-mbot-mesurer-des-distances/ [R=301,L,NC]

	# Typo dans l'URL (enfants au pluriel au lieu de enfant)
	RewriteRule ^meilleur-robot-programmable-enfants-2026/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]

	# Guides mBlock : consolider vers page principale installation
	RewriteRule ^installer-mblock-windows-11-guide-facile/?$ /installer-mblock-5-sous-windows-10/ [R=301,L,NC]

	# Pages citées dans les articles mais jamais publiées, ou anciens slugs
	RewriteRule ^domotique/100-projets-domotique-utiles-2026/?$ /domotique/configurateur-projet-domotique/ [R=301,L,NC]
	RewriteRule ^domotique/maison-connectee-sans-cloud-100-pourcent-locale/?$ /domotique/debuter-en-domotique-guide-complet/ [R=301,L,NC]
	RewriteRule ^domotique/automatiser-porte-garage-homey/?$ /domotique/ouvrir-porte-garage-smartphone-esp32-esphome/ [R=301,L,NC]
	RewriteRule ^domotique/suivre-consommation-electrique-prise-connectee/?$ /domotique/projets/suivi-consommation-electrique/ [R=301,L,NC]
	RewriteRule ^domotique/volet-roulant-sans-neutral/?$ /domotique/projets/volet-roulant-connecte/ [R=301,L,NC]
	RewriteRule ^python-listes-et-boucles-for/?$ /python-boucles-for-while/ [R=301,L,NC]
	RewriteRule ^meilleur-robot-educatif-6-ans/?$ /quel-robot-acheter-enfant-6-ans-guide-achat/ [R=301,L,NC]
	RewriteRule ^en/robot-for-8-year-old/?$ /en/best-robot-for-an-8-year-old/ [R=301,L,NC]
	RewriteRule ^en/robot-for-10-year-old/?$ /en/best-robot-for-a-10-year-old/ [R=301,L,NC]
	RewriteRule ^en/robot-for-12-year-old/?$ /en/best-robot-for-a-12-year-old/ [R=301,L,NC]
	RewriteRule ^en/best-screen-free-coding-toys/?$ /en/best-robot-for-a-6-year-old/ [R=301,L,NC]
	RewriteRule ^uk/educational-robot-christmas-gifts-2026/?$ /en/educational-robot-christmas-gifts-2026/ [R=301,L,NC]


	# Projets mBot classe : rediriger vers la nouvelle page avec PDF (+ variantes tronquées vues dans GSC)
	RewriteRule ^projets-mbot-classe/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]
	RewriteRule ^10-projets-mbot-classe-faciles/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]
	RewriteRule ^10-projets-(gratuits-)?classe-faciles/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]
	RewriteRule ^10-mbot-(projects|classes-faciles)/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]

	# Guides par âge consolidés
	RewriteRule ^robot-par-age/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]

	# Guide budget vers page existante
	RewriteRule ^robots-budget/?$ /robot-moins-de-100-euros/ [R=301,L,NC]

	# Typos : meilleur-robot-programmable sans "enfant", ou sans "robot"
	RewriteRule ^meilleur-robot-programmable-2026/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]
	RewriteRule ^meilleur-programmable-enfant-2026/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]

	# Typos guides par âge : quel-acheter au lieu de quel-robot-acheter
	RewriteRule ^quel-acheter-enfant-5-ans-guide-achat/?$ /quel-robot-acheter-enfant-5-ans-guide-achat/ [R=301,L,NC]
	RewriteRule ^quel-acheter-enfant-10-ans-guide-achat/?$ /quel-robot-acheter-enfant-10-ans-guide-achat/ [R=301,L,NC]

	# Typo : mbot2 avec "for-enfants" au lieu de "pour-enfants"
	RewriteRule ^mbot-vs-mbot2-comparaison-des-robots-educatifs-for-enfants/?$ /mbot-vs-mbot2-comparaison-des-robots-educatifs-pour-enfants/ [R=301,L,NC]

	# Typo : activité clignoter
	RewriteRule ^activite-mbot-faire-colignoter-les-leds/?$ /activite-mbot-faire-clignoter-les-leds/ [R=301,L,NC]

	# Raspberry Pi : anciens slugs / variantes
	RewriteRule ^raspberry-pi-3-v-pi-4-b-vs-pi-5-comparatif-2026/?$ /raspberry-pi-3-vs-4-vs-5-comparatif-2026/ [R=301,L,NC]
	RewriteRule ^raspberry-pi-3-vrai-pc-[^/]*/?$ /mise-en-route-raspberry-pi-3-modele-b/ [R=301,L,NC]

	# Arduino : rediriger ancienne page vers nouveau guide complet
	RewriteRule ^kit-robot-arduino-enfant/?$ /meilleur-robot-educatif-arduino-kit-choisir/ [R=301,L,NC]

	# URLs courtes outils / dépannage domotique
	RewriteRule ^domotique/codes-erreurs-domotique/?$ /domotique/codes-erreurs-depannage-zigbee-home-assistant-shelly/ [R=301,L,NC]
	RewriteRule ^domotique/pieces-detachees-sav-domotique/?$ /domotique/pieces-detachees-capteurs-compatibles-moins-cher/ [R=301,L,NC]
	RewriteRule ^outils/quel-robot-educatif-choisir/?$ /outil-quel-robot-enfant/ [R=301,L,NC]

	# BEGIN RE-301-20261111 (pages esp32 doublons + 141 pages orphelines du serveur, dont /us/)
  RewriteRule ^en/smart-home/esp32-smart-home-projects/?$ https://robot-educatif.info/en/smart-home/esp32-smart-home-project-ideas/ [R=301,L,QSA]
  RewriteRule ^(uk|ca|us)/smart-home/esp32-smart-home-projects/?$ https://robot-educatif.info/en/smart-home/esp32-smart-home-project-ideas/ [R=301,L,QSA]
