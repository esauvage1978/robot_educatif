# Apache — site statique Astro (build dans dist/, ce fichier est copié depuis public/)
# Compatible Apache 2.4+ / WAMP

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Production : https://robot-educatif.info (racine du vhost)
	# Si le site est dans un sous-dossier, décommentez et adaptez :
	# RewriteBase /site_vitrine/robot_educatif/

	# Ancien segment anglais « category » (liens externes / Google) → « categorie »
	RewriteRule ^category/?$ /categorie/ [R=301,L,NC]
	RewriteRule ^category/(.*)$ /categorie/$1 [R=301,L,NC]

	# Ancien slug sans « r » (mesure → mesurer)
	RewriteRule ^activite-mbot-mesure-des-distances/?$ /activite-mbot-mesurer-des-distances/ [R=301,L,NC]

	# Ancien slug installation mBlock (sans « -10 »)
	RewriteRule ^installer-mblock-5-sous-windows/?$ /installer-mblock-5-sous-windows-10/ [R=301,L,NC]

	# Archives WordPress / anciennes URL
	RewriteRule ^author/redacteur/?$ /about/ [R=301,L,NC]
	RewriteRule ^categorie/makeblock/mbot/?$ /categorie/mbot/ [R=301,L,NC]
	RewriteRule ^categorie/makeblock/cyberpi/?$ /categorie/cyberpi/ [R=301,L,NC]
	RewriteRule ^page/[12]/?$ /blog/ [R=301,L,NC]
	RewriteRule ^politique-de-cookies-ue/?$ /gestion-des-cookies/ [R=301,L,NC]
	RewriteRule ^2020/04/07/premier-pas-avec-mblock-5/?$ /premier-pas-avec-mblock-5/ [R=301,L,NC]
	RewriteRule ^2020/04/12/activite-scratch-decor-qui-se-deplace/?$ /scratch-creer-un-jeu-video-premiere-partie/ [R=301,L,NC]
	RewriteRule ^2020/04/06/mbot-mon-premier-robot-educatif/?$ /mbot-mon-premier-robot-educatif/ [R=301,L,NC]
	RewriteRule ^privacy-policy/?$ /politique-de-confidentialite/ [R=301,L,NC]
	RewriteRule ^programmes/jeu_video_partie_1_[24]\.mblock/?$ /scratch-creer-un-jeu-video-premiere-partie/ [R=301,L,NC]
	RewriteRule ^recherche2/?$ /recherche/ [R=301,L,NC]
	RewriteRule ^contact-us/?$ /contact/ [R=301,L,NC]

	# Slash final : chaque page est dans <chemin>/index.html. Sans slash, certains serveurs
	# Apache renvoient 404 au lieu de servir le dossier (selon DirectorySlash / hébergeur).
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_URI} !/$
	RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
	RewriteRule ^(.*)$ /$1/ [R=301,L]

	# HTTPS uniquement pour le domaine public (localhost / autres hôtes non concernés)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^robot-educatif\.info$ [NC]
	RewriteRule ^ https://robot-educatif.info%{REQUEST_URI} [R=301,L]
</IfModule>

# Page d’accueil des dossiers
DirectoryIndex index.html

# 404 personnalisée : le build Astro produit /404.html à la racine du site.
# Sans cette ligne, l’hébergeur peut utiliser un ErrorDocument cassé → message
# « error was encountered while trying to use an ErrorDocument ».
ErrorDocument 404 /404.html

# Ne pas lister le contenu des répertoires
Options -Indexes

# Encodage par défaut
AddDefaultCharset utf-8

<IfModule mod_headers.c>
	# Réduction des fuites d’infos (navigateurs récents)
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression (si mod_deflate est activé)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache long pour les fichiers hashés Astro (/_astro/…)
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|mjs|woff2?|webp|avif|ico|png|jpg|jpeg|gif|svg)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# HTML : revalidation modérée (contenu éditorial)
<IfModule mod_headers.c>
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
</IfModule>

# Types MIME utiles
<IfModule mod_mime.c>
	AddType application/manifest+json webmanifest
	# Favicon SVG : sans ceci + nosniff, certains navigateurs repassent au PNG 32×32 (moins net).
	AddType image/svg+xml .svg
</IfModule>
