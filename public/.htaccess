	# Marchés UK / CA / US sans fichier : 301 vers /en/ (plus de contenu EN servi en doublon)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}/index.html !-f
	RewriteRule ^(uk|ca|us)/(.+)$ https://robot-educatif.info/en/$2 [R=301,L,QSA]
	RewriteCond %{REQUEST_FILENAME}/index.html !-f
	RewriteRule ^(uk|ca|us)/?$ https://robot-educatif.info/en/ [R=301,L,QSA]
</IfModule>

# Page d’accueil des dossiers
DirectoryIndex index.html

# 404 personnalisée : le build Astro produit /404.html à la racine du site.
# Sans cette ligne, l’hébergeur peut utiliser un ErrorDocument cassé → message
# « error was encountered while trying to use an ErrorDocument ».
ErrorDocument 404 /404.html

# Ne pas lister le contenu des répertoires
Options -Indexes

# Encodage par défaut
AddDefaultCharset utf-8

<IfModule mod_headers.c>
	# Réduction des fuites d’infos (navigateurs récents)
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression (si mod_deflate est activé)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# BEGIN TRUITE cache-hsts (géré par TRUITE, à garder dans public/.htaccess)
<IfModule mod_headers.c>
  # HSTS 1 an, sans includeSubDomains ni preload
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset ETag
</IfModule>
FileETag None
<IfModule mod_expires.c>
  # On supprime les Expires pour éviter les contradictions avec Cache-Control
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  Header unset Expires
  # HTML : toujours revalidé
  <FilesMatch "\.(html?|xml|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images et polices non versionnées : 30 jours
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Fichiers versionnés (/_astro/ hashés) : 1 an immutable
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
# END TRUITE cache-hsts

# Types MIME utiles
<IfModule mod_mime.c>
	AddType application/manifest+json webmanifest
	# Favicon SVG : sans ceci + nosniff, certains navigateurs repassent au PNG 32×32 (moins net).
	AddType image/svg+xml .svg
</IfModule>
