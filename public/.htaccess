# Apache — site statique Astro (build dans dist/, ce fichier est copié depuis public/)
# Compatible Apache 2.4+ / WAMP

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Production : https://robot-educatif.info (racine du vhost)
	# Si le site est dans un sous-dossier, décommentez et adaptez :
	# RewriteBase /site_vitrine/robot_educatif/

	# WWW vers non-WWW (https, évite chaînes de redirections)
	RewriteCond %{HTTP_HOST} ^www\.robot-educatif\.info$ [NC]
	RewriteRule ^ https://robot-educatif.info%{REQUEST_URI} [R=301,L]

	# HTTPS uniquement pour le domaine public (localhost / autres hôtes non concernés)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^robot-educatif\.info$ [NC]
	RewriteRule ^ https://robot-educatif.info%{REQUEST_URI} [R=301,L]

	# Ancien segment anglais « category » (liens externes / Google) → « categorie »
	RewriteRule ^category/?$ /categorie/ [R=301,L,NC]
	RewriteRule ^category/(.*)$ /categorie/$1 [R=301,L,NC]

	# Ancien slug sans « r » (mesure → mesurer)
	RewriteRule ^activite-mbot-mesure-des-distances/?$ /activite-mbot-mesurer-des-distances/ [R=301,L,NC]

	# Typo dans l'URL (enfants au pluriel au lieu de enfant)
	RewriteRule ^meilleur-robot-programmable-enfants-2026/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]

	# Anciens URLs WordPress vers équivalents
	RewriteRule ^category/matatalab/tale-bot/?$ /categorie/matatalab/ [R=301,L,NC]
	RewriteRule ^category/test/?$ /blog/ [R=301,L,NC]
	RewriteRule ^category/activity/?$ /categorie/activite/ [R=301,L,NC]
	RewriteRule ^category/developpement/?$ /programmation/ [R=301,L,NC]
	RewriteRule ^privacy-policy/?$ /politique-de-confidentialite/ [R=301,L,NC]

	# Sitemap legacy
	RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

	# Guides mBlock : consolider vers page principale installation
	RewriteRule ^telecharger-mblock-5-gratuit-guide-2026/?$ /installer-mblock-5-sous-windows-10/ [R=301,L,NC]
	RewriteRule ^installer-mblock-windows-11-guide-facile/?$ /installer-mblock-5-sous-windows-10/ [R=301,L,NC]
	
	# Guide mBlock en ligne vers page dédiée logiciel
	RewriteRule ^mblock-en-ligne-programmer-sans-installer/?$ /logiciel-mblock-makeblock-mbot-quel-choisir/ [R=301,L,NC]
	
	# Projets mBot classe : rediriger vers la nouvelle page avec PDF
	RewriteRule ^projets-mbot-classe/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]
	
	# Guides par âge consolidés
	RewriteRule ^robot-par-age/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]
	
	# Guide budget vers page existante
	RewriteRule ^robots-budget/?$ /robot-moins-de-100-euros/ [R=301,L,NC]
	
	# Corrections de typos communes : 10-projets-mbot (sans "gratuits")
	RewriteRule ^10-projets-mbot-classe-faciles/?$ /10-projets-mbot-gratuits-classe-faciles/ [R=301,L,NC]
	
	# Typo : meilleur-robot-programmable sans "enfant"
	RewriteRule ^meilleur-robot-programmable-2026/?$ /meilleur-robot-programmable-enfant-2026/ [R=301,L,NC]
	
	# Typos guides par âge : quel-acheter au lieu de quel-robot-acheter
	RewriteRule ^quel-acheter-enfant-5-ans-guide-achat/?$ /quel-robot-acheter-enfant-5-ans-guide-achat/ [R=301,L,NC]
	RewriteRule ^quel-acheter-enfant-10-ans-guide-achat/?$ /quel-robot-acheter-enfant-10-ans-guide-achat/ [R=301,L,NC]
	
	# Typo : mbot2 avec "for-enfants" au lieu de "pour-enfants"
	RewriteRule ^mbot-vs-mbot2-comparaison-des-robots-educatifs-for-enfants/?$ /mbot-vs-mbot2-comparaison-des-robots-educatifs-pour-enfants/ [R=301,L,NC]
	
	# Typo : activité clignoter
	RewriteRule ^activite-mbot-faire-colignoter-les-leds/?$ /activite-mbot-faire-clignoter-les-leds/ [R=301,L,NC]
	
	# Arduino : rediriger ancienne page vers nouveau guide complet
	RewriteRule ^kit-robot-arduino-enfant/?$ /meilleur-robot-educatif-arduino-kit-choisir/ [R=301,L,NC]
</IfModule>

# Page d’accueil des dossiers
DirectoryIndex index.html

# 404 personnalisée : le build Astro produit /404.html à la racine du site.
# Sans cette ligne, l’hébergeur peut utiliser un ErrorDocument cassé → message
# « error was encountered while trying to use an ErrorDocument ».
ErrorDocument 404 /404.html

# Ne pas lister le contenu des répertoires
Options -Indexes

# Encodage par défaut
AddDefaultCharset utf-8

<IfModule mod_headers.c>
	# Réduction des fuites d’infos (navigateurs récents)
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression (si mod_deflate est activé)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache long pour les fichiers hashés Astro (/_astro/…)
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|mjs|woff2?|webp|avif|ico|png|jpg|jpeg|gif|svg)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# HTML : revalidation modérée (contenu éditorial)
<IfModule mod_headers.c>
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
</IfModule>

# Types MIME utiles
<IfModule mod_mime.c>
	AddType application/manifest+json webmanifest
	# Favicon SVG : sans ceci + nosniff, certains navigateurs repassent au PNG 32×32 (moins net).
	AddType image/svg+xml .svg
</IfModule>
