{
  "name": "robot_educatif",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "import:wp": "node scripts/import-wordpress.mjs",
    "normalize:amazon": "node scripts/normalize-amazon-links.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "optimize:hero": "node scripts/optimize-hero-home.mjs",
    "verify:images-mblock": "node scripts/verify-public-installer-images.mjs",
    "fix:svg-mblock": "node scripts/fix-svg-control-chars.mjs",
    "normalize:utf8-mblock": "node scripts/normalize-svg-utf8.mjs",
    "repair:svg-mblock": "node scripts/fix-svg-control-chars.mjs && node scripts/normalize-svg-utf8.mjs",
    "dev": "astro dev --strictPort",
    "dev:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro dev --strictPort",
    "build": "cross-env ASTRO_BASE= astro build && node scripts/rewrite-relative-assets.mjs && cross-env ASTRO_BASE= node scripts/write-404-stats-tracker.mjs && node scripts/run-pagefind.mjs && node scripts/verify-blog-routes.mjs && node scripts/verify-canonical-html.mjs",
    "verify:blog-routes": "node scripts/verify-blog-routes.mjs",
    "verify:canonical-html": "node scripts/verify-canonical-html.mjs",
    "blog:add-headlines": "node scripts/blog-add-missing-headlines.mjs",
    "build:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro build && node scripts/rewrite-relative-assets.mjs && cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ node scripts/write-404-stats-tracker.mjs && node scripts/run-pagefind.mjs",
    "preview": "cross-env ASTRO_BASE= astro preview",
    "preview:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "pagefind": "^1.4.0",
    "png-to-ico": "^3.0.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
