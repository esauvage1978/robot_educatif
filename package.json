{
  "name": "robot_educatif",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "import:wp": "node scripts/import-wordpress.mjs",
    "normalize:amazon": "node scripts/normalize-amazon-links.mjs",
    "images:amazon": "node scripts/fetch-amazon-images.mjs",
    "prices:amazon": "node scripts/fetch-amazon-prices.mjs && node scripts/apply-amazon-prices.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:pins": "node scripts/generate-pins.mjs",
    "optimize:hero": "node scripts/optimize-hero-home.mjs",
    "verify:images-mblock": "node scripts/verify-public-installer-images.mjs",
    "fix:svg-mblock": "node scripts/fix-svg-control-chars.mjs",
    "normalize:utf8-mblock": "node scripts/normalize-svg-utf8.mjs",
    "repair:svg-mblock": "node scripts/fix-svg-control-chars.mjs && node scripts/normalize-svg-utf8.mjs",
    "dev": "astro dev --port 4321",
    "dev:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro dev --port 4321",
    "prebuild": "node scripts/generate-blog-thumbnails.mjs",
    "build": "cross-env ASTRO_BASE= astro build && node scripts/check-product-jsonld.mjs dist && node scripts/rewrite-relative-assets.mjs && node scripts/ensure-inline-css-live-parity.mjs dist && cross-env ASTRO_BASE= node scripts/write-404-stats-tracker.mjs && node scripts/run-pagefind.mjs && node scripts/verify-blog-routes.mjs && node scripts/mirror-en-to-uk-ca.mjs dist && node scripts/extend-sitemap-uk-ca.mjs dist && node scripts/sitemap-hreflang.mjs dist && node scripts/uk-ca-geo.mjs dist --site https://robot-educatif.info && node scripts/go-links.mjs dist --site robot-educatif.info",
    "verify:blog-routes": "node scripts/verify-blog-routes.mjs",
    "check:product-jsonld": "node scripts/check-product-jsonld.mjs",
    "build:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro build && node scripts/check-product-jsonld.mjs dist && node scripts/rewrite-relative-assets.mjs && cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ node scripts/write-404-stats-tracker.mjs && node scripts/run-pagefind.mjs",
    "preview": "cross-env ASTRO_BASE= astro preview",
    "preview:wamp": "cross-env ASTRO_BASE=/site_vitrine/robot_educatif/ astro preview",
    "astro": "astro",
    "routine": "node public/cron/routine.mjs",
    "releve-prix": "node public/cron/releve-prix.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^9.0.4",
    "pagefind": "^1.4.0",
    "playwright": "^1.64.1",
    "png-to-ico": "^3.0.1",
    "satori": "^0.32.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "unist-util-visit": "^5.1.0"
  }
}
