---
import HubEssentials from '../components/HubEssentials.astro';
import '../styles/global.css';
import '../styles/dark-mobile-surfaces-fix.css';
import ArticleQuestionForm from '../components/ArticleQuestionForm.astro';
import ShareButtons from '../components/ShareButtons.astro';
import PageRatingWidget from '../components/PageRatingWidget.astro';
import BaseHead from '../components/BaseHead.astro';
import StructuredDataFaq from '../components/StructuredDataFaq.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import GuideOfferRail from '../components/GuideOfferRail.astro';
import ReviewLayoutStyle from '../components/ReviewLayoutStyle.astro';
import { reviewPageForPath } from '../lib/reviewOffers.mjs';
import { findPair, slugOf } from '../lib/i18n.mjs';
import { EN_ASIDE_HUB_LINKS } from '../lib/enAsideHubLinks.mjs';
import { getIllustration } from '../lib/illustration';
import { withBase } from '../lib/siteUrl';
import ArticleByline from '../components/ArticleByline.astro';
const fm = Astro.props.frontmatter ?? Astro.props;
const { title, description, updated, shareTitle, shareDescription, lang: htmlLang = 'en' } = fm;
const minutesRead = Number(fm.minutesRead);
const readingMinutes = Number.isFinite(minutesRead) && minutesRead > 0 ? minutesRead : undefined;
const _p = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const pair = findPair(_p);
const frSlug = pair && pair.fr ? slugOf(pair.fr) : '';
const ill = frSlug ? getIllustration(frSlug) : null;
const ogImage = ill ? ill.src : undefined;
const _n = _p.endsWith('/') ? _p : _p + '/';
const isSmart = _n.startsWith('/en/smart-home/');
const others = EN_ASIDE_HUB_LINKS.filter((x) => x.href !== _n && x.href.startsWith('/en/smart-home/') === isSmart);
const hubRelated = others.slice(0, 5).map((o) => ({ title: o.title, href: o.href }));
const sharePath = _n;
const reviewPage = reviewPageForPath(_n);
const isReviewLayout = Boolean(reviewPage?.review);
const reviewOffer = reviewPage?.offer ?? null;
---
<html lang={htmlLang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} ogType="article" />
		<StructuredDataFaq items={fm.faqSchema} />
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			.hero-article {
				width: 100%;
				max-width: 100%;
				position: relative;
				margin-left: 0;
				margin-right: 0;
				margin-bottom: 2rem;
				border-radius: 0;
				overflow: hidden;
				border: none;
				border-bottom: 1px solid var(--surface-border);
				background: var(--page-bg);
				box-shadow: none;
			}
			.hero-article-media {
				max-width: 1023px;
				margin: 0 auto;
				padding: 0.35rem 1.25rem 1.75rem;
				box-sizing: border-box;
				background: transparent;
			}
			.hero-article-media img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: contain;
				border-radius: 1.35rem;
				box-shadow: 0 10px 28px rgba(11, 31, 42, 0.08);
			}
			
			@media (max-width: 768px) {
				.hero-article-media {
					max-width: 100%;
				}
			}
			.hero-article-content {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 1.75rem 0 2rem 0;
				background: transparent;
			}
			.hero-article:not(:has(.hero-article-media)) .hero-article-content {
				padding-top: 2.5rem;
			}
			.hero-article-content h1 {
				margin: 0 0 0.6rem 0;
				font-size: clamp(1.65rem, 3.2vw, 2.65rem);
				max-width: 100%;
				line-height: 1.14;
			}
			.hero-article-content .hero-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.125rem;
				line-height: 1.55;
				max-width: 100%;
				font-family: var(--font-body, system-ui);
			}
			.hero-meta {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				align-items: center;
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				font-family: var(--font-body, system-ui);
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.hero-article-toolbar {
				display: flex;
				flex-wrap: wrap;
				align-items: flex-start;
				justify-content: flex-start;
				gap: 0.65rem 1rem;
				margin: 0 0 0.85rem 0;
			}
			.hero-article-toolbar .hero-categories {
				flex: 1 1 auto;
				min-width: 0;
				margin: 0;
			}
			.hero-article-toolbar .article-engagement--hero {
				margin-left: auto;
			}
			.hero-article-toolbar .article-engagement--hero:only-child {
				margin-left: 0;
				max-width: 100%;
			}
			.hero-article-toolbar .pinterest-hero-button {
				flex-shrink: 0;
			}
			.hero-categories {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.5rem;
				align-items: center;
				margin: 0 0 0.85rem 0;
				padding: 0;
				list-style: none;
			}
			.hero-categories li {
				margin: 0;
			}
		.hero-categories a {
			display: inline-block;
			padding: 0.28rem 0.65rem;
			font-size: 0.82rem;
			font-weight: 600;
			font-family: var(--font-body, system-ui);
			text-decoration: none;
			color: var(--accent-dark);
			background: color-mix(in oklab, var(--accent-dark) 12%, transparent);
			border: 1px solid color-mix(in oklab, var(--accent-dark) 28%, var(--surface-border));
			border-radius: 999px;
			transition: background 0.12s ease, color 0.12s ease;
		}
		
		.hero-categories a:hover {
			background: color-mix(in oklab, var(--accent-dark) 22%, transparent);
		}
		
			.page-layout {
				width: min(1200px, calc(100% - 2em));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				align-items: start;
				min-width: 0;
			}
			.page-layout > article {
				min-width: 0;
			}
			@media (max-width: 1023px) {
				.page-layout--with-sidebar {
					grid-template-columns: 1fr;
				}
				.page-layout--with-sidebar > :global(.guide-rail),
				.page-layout--with-sidebar > :global(.guide-sidebar) {
					order: -1;
				}
			}
			/* Typo et images du corps d’article : src/styles/global.css (.prose) */
			.last-updated-on {
				font-style: italic;
			}
			.hero-author {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
		@media (max-width: 720px) {
			.hero-article {
				width: 100%;
				max-width: 100%;
				margin-left: 0;
				margin-right: 0;
				margin-bottom: 1rem !important;
			}
			.hero-article-media {
				max-width: 100% !important;
			}
				.hero-article-media img {
				object-fit: contain !important;
				border-radius: 1.1rem !important;
			}
			.hero-article-content {
				padding: 0 0.9rem 0.9rem !important;
				width: 100%;
				box-sizing: border-box;
			}
			.hero-meta {
				margin-bottom: 0.15rem !important;
				font-size: 0.76rem !important;
				gap: 0.2rem 0.45rem !important;
			}
			.hero-article-toolbar {
				margin-bottom: 0.3rem !important;
				gap: 0.25rem 0.5rem !important;
			}
			.hero-categories {
				margin-bottom: 0.4rem !important;
				gap: 0.3rem !important;
			}
			.hero-categories a {
				padding: 0.2rem 0.5rem !important;
				font-size: 0.78rem !important;
			}
			.hero-article-content h1 {
				margin-top: 0 !important;
				margin-bottom: 0.3rem !important;
				font-size: clamp(1.35rem, 4vw, 1.75rem) !important;
			}
			.hero-article-content .hero-desc {
				font-size: 0.95rem !important;
				line-height: 1.4 !important;
			}
			.page-layout {
				grid-template-columns: 1fr;
			}
		}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{!isReviewLayout && (
			<section class="hero-article">
				<div class="hero-article-content">
					<h1>{title}</h1>
					<p class="hero-desc">{description}</p>
					<ArticleByline lang="en" dateText={updated} updated={Boolean(updated)} minutes={readingMinutes} />
				</div>
				{ill && (
					<div class="hero-article-media">
						<img src={withBase(ill.src)} alt={`Illustration: ${title}`} width="960" height="540" fetchpriority="high" decoding="async" />
						<p class="ai-illustration-caption">AI-generated illustration</p>
					</div>
				)}
			</section>
			)}
			<div class:list={['page-layout page-layout--with-sidebar', isReviewLayout && 'page-layout--review']}>
				<article>
					{isReviewLayout && (
						<header class="article-header article-header--review">
							<ArticleByline lang="en" dateText={updated} updated={Boolean(updated)} minutes={readingMinutes} />
							<h1>{title}</h1>
							<p>{description}</p>
						</header>
					)}
					<div class="prose">
						<HubEssentials />
						<slot />
					</div>
					<ShareButtons url={withBase(sharePath)} title={shareTitle ?? title} description={shareDescription ?? description} lang="en" />
					<PageRatingWidget lang="en" />
					<ArticleQuestionForm lang="en" pageTitle={title} />
				</article>
				<div class="guide-rail">
					{isReviewLayout && <ReviewLayoutStyle />}
					{reviewOffer && <GuideOfferRail offer={reviewOffer} />}
					<Sidebar variant="guide" relatedLinks={hubRelated} />
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
