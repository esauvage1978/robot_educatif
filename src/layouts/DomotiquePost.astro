---
import '../styles/global.css';
import ArticleQuestionForm from '../components/ArticleQuestionForm.astro';
import PageRatingWidget from '../components/PageRatingWidget.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import DomotiqueSubNav from '../components/DomotiqueSubNav.astro';
import Sidebar from '../components/Sidebar.astro';
import GuideOfferRail from '../components/GuideOfferRail.astro';
import ReviewLayoutStyle from '../components/ReviewLayoutStyle.astro';
import { reviewPageForPath } from '../lib/reviewOffers.mjs';
import StructuredDataArticle from '../components/StructuredDataArticle.astro';
import StructuredDataBreadcrumb from '../components/StructuredDataBreadcrumb.astro';
import DomotiqueBreadcrumbNav from '../components/DomotiqueBreadcrumbNav.astro';
import EditorialReadAlso from '../components/EditorialReadAlso.astro';
import GscIntentCta from '../components/GscIntentCta.astro';
import { gscIntentForPath } from '../lib/gscIntentPages.mjs';
import { NOEL_PATHS } from '../data/noelGuideI18n.mjs';
import StructuredDataFaq from '../components/StructuredDataFaq.astro';
import ArticleByline from '../components/ArticleByline.astro';
import { withBase } from '../lib/siteUrl';
import { withImageVersion } from '../lib/imageVersion';
import { getIllustration } from '../lib/illustration';
import { resolveArticleOgImage } from '../lib/articleOgImage.mjs';

type Props = CollectionEntry<'domotique'>['data'] & {
	articleSlug: string;
	faqSchema?: { question: string; answer: string }[];
	minutes?: number;
	/** Rubriques hub : ne pas afficher la vignette IA/générique au-dessus du texte. */
	hubContentIllustration?: boolean;
};

const DOMOTIQUE_READ_ALSO = [
	{ title: 'Débuter en domotique', href: '/domotique/debuter-domotique-par-ou-commencer/' },
	{ title: 'Meilleur dongle Zigbee', href: '/domotique/meilleur-dongle-zigbee-home-assistant/' },
	{ title: 'Prise connectée Zigbee', href: '/domotique/prise-connectee-zigbee-home-assistant/' },
	{ title: 'Home Assistant Green vs Pi 5', href: '/domotique/home-assistant-green-vs-raspberry-pi-5/' },
];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category = 'home-assistant',
	articleSlug,
	faqSchema = [],
	minutes,
	hubContentIllustration = true,
} = Astro.props;
const _pp = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const _m = /^\/(en|uk|ca|de|it|es|nl)(\/|$)/.exec(_pp);
const pageLang = (_m ? (_m[1] === 'uk' || _m[1] === 'ca' ? 'en' : _m[1]) : 'fr') as 'fr' | 'en' | 'de' | 'it' | 'es' | 'nl';
const badgeTx: Record<string, Record<string, string>> = {
	'guides-achat': { fr: "Guide d'achat", en: 'Buying guide', de: 'Kaufratgeber', it: "Guida all'acquisto", es: 'Guía de compra', nl: 'Koopgids' },
	debuter: { fr: 'Débuter', en: 'Getting started', de: 'Einstieg', it: 'Primi passi', es: 'Primeros pasos', nl: 'Beginnen' },
	_: { fr: 'Domotique', en: 'Smart home', de: 'Smart Home', it: 'Domotica', es: 'Domótica', nl: 'Domotica' },
};

const subnavCategory = articleSlug === 'debuter-en-domotique-guide-complet' ? 'guide-debuter' : category;
const selfPath = `/domotique/${articleSlug}/`;
const guideRelated = DOMOTIQUE_READ_ALSO.filter((l) => l.href !== selfPath).slice(0, 4);

const illustration = getIllustration(articleSlug);
const realHero = typeof heroImage === 'string' && heroImage.trim() ? heroImage.trim() : '';
const thumbnailPath = realHero || (illustration ? illustration.src : `/images/blog-thumbnails/${articleSlug}.png`);
const thumbnailImage = withImageVersion(thumbnailPath);
const ogProductImage = resolveArticleOgImage({ heroImage: realHero, articleSlug }) ?? undefined;
const ogImageForHead = ogProductImage ?? (realHero ? thumbnailImage : undefined);

const breadcrumbLabel = title.includes(':') ? title.split(':')[0].trim() : title;
const reviewPage = reviewPageForPath(`/domotique/${articleSlug}/`);
const isReviewLayout = Boolean(reviewPage?.review);
const reviewOffer = reviewPage?.offer ?? null;
const gscIntent = gscIntentForPath(Astro.url.pathname);
const noelHref = NOEL_PATHS.fr;
---

<html lang={pageLang}>
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={ogImageForHead}
			ogType="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		<StructuredDataArticle
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			heroImage={thumbnailImage}
			articleSlug={articleSlug}
		/>
		<StructuredDataBreadcrumb
			items={[
				{ name: 'Accueil', url: withBase('/') },
				{ name: 'Domotique', url: withBase('/domotique/') },
				{ name: title, url: withBase(`/domotique/${articleSlug}/`) },
			]}
		/>
		<StructuredDataFaq items={faqSchema} />
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			
			.article-header {
				max-width: none;
				width: 100%;
				margin: 0;
				padding: 0 0 1.5rem;
				box-sizing: border-box;
				min-width: 0;
			}
			
			.article-header h1 {
				font-size: clamp(1.75rem, 5vw, 2.5rem);
				line-height: 1.2;
				margin-bottom: 1rem;
				color: rgb(var(--black));
			}
			
			.article-meta {
				display: flex;
				gap: 1rem;
				align-items: center;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				margin-top: 1rem;
			}
			
			.category-badge {
				display: inline-block;
				padding: 0.25rem 0.75rem;
				background: var(--accent);
				color: white;
				border-radius: 999px;
				font-size: 0.8rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			
			.domotique-illustration { max-width: none; width: 100%; margin: 0.4rem 0 1.5rem; padding: 0; box-sizing: border-box; }
			.domotique-illustration img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: contain; border-radius: 1.35rem; box-shadow: 0 10px 28px rgba(11, 31, 42, 0.08); background: var(--surface, #f1f5f9); }
			.article-content {
				width: 100%;
				margin: 0;
				padding: 0 0 3rem;
				box-sizing: border-box;
				min-width: 0;
				--prose-width: 100%;
			}
			.page-layout {
				width: min(1200px, calc(100% - 2em));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				align-items: start;
				min-width: 0;
				padding: 0 0 2rem;
				box-sizing: border-box;
			}
			.page-layout > article {
				min-width: 0;
			}
			@media (max-width: 1023px) {
				.page-layout--with-sidebar {
					grid-template-columns: 1fr;
				}
				.page-layout--with-sidebar > :global(.guide-rail),
				.page-layout--with-sidebar > :global(.guide-sidebar) {
					order: -1;
				}
			}
			
			@media (max-width: 768px) {
				.article-header,
				.article-content {
					padding-left: 1rem;
					padding-right: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<DomotiqueSubNav currentCategory={subnavCategory} />
		
		<main>
			<div class:list={['page-layout page-layout--with-sidebar', isReviewLayout && 'page-layout--review']}>
			<article>
				<header class:list={['article-header', isReviewLayout && 'article-header--review']}>
					<DomotiqueBreadcrumbNav currentLabel={breadcrumbLabel} />
					<span class="category-badge">{category === 'home-assistant' ? 'Home Assistant' : category === 'esp32' ? 'ESP32' : (badgeTx[category] ?? badgeTx._)[pageLang]}</span>
					<h1>{title}</h1>
<p style="font-size: 1.1rem; color: rgb(var(--gray-dark)); margin-top: 0.5rem;">{description}</p>
					<ArticleByline
						lang={pageLang}
						date={updatedDate ?? pubDate}
						updated={Boolean(updatedDate)}
						minutes={minutes}
					/>
				</header>
				{(realHero || illustration) && !isReviewLayout && (realHero || hubContentIllustration) && (
					<figure class="domotique-illustration">
						<img src={thumbnailImage} alt={realHero ? title : illustration.alt} width="960" height="540" fetchpriority="high" decoding="async" />
						{!realHero && illustration && (
						<figcaption class="ai-illustration-caption">Illustration générée par IA</figcaption>
						)}
					</figure>
				)}

				<div class="article-content prose">
								{gscIntent && !gscIntent.skipInjectPick && <GscIntentCta config={gscIntent} phase="pick" />}
								{gscIntent && !gscIntent.skipInjectTable && <GscIntentCta config={gscIntent} phase="table" />}
								<slot />
								{gscIntent && <GscIntentCta config={gscIntent} phase="conclusion" noelHref={noelHref} />}
								<EditorialReadAlso />
							</div>
							<PageRatingWidget lang={pageLang} />
							<ArticleQuestionForm lang={pageLang} pageTitle={title} />
			</article>
			<div class="guide-rail">
				{isReviewLayout && <ReviewLayoutStyle />}
				{reviewOffer && <GuideOfferRail offer={reviewOffer} />}
				<Sidebar variant="guide" relatedLinks={guideRelated} />
			</div>
			</div>
		</main>
		
		<Footer />
	</body>
</html>
