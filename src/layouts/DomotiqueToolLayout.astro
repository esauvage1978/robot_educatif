---
import ArticleQuestionForm from '../components/ArticleQuestionForm.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import DomotiqueSubNav from '../components/DomotiqueSubNav.astro';
import Sidebar from '../components/Sidebar.astro';
import ToolResolutionBanner from '../components/ToolResolutionBanner.astro';
import { URL_CODES_ERREURS_CANON } from '../lib/siteToolUrls.mjs';
import StructuredDataBreadcrumb from '../components/StructuredDataBreadcrumb.astro';
import DomotiqueBreadcrumbNav from '../components/DomotiqueBreadcrumbNav.astro';
import { ARTICLE_AUTHOR } from '../consts';
import { withBase } from '../lib/siteUrl';
import StructuredDataArticle from '../components/StructuredDataArticle.astro';
import EditorialReadAlso from '../components/EditorialReadAlso.astro';
import { resolveDomotiqueToolOgImage } from '../lib/toolPageOgImage.mjs';

interface Props {
	title: string;
	description: string;
	lang: 'fr' | 'en' | 'de' | 'it' | 'es';
	pubDate: Date;
	updatedDate?: Date;
	articlePath: string;
	hubLabel: string;
	/** Chemin public /images/... — og:image + twitter:image + JSON-LD (photo produit réelle) */
	image?: string;
	/** Pages codes erreurs / pièces détachées (conformité SAV) */
	repairGuide?: boolean;
	/** Remplace le fil d’Ariane par défaut (JSON-LD) */
	breadcrumbItems?: { name: string; url: string }[];
	/** Le contenu du slot fournit déjà le h1 visible (projets / catalogue). */
	contentProvidesH1?: boolean;
	/** Fil d’Ariane HTML déjà présent dans le contenu (ex. fiche code erreur). */
	skipDefaultBreadcrumb?: boolean;
}

const {
	title,
	description,
	lang,
	pubDate,
	updatedDate = new Date('2026-11-17T11:00:00+01:00'),
	articlePath,
	hubLabel,
	repairGuide = false,
	breadcrumbItems,
	contentProvidesH1 = false,
	skipDefaultBreadcrumb = false,
	image: imageProp,
} = Astro.props;
const toolOgImage = imageProp ?? resolveDomotiqueToolOgImage(articlePath);
const articleSlug = articlePath.replace(/^\/(fr\/)?/, '').replace(/\/$/, '');
const formLang = lang === 'fr' ? 'fr' : lang;
const hubPath =
	lang === 'fr'
		? '/domotique/'
		: lang === 'en'
			? '/en/smart-home/'
			: lang === 'de'
				? '/de/smart-home/'
				: lang === 'it'
					? '/it/domotica/'
					: '/es/domotica/';

const breadcrumbJsonLd =
	breadcrumbItems ??
	[
		{ name: lang === 'fr' ? 'Accueil' : 'Home', url: withBase(lang === 'fr' ? '/' : `/${lang}/`) },
		{ name: hubLabel, url: withBase(hubPath) },
		{ name: title, url: withBase(articlePath) },
	];

const crossLinkVariant =
	lang === 'fr' && articlePath.includes('configurateur-projet-domotique')
		? 'to-troubleshooting'
		: lang === 'fr' &&
				(articlePath.includes(URL_CODES_ERREURS_CANON.replace(/\/$/, '')) ||
					articlePath.includes('diagnostic-par-symptome') ||
					articlePath.includes('pieces-detachees') ||
					articlePath.includes('/code-erreur/'))
			? 'to-configurator'
			: null;
import PageRatingWidget from '../components/PageRatingWidget.astro';
---

<html lang={lang === 'fr' ? 'fr' : lang}>
	<head>
		<BaseHead title={title} description={description} image={toolOgImage} ogType="article" pubDate={pubDate} updatedDate={updatedDate} />
		<StructuredDataArticle
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			articleSlug={articleSlug}
			heroImage={toolOgImage}
		/>
		<StructuredDataBreadcrumb items={breadcrumbJsonLd} />
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			.article-header {
				max-width: none;
				width: 100%;
				margin: 0;
				padding: 0 0 1rem;
				box-sizing: border-box;
			}
			.article-header h1 {
				font-size: clamp(1.65rem, 4vw, 2.35rem);
				line-height: 1.2;
				margin-bottom: 0.75rem;
			}
			.article-content {
				max-width: none;
				width: 100%;
				margin: 0;
				padding: 0 0 3rem;
				box-sizing: border-box;
				min-width: 0;
			}
			.category-badge {
				display: inline-block;
				padding: 0.25rem 0.75rem;
				background: var(--accent);
				color: white;
				border-radius: 999px;
				font-size: 0.8rem;
				font-weight: 600;
				text-transform: uppercase;
				margin-bottom: 0.75rem;
			}
			.article-content.repair-guide-page :global(.repair-compliance--disclaimer) {
				margin-top: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		{lang === 'fr' && <DomotiqueSubNav currentCategory="home-assistant" />}
		<main>
			<div class="page-layout page-layout--with-sidebar">
			<article>
				{!skipDefaultBreadcrumb && (
				<div class="article-content" style="padding-top: 1.25rem; padding-bottom: 0;">
					<DomotiqueBreadcrumbNav currentLabel={title} hubHref={withBase(hubPath)} hubLabel={hubLabel} />
				</div>
				)}
				{!contentProvidesH1 && (
				<header class="article-header">
					<span class="category-badge">{hubLabel}</span>
					<h1>{title}</h1>
					<p style="font-size: 1.05rem; color: rgb(var(--gray-dark));">{description}</p>
					<p style="font-size: 0.9rem; color: rgb(var(--gray-dark)); margin-top: 0.75rem;">
						{lang === 'fr' ? 'Mis à jour le' : lang === 'de' ? 'Aktualisiert am' : lang === 'it' ? 'Aggiornato il' : lang === 'es' ? 'Actualizado el' : 'Updated'}{' '}
						<FormattedDate
							date={updatedDate}
							locale={lang === 'fr' ? 'fr-FR' : lang === 'de' ? 'de-DE' : lang === 'it' ? 'it-IT' : lang === 'es' ? 'es-ES' : 'en-GB'}
						/>{' '}
						· {ARTICLE_AUTHOR}
					</p>
				</header>
				)}
				<div class:list={['article-content', 'prose', { 'repair-guide-page': repairGuide }]}>
					{crossLinkVariant && <ToolResolutionBanner variant={crossLinkVariant} />}
					<slot />
					<EditorialReadAlso pathname={articlePath} />
				</div>
				<div class="article-content">
					<PageRatingWidget lang={lang} />
<ArticleQuestionForm lang={formLang} pageTitle={title} />
				</div>
			</article>
			<Sidebar variant="guide" />
			</div>
		</main>
		<Footer />
	</body>
</html>
