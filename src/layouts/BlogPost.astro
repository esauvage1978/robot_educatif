---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleEngagement from '../components/ArticleEngagement.astro';
import Sidebar from '../components/Sidebar.astro';
import { categoryToSlug, topCategoriesByCount } from '../lib/categories';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { ARTICLE_AUTHOR } from '../consts';
import { withBase } from '../lib/siteUrl';

type Props = CollectionEntry<'blog'>['data'] & {
	/** Obligatoire pour les articles ; sur les pages type « À propos », laisser vide pour des suggestions générales */
	articleSlug?: string;
};

const {
	title,
	headline,
	description,
	pubDate,
	updatedDate,
	heroImage,
	amazonPreset,
	relatedLinks,
	categories = [],
	faqSchema,
	productItemListSchema,
	articleJsonLd,
	articleSlug = '',
} = Astro.props;

const pageHeading = headline ?? title;

const articleCanonicalUrl =
	Astro.site && articleSlug ? new URL(Astro.url.pathname, Astro.site).href : '';
const articleLdJson =
	articleJsonLd && articleCanonicalUrl
		? JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: pageHeading,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: {
					'@type': 'Person',
					name: ARTICLE_AUTHOR,
				},
				mainEntityOfPage: {
					'@type': 'WebPage',
					'@id': articleCanonicalUrl,
				},
			})
		: '';

const resolvedHero = resolveHeroImage(heroImage);
const allPosts = await getCollection('blog');
const topCategories = topCategoriesByCount(allPosts, 15);

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.replace(/\/$/, '') ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const showArticleEngagement = Boolean(supabaseUrl && supabaseKey && articleSlug);
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			.hero-article {
				width: 100vw;
				max-width: 100vw;
				position: relative;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				margin-bottom: 2rem;
				border-radius: 0;
				overflow: hidden;
				border: none;
				border-bottom: 1px solid var(--surface-border);
				background: var(--page-bg);
				box-shadow: none;
			}
			.hero-article-media {
				max-height: min(52vh, 560px);
				overflow: hidden;
				background: var(--page-bg-elevated);
			}
			.hero-article-media img {
				display: block;
				width: 100%;
				height: min(52vh, 560px);
				object-fit: cover;
				border-radius: 0;
			}
			.hero-article-content {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 1.75rem 0 2rem 0;
				background: transparent;
			}
			.hero-article:not(:has(.hero-article-media)) .hero-article-content {
				padding-top: 2.5rem;
			}
			.hero-article-content h1 {
				margin: 0 0 0.6rem 0;
				font-size: clamp(1.65rem, 3.2vw, 2.65rem);
				max-width: 100%;
				line-height: 1.14;
			}
			.hero-article-content .hero-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.125rem;
				line-height: 1.55;
				max-width: 100%;
				font-family: var(--font-body, system-ui);
			}
			.hero-meta {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				align-items: center;
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				font-family: var(--font-body, system-ui);
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.hero-article-toolbar {
				display: flex;
				flex-wrap: wrap;
				align-items: flex-start;
				justify-content: flex-start;
				gap: 0.65rem 1rem;
				margin: 0 0 0.85rem 0;
			}
			.hero-article-toolbar .hero-categories {
				flex: 1 1 auto;
				min-width: 0;
				margin: 0;
			}
			.hero-article-toolbar .article-engagement--hero {
				margin-left: auto;
			}
			.hero-article-toolbar .article-engagement--hero:only-child {
				margin-left: 0;
				max-width: 100%;
			}
			.hero-categories {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.5rem;
				align-items: center;
				margin: 0 0 0.85rem 0;
				padding: 0;
				list-style: none;
			}
			.hero-categories li {
				margin: 0;
			}
			.hero-categories a {
				display: inline-block;
				padding: 0.28rem 0.65rem;
				font-size: 0.82rem;
				font-weight: 600;
				font-family: var(--font-body, system-ui);
				text-decoration: none;
				color: var(--accent-dark);
				background: color-mix(in oklab, var(--accent-dark) 12%, transparent);
				border: 1px solid color-mix(in oklab, var(--accent-dark) 28%, var(--surface-border));
				border-radius: 999px;
				transition: background 0.12s ease, color 0.12s ease;
			}
			.hero-categories a:hover {
				background: color-mix(in oklab, var(--accent-dark) 22%, transparent);
			}
			html:not([data-theme='light']) .hero-categories a:hover {
				color: var(--accent);
			}
			.page-layout {
				width: min(1200px, calc(100% - 2em));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				align-items: start;
				min-width: 0;
			}
			.page-layout > article {
				min-width: 0;
			}
			/* Typo et images du corps d’article : src/styles/global.css (.prose) */
			.last-updated-on {
				font-style: italic;
			}
			.hero-author {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 720px) {
				.hero-article-media,
				.hero-article-media img {
					max-height: 42vh;
					height: 42vh;
				}
				.hero-article-content {
					padding: 1.25rem 1rem 1.5rem;
					width: 100%;
					box-sizing: border-box;
				}
				.page-layout {
					grid-template-columns: 1fr;
				}
			}
			/* CTA dans le corps d’article (HTML brut dans le Markdown) */
			.prose .article-cta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				margin: 1.35rem 0;
			}
			.prose .article-cta {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				box-sizing: border-box;
				font-family: var(--font-body, system-ui);
				font-weight: 700;
				font-size: 0.95rem;
				line-height: 1.25;
				text-decoration: none;
				border-radius: 8px;
				padding: 0.6rem 1.1rem;
				border: 1px solid transparent;
				transition:
					background 0.15s ease,
					border-color 0.15s ease,
					filter 0.12s ease;
			}
			.prose .article-cta--primary {
				color: #fff !important;
				background: var(
					--brand-gradient,
					linear-gradient(135deg, var(--accent), var(--accent-warm))
				);
				border-color: color-mix(in oklab, #fff 18%, transparent);
				box-shadow:
					0 1px rgba(255, 255, 255, 0.12) inset,
					0 4px 16px rgba(0, 0, 0, 0.18);
			}
			.prose .article-cta--primary:hover {
				filter: brightness(1.06);
				text-decoration: none !important;
			}
			.prose .article-cta--secondary {
				color: var(--accent-dark) !important;
				background: color-mix(in oklab, var(--accent) 22%, var(--surface-2));
				border-color: color-mix(in oklab, var(--accent) 38%, var(--surface-border));
			}
			.prose .article-cta--secondary:hover {
				background: color-mix(in oklab, var(--accent) 30%, var(--surface-2));
				text-decoration: none !important;
			}
			.prose .article-toc {
				margin: 0 0 1.75rem 0;
				padding: 1rem 1.15rem;
				border-radius: 12px;
				border: 1px solid var(--surface-border);
				background: color-mix(in oklab, var(--surface-2) 88%, var(--page-bg));
				font-size: 0.95rem;
			}
			.prose .article-toc-title {
				margin: 0 0 0.65rem 0;
				font-size: 0.82rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
				font-family: var(--font-body, system-ui);
			}
			.prose .article-toc ul {
				margin: 0;
				padding-left: 1.15rem;
				display: grid;
				gap: 0.35rem;
			}
			.prose .article-toc a {
				font-weight: 600;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<section class="hero-article">
				{resolvedHero && (
					<div class="hero-article-media">
						<Image width={1600} height={760} src={resolvedHero} alt={pageHeading} />
					</div>
				)}
				<div class="hero-article-content">
					<div class="hero-meta">
						<span><FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<span class="last-updated-on">Mis à jour le <FormattedDate date={updatedDate} /></span>
							)
						}
						{
							articleSlug && (
								<span class="hero-author">
									Par {ARTICLE_AUTHOR}
								</span>
							)
						}
					</div>
					{
						(categories.length > 0 || showArticleEngagement) && (
							<div class="hero-article-toolbar">
								{
									categories.length > 0 && (
										<ul class="hero-categories" aria-label="Catégories de l’article">
											{categories.map((cat) => (
												<li>
													<a href={withBase(`/categorie/${categoryToSlug(cat)}/`)}>{cat}</a>
												</li>
											))}
										</ul>
									)
								}
								{showArticleEngagement ? (
									<ArticleEngagement articleSlug={articleSlug!} variant="hero" />
								) : null}
							</div>
						)
					}
					<h1>{pageHeading}</h1>
					<p class="hero-desc">{description}</p>
				</div>
			</section>
			<div class="page-layout">
				<article>
					<div class:list={['prose', articleSlug ? `prose--slug-${articleSlug}` : false]}>
						<slot />
						{
							articleLdJson && (
								<script type="application/ld+json" set:html={articleLdJson} />
							)
						}
						{
							faqSchema && faqSchema.length > 0 && (
								<script
									type="application/ld+json"
									set:html={JSON.stringify({
										'@context': 'https://schema.org',
										'@type': 'FAQPage',
										mainEntity: faqSchema.map((item) => ({
											'@type': 'Question',
											name: item.question,
											acceptedAnswer: {
												'@type': 'Answer',
												text: item.answer,
											},
										})),
									})}
								/>
							)
						}
						{
							productItemListSchema && productItemListSchema.length > 0 && (
								<script
									type="application/ld+json"
									set:html={JSON.stringify({
										'@context': 'https://schema.org',
										'@type': 'ItemList',
										name: pageHeading,
										numberOfItems: productItemListSchema.length,
										itemListElement: productItemListSchema.map((item) => ({
											'@type': 'ListItem',
											position: item.position,
											item: {
												'@type': 'Product',
												name: item.name,
												url: item.url,
												...(item.brand
													? {
															brand: {
																'@type': 'Brand',
																name: item.brand,
															},
														}
													: {}),
												/* Requis par Google (offers, review ou aggregateRating) : prix indicatifs EUR alignés sur le guide */
												offers: {
													'@type': 'AggregateOffer',
													url: item.url,
													priceCurrency: 'EUR',
													lowPrice:
														item.offerLowPrice !== undefined && item.offerLowPrice !== ''
															? item.offerLowPrice
															: '1',
													highPrice:
														item.offerHighPrice !== undefined && item.offerHighPrice !== ''
															? item.offerHighPrice
															: '999',
													offerCount: 1,
													availability: 'https://schema.org/InStock',
												},
											},
										})),
									})}
								/>
							)
						}
					</div>
				</article>
				<Sidebar
					articleSlug={articleSlug}
					affiliatePreset={amazonPreset ?? null}
					relatedLinks={relatedLinks}
					categories={categories}
					topCategories={topCategories}
				/>
			</div>
		</main>
		<Footer suppressPagePathTracking={Boolean(articleSlug)} />
	</body>
</html>
