---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleEngagement from '../components/ArticleEngagement.astro';
import Sidebar from '../components/Sidebar.astro';
import StructuredDataArticle from '../components/StructuredDataArticle.astro';
import StructuredDataBreadcrumb from '../components/StructuredDataBreadcrumb.astro';
import TutorialProductBox from '../components/TutorialProductBox.astro';
import ChristmasBanner from '../components/ChristmasBanner.astro';
import PinterestShare from '../components/PinterestShare.astro';
import { categoryToSlug, topCategoriesByCount } from '../lib/categories';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { ARTICLE_AUTHOR } from '../consts';
import { withBase } from '../lib/siteUrl';

type Props = CollectionEntry<'blog'>['data'] & {
	/** Obligatoire pour les articles ; sur les pages type « À propos », laisser vide pour des suggestions générales */
	articleSlug?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	amazonPreset,
	relatedLinks,
	categories = [],
	articleSlug = '',
} = Astro.props;

const resolvedHero = resolveHeroImage(heroImage);
const allPosts = await getCollection('blog');
const topCategories = topCategoriesByCount(allPosts, 15);

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.replace(/\/$/, '') ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const showArticleEngagement = Boolean(supabaseUrl && supabaseKey && articleSlug);

// URL de la page pour Pinterest
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Vérifier si l'image Pinterest existe avant de l'afficher
let pinterestMediaUrl = '';
if (articleSlug) {
	try {
		const pinterestImagePath = `/pinterest/${articleSlug}-1.jpg`;
		const fs = await import('node:fs');
		const path = await import('node:path');
		const publicPath = path.join(process.cwd(), 'public', pinterestImagePath);
		if (fs.existsSync(publicPath)) {
			pinterestMediaUrl = new URL(pinterestImagePath, Astro.site).toString();
		}
	} catch (e) {
		// Image Pinterest non disponible, on n'affiche pas
	}
}

// Détection automatique du TutorialProductBox selon les catégories
const categoryLower = categories.map(c => c.toLowerCase());
let tutorialProducts: string[] | null = null;
let tutorialGuide: { url: string; title: string } | null = null;

if (categoryLower.some(c => c.includes('mblock') || c.includes('mbot'))) {
	tutorialProducts = ['mbot2', 'mbot'];
	tutorialGuide = { url: '/quel-robot-acheter-enfant-10-ans-guide-achat/', title: 'Guide complet : quel robot mBot choisir ?' };
} else if (categoryLower.some(c => c.includes('python'))) {
	tutorialProducts = ['mbot2', 'raspberry-pi-5-8gb', 'cyberpi'];
	tutorialGuide = { url: '/robot-programmable-python/', title: 'Guide : robots programmables Python' };
} else if (categoryLower.some(c => c.includes('arduino'))) {
	tutorialProducts = ['elegoo-robot-car', 'elegoo-penguin'];
	tutorialGuide = { url: '/kit-robot-arduino-enfant/', title: 'Guide : kits robot Arduino pour enfants' };
} else if (categoryLower.some(c => c.includes('raspberry'))) {
	tutorialProducts = ['raspberry-pi-5-8gb', 'raspberry-pi-5-4gb'];
	tutorialGuide = { url: '/kit-raspberry-pi-5-complet/', title: 'Guide : kit Raspberry Pi 5 complet' };
}
---

<html lang="fr">
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={resolvedHero}
			ogType="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		{articleSlug && (
			<>
				<StructuredDataArticle
					title={title}
					description={description}
					pubDate={pubDate}
					updatedDate={updatedDate}
					heroImage={resolvedHero}
					articleSlug={articleSlug}
				/>
				<StructuredDataBreadcrumb
					items={[
						{ name: 'Accueil', url: withBase('/') },
						{ name: 'Blog', url: withBase('/blog/') },
						{ name: title, url: withBase(`/${articleSlug}/`) },
					]}
				/>
			</>
		)}
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			.hero-article {
				width: 100vw;
				max-width: 100vw;
				position: relative;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				margin-bottom: 2rem;
				border-radius: 0;
				overflow: hidden;
				border: none;
				border-bottom: 1px solid var(--surface-border);
				background: var(--page-bg);
				box-shadow: none;
			}
			.hero-article-media {
				max-height: 360px;
				overflow: hidden;
				background: var(--page-bg-elevated);
			}
			.hero-article-media img {
				display: block;
				width: 100%;
				height: 360px;
				object-fit: cover;
				border-radius: 0;
			}
			
			@media (max-width: 768px) {
				.hero-article-media {
					max-height: 220px;
				}
				.hero-article-media img {
					height: 220px;
				}
			}
			.hero-article-content {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 1.75rem 0 2rem 0;
				background: transparent;
			}
			.hero-article:not(:has(.hero-article-media)) .hero-article-content {
				padding-top: 2.5rem;
			}
			.hero-article-content h1 {
				margin: 0 0 0.6rem 0;
				font-size: clamp(1.65rem, 3.2vw, 2.65rem);
				max-width: 100%;
				line-height: 1.14;
			}
			.hero-article-content .hero-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.125rem;
				line-height: 1.55;
				max-width: 100%;
				font-family: var(--font-body, system-ui);
			}
			.hero-meta {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				align-items: center;
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				font-family: var(--font-body, system-ui);
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.hero-article-toolbar {
				display: flex;
				flex-wrap: wrap;
				align-items: flex-start;
				justify-content: flex-start;
				gap: 0.65rem 1rem;
				margin: 0 0 0.85rem 0;
			}
			.hero-article-toolbar .hero-categories {
				flex: 1 1 auto;
				min-width: 0;
				margin: 0;
			}
			.hero-article-toolbar .article-engagement--hero {
				margin-left: auto;
			}
			.hero-article-toolbar .article-engagement--hero:only-child {
				margin-left: 0;
				max-width: 100%;
			}
			.hero-article-toolbar .pinterest-hero-button {
				flex-shrink: 0;
			}
			.hero-categories {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem 0.5rem;
				align-items: center;
				margin: 0 0 0.85rem 0;
				padding: 0;
				list-style: none;
			}
			.hero-categories li {
				margin: 0;
			}
			.hero-categories a {
				display: inline-block;
				padding: 0.28rem 0.65rem;
				font-size: 0.82rem;
				font-weight: 600;
				font-family: var(--font-body, system-ui);
				text-decoration: none;
				color: var(--accent-dark);
				background: color-mix(in oklab, var(--accent-dark) 12%, transparent);
				border: 1px solid color-mix(in oklab, var(--accent-dark) 28%, var(--surface-border));
				border-radius: 999px;
				transition: background 0.12s ease, color 0.12s ease;
			}
			.hero-categories a:hover {
				background: color-mix(in oklab, var(--accent-dark) 22%, transparent);
			}
			html:not([data-theme='light']) .hero-categories a:hover {
				color: var(--accent);
			}
			.page-layout {
				width: min(1200px, calc(100% - 2em));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				align-items: start;
				min-width: 0;
			}
			.page-layout > article {
				min-width: 0;
			}
			/* Typo et images du corps d’article : src/styles/global.css (.prose) */
			.last-updated-on {
				font-style: italic;
			}
			.hero-author {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
		@media (max-width: 720px) {
			.hero-article {
				margin-bottom: 1rem !important;
			}
			.hero-article-media {
				max-height: 200px !important;
			}
			.hero-article-media img {
				height: 170px !important;
				max-height: 200px !important;
				object-fit: cover;
			}
			.hero-article-content {
				padding: 0 0.9rem 0.9rem !important;
				width: 100%;
				box-sizing: border-box;
			}
			.hero-meta {
				margin-bottom: 0.15rem !important;
				font-size: 0.76rem !important;
				gap: 0.2rem 0.45rem !important;
			}
			.hero-article-toolbar {
				margin-bottom: 0.3rem !important;
				gap: 0.25rem 0.5rem !important;
			}
			.hero-categories {
				margin-bottom: 0.4rem !important;
				gap: 0.3rem !important;
			}
			.hero-categories a {
				padding: 0.2rem 0.5rem !important;
				font-size: 0.78rem !important;
			}
			.hero-article-content h1 {
				margin-top: 0 !important;
				margin-bottom: 0.3rem !important;
				font-size: clamp(1.35rem, 4vw, 1.75rem) !important;
			}
			.hero-article-content .hero-desc {
				font-size: 0.95rem !important;
				line-height: 1.4 !important;
			}
			.page-layout {
				grid-template-columns: 1fr;
			}
		}
		</style>
	</head>

	<body>
		<Header />
		<ChristmasBanner />
		<main>
			<section class="hero-article">
				{resolvedHero && (
					<div class="hero-article-media">
						<Image width={1600} height={760} src={resolvedHero} alt={title} />
					</div>
				)}
				<div class="hero-article-content">
					<div class="hero-meta">
						<span><FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<span class="last-updated-on">Mis à jour le <FormattedDate date={updatedDate} /></span>
							)
						}
						{
							articleSlug && (
								<span class="hero-author">
									Par {ARTICLE_AUTHOR}
								</span>
							)
						}
					</div>
					{articleSlug && pinterestMediaUrl && (
						<img 
							src={pinterestMediaUrl} 
							alt={title}
							data-pin-media={pinterestMediaUrl}
							style="position: absolute; left: -9999px; width: 1px; height: 1px;"
							aria-hidden="true"
						/>
					)}
					{
						(categories.length > 0 || showArticleEngagement || articleSlug) && (
							<div class="hero-article-toolbar">
								{
									categories.length > 0 && (
										<ul class="hero-categories" aria-label="Catégories de l’article">
											{categories.map((cat) => (
												<li>
													<a href={withBase(`/categorie/${categoryToSlug(cat)}/`)}>{cat}</a>
												</li>
											))}
										</ul>
									)
								}
								{showArticleEngagement ? (
									<ArticleEngagement articleSlug={articleSlug!} variant="hero" />
								) : null}
								{articleSlug && (
									<PinterestShare
										url={pageUrl}
										description={`${title} - ${description}`}
										media={pinterestMediaUrl}
										variant="button"
										class="pinterest-hero-button"
									/>
								)}
							</div>
						)
					}
					<h1>{title}</h1>
					<p class="hero-desc">{description}</p>
				</div>
			</section>
			<div class="page-layout">
				<article>
					<div class:list={['prose', articleSlug ? `prose--slug-${articleSlug}` : false]}>
						<slot />
						{tutorialProducts && tutorialProducts.length > 0 && (
							<TutorialProductBox
								productIds={tutorialProducts}
								guideUrl={tutorialGuide?.url}
								guideTitle={tutorialGuide?.title}
							/>
						)}
					</div>
				</article>
				<Sidebar
					articleSlug={articleSlug}
					affiliatePreset={amazonPreset ?? null}
					relatedLinks={relatedLinks}
					categories={categories}
					topCategories={topCategories}
				/>
			</div>
		</main>
		<Footer suppressPagePathTracking={Boolean(articleSlug)} />
	</body>
</html>
