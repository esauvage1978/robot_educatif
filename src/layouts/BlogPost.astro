---
import '../styles/global.css';
import '../styles/dark-mobile-surfaces-fix.css';
import ArticleQuestionForm from '../components/ArticleQuestionForm.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ArticleEngagement from '../components/ArticleEngagement.astro';
import Sidebar from '../components/Sidebar.astro';
import StructuredDataArticle from '../components/StructuredDataArticle.astro';
import StructuredDataBreadcrumb from '../components/StructuredDataBreadcrumb.astro';
import StructuredDataFaq from '../components/StructuredDataFaq.astro';
import TutorialProductBox from '../components/TutorialProductBox.astro';
import GuideOfferRail from '../components/GuideOfferRail.astro';
import ReviewLayoutStyle from '../components/ReviewLayoutStyle.astro';
import { reviewPageForPath } from '../lib/reviewOffers.mjs';
import ChooseRobotBox from '../components/ChooseRobotBox.astro';
import { CHOOSE_ROBOT_SLUGS } from '../lib/chooseRobotLinks';
import PinterestShare from '../components/PinterestShare.astro';
import FollowBlock from '../components/FollowBlock.astro';
import ArticleByline from '../components/ArticleByline.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { categoryToSlug } from '../lib/categories';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { resolveArticleImage } from '../lib/articleThumbnail';
import { getIllustration } from '../lib/illustration';
import { withImageVersion } from '../lib/imageVersion';
import { withBase } from '../lib/siteUrl';
import { findPair } from '../lib/i18n.mjs';

type Props = CollectionEntry<'blog'>['data'] & {
	/** Obligatoire pour les articles ; sur les pages type « À propos », laisser vide pour des suggestions générales */
	articleSlug?: string;
	/** Questions/réponses de la FAQ visible (rehype-faq-schema) → JSON-LD FAQPage */
	faqSchema?: { question: string; answer: string }[];
	minutes?: number;
};

const {
	title,
	description,
	shareTitle,
	shareDescription,
	pubDate,
	updatedDate,
	heroImage,
	amazonPreset,
	relatedLinks,
	categories = [],
	articleSlug = '',
	faqSchema = [],
	minutes,
} = Astro.props;

// Résoudre l'image pour la bannière et og:image selon les mêmes priorités
// 1. heroImage si spécifique (pas générique)
// 2. Vignette générée avec photo produit intégrée
const resolvedImageForMeta = resolveArticleImage(articleSlug, heroImage);
const illustration = articleSlug ? getIllustration(articleSlug) : null;

// Pour la bannière, on affiche soit ImageMetadata, soit le string path vers vignette
const heroIsImageMetadata = resolvedImageForMeta && typeof resolvedImageForMeta !== 'string';
const heroImagePath = typeof resolvedImageForMeta === 'string' ? resolvedImageForMeta : null;

// Versionner les images pour le cache
const heroImagePathWithVersion = heroImagePath ? withImageVersion(heroImagePath.replace('.png', '.webp')) : null;
const ogImagePath = typeof resolvedImageForMeta === 'string' ? withImageVersion(resolvedImageForMeta) : resolvedImageForMeta;
const enPair = findPair(Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, ''));
const allPosts = await getCollection('blog');

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.replace(/\/$/, '') ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const showArticleEngagement = Boolean(supabaseUrl && supabaseKey && articleSlug);

// URL de la page pour Pinterest
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Vérifier si l'image Pinterest existe avant de l'afficher
let pinterestMediaUrl = '';
if (articleSlug) {
	try {
		const pinterestImagePath = `/pinterest/${articleSlug}-1.jpg`;
		const fs = await import('node:fs');
		const path = await import('node:path');
		const publicPath = path.join(process.cwd(), 'public', pinterestImagePath);
		if (fs.existsSync(publicPath)) {
			pinterestMediaUrl = new URL(pinterestImagePath, Astro.site).toString();
		}
	} catch (e) {
		// Image Pinterest non disponible, on n'affiche pas
	}
}

const chooseRobotAges = articleSlug ? CHOOSE_ROBOT_SLUGS[articleSlug] : undefined;
const reviewPage = reviewPageForPath(Astro.url.pathname);
const isReviewLayout = Boolean(reviewPage?.review);
const reviewOffer = reviewPage?.offer ?? null;

// Détection automatique du TutorialProductBox selon les catégories
const categoryLower = categories.map(c => c.toLowerCase());
let tutorialProducts: string[] | null = null;
let tutorialGuide: { url: string; title: string } | null = null;

const isBatailleNavaleSeries =
	articleSlug?.startsWith('python-bataille-navale-') || categoryLower.some((c) => c.includes('bataille navale'));
const isPuissance4Series =
	articleSlug?.startsWith('python-puissance-4-') || categoryLower.some((c) => c.includes('puissance 4'));
const isCarnetTodoSeries = Boolean(articleSlug?.startsWith('python-carnet-todo-'));
const isJournalCliSeries = Boolean(articleSlug?.startsWith('projet-av-journal-'));
const isAgendaCliSeries = Boolean(articleSlug?.startsWith('projet-inter-agenda-'));
const isPythonInterLesson = Boolean(articleSlug?.startsWith('python-inter-'));

if (categoryLower.some(c => c.includes('mblock') || c.includes('mbot'))) {
	tutorialProducts = ['mbot2', 'mbot'];
	tutorialGuide = { url: '/quel-robot-acheter-enfant-10-ans-guide-achat/', title: 'Guide complet : quel robot mBot choisir ?' };
} else if (
	categoryLower.some((c) => c.includes('python')) &&
	!isBatailleNavaleSeries &&
	!isPuissance4Series &&
	!isCarnetTodoSeries &&
	!isJournalCliSeries &&
	!isAgendaCliSeries &&
	!isPythonInterLesson
) {
	tutorialProducts = ['mbot2', 'raspberry-pi-5-8gb', 'cyberpi'];
	tutorialGuide = { url: '/robot-programmable-python/', title: 'Guide : robots programmables Python' };
} else if (categoryLower.some(c => c.includes('arduino'))) {
	tutorialProducts = ['elegoo-robot-car', 'elegoo-penguin'];
	tutorialGuide = { url: '/meilleur-robot-educatif-arduino-kit-choisir/', title: 'Guide : kits robot Arduino pour enfants' };
} else if (categoryLower.some(c => c.includes('raspberry'))) {
	tutorialProducts = ['raspberry-pi-5-8gb', 'raspberry-pi-5-4gb'];
	tutorialGuide = { url: '/kit-raspberry-pi-5-complet/', title: 'Guide : kit Raspberry Pi 5 complet' };
}
---

<html lang="fr">
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={ogImagePath}
			ogType="article"
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
		{articleSlug && (
			<>
				<StructuredDataArticle
					title={title}
					description={description}
					pubDate={pubDate}
					updatedDate={updatedDate}
					heroImage={heroIsImageMetadata ? resolvedImageForMeta : (ogImagePath ?? undefined)}
					articleSlug={articleSlug}
				/>
				<StructuredDataBreadcrumb
					items={[
						{ name: 'Accueil', url: withBase('/') },
						{ name: 'Blog', url: withBase('/blog/') },
						{ name: title, url: withBase(`/${articleSlug}/`) },
					]}
				/>
				<StructuredDataFaq items={faqSchema} />
			</>
		)}
	</head>

	<body>
		<Header />
		<main>
			{!isReviewLayout && <section class="hero-article">
				<div class="hero-article-content">
					{articleSlug && pinterestMediaUrl && (
						<img 
							src={pinterestMediaUrl} 
							alt={title}
							data-pin-media={pinterestMediaUrl}
							style="position: absolute; left: -9999px; width: 1px; height: 1px;"
							aria-hidden="true"
						/>
					)}
					{
						(categories.length > 0 || showArticleEngagement || articleSlug) && (
							<div class="hero-article-toolbar">
								{
									categories.length > 0 && (
										<ul class="hero-categories" aria-label="Catégories de l’article">
											{categories.map((cat) => (
												<li>
													<a href={withBase(`/categorie/${categoryToSlug(cat)}/`)}>{cat}</a>
												</li>
											))}
										</ul>
									)
								}
								{showArticleEngagement ? (
									<ArticleEngagement articleSlug={articleSlug!} variant="hero" />
								) : null}
								{articleSlug && (
									<PinterestShare
										url={pageUrl}
										description={`${title} - ${shareDescription ?? description}`}
										media={pinterestMediaUrl}
										variant="button"
										class="pinterest-hero-button"
									/>
								)}
							</div>
						)
					}
					<h1>{title}</h1>
					<p class="hero-desc">{description}</p>
					<ArticleByline
						lang="fr"
						date={updatedDate ?? pubDate}
						updated={Boolean(updatedDate)}
						minutes={minutes}
					/>
				</div>
				{heroIsImageMetadata && (
					<div class="hero-article-media">
						<Image width={1600} height={760} src={resolvedImageForMeta} alt={title} />
					</div>
				)}
				{heroImagePathWithVersion && (
					<div class="hero-article-media">
						{illustration ? (
							<>
								<img src={heroImagePathWithVersion} alt={illustration.alt} width="960" height="540" fetchpriority="high" decoding="async" />
								<p class="ai-illustration-caption">Illustration générée par IA</p>
							</>
						) : (
							<img src={heroImagePathWithVersion} alt={title} width="1200" height="630" loading="lazy" />
						)}
					</div>
				)}
			</section>}
			<div class:list={['page-layout page-layout--with-sidebar', isReviewLayout && 'page-layout--review']}>
				<article>
					{isReviewLayout && (
						<header class="article-header article-header--review">
							<ArticleByline
								lang="fr"
								date={updatedDate ?? pubDate}
								updated={Boolean(updatedDate)}
								minutes={minutes}
							/>
							{categories.length > 0 && (
								<ul class="hero-categories" aria-label="Catégories de l’article">
									{categories.map((cat) => (
										<li>
											<a href={withBase(`/categorie/${categoryToSlug(cat)}/`)}>{cat}</a>
										</li>
									))}
								</ul>
							)}
							<h1>{title}</h1>
							<p>{description}</p>
						</header>
					)}
					<div class:list={['prose', articleSlug ? `prose--slug-${articleSlug}` : false]}>
						<slot />
						{chooseRobotAges && <ChooseRobotBox ages={chooseRobotAges} />}
						{tutorialProducts && tutorialProducts.length > 0 && (
							<TutorialProductBox
								productIds={tutorialProducts}
								guideUrl={tutorialGuide?.url}
								guideTitle={tutorialGuide?.title}
							/>
						)}
					</div>
					{articleSlug && (
						<>
							<ShareButtons 
								url={withBase(`/${articleSlug}/`)}
								title={shareTitle ?? title}
								description={shareDescription ?? description}
							/>
							<FollowBlock />
						</>
					)}
					<!-- page-rating-v1 -->
<section id="pr-widget" class="pr-widget" aria-labelledby="pr-title">
<style>#pr-widget{margin:1.6rem 0 1rem;padding:1rem 1.1rem;border-radius:12px;border:1px solid rgba(43,125,233,.22);background:linear-gradient(135deg,rgba(43,125,233,.07),rgba(43,125,233,.02));max-width:100%;box-sizing:border-box}#pr-title{margin:0 0 .55rem;font-size:1.05rem;line-height:1.35;font-weight:700}#pr-stars{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .5rem}.pr-star{font:inherit;cursor:pointer;border:1px solid rgba(0,0,0,.12);background:#fff;border-radius:8px;padding:.25rem .45rem;line-height:1;font-size:1.35rem;color:#c4c9d4;transition:transform .12s,color .12s}.pr-star.on{color:#f5b301;border-color:rgba(245,179,1,.45)}.pr-star:focus-visible{outline:2px solid #2b7de9;outline-offset:2px}#pr-avg{font-size:.88rem;opacity:.85;margin-left:.25rem}#pr-thx,#pr-feed{margin-top:.65rem;font-size:.92rem}#pr-feed[hidden],#pr-thx[hidden],#pr-stars[hidden]{display:none!important}.pr-reasons{display:flex;flex-wrap:wrap;gap:.4rem;margin:.45rem 0}.pr-reasons button{font:inherit;font-size:.82rem;padding:.35rem .55rem;border-radius:999px;border:1px solid rgba(0,0,0,.14);background:#fff;cursor:pointer}.pr-reasons button.on{background:#2b7de9;color:#fff;border-color:#2b7de9}#pr-txt{width:100%;max-width:420px;margin:.45rem 0;padding:.45rem .55rem;border-radius:8px;border:1px solid rgba(0,0,0,.15);font:inherit;font-size:.88rem}#pr-send{font:inherit;font-size:.88rem;padding:.4rem .75rem;border-radius:8px;border:0;background:#2b7de9;color:#fff;cursor:pointer}@media(max-width:600px){.pr-star{font-size:1.55rem;padding:.35rem .55rem}#pr-txt{max-width:100%}}</style>
<p id="pr-title">Cette page vous a-t-elle été utile ?</p>
<div id="pr-stars" role="group" aria-label="Rating">
<button type="button" class="pr-star" data-v="1" aria-label="1">★</button><button type="button" class="pr-star" data-v="2" aria-label="2">★</button><button type="button" class="pr-star" data-v="3" aria-label="3">★</button><button type="button" class="pr-star" data-v="4" aria-label="4">★</button><button type="button" class="pr-star" data-v="5" aria-label="5">★</button>
<span id="pr-avg" class="mut"></span></div>
<p id="pr-thx" hidden>Merci !</p>
<div id="pr-feed" hidden>
<p id="pr-im">Que devons-nous améliorer ?</p>
<div class="pr-reasons">
<button type="button" data-reason="Info incomplète">Info incomplète</button><button type="button" data-reason="Lien / prix à jour">Lien / prix à jour</button><button type="button" data-reason="Outil / tableau à corriger">Outil / tableau à corriger</button></div>
<textarea id="pr-txt" maxlength="180" rows="2" placeholder="Commentaire optionnel (180 car.)"></textarea>
<button type="button" id="pr-send">Envoyer</button></div>
<input type="text" id="pr-hp" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0" />
</section>
<script>(function(){/*mnz-click-v1*/var A="https://manuso.fr/rating_api.php",B="https://manuso.fr/realtime_api.php";var site=location.hostname.replace(/^www\./,""),path=location.pathname||"/";if(!/\/$/.test(path))path+="/";var lc=0;function tc(ev){if(ev.type==="auxclick"&&ev.button!==1)return;var a=ev.target&&ev.target.closest?ev.target.closest("a"):null;if(!a)return;var h=a.href||"";if(!/^https?:\/\//i.test(h))return;var hn="";try{hn=new URL(h).hostname.replace(/^www\./,"")}catch(e){}if((hn===site||hn==="manuso.fr")&&!/\/go\/|\/r\.php/i.test(h))return;if(Date.now()-lc<400)return;lc=Date.now();var lb=((a.innerText||a.getAttribute("aria-label")||a.title||"").replace(/\s+/g," ").trim()).slice(0,80);var u=B+"?track_click=1&site="+encodeURIComponent(site)+"&page="+encodeURIComponent(path)+"&label="+encodeURIComponent(lb)+"&url="+encodeURIComponent(h);var ok=0;try{if(navigator.sendBeacon)ok=navigator.sendBeacon(u)?1:0}catch(e){}if(!ok){try{fetch(u,{mode:"no-cors",keepalive:1})}catch(e){}try{(new Image()).src=u}catch(e){}}}document.addEventListener("click",tc,1);document.addEventListener("auxclick",tc,1);var w=document.getElementById("pr-widget");if(!w)return;var i=["Merci !","Note moyenne"],$=function(id){return document.getElementById(id)};var ls="pr_voted_"+site+"_"+path.replace(/\//g,"_"),tok="",t0=Date.now(),tm=0,sc=0,rs="";function avg(n,c){var e=$("pr-avg");e.textContent=c?i[1]+" "+n.toFixed(1).replace(".",",")+"/5 ("+c+")":""}function paint(n){w.querySelectorAll(".pr-star").forEach(function(b){var v=+b.dataset.v;b.classList.toggle("on",v<=n);});}function post(n,o){o=o||{};if(!tok)return Promise.resolve();return fetch(A,{method:"POST",headers:{"Content-Type":"application/json"},keepalive:1,body:JSON.stringify({action:"vote",site:site,path:path,score:n,token:tok,hp:($("pr-hp")||{}).value||"",reason:o.reason!==undefined?o.reason:rs,comment:o.comment||""})}).then(function(r){return r.json()}).then(function(d){if(d&&d.ok&&!d.ignored){avg(+d.avg||n,+d.count||1);try{localStorage.setItem(ls,n)}catch(e){}}})}function queue(n,o,cb){clearTimeout(tm);var wms=Math.max(350,3200-(Date.now()-t0));tm=setTimeout(function(){post(n,o).then(function(){if(cb)cb()})},wms)}fetch(A+"?action=token&site="+encodeURIComponent(site)+"&path="+encodeURIComponent(path)).then(function(r){return r.json()}).then(function(d){if(!d||!d.ok)return;tok=d.token;t0=Date.now();avg(+d.avg,+d.count);var o=0;try{o=+localStorage.getItem(ls)||0}catch(e){}if(o>0&&o<6){paint(o);sc=o}});w.querySelectorAll(".pr-star").forEach(function(b){b.onclick=function(){var n=+b.dataset.v;paint(n);sc=n;if(n>3){$("pr-feed").hidden=1;$("pr-thx").hidden=0;queue(n)}else{$("pr-thx").hidden=1;$("pr-feed").hidden=0;queue(n)}}});$("pr-feed").onclick=function(ev){var t=ev.target.closest("[data-reason]");if(!t||!sc)return;rs=t.dataset.reason;w.querySelectorAll("[data-reason]").forEach(function(x){x.classList.toggle("on",x===t)});queue(sc,{reason:rs,comment:($("pr-txt").value||"").slice(0,180)})};$("pr-send").onclick=function(){if(!sc)return;queue(sc,{reason:rs,comment:($("pr-txt").value||"").slice(0,180)},function(){$("pr-feed").hidden=1;$("pr-thx").hidden=0})};})();</script>
<!-- /page-rating-v1 -->
<ArticleQuestionForm lang="fr" pageTitle={title} />
				</article>
				<div class="guide-rail">
					{isReviewLayout && <ReviewLayoutStyle />}
					{reviewOffer && <GuideOfferRail offer={reviewOffer} />}
					<Sidebar variant="guide" relatedLinks={relatedLinks} />
				</div>
			</div>
		</main>
		<Footer suppressPagePathTracking={Boolean(articleSlug)} />
		
		{articleSlug && (
			<script define:vars={{ currentUrl: withBase(`/${articleSlug}/`), pageTitle: title }}>
				// Add Pinterest overlay to article images (no third-party JS, no CLS)
				document.addEventListener('DOMContentLoaded', () => {
					const figures = document.querySelectorAll('.prose figure');
					figures.forEach((figure) => {
						const img = figure.querySelector('img');
						if (!img) return;
						
						// Get image URL (prefer data-pin-media if set, otherwise src)
						const imageUrl = img.getAttribute('data-pin-media') || img.src;
						const description = img.alt || pageTitle;
						
						// Create Pinterest overlay button
						const overlay = document.createElement('div');
						overlay.className = 'pinterest-img-overlay';
						
						const pinterestUrl = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(currentUrl)}&media=${encodeURIComponent(imageUrl)}&description=${encodeURIComponent(description)}`;
						
						overlay.innerHTML = `
							<a href="${pinterestUrl}" target="_blank" rel="noopener noreferrer" class="pinterest-img-overlay-btn" aria-label="Épingler cette image sur Pinterest">
								<svg class="pinterest-img-overlay-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
								</svg>
								Enregistrer
							</a>
						`;
						
						figure.appendChild(overlay);
					});
				});
			</script>
		)}
	</body>
</html>

<style>
	main {
		width: 100%;
		padding-top: 0;
		}
		.hero-article {
		width: 100%;
		max-width: 100%;
		position: relative;
		margin-left: 0;
		margin-right: 0;
		margin-bottom: 2rem;
		border-radius: 0;
		overflow: hidden;
		border: none;
		border-bottom: 1px solid var(--surface-border);
		background: var(--page-bg);
		box-shadow: none;
		}
		.hero-article-media {
		max-width: 900px;
		margin: 0 auto;
		padding: 0.35rem 1.25rem 1.75rem;
		box-sizing: border-box;
		background: transparent;
		}
		.hero-article-media img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: contain;
		border-radius: 1.35rem;
		box-shadow: 0 10px 28px rgba(11, 31, 42, 0.08);
		}
		
		@media (max-width: 768px) {
		.hero-article-media {
			max-width: 100%;
		}
		}
		.hero-article-content {
		width: min(1140px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 1.75rem 0 2rem 0;
		background: transparent;
		}
		.hero-article:not(:has(.hero-article-media)) .hero-article-content {
		padding-top: 2.5rem;
		}
		.hero-article-content h1 {
		margin: 0 0 0.6rem 0;
		font-size: clamp(1.65rem, 3.2vw, 2.65rem);
		max-width: 100%;
		line-height: 1.14;
		}
		.hero-article-content .hero-desc {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1.125rem;
		line-height: 1.55;
		max-width: 100%;
		font-family: var(--font-body, system-ui);
		}
		.hero-meta {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		align-items: center;
		margin-bottom: 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		font-family: var(--font-body, system-ui);
		font-weight: 600;
		letter-spacing: 0.02em;
		}
		.hero-article-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: flex-start;
		gap: 0.65rem 1rem;
		margin: 0 0 0.85rem 0;
		}
		.hero-article-toolbar .hero-categories {
		flex: 1 1 auto;
		min-width: 0;
		margin: 0;
