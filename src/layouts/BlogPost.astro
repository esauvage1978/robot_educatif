---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, amazonPreset, relatedLinks } =
	Astro.props;
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				padding-top: 0;
			}
			.hero-article {
				width: 100vw;
				max-width: 100vw;
				position: relative;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				margin-bottom: 2rem;
				border-radius: 0;
				overflow: hidden;
				border: none;
				border-bottom: 1px solid var(--surface-border);
				background: var(--page-bg);
				box-shadow: none;
			}
			.hero-article-media {
				max-height: min(52vh, 560px);
				overflow: hidden;
				background: var(--page-bg-elevated);
			}
			.hero-article-media img {
				display: block;
				width: 100%;
				height: min(52vh, 560px);
				object-fit: cover;
				border-radius: 0;
			}
			.hero-article-content {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 1.75rem 0 2rem 0;
				background: transparent;
			}
			.hero-article:not(:has(.hero-article-media)) .hero-article-content {
				padding-top: 2.5rem;
			}
			.hero-article-content h1 {
				margin: 0 0 0.6rem 0;
				font-size: clamp(1.65rem, 3.2vw, 2.65rem);
				max-width: 22ch;
				line-height: 1.14;
			}
			.hero-article-content .hero-desc {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1.125rem;
				line-height: 1.55;
				max-width: var(--prose-width, 42rem);
				font-family: var(--font-body, system-ui);
			}
			.hero-meta {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 0.65rem 1rem;
				align-items: center;
				margin-bottom: 0.75rem;
				color: rgb(var(--gray));
				font-size: 0.88rem;
				font-family: var(--font-body, system-ui);
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.page-layout {
				width: min(1200px, calc(100% - 2em));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 2rem;
				align-items: start;
			}
			.prose {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0.25em 0 1em 0;
				color: rgb(var(--gray-dark));
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 720px) {
				.hero-article-media,
				.hero-article-media img {
					max-height: 42vh;
					height: 42vh;
				}
				.hero-article-content {
					padding: 1.25rem 1rem 1.5rem;
					width: 100%;
					box-sizing: border-box;
				}
				.page-layout {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<section class="hero-article">
				{heroImage && (
					<div class="hero-article-media">
						<Image width={1600} height={760} src={heroImage} alt={title} />
					</div>
				)}
				<div class="hero-article-content">
					<div class="hero-meta">
						<span><FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<span class="last-updated-on">Mis à jour le <FormattedDate date={updatedDate} /></span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="hero-desc">{description}</p>
				</div>
			</section>
			<div class="page-layout">
				<article>
					<div class="prose">
						<slot />
					</div>
				</article>
				<Sidebar affiliatePreset={amazonPreset ?? null} relatedLinks={relatedLinks} />
			</div>
		</main>
		<Footer />
	</body>
</html>
