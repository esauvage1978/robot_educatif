---
import ComparisonTable from './ComparisonTable.astro';
import { priceMentionForLocale } from '../lib/amazonMarket.mjs';
import { catalogForMarket } from '../lib/marketProducts.mjs';

interface Props {
	market?: string;
	locale?: string;
}

const pathname = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const locale =
	Astro.props.locale ||
	(pathname.startsWith('/de/')
		? 'de'
		: pathname.startsWith('/it/')
			? 'it'
			: pathname.startsWith('/es/')
				? 'es'
				: pathname.startsWith('/nl/')
					? 'nl'
					: /^\/(en|uk|ca|us)\//.test(pathname)
						? 'en'
						: 'fr');
const market = Astro.props.market || (locale === 'de' ? 'de' : locale === 'it' ? 'it' : locale === 'es' ? 'es' : locale === 'fr' ? 'fr' : 'uk');
const { releveAffichage } = await catalogForMarket(market, locale);
const priceMention = priceMentionForLocale(releveAffichage, locale);

