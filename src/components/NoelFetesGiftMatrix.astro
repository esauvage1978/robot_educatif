	},
};

const c = COPY[locale] || COPY.fr;
---

<section class="noel-matrix" aria-labelledby="noel-matrix-title">
	<h2 id="noel-matrix-title">{c.h2}</h2>
	<p class="noel-matrix-lead">{c.lead}</p>
	{priceMention && <p class="amazon-price-mention">{priceMention}</p>}

	{c.ages.map((block) => (
		<div>
			<h3 id={`noel-age-${block.id}`}>{block.title}</h3>
			<ComparisonTable variant="cards" market={market} locale={locale} title="" products={block.products} />
		</div>
	))}

	<h3>{locale === 'fr' ? 'Par budget' : locale === 'de' ? 'Nach Budget' : locale === 'it' ? 'Per budget' : locale === 'es' ? 'Por presupuesto' : locale === 'nl' ? 'Per budget' : 'By budget'}</h3>
	{c.budgets.map((block) => (
		<div>
			<h4>{block.title}</h4>
			<ComparisonTable variant="cards" market={market} locale={locale} title="" products={block.products} />
		</div>
	))}
</section>

<style>
	.noel-matrix {
		margin: 2rem 0;
		padding: 1.25rem 1rem;
		border-radius: 14px;
		background: linear-gradient(135deg, #fff8f0, #f3f8ff);
		border: 1px solid #e8e0d4;
	}
	.noel-matrix h2 {
		margin: 0 0 0.5rem;
		font-size: 1.35rem;
	}
	.noel-matrix-lead {
		margin: 0 0 1rem;
		color: #4a5160;
	}
	.noel-matrix h3 {
		margin: 1.5rem 0 0.5rem;
		font-size: 1.1rem;
	}
	.noel-matrix h4 {
		margin: 1rem 0 0.35rem;
		font-size: 1rem;
	}
</style>