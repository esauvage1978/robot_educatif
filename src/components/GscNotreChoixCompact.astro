---
import ProductBox from './ProductBox.astro';
import { GSC_INTENT_KEYS, PICK_UI } from '../data/gscIntentPageConfig.mjs';
import { marketFromPathname } from '../lib/amazonMarket.mjs';

interface Props {
	pageKey?: string;
	market?: string;
	locale?: string;
}

const pageKey = Astro.props.pageKey || 'hub-best-robot';
const pathname = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const market = Astro.props.market || marketFromPathname(pathname);
const locale =
	Astro.props.locale ||
	(market === 'de' ? 'de' : market === 'it' ? 'it' : market === 'es' ? 'es' : market === 'fr' ? 'fr' : 'en');
const cfg = GSC_INTENT_KEYS[pageKey];
const pick = cfg?.pick?.slice(0, 3) || [];
const ui = PICK_UI[locale] || PICK_UI.fr;
---

{pick.length > 0 && (
	<section class="gsc-pick-compact" aria-label={ui.title}>
		<h2 class="gsc-pick-compact__title">{ui.title}</h2>
		<div class="gsc-pick-compact__grid">
			{pick.map((item) => (
				<ProductBox
					id={item.id}
					productId={item.id}
					layout="stack"
					badge={item.badge || ''}
					lang={locale}
					showProsCons={false}
					preferLocalImage={true}
				/>
			))}
		</div>
	</section>
)}

<style>
	.gsc-pick-compact {
		margin: 1.25rem 0 1.5rem;
	}
	.gsc-pick-compact__title {
		margin: 0 0 0.65rem;
		font-size: 1.15rem;
		line-height: 1.3;
	}
	.gsc-pick-compact__grid {
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
	}
</style>