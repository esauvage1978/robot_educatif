---
import { COOKIE_CONSENT_STORAGE_KEY } from '../lib/cookieConsent';
import { withBase } from '../lib/siteUrl';

const cookiesPageUrl = withBase('/gestion-des-cookies/');
const _p = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const isEn = _p === '/en' || _p.startsWith('/en/') || _p === '/uk' || _p.startsWith('/uk/') || _p === '/ca' || _p.startsWith('/ca/');
const isDe = _p === '/de' || _p.startsWith('/de/');
const isIt = _p === '/it' || _p.startsWith('/it/');
const isEs = _p === '/es' || _p.startsWith('/es/');
const isNl = _p === '/nl' || _p.startsWith('/nl/');
---

<div id="cookie-consent-banner" class="cookie-consent" data-pagefind-ignore="all" role="dialog" aria-modal="false" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-desc" hidden>
	<div class="cookie-consent__inner">
		{isNl ? (
		<>
			<p id="cookie-consent-title" class="cookie-consent__title">Cookies en statistieken</p>
			<p id="cookie-consent-desc" class="cookie-consent__text">
				We gebruiken Google Analytics 4 om te begrijpen hoe de site wordt gebruikt (bekeken pagina's, navigatie). Dit wordt alleen ingeschakeld als je akkoord gaat. Weigeren belet je niet om de site te bekijken. Meer informatie: <a href={cookiesPageUrl} hreflang="fr">cookiebeheer</a> en <a href={withBase('/politique-de-confidentialite/')} hreflang="fr">privacybeleid</a> (in het Frans).
			</p>
			<div class="cookie-consent__actions">
				<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Weigeren</button>
				<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Accepteren</button>
			</div>
		</>
		) : isIt ? (
		<>
			<p id="cookie-consent-title" class="cookie-consent__title">Cookie e statistiche</p>
			<p id="cookie-consent-desc" class="cookie-consent__text">
				Usiamo Google Analytics 4 per capire come viene usato il sito (pagine viste, navigazione). Viene attivato solo se accettate. Rifiutare non impedisce di consultare il sito. Per saperne di più: <a href={cookiesPageUrl} hreflang="fr">gestione dei cookie</a> e <a href={withBase('/politique-de-confidentialite/')} hreflang="fr">informativa sulla privacy</a> (in francese).
			</p>
			<div class="cookie-consent__actions">
				<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Rifiuta</button>
				<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Accetta</button>
			</div>
		</>
		) : isEs ? (
		<>
			<p id="cookie-consent-title" class="cookie-consent__title">Cookies y estadísticas</p>
			<p id="cookie-consent-desc" class="cookie-consent__text">
				Usamos Google Analytics 4 para entender cómo se usa el sitio (páginas vistas, navegación). Solo se activa si aceptas. Rechazar no impide consultar el sitio. Más información: <a href={cookiesPageUrl} hreflang="fr">gestión de cookies</a> y <a href={withBase('/politique-de-confidentialite/')} hreflang="fr">política de privacidad</a> (en francés).
			</p>
			<div class="cookie-consent__actions">
				<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Rechazar</button>
				<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Aceptar</button>
			</div>
		</>
		) : isDe ? (
		<>
			<p id="cookie-consent-title" class="cookie-consent__title">Cookies und Statistik</p>
			<p id="cookie-consent-desc" class="cookie-consent__text">
				Wir nutzen Google Analytics 4, um zu verstehen, wie die Website genutzt wird (Seitenaufrufe, Navigation). Es wird nur aktiviert, wenn Sie zustimmen. Eine Ablehnung schränkt die Nutzung der Website nicht ein. Mehr: <a href={cookiesPageUrl} hreflang="fr">Cookie-Einstellungen</a> und <a href={withBase('/politique-de-confidentialite/')} hreflang="fr">Datenschutzerklärung</a> (auf Französisch).
			</p>
			<div class="cookie-consent__actions">
				<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Ablehnen</button>
				<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Akzeptieren</button>
			</div>
		</>
		) : isEn ? (
		<>
			<p id="cookie-consent-title" class="cookie-consent__title">Cookies and analytics</p>
			<p id="cookie-consent-desc" class="cookie-consent__text">
				We use Google Analytics 4 to understand how the site is used (page views, navigation). It is only switched on if you accept. Declining does not stop you using the site. More: <a href={cookiesPageUrl} hreflang="fr">cookie settings</a> and <a href={withBase('/politique-de-confidentialite/')} hreflang="fr">privacy policy</a> (in French).
			</p>
			<div class="cookie-consent__actions">
				<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Decline</button>
				<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Accept</button>
			</div>
		</>
	) : (
		<>
		<p id="cookie-consent-title" class="cookie-consent__title">Cookies et mesure d&apos;audience</p>
		<p id="cookie-consent-desc" class="cookie-consent__text">
			Nous utilisons Google Analytics 4 pour comprendre comment le site est utilisé (pages vues, navigation). Ces données sont
			activées uniquement si vous acceptez. Refuser n&apos;empêche pas la consultation du site. En savoir plus :
			<a href={cookiesPageUrl}>gestion des cookies</a>{' '}et{' '}
			<a href={withBase('/politique-de-confidentialite/')}>politique de confidentialité</a>.
		</p>
		<div class="cookie-consent__actions">
			<button type="button" class="cookie-consent__btn cookie-consent__btn--secondary" id="cookie-consent-reject">Refuser</button>
			<button type="button" class="cookie-consent__btn cookie-consent__btn--primary" id="cookie-consent-accept">Accepter</button>
		</div>

		</>
	)}
	</div>
</div>

<script is:inline define:vars={{ COOKIE_CONSENT_STORAGE_KEY }}>
	(function () {
		var banner = document.getElementById('cookie-consent-banner');
		var btnAccept = document.getElementById('cookie-consent-accept');
		var btnReject = document.getElementById('cookie-consent-reject');
		if (!banner || !btnAccept || !btnReject) return;

		function hide() {
			banner.hidden = true;
			banner.setAttribute('aria-hidden', 'true');
		}

		function show() {
			banner.hidden = false;
			banner.removeAttribute('aria-hidden');
		}

		try {
			if (localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY) === null) {
				show();
			} else {
				hide();
			}
		} catch (e) {
			show();
		}

		btnAccept.addEventListener('click', function () {
			window.dispatchEvent(new CustomEvent('robot-educatif-cookie-accept'));
			hide();
		});
		btnReject.addEventListener('click', function () {
			window.dispatchEvent(new CustomEvent('robot-educatif-cookie-reject'));
			hide();
		});
	})();
</script>

<style>
	/* Bandeau compact : texte à gauche, deux choix de même taille à droite (refonte 2026-11). */
	.cookie-consent {
		position: fixed;
		z-index: 9999;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.6rem;
		pointer-events: none;
	}
	.cookie-consent[hidden] {
		display: none !important;
	}
	.cookie-consent__inner {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0.75rem 1rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas: 'title actions' 'text actions';
		column-gap: 1.25rem;
		align-items: center;
		background: var(--surface, #fff);
		color: rgb(var(--gray-dark, 60 60 65));
		border: 1px solid var(--surface-border, #e5e7eb);
		border-radius: 12px;
		box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.12);
		pointer-events: auto;
	}
	.cookie-consent__title {
		grid-area: title;
		margin: 0 0 0.15rem;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--re-ink, #0b1f2a);
	}
	.cookie-consent__text {
		grid-area: text;
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.45;
	}
	.cookie-consent__text a {
		color: var(--re-teal, #0f766e);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.cookie-consent__actions {
		grid-area: actions;
		display: flex;
		gap: 0.5rem;
	}
	.cookie-consent__btn {
		cursor: pointer;
		min-width: 7.5rem;
		min-height: 42px;
		border-radius: 8px;
		padding: 0.5rem 1rem;
		font-size: 0.95rem;
		font-weight: 700;
		border: 2px solid var(--re-teal, #0f766e);
		background: #fff;
		color: var(--re-teal, #0f766e);
	}
	.cookie-consent__btn--primary {
		background: var(--re-teal, #0f766e);
		color: #fff;
	}
	.cookie-consent__btn--primary:hover {
		background: var(--re-teal-700, #115e59);
		border-color: var(--re-teal-700, #115e59);
	}
	.cookie-consent__btn--secondary:hover {
		background: var(--re-teal-50, #f0fdfa);
	}
	@media (max-width: 640px) {
		.cookie-consent {
			padding: 0.35rem;
		}
		.cookie-consent__inner {
			grid-template-columns: 1fr;
			grid-template-areas: 'title' 'text' 'actions';
			padding: 0.55rem 0.7rem;
		}
		.cookie-consent__title {
			font-size: 0.85rem;
		}
		.cookie-consent__text {
			font-size: 0.78rem;
			line-height: 1.35;
			margin-bottom: 0.45rem;
		}
		.cookie-consent__btn {
			flex: 1;
			min-width: 0;
			min-height: 40px;
			font-size: 0.9rem;
		}
	}
</style>
