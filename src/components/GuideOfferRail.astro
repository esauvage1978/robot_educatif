---
import { withBase } from '../lib/siteUrl';

interface Offer {
	name: string;
	subtitle: string;
	image: string;
	href: string;
	price: string;
	priceLabel: string;
	cta: string;
	trust: string[];
	note: string;
	sponsored: boolean;
	amazonQuery?: string;
	aria: string;
}

interface Props {
	offer: Offer;
}

const { offer } = Astro.props;
const rel = offer.sponsored ? 'sponsored nofollow noopener' : 'noopener';
const image = offer.image.startsWith('/') ? withBase(offer.image) : offer.image;
---

<aside class="guide-offer" aria-label={offer.aria}>
	{offer.image && (
		<img class="guide-offer__photo" src={image} alt={offer.name} width="280" height="210" loading="lazy" decoding="async" />
	)}
	<div class="guide-offer__head">
		<b>{offer.name}</b>
		{offer.subtitle && <span>{offer.subtitle}</span>}
	</div>
	<div class="guide-offer__body">
		<div class="guide-offer__price">
			<span>{offer.priceLabel}</span>
			{offer.price && (offer.amazonQuery ? <b data-amazon-price="1">{offer.price}</b> : <b>{offer.price}</b>)}
		</div>
		<a
			class:list={['guide-offer__buy', offer.sponsored && 'affiliate-link']}
			href={offer.href}
			target="_blank"
			rel={rel}
			data-amazon-query={offer.amazonQuery || undefined}
		>
			{offer.cta}
		</a>
		<ul class="guide-offer__trust">
			{offer.trust.map((line) => <li>{line}</li>)}
		</ul>
		{offer.note && (
			<p class="guide-offer__note" data-amazon-note={offer.amazonQuery ? 'uk' : undefined}>
				{offer.note}
			</p>
		)}
	</div>
</aside>

<style>
	.guide-offer {
		position: sticky;
		top: 5.5rem;
		margin-bottom: 1rem;
		background: #fff;
		border: 1px solid #dde3ec;
		border-radius: 18px;
		box-shadow: 0 2px 8px rgba(10, 15, 28, 0.06), 0 1px 2px rgba(10, 15, 28, 0.04);
		overflow: hidden;
	}
	.guide-offer__photo {
		display: block;
		width: 100%;
		height: 168px;
		object-fit: contain;
		background: #f7f9fc;
		padding: 0.75rem;
		box-sizing: border-box;
	}
	.guide-offer__head,
	.guide-offer__body {
		padding: 0.9rem 1rem 0;
	}
	.guide-offer__body {
		padding-bottom: 1rem;
	}
	.guide-offer__head b {
		display: block;
		color: #0a0f1c;
		font-size: 1rem;
		line-height: 1.3;
	}
	.guide-offer__head span {
		display: block;
		margin-top: 0.2rem;
		color: #5a6883;
		font-size: 0.84rem;
	}
	.guide-offer__price {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}
	.guide-offer__price span {
		color: #5a6883;
		font-size: 0.82rem;
	}
	.guide-offer__price b {
		color: #0a0f1c;
		font-size: 1.35rem;
	}
	.guide-offer__buy {
		display: block;
		text-align: center;
		text-decoration: none;
		font-weight: 700;
		color: #14100a;
		background: linear-gradient(135deg, #ff9900, #f57c00);
		border-radius: 999px;
		padding: 0.7rem 1.1rem;
	}
	.guide-offer__buy:hover {
		filter: brightness(0.97);
	}
	.guide-offer__trust {
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.guide-offer__trust li {
		position: relative;
		margin: 0.35rem 0;
		padding-left: 1.15rem;
		color: #3a4761;
		font-size: 0.84rem;
		line-height: 1.35;
	}
	.guide-offer__trust li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.4rem;
		width: 0.45rem;
		height: 0.28rem;
		border-left: 2px solid #1d4ed8;
		border-bottom: 2px solid #1d4ed8;
		transform: rotate(-45deg);
	}
	.guide-offer__note {
		margin: 0.75rem 0 0;
		color: #5a6883;
		font-size: 0.75rem;
		line-height: 1.4;
	}
	
	
	
	
</style>
