---
import { CAUTION_LABEL } from '../data/repairCompliance.mjs';

interface Props {
	lang: 'fr' | 'en' | 'de' | 'it' | 'es';
	text: string;
}

const { lang, text } = Astro.props;
---

<aside class="repair-caution" role="note">
	<strong>⚠️ {CAUTION_LABEL[lang]}</strong>
	<p>{text}</p>
</aside>

<style>
	.repair-caution {
		margin: 0.75rem 0 0;
		padding: 0.75rem 1rem;
		border: 1px solid #dc2626;
		border-radius: 8px;
		background: #fef2f2;
		font-size: 0.92rem;
	}
	.repair-caution strong {
		color: #991b1b;
	}
	.repair-caution p {
		margin: 0.35rem 0 0;
	}
</style>
