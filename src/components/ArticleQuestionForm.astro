---
import { CONTACT_FORM_WEBHOOK_URL, CONTACT_EMAIL } from '../consts';
interface Props { lang?: 'fr' | 'en' | 'de' | 'it' | 'es'; pageTitle?: string }
const { lang = 'fr', pageTitle = '' } = Astro.props;
const T = {
	fr: { h: "Une question sur cet article ou besoin d'un conseil ? Posez-la ici", p: "Vous hésitez entre deux modèles ou vous avez besoin d'aide sur un montage ? Écrivez-nous, nous vous répondons rapidement par e-mail.", name: 'Nom', email: 'E-mail', msg: 'Votre question', rgpd: "J'accepte d'être recontacté(e) par e-mail au sujet de ma demande.", send: 'Envoyer ma question', sending: 'Envoi en cours…', ok: 'Merci ! Votre question est bien envoyée, nous vous répondons par e-mail.', err: "L'envoi n'a pas abouti. Réessayez dans un instant ou écrivez-nous à ", req: 'Merci de remplir tous les champs et de cocher la case.', objet: "Question depuis l'article : " },
	en: { h: 'Have a question about this guide or need advice? Ask us here', p: 'Torn between two models or stuck on a build? Drop us a line and we will get back to you by email.', name: 'Name', email: 'Email', msg: 'Your question', rgpd: 'I agree to be contacted by email about my request.', send: 'Send my question', sending: 'Sending…', ok: 'Thank you! Your question has been sent, we will reply by email.', err: 'Sending failed. Please try again shortly or email us at ', req: 'Please fill in all fields and tick the box.', objet: 'Question from the article: ' },
	de: { h: 'Haben Sie eine Frage zu diesem Artikel oder brauchen Sie einen Rat? Schreiben Sie uns', p: 'Sie schwanken zwischen zwei Modellen oder brauchen Hilfe beim Aufbau? Schreiben Sie uns, wir antworten schnell per E-Mail.', name: 'Name', email: 'E-Mail', msg: 'Ihre Frage', rgpd: 'Ich bin einverstanden, zu meiner Anfrage per E-Mail kontaktiert zu werden.', send: 'Frage senden', sending: 'Wird gesendet…', ok: 'Danke! Ihre Frage wurde gesendet, wir antworten per E-Mail.', err: 'Senden fehlgeschlagen. Bitte versuchen Sie es gleich noch einmal oder schreiben Sie an ', req: 'Bitte füllen Sie alle Felder aus und setzen Sie das Häkchen.', objet: 'Frage zum Artikel: ' },
	it: { h: 'Hai una domanda su questo articolo o cerchi un consiglio? Scrivici qui', p: 'Sei indeciso tra due modelli o ti serve aiuto con un montaggio? Scrivici, ti rispondiamo rapidamente via e-mail.', name: 'Nome', email: 'E-mail', msg: 'La tua domanda', rgpd: 'Accetto di essere ricontattato via e-mail in merito alla mia richiesta.', send: 'Invia la domanda', sending: 'Invio in corso…', ok: 'Grazie! La tua domanda è stata inviata, ti risponderemo via e-mail.', err: 'Invio non riuscito. Riprova tra poco o scrivici a ', req: 'Compila tutti i campi e spunta la casella.', objet: "Domanda dall'articolo: " },
	es: { h: '¿Tienes alguna pregunta sobre este artículo o necesitas consejo? Escríbenos aquí', p: '¿Dudas entre dos modelos o necesitas ayuda con un montaje? Escríbenos y te responderemos rápido por correo.', name: 'Nombre', email: 'Correo electrónico', msg: 'Tu pregunta', rgpd: 'Acepto que me contacten por correo electrónico sobre mi solicitud.', send: 'Enviar mi pregunta', sending: 'Enviando…', ok: '¡Gracias! Tu pregunta se ha enviado, te responderemos por correo.', err: 'No se pudo enviar. Inténtalo de nuevo en un momento o escríbenos a ', req: 'Rellena todos los campos y marca la casilla.', objet: 'Pregunta desde el artículo: ' },
}[lang];
---
<section class="aqf" aria-labelledby="aqf-t" data-webhook={CONTACT_FORM_WEBHOOK_URL} data-email={CONTACT_EMAIL} data-objet={T.objet} data-title={pageTitle} data-ok={T.ok} data-err={T.err} data-req={T.req} data-sending={T.sending} data-send={T.send}>
	<h2 id="aqf-t">{T.h}</h2>
	<p class="aqf-sub">{T.p}</p>
	<form class="aqf-form" novalidate>
		<div class="aqf-row">
			<label>{T.name}<input name="name" type="text" required autocomplete="name" maxlength="120" /></label>
			<label>{T.email}<input name="email" type="email" required autocomplete="email" maxlength="200" /></label>
		</div>
		<label>{T.msg}<textarea name="message" rows="4" required maxlength="4000"></textarea></label>
		<div class="aqf-hp" aria-hidden="true"><label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
		<label class="aqf-check"><input name="rgpd" type="checkbox" required /> <span>{T.rgpd}</span></label>
		<button type="submit" class="aqf-btn">{T.send}</button>
		<p class="aqf-status" role="status" aria-live="polite"></p>
	</form>
</section>
<script>
	document.querySelectorAll<HTMLElement>('.aqf').forEach((box) => {
		const form = box.querySelector('form') as HTMLFormElement;
		const st = box.querySelector('.aqf-status') as HTMLElement;
		const btn = box.querySelector('.aqf-btn') as HTMLButtonElement;
		const d = box.dataset;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const f = new FormData(form);
			const v = (k: string) => String(f.get(k) || '').trim();
			if (v('website')) { st.className = 'aqf-status is-ok'; st.textContent = d.ok || ''; form.reset(); return; }
			const email = v('email');
			if (!v('name') || !v('message') || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !f.get('rgpd')) { st.className = 'aqf-status is-err'; st.textContent = d.req || ''; return; }
			btn.disabled = true; btn.textContent = d.sending || '';
			const now = new Date().toISOString();
			const body = new URLSearchParams({ name: v('name'), email, message: v('message'), objet: (d.objet || '') + (d.title || document.title), page: location.href, source: 'robot-educatif.info', rgpd: 'true', privacy_policy_accepted: 'true', privacy_policy_accepted_at: now, submitted_at: now, lang: document.documentElement.lang || '' }).toString();
			try {
				await fetch(d.webhook || '', { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
				st.className = 'aqf-status is-ok'; st.textContent = d.ok || ''; form.reset();
			} catch {
				st.className = 'aqf-status is-err'; st.textContent = (d.err || '') + (d.email || '') + '.';
			} finally { btn.disabled = false; btn.textContent = d.send || ''; }
		});
	});
</script>
<style>
	.aqf { margin: 2.5rem 0 1rem; padding: 1.4rem 1.5rem; border-radius: 14px; border: 1px solid rgba(43,125,233,.25); background: linear-gradient(135deg, rgba(43,125,233,.07), rgba(43,125,233,.02)); box-sizing: border-box; max-width: 100%; }
	.aqf h2 { margin: 0 0 .35rem; font-size: 1.25rem; line-height: 1.3; }
	.aqf-sub { margin: 0 0 1rem; opacity: .8; font-size: .95rem; }
	.aqf-form { display: grid; gap: .8rem; }
	.aqf-row { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
	.aqf label { display: flex; flex-direction: column; gap: .3rem; font-size: .9rem; font-weight: 600; min-width: 0; }
	.aqf input[type=text], .aqf input[type=email], .aqf textarea { width: 100%; box-sizing: border-box; padding: .6rem .75rem; border: 1px solid rgba(0,0,0,.2); border-radius: 8px; font: inherit; font-weight: 400; background: #fff; color: #1f2430; }
	.aqf textarea { resize: vertical; min-height: 6rem; }
	.aqf input:focus, .aqf textarea:focus { outline: 2px solid #2b7de9; outline-offset: 1px; }
	.aqf .aqf-check { flex-direction: row; align-items: flex-start; gap: .5rem; font-weight: 400; font-size: .85rem; }
	.aqf-check input { margin-top: .2rem; flex: none; }
	.aqf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
	.aqf-btn { justify-self: start; padding: .65rem 1.3rem; border: 0; border-radius: 8px; background: #2b7de9; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
	.aqf-btn:hover { background: #1f68c9; } .aqf-btn:disabled { opacity: .6; cursor: wait; }
	.aqf-status { margin: 0; font-size: .92rem; } .aqf-status:empty { display: none; }
	.aqf-status.is-ok { padding: .7rem .9rem; border-radius: 8px; background: #e6f6ea; color: #17692e; border: 1px solid #9fd8ad; }
	.aqf-status.is-err { padding: .7rem .9rem; border-radius: 8px; background: #fdecec; color: #a12a20; border: 1px solid #f0b4ae; }
	@media (max-width: 600px) { .aqf { padding: 1rem; } .aqf-row { grid-template-columns: 1fr; } .aqf-btn { justify-self: stretch; } }
</style>
