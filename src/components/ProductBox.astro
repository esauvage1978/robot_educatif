---
import productsData from '../data/products.json';
import { MARKET_CONFIG, amazonDpUrl, marketFromPathname } from '../lib/amazonMarket.mjs';
import { amazonOffer, amazonSnapshot, priceMarket } from '../lib/amazonPriceStore.mjs';
import { withBase } from '../lib/siteUrl';
import Button from './Button.astro';

interface Props {
	id?: string;
	productId?: string;
	name?: string;
	asin?: string;
	image?: string;
	priceRange?: string;
	pros?: string[];
	cons?: string[];
	badge?: string;
	description?: string;
	position?: number;
	showProsCons?: boolean;
	ctaText?: string;
	culturaUrl?: string;
	partnerUrl?: string;
	partnerLabel?: string;
	partnerSponsored?: boolean;
	officialUrl?: string;
	lang?: string;
	ages?: string;
	languages?: string[];
	/** `stack` : carte étroite (grille). `row` : carte pleine largeur. */
	layout?: 'row' | 'stack';
}

const {
	id,
	productId,
	name,
	asin,
	image,
	priceRange: propPriceRange,
	pros: propPros,
	cons: propCons,
	badge: propBadge,
	description: propDescription,
	showProsCons = true,
	ctaText,
	culturaUrl: propCulturaUrl,
	partnerUrl: propPartnerUrl,
	partnerLabel: propPartnerLabel,
	partnerSponsored,
	officialUrl = '',
	lang,
	ages: propAges,
	languages: propLanguages,
	layout = 'row',
} = Astro.props;

const UI = {
	fr: {
		indicative: 'Tarif indicatif',
		unavailable: 'Indisponible sur Amazon',
		seePrice: 'Consulter le prix',
		amazon: 'Voir le prix du jour sur Amazon',
		amazonListing: 'Voir la fiche sur Amazon',
		also: 'Autres boutiques',
		pros: 'Points forts',
		cons: "Points d'attention",
		maker: 'Voir chez le fabricant',
		official: 'Fiche officielle',
		checked: (d: string) => `Relevé le ${d}`,
	},
	en: {
		indicative: 'Indicative price',
		unavailable: 'Unavailable on Amazon',
		seePrice: "See today's price",
		amazon: "See today's price on Amazon",
		amazonListing: 'See the Amazon listing',
		also: 'Other shops',
		pros: 'Strengths',
		cons: 'Watch-outs',
		maker: 'See it at the manufacturer',
		official: 'Official page',
		checked: (d: string) => `Checked on ${d}`,
	},
	de: {
		indicative: 'Richtpreis',
		unavailable: 'Bei Amazon nicht verfügbar',
		seePrice: 'Tagespreis ansehen',
		amazon: 'Tagespreis bei Amazon ansehen',
		amazonListing: 'Amazon-Angebot ansehen',
		also: 'Andere Shops',
		pros: 'Stärken',
		cons: 'Zu beachten',
		maker: 'Beim Hersteller ansehen',
		official: 'Offizielle Seite',
		checked: (d: string) => `Stand ${d}`,
	},
	it: {
		indicative: 'Prezzo indicativo',
		unavailable: 'Non disponibile su Amazon',
		seePrice: 'Vedi il prezzo',
		amazon: 'Vedi il prezzo del giorno su Amazon',
		amazonListing: 'Vedi la scheda Amazon',
		also: 'Altri negozi',
		pros: 'Punti di forza',
		cons: 'Da sapere',
		maker: 'Vedi dal produttore',
		official: 'Scheda ufficiale',
		checked: (d: string) => `Rilevato il ${d}`,
	},
	es: {
		indicative: 'Precio orientativo',
		unavailable: 'No disponible en Amazon',
		seePrice: 'Consultar el precio',
		amazon: 'Ver el precio del día en Amazon',
		amazonListing: 'Ver la ficha en Amazon',
		also: 'Otras tiendas',
		pros: 'Puntos fuertes',
		cons: 'A tener en cuenta',
		maker: 'Ver en el fabricante',
		official: 'Ficha oficial',
		checked: (d: string) => `Consultado el ${d}`,
	},
};

function uiLocale(pathname: string, explicit?: string) {
	if (explicit && explicit in UI) return explicit;
	const p = pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
	if (p.startsWith('/de/')) return 'de';
	if (p.startsWith('/it/')) return 'it';
	if (p.startsWith('/es/')) return 'es';
	if (/^\/(en|uk|ca|us)\//.test(p)) return 'en';
	return 'fr';
}

function shortDate(releve: string, locale: string) {
	const datePart = String(releve || '').split(/\s+/)[0];
	const [d, m, y] = datePart.split('/');
	const day = parseInt(d, 10);
	const month = parseInt(m, 10);
	if (!day || !month || !y) return datePart;
	if (locale === 'en') {
		const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
		return `${day} ${months[month - 1]} ${y}`;
	}
	if (locale === 'de') return `${day}.${month}.${y}`;
	return `${String(day).padStart(2, '0')}/${String(month).padStart(2, '0')}/${y}`;
}

function sponsoredUrl(url: string) {
	return /awin1\.com|awin\.com|[?&](tag|aff|awinaffid)=/i.test(url);
}

const lookupId = id || productId || '';
const catalogMap = (productsData as Record<string, any>) || {};
const fromCatalog = catalogMap[lookupId] || Object.values(catalogMap).find((p: any) => p && p.id === lookupId);

if (!fromCatalog && !name) {
	throw new Error(`Product with id "${lookupId}" not found in products.json`);
}

const product = fromCatalog || {
	id: lookupId,
	name,
	asin: asin || '',
	ages: propAges || '',
	priceRange: '',
	languages: propLanguages || [],
	pros: propPros || [],
	cons: propCons || [],
	culturaUrl: '',
	partnerUrl: '',
	partnerLabel: '',
	image: image || '',
	description: '',
	badge: propBadge || '',
};

const locale = uiLocale(Astro.url.pathname, lang);
const ui = UI[locale as keyof typeof UI] || UI.fr;
const pageMarket = priceMarket(marketFromPathname(Astro.url.pathname)) || 'fr';
const marketCfg = MARKET_CONFIG[pageMarket] || MARKET_CONFIG.fr;
const finalAsin = String(asin || product.asin || '').trim();
const offer = finalAsin ? amazonOffer(pageMarket, finalAsin) : null;
const snap = finalAsin ? amazonSnapshot(pageMarket) : null;
const listing = snap?.items?.[finalAsin.toUpperCase()] || null;
const unavailable = !!(listing && listing.dispo === false);

const amazonUrl = finalAsin
	? amazonDpUrl(finalAsin, pageMarket)
	: product.amazonSearchQuery
		? `https://${marketCfg.host}/s?k=${encodeURIComponent(product.amazonSearchQuery)}&tag=${encodeURIComponent(marketCfg.tag)}`
		: '';

const culturaUrl = marketCfg.showCultura
	? (propCulturaUrl !== undefined ? propCulturaUrl : (fromCatalog?.culturaUrl || ''))
	: '';
const partnerUrl = propPartnerUrl !== undefined ? propPartnerUrl : (product.partnerUrl || '');
const partnerLabel = propPartnerLabel || product.partnerLabel || ui.maker;
const partnerIsSponsored = partnerSponsored ?? sponsoredUrl(partnerUrl);

const placeholderPrice = (value: string) =>
	!value || /vérifier|voir prix|see today|to check|tagespreis|precio del día|prezzo del giorno|consultar el precio|consulter le prix/i.test(value);

const explicitPrice = !placeholderPrice(propPriceRange || '') ? propPriceRange : '';
const catalogPrice = pageMarket === 'fr' && !placeholderPrice(product.priceRange || '') ? product.priceRange : '';

let priceMode: 'amount' | 'unavailable' | 'phrase' = 'phrase';
let priceValue = ui.seePrice;
if (offer) {
	priceMode = 'amount';
	priceValue = offer.label;
} else if (unavailable) {
	priceMode = 'unavailable';
	priceValue = '';
} else if (explicitPrice) {
	priceMode = explicitPrice.length <= 18 && /\d/.test(explicitPrice) ? 'amount' : 'phrase';
	priceValue = explicitPrice;
} else if (catalogPrice) {
	priceMode = 'amount';
	priceValue = catalogPrice;
} else {
	priceValue = ui.seePrice;
}

const checkedOn = (offer || unavailable) && snap?.releveAffichage
	? ui.checked(shortDate(snap.releveAffichage, locale))
	: '';

const imageSrc =
	!unavailable && !product.amazonIndispo && product.imageAmazon
		? product.imageAmazon
		: withBase(image || product.image || product.imageUrl || '/images/products/mbot2.webp');

const prosList: string[] = propPros || product.pros || [];
const consList: string[] = propCons || product.cons || [];
const ageText = propAges !== undefined ? propAges : (product.ages || product.ageRange || '');
const badgeText = propBadge || product.badge || '';
const descText =
	propDescription !== undefined
		? propDescription
		: fromCatalog
			? product.description || product.shortDescription || ''
			: '';
const rawLangs = propLanguages !== undefined ? propLanguages : (product.languages || product.programming || []);
const displayName = name || product.name;
const programmingList: string[] = Array.isArray(rawLangs) ? rawLangs : [];
const metaBits = [ageText, programmingList.join(', ')].filter(Boolean);

const sponsoredRel = 'nofollow sponsored noopener';
const plainRel = 'noopener';

type ShopLink = { href: string; label: string; sponsored: boolean };
const primary: ShopLink | null = amazonUrl
	? { href: amazonUrl, label: unavailable ? ui.amazonListing : (ctaText || ui.amazon), sponsored: true }
	: partnerUrl
		? { href: partnerUrl, label: partnerLabel || ui.maker, sponsored: partnerIsSponsored }
		: officialUrl
			? { href: officialUrl, label: ui.official, sponsored: false }
			: culturaUrl
				? { href: culturaUrl, label: 'Cultura', sponsored: true }
				: null;

const extras: ShopLink[] = [];
if (culturaUrl && primary?.href !== culturaUrl) extras.push({ href: culturaUrl, label: 'Cultura', sponsored: true });
if (partnerUrl && primary?.href !== partnerUrl) extras.push({ href: partnerUrl, label: partnerLabel, sponsored: partnerIsSponsored });
if (officialUrl && primary?.href !== officialUrl) extras.push({ href: officialUrl, label: ui.official, sponsored: false });

---

<article class:list={['product-box', layout === 'stack' && 'is-stack']}>
	<div class="product-stage">
		{primary ? (
			<a href={primary.href} target="_blank" rel={primary.sponsored ? sponsoredRel : plainRel} aria-label={primary.label}>
				<img src={imageSrc} alt={displayName} width="176" height="176" loading="lazy" decoding="async" />
			</a>
		) : (
			<img src={imageSrc} alt={displayName} width="176" height="176" loading="lazy" decoding="async" />
		)}
	</div>
	<div class="product-body">
		<div class="product-top">
			<div class="product-copy">
				{badgeText && <p class="product-badge">{badgeText}</p>}
				<h3 class="product-title">
					{primary ? (
						<a href={primary.href} target="_blank" rel={primary.sponsored ? sponsoredRel : plainRel} class="product-title-link">{displayName}</a>
					) : (
						displayName
					)}
				</h3>
				{descText && <p class="product-desc">{descText}</p>}
				{metaBits.length > 0 && <p class="product-meta">{metaBits.join(' · ')}</p>}
			</div>
			<div class="product-price" data-mode={priceMode}>
				{priceMode === 'amount' && <span class="product-price-kicker">{ui.indicative}</span>}
				{priceMode === 'unavailable' && <span class="product-price-kicker">{ui.unavailable}</span>}
				{priceValue && <strong class:list={['product-price-value', priceMode === 'phrase' && 'is-phrase']}>{priceValue}</strong>}
				{checkedOn && <span class="product-price-date">{checkedOn}</span>}
			</div>
		</div>

		{showProsCons && prosList.length > 0 && (
			<ul class="pros" aria-label={ui.pros}>
				{prosList.map((pro) => <li>{pro}</li>)}
			</ul>
		)}

		{showProsCons && consList.length > 0 && (
			<div class="cons">
				<h4>{ui.cons}</h4>
				<ul>
					{consList.map((con) => <li>{con}</li>)}
				</ul>
			</div>
		)}

		<div class="product-foot">
			{primary && (
				<div class="product-cta-group">
					{primary.href === amazonUrl ? (
						<Button href={amazonUrl} variant="amazon" target="_blank" rel={sponsoredRel}>
							{primary.label} →
						</Button>
					) : (
						<a class="product-primary" href={primary.href} target="_blank" rel={primary.sponsored ? sponsoredRel : plainRel}>
							{primary.label} →
						</a>
					)}
				</div>
			)}

			{extras.length > 0 && (
				<p class="product-also">
					{extras.some((shop) => shop.href !== officialUrl) && <span>{ui.also}</span>}
					{extras.map((shop, index) => (
						<>
							{index > 0 && <span class="product-also-dot" aria-hidden="true">·</span>}
							<a class="product-alt-link" href={shop.href} target="_blank" rel={shop.sponsored ? sponsoredRel : plainRel}>{shop.label}</a>
						</>
					))}
				</p>
			)}
		</div>
	</div>
</article>

<style>
	.product-box {
		display: flex;
		gap: 1.15rem;
		align-items: center;
		margin: 1.35rem 0 1.6rem;
		padding: 1rem;
		background: #fff;
		border: 1px solid #e5edf3;
		border-left: 4px solid #0f766e;
		border-radius: 18px;
		box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
	}
	.product-stage {
		flex: 0 0 176px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #f4f7fb;
		border-radius: 14px;
		padding: 0.85rem;
	}
	.product-stage a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	.product-stage img {
		width: 100%;
		height: 148px;
		object-fit: contain;
	}
	.product-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.product-top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: flex-start;
	}
	.product-copy {
		min-width: 0;
	}
	.product-badge {
		display: inline-flex;
		margin: 0 0 0.35rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: #e6f6f4;
		color: #0f766e;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.product-title {
		margin: 0;
		font-size: 1.35rem;
		line-height: 1.25;
		font-weight: 800;
		color: #0f172a;
	}
	.product-title-link {
		color: inherit;
		text-decoration: none;
	}
	.product-title-link:hover {
		color: #0f766e;
	}
	.product-desc {
		margin: 0.35rem 0 0;
		color: #475569;
		font-size: 0.98rem;
		line-height: 1.45;
	}
	.product-meta {
		margin: 0.35rem 0 0;
		color: #64748b;
		font-size: 0.82rem;
	}
	.product-price {
		flex: 0 0 auto;
		text-align: right;
		min-width: 7.5rem;
	}
	.product-price-kicker,
	.product-price-date {
		display: block;
		color: #64748b;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.product-price-value {
		display: block;
		margin: 0.1rem 0;
		color: #0f172a;
		font-size: 1.55rem;
		line-height: 1.1;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.product-price-value.is-phrase {
		font-size: 1rem;
		line-height: 1.3;
		font-weight: 700;
		letter-spacing: 0;
		max-width: 11rem;
	}
	.pros {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.pros li {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		margin: 0;
		color: #1e293b;
		font-size: 0.92rem;
		line-height: 1.35;
	}
	.pros li::before {
		content: "";
		flex: 0 0 0.45rem;
		width: 0.45rem;
		height: 0.45rem;
		margin-top: 0.4rem;
		border-radius: 99px;
		background: #0f766e;
	}
	.cons {
		margin-top: 0.8rem;
		padding-left: 0.75rem;
		border-left: 3px solid #fdba74;
	}
	.cons h4 {
		margin: 0 0 0.3rem;
		color: #9a3412;
		font-size: 0.82rem;
	}
	.cons ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	.cons li {
		margin: 0.15rem 0;
		font-size: 0.88rem;
	}
	.product-foot {
		margin-top: 0.95rem;
	}
	.product-cta-group {
		margin-top: 0;
	}
	.product-box.is-stack {
		flex-direction: column;
		align-items: stretch;
		margin: 0;
	}
	.product-box.is-stack .product-stage {
		flex: none;
		width: 100%;
	}
	.product-box.is-stack .product-stage img {
		height: 168px;
	}
	.product-box.is-stack .product-body {
		flex: 1;
	}
	.product-box.is-stack .product-top {
		flex-direction: column;
	}
	.product-box.is-stack .product-price,
	.product-box.is-stack .product-price-value.is-phrase {
		text-align: left;
		max-width: none;
	}
	.product-box.is-stack .product-foot {
		margin-top: auto;
		padding-top: 0.95rem;
	}
	.product-box.is-stack .pros {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
	}
	.product-box.is-stack .product-cta-group :global(.ui-btn),
	.product-box.is-stack .product-primary {
		width: 100%;
	}
	.product-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.7rem;
		padding: 0.65rem 1.15rem;
		border-radius: 8px;
		background: #0f766e;
		color: #fff !important;
		font-weight: 700;
		text-decoration: none !important;
	}
	.product-primary:hover {
		background: #115e59;
		color: #fff !important;
		text-decoration: none !important;
	}
	.product-also {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.45rem;
		margin: 0.55rem 0 0;
		color: #64748b;
		font-size: 0.84rem;
	}
	.product-also-dot {
		color: #94a3b8;
	}

	@media (max-width: 640px) {
		.product-box {
			flex-direction: column;
			align-items: stretch;
			gap: 0.9rem;
		}
		.product-stage {
			flex-basis: auto;
			width: auto;
			align-self: center;
			min-height: 0;
			max-width: 100%;
		}
		.product-stage img {
			width: auto;
			max-width: 100%;
			height: auto;
			max-height: 180px;
		}
		.product-top {
			flex-direction: column;
		}
		.product-price,
		.product-price-value.is-phrase {
			text-align: left;
			max-width: none;
		}
		.product-cta-group :global(.ui-btn),
		.product-primary {
			width: 100%;
		}
	}
</style>
