---
/**
 * Navigation du parcours « Débuter en domotique ».
 * Bottom : préférable avant ## FAQ dans le MDX (voir commentaire ci-dessous).
 * Si injecté après tout le contenu (layouts i18n), la FAQ reste au-dessus du bloc bottom.
 */
import { withBase } from '../lib/siteUrl';
import { getParcoursNav } from '../data/debuterDomotique/parcours.mjs';

interface Props {
	lang: 'fr' | 'en' | 'de' | 'it' | 'es';
	frSlug: string;
	position: 'top' | 'bottom';
}

const { lang, frSlug, position } = Astro.props;
const nav = getParcoursNav(lang, frSlug);
if (!nav) return;

const { labels, stepIndex, total, isHub, prev, next } = nav;
---

{position === 'top' && (
	<p class="parcours-step">
		{isHub ? labels.hubIntro(total) : labels.stepOf(stepIndex, total)}
	</p>
)}

{position === 'bottom' && (prev || next) && (
	<nav class="parcours-nav" aria-label={labels.navAria}>
		<div class="parcours-nav__inner">
			{prev ? (
				<a
					class="parcours-nav__btn parcours-nav__btn--prev"
					href={withBase(prev.href)}
					rel={prev.rel}
				>
					<span class="parcours-nav__dir">{prev.dirLabel}</span>
					<span class="parcours-nav__title">
						{prev.isHub ? labels.backToParcours : prev.shortTitle}
					</span>
				</a>
			) : (
				<span class="parcours-nav__spacer" aria-hidden="true" />
			)}
			{next ? (
				<a
					class="parcours-nav__btn parcours-nav__btn--next"
					href={withBase(next.href)}
					rel={next.rel}
				>
					<span class="parcours-nav__dir">{next.dirLabel}</span>
					<span class="parcours-nav__title">
						{next.isHub ? labels.backToParcours : next.shortTitle}
					</span>
				</a>
			) : (
				<span class="parcours-nav__spacer" aria-hidden="true" />
			)}
		</div>
	</nav>
)}

<style>
	.parcours-step {
		margin: 0.35rem 0 0.75rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: rgb(var(--gray-dark, 71 85 105));
		letter-spacing: 0.02em;
	}

	.parcours-nav {
		margin: 2rem 0 1.5rem;
		padding: 0;
	}

	.parcours-nav__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		align-items: stretch;
	}

	.parcours-nav__btn {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		border: 1px solid var(--surface-border, #cbd5e1);
		background: var(--surface, #f8fafc);
		color: rgb(var(--black, 15 23 42));
		text-decoration: none;
		font-weight: 600;
		line-height: 1.35;
		min-height: 3.25rem;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			box-shadow 0.15s ease;
	}

	.parcours-nav__btn:hover {
		border-color: var(--accent, #0f766e);
		background: color-mix(in oklab, var(--accent, #0f766e) 8%, var(--surface, #f8fafc));
	}

	.parcours-nav__btn:focus-visible {
		outline: 2px solid var(--accent, #0f766e);
		outline-offset: 2px;
	}

	.parcours-nav__btn--next {
		text-align: right;
	}

	.parcours-nav__dir {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent, #0f766e);
	}

	.parcours-nav__title {
		font-size: 0.95rem;
		font-weight: 600;
	}

	.parcours-nav__spacer {
		display: block;
	}

	@media (max-width: 640px) {
		.parcours-nav__inner {
			grid-template-columns: 1fr;
		}

		.parcours-nav__btn--next {
			text-align: left;
		}
	}
</style>
