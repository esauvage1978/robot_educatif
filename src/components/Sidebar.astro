---
import { getCollection } from 'astro:content';
import { getSidebarGuideNav } from '../lib/sidebarGuideNav.mjs';
import { resolveRelatedThumbs } from '../lib/sidebarRelatedThumb';
import { withBase } from '../lib/siteUrl';

interface RelatedLink {
	title: string;
	href: string;
}

interface Props {
	/** guide = colonne guides d’achat ; hub = liste blog */
	variant?: 'guide' | 'hub';
	relatedLinks?: RelatedLink[] | undefined;
}

const { variant = 'guide', relatedLinks = undefined } = Astro.props;
const pathname = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const nav = getSidebarGuideNav(pathname);
const allPosts = await getCollection('blog');
const domotiquePosts = await getCollection('domotique');
const readAlso = variant === 'guide' ? resolveRelatedThumbs(relatedLinks, pathname, allPosts, domotiquePosts) : [];
---

<aside class="guide-sidebar" data-guide-sidebar>
	{
		variant === 'guide' && (
			<section class="guide-sidebar__box guide-sidebar__box--quick" aria-labelledby="guide-sidebar-quick-title">
				<button
					type="button"
					class="guide-sidebar__toc-toggle"
					data-guide-toc-toggle
					aria-expanded="true"
					aria-controls="guide-sidebar-toc-panel"
				>
					<span class="guide-sidebar__title" id="guide-sidebar-quick-title">
						{nav.quickNavTitle}
					</span>
					<span class="guide-sidebar__toc-chevron" aria-hidden="true">▾</span>
				</button>
				<nav
					id="guide-sidebar-toc-panel"
					class="guide-sidebar__toc"
					data-guide-toc
					aria-label={nav.quickNavTitle}
				>
					<p class="guide-sidebar__toc-empty" data-guide-toc-empty hidden>
						—
					</p>
					<ul class="guide-sidebar__toc-list" data-guide-toc-list></ul>
				</nav>
			</section>
		)
	}
	{
		readAlso.length > 0 && (
			<section class="guide-sidebar__box" aria-labelledby="guide-sidebar-read-title">
				<h2 id="guide-sidebar-read-title" class="guide-sidebar__title guide-sidebar__title--plain">
					{nav.readAlsoTitle}
				</h2>
				<div class="guide-sidebar__read-also">
					{readAlso.map((item) => (
						<a href={withBase(item.href)}>
							<img
								src={withBase(item.imgSrc)}
								alt={item.imgAlt}
								width="112"
								height="84"
								loading="lazy"
								decoding="async"
							/>
							<span>{item.title}</span>
						</a>
					))}
				</div>
			</section>
		)
	}
</aside>

<style>
	.guide-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.125rem;
		min-width: 0;
	}
	.guide-sidebar__box {
		background: var(--surface-2, #fff);
		border: 1px solid var(--surface-border, #e2e8f0);
		border-radius: 14px;
		padding: 1.125rem 1.1rem;
	}
	.guide-sidebar__box--quick {
		border-top: 4px solid #0f766e;
	}
	.guide-sidebar__toc-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		gap: 0.5rem;
		padding: 0;
		margin: 0 0 0.75rem;
		border: none;
		background: transparent;
		cursor: pointer;
		text-align: left;
	}
	.guide-sidebar__toc-chevron {
		font-size: 0.85rem;
		color: #0f766e;
		transition: transform 0.15s ease;
		flex-shrink: 0;
	}
	.guide-sidebar__toc-toggle[aria-expanded='false'] + .guide-sidebar__toc {
		display: none;
	}
	.guide-sidebar__toc-toggle[aria-expanded='false'] .guide-sidebar__toc-chevron {
		transform: rotate(-90deg);
	}
	.guide-sidebar__title {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.3;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: #0f766e;
		font-weight: 700;
	}
	.guide-sidebar__title--plain {
		color: rgb(var(--black, 11 31 42));
	}
	.guide-sidebar__toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-height: min(42vh, 20rem);
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-gutter: stable;
	}
	.guide-sidebar__toc-list li {
		margin: 0;
		min-width: 0;
	}
	.guide-sidebar__toc-list a {
		display: block;
		font-size: 0.875rem;
		padding: 0.38rem 0.55rem;
		margin: 0.1rem 0;
		border-radius: 8px;
		color: var(--prose-link, #0f766e);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-decoration-color: var(--prose-link-line, #5eead4);
		text-underline-offset: 3px;
		font-weight: 600;
		line-height: 1.35;
		border-left: 3px solid transparent;
		overflow-wrap: anywhere;
		word-break: normal;
		hyphens: auto;
	}
	.guide-sidebar__toc-list a:hover {
		background: #f0fdfa;
		color: var(--prose-link-hover, #115e59);
		text-decoration-color: var(--prose-link, #0f766e);
	}
	.guide-sidebar__toc-list a.is-active,
	.guide-sidebar__toc-list a[aria-current='true'] {
		background: #f0fdfa;
		color: var(--prose-link-hover, #115e59);
		text-decoration-color: var(--prose-link, #0f766e);
		border-left-color: var(--prose-link, #0f766e);
	}
	
	@media (max-width: 1023px) {
		.guide-sidebar__toc-toggle {
			margin-bottom: 0.35rem;
		}
	}
	@media (min-width: 1024px) {
		.guide-sidebar__toc-toggle {
			cursor: default;
			pointer-events: none;
		}
		.guide-sidebar__toc-chevron {
			display: none;
		}
	}
	@media (min-width: 1024px) {
		:global(.re-toc-mobile) {
			display: none !important;
		}
	}
	.guide-sidebar__toc-empty {
		margin: 0;
		font-size: 0.85rem;
		color: #64748b;
	}
	.guide-sidebar__read-also a {
		display: flex;
		gap: 0.65rem;
		align-items: center;
		padding: 0.5rem 0;
		text-decoration: none;
		color: rgb(var(--black, 11 31 42));
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.guide-sidebar__read-also a + a {
		border-top: 1px dashed var(--surface-border, #e2e8f0);
	}
	.guide-sidebar__read-also img {
		width: 56px;
		height: 42px;
		border-radius: 8px;
		object-fit: cover;
		flex: none;
		background: #e2e8f0;
	}
	@media (min-width: 1024px) {
		:global(.page-layout--with-sidebar) > .guide-rail,
		:global(.page-layout--with-sidebar) > .guide-sidebar,
		:global(.page-layout--with-sidebar) > [data-guide-sidebar] {
			position: sticky;
			top: 5.25rem;
			align-self: start;
			max-height: calc(100vh - 6.5rem);
			overflow: auto;
		}
	}
</style>

<script>
	(() => {
		const SKIP =
			/^(aqf-t|navigation-rapide|quick-navigation|schnelle-navigation|navigazione-rapida|navegación-rápida|pr-title|pr-widget|faq|questions-fréquentes|häufige-fragen|domande-frequenti|preguntas-frecuentes)$/i;
		const FAQ_SECTION = /faq|questions|fréquent|häufig|frequenti|preguntas/i;
		const root = document.querySelector<HTMLElement>('[data-guide-toc]');
		if (!root) return;
		const list = root.querySelector<HTMLUListElement>('[data-guide-toc-list]');
		const empty = root.querySelector<HTMLElement>('[data-guide-toc-empty]');
		if (!list) return;

		const toggle = document.querySelector<HTMLButtonElement>('[data-guide-toc-toggle]');
		if (toggle) {
			const mq = window.matchMedia('(max-width: 1023px)');
			toggle.addEventListener('click', () => {
				if (!mq.matches) return;
				const open = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
			});
		}

		const article =
			document.querySelector<HTMLElement>('.page-layout--with-sidebar article .prose') ||
			document.querySelector<HTMLElement>('article .prose') ||
			document.querySelector<HTMLElement>('article');
		if (!article) return;

		const inlineTocTitle =
			/^(sommaire|contents|inhalt|inhaltsverzeichnis|indice|índice|sommario)$/i;
		article.querySelectorAll('.article-toc').forEach((node) => node.remove());
		for (const heading of Array.from(article.querySelectorAll<HTMLElement>('h2'))) {
			const label = (heading.textContent || '').replace(/\s+/g, ' ').trim();
			if (!inlineTocTitle.test(label)) continue;
			const next = heading.nextElementSibling;
			if (next && (next.tagName === 'UL' || next.tagName === 'OL')) next.remove();
			heading.remove();
		}

		const cleanLabel = (text: string) =>
			text
				.replace(/\s+/g, ' ')
				.replace(/^(\d+[\.\)\]]\s*)/, '')
				.replace(/^(\d+\s*[-–—]\s*)/, '')
				.trim();

		const slugify = (value: string) =>
			value
				.normalize('NFD')
				.replace(/[\u0300-\u036f]/g, '')
				.toLowerCase()
				.replace(/[^a-z0-9]+/g, '-')
				.replace(/^-+|-+$/g, '')
				.slice(0, 80);

		const usedIds = new Set(
			Array.from(document.querySelectorAll<HTMLElement>('[id]')).map((el) => el.id),
		);
		for (const h of Array.from(article.querySelectorAll<HTMLElement>('h2'))) {
			if (h.closest('.guide-sidebar') || h.id) continue;
			const base = slugify(h.textContent || '') || 'section';
			let id = base;
			let n = 2;
			while (usedIds.has(id)) id = `${base}-${n++}`;
			h.id = id;
			usedIds.add(id);
		}

		const headings = Array.from(article.querySelectorAll<HTMLElement>('h2[id]')).filter((h) => {
			const id = h.id || '';
			if (!id || SKIP.test(id)) return false;
			if (h.closest('.guide-sidebar')) return false;
			if (FAQ_SECTION.test(h.textContent || '')) return false;
			return true;
		});

		const seen = new Set<string>();
		const unique = headings.filter((h) => {
			if (seen.has(h.id)) return false;
			seen.add(h.id);
			return true;
		});

		if (!unique.length) {
			if (empty) empty.hidden = false;
			return;
		}
		if (empty) empty.hidden = true;

		type LinkPair = { a: HTMLAnchorElement; h: HTMLElement; mobileA?: HTMLAnchorElement };
		const links: LinkPair[] = [];
		for (const h of unique) {
			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `#${h.id}`;
			a.textContent = cleanLabel(h.textContent || '');
			a.title = a.textContent;
			li.appendChild(a);
			list.appendChild(li);
			links.push({ a, h });
		}

		const lang = document.documentElement.lang || 'fr';
		const mobileTitle =
			lang === 'de'
				? 'Inhalt'
				: lang === 'it'
					? 'Indice'
					: lang === 'es'
						? 'Índice'
						: lang.startsWith('en')
							? 'Contents'
							: 'Sommaire';

		let mobile = article.querySelector<HTMLDetailsElement>('.re-toc-mobile');
		if (!mobile) {
			mobile = document.createElement('details');
			mobile.className = 're-toc-mobile';
			const sum = document.createElement('summary');
			sum.textContent = mobileTitle;
			mobile.appendChild(sum);
			const nav = document.createElement('nav');
			nav.setAttribute('aria-label', mobileTitle);
			const mul = document.createElement('ul');
			mul.className = 'guide-sidebar__toc-list';
			nav.appendChild(mul);
			mobile.appendChild(nav);
			article.insertBefore(mobile, article.firstChild);
		}
		const mul = mobile.querySelector<HTMLUListElement>('.guide-sidebar__toc-list');
		if (mul) {
			mul.innerHTML = '';
			for (const item of links) {
				const li = document.createElement('li');
				const ma = document.createElement('a');
				ma.href = item.a.href;
				ma.textContent = item.a.textContent;
				ma.title = item.a.title;
				li.appendChild(ma);
				mul.appendChild(li);
				item.mobileA = ma;
			}
		}

		const setActive = (id: string | null) => {
			for (const item of links) {
				const on = id !== null && item.h.id === id;
				item.a.classList.toggle('is-active', on);
				if (on) item.a.setAttribute('aria-current', 'true');
				else item.a.removeAttribute('aria-current');
				item.mobileA?.classList.toggle('is-active', on);
				if (on) item.mobileA?.setAttribute('aria-current', 'true');
				else item.mobileA?.removeAttribute('aria-current');
			}
		};

		if (typeof IntersectionObserver !== 'undefined') {
			const obs = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((e) => e.isIntersecting)
						.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
					if (visible.length) setActive(visible[0].target.id);
				},
				{ rootMargin: '-30% 0px -55% 0px', threshold: 0 },
			);
			for (const h of unique) obs.observe(h);
		} else {
			window.addEventListener('scroll', () => {
				const y = window.scrollY + 120;
				let current: string | null = unique[0]?.id ?? null;
				for (const h of unique) {
					if (h.offsetTop <= y) current = h.id;
				}
				setActive(current);
			}, { passive: true });
		}
	})();
</script>
