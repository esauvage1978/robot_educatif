---
import { amazonSearchUrl } from '../lib/amazon';
import type { AmazonSidebarPreset } from '../lib/amazonSidebarPresets';
import { categoryToSlug, type TopCategory } from '../lib/categories';
import { resolveAmazonSidebarLinks } from '../lib/resolveAmazonSidebar';

interface RelatedLink {
	title: string;
	href: string;
}

interface Props {
	/** Slug fichier article (sans extension) ; vide sur la liste blog → suggestions générales */
	articleSlug?: string;
	affiliatePreset?: AmazonSidebarPreset | null;
	relatedLinks?: RelatedLink[] | undefined;
	/** Quatre catégories (liens vers /categorie/…) — colonne 1/3 */
	categories?: string[];
	/** Top catégories par nombre d’articles (accueil, blog, etc.) */
	topCategories?: TopCategory[];
}

const {
	articleSlug = '',
	affiliatePreset = null,
	relatedLinks = undefined,
	categories = [],
	topCategories = undefined,
} = Astro.props;
const affiliateLinks = resolveAmazonSidebarLinks(articleSlug, affiliatePreset);
const internalLinks = relatedLinks?.length ? relatedLinks : null;
---

<aside class="sidebar">
	<section class="widget widget-affiliate" aria-labelledby="sidebar-affiliate-title">
		<h3 id="sidebar-affiliate-title">Propositions d’achat Amazon</h3>
		<p class="affiliate-note">
			Idées de produits en lien avec cet article. Liens affiliés : en tant que partenaire Amazon, ce site peut
			percevoir une commission sur des achats éligibles, sans surcoût pour vous.
		</p>
		<ul class="affiliate-list">
			{affiliateLinks.map((item) => (
				<li>
					<a href={amazonSearchUrl(item.query)} target="_blank" rel="noopener noreferrer sponsored">
						{item.label}
						<span aria-hidden="true" class="external-hint"> ↗</span>
					</a>
				</li>
			))}
		</ul>
	</section>
	{
		internalLinks && (
			<section class="widget widget-related" aria-labelledby="sidebar-related-title">
				<h3 id="sidebar-related-title">À lire aussi</h3>
				<p class="related-hint">Articles du site en lien avec ce sujet.</p>
				<ul class="related-list">
					{internalLinks.map((item) => (
						<li>
							<a href={item.href}>{item.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		categories.length > 0 && (
			<section class="widget widget-categories" aria-labelledby="sidebar-categories-title">
				<h3 id="sidebar-categories-title">Catégories</h3>
				<p class="related-hint">Cliquez pour voir tous les articles du même thème.</p>
				<ul class="related-list category-chips">
					{categories.map((cat) => (
						<li>
							<a href={`/categorie/${categoryToSlug(cat)}/`}>{cat}</a>
						</li>
					))}
				</ul>
				<p class="cat-all">
					<a href="/categorie/">Toutes les catégories</a>
				</p>
			</section>
		)
	}
	{
		topCategories && topCategories.length > 0 && (
			<section class="widget widget-top-categories" aria-labelledby="sidebar-top-cats-title">
				<h3 id="sidebar-top-cats-title">Catégories les plus représentées</h3>
				<p class="related-hint">Les 15 thèmes avec le plus d’articles.</p>
				<ul class="related-list top-cat-list">
					{topCategories.map((c) => (
						<li>
							<a href={`/categorie/${c.slug}/`}>
								<span class="top-cat-label">{c.label}</span>
								<span class="top-cat-count">{c.count}</span>
							</a>
						</li>
					))}
				</ul>
				<p class="cat-all">
					<a href="/categorie/">Toutes les catégories</a>
				</p>
			</section>
		)
	}
	<section class="widget">
		<h3>Explorer le blog</h3>
		<ul>
			<li><a href="/blog/">Tous les articles</a></li>
			<li><a href="/categorie/">Par catégorie</a></li>
			<li><a href="/programmation/">Programmation</a></li>
		</ul>
	</section>
</aside>

<style>
	.sidebar {
		display: grid;
		gap: 1rem;
	}
	.widget {
		background: var(--surface-2);
		border: 1px solid var(--surface-border);
		border-radius: 8px;
		padding: 1.15rem 1.1rem;
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset;
	}
	.widget-affiliate {
		border-color: color-mix(in oklab, var(--accent) 22%, var(--surface-border));
	}
	.widget-related {
		border-color: color-mix(in oklab, var(--accent-warm) 18%, var(--surface-border));
	}
	.widget-categories {
		border-color: color-mix(in oklab, var(--accent) 15%, var(--surface-border));
	}
	.widget-top-categories {
		border-color: color-mix(in oklab, var(--accent-warm) 12%, var(--surface-border));
	}
	.top-cat-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.65rem;
		width: 100%;
		box-sizing: border-box;
	}
	.top-cat-label {
		min-width: 0;
		flex: 1;
	}
	.top-cat-count {
		flex-shrink: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
		text-decoration: none !important;
	}
	.category-chips a {
		font-weight: 600;
	}
	.cat-all {
		margin: 0.75rem 0 0 0;
		font-size: 0.88rem;
	}
	.cat-all a {
		color: rgb(var(--gray));
		font-weight: 600;
	}
	.related-hint {
		margin: 0 0 0.75rem 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: rgb(var(--gray));
		font-family: var(--font-body, system-ui);
	}
	.related-list {
		gap: 0.5rem;
	}
	.widget h3 {
		margin: 0 0 0.85rem 0;
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-weight: 600;
		font-family: var(--font-body, system-ui);
		color: rgb(var(--gray));
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--surface-border);
	}
	.affiliate-note {
		margin: 0 0 0.85rem 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: rgb(var(--gray));
		font-family: var(--font-body, system-ui);
	}
	.widget ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	.sidebar-heading {
		margin: 0.6rem 0 0.1rem 0;
		padding: 0.35rem 0 0 0;
		border-top: 1px solid var(--surface-border);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		font-weight: 600;
		list-style: none;
	}
	.affiliate-list {
		gap: 0.55rem;
	}
	.widget a {
		text-decoration: none;
		color: var(--accent);
		font-weight: 600;
		font-size: 0.96rem;
		display: inline-block;
		padding: 0.2rem 0;
		border: none;
		background: none;
		border-radius: 0;
		transition: color 0.12s ease;
	}
	.widget a:hover {
		color: var(--accent-dark);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.external-hint {
		font-weight: 500;
		opacity: 0.75;
		text-decoration: none !important;
	}
</style>
