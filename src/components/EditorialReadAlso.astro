---
import { withBase } from '../lib/siteUrl';
import { READ_ALSO_HEADING, detectContentLang, MAILLAGE_EXCLUDE_PATHS } from '../lib/maillageLocales.mjs';
import { isInvalidAnchorTitle, humanizeUrlPath, normalizeMaillageHref } from '../lib/maillagePageTitles.mjs';
import planData from '../data/maillage-plan.json';

type Props = {
	pathname?: string;
};

const { pathname = Astro.url.pathname } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
let path = pathname;
if (base !== '/' && path.startsWith(base)) path = path.slice(base.length - 1) || '/';
path = path.endsWith('/') ? path : `${path}/`;

if (MAILLAGE_EXCLUDE_PATHS.has(path)) {
	return null;
}

const rawLinks = (planData.outbound?.[path] ?? []) as { href: string; title: string }[];
const links = rawLinks
	.filter((link) => link.href?.startsWith('/'))
	.map((link) => {
		const href = normalizeMaillageHref(link.href);
		let title = link.title;
		if (isInvalidAnchorTitle(title)) title = humanizeUrlPath(href);
		return { href, title };
	});
if (!links.length) {
	return null;
}

const lang = detectContentLang(path);
const heading = READ_ALSO_HEADING[lang] ?? READ_ALSO_HEADING.en;
---

<section class="editorial-read-also" aria-labelledby="editorial-read-also-title">
	<h2 id="editorial-read-also-title">{heading}</h2>
	<ul>
		{links.map((link) => (
			<li>
				<a href={withBase(link.href)}>{link.title}</a>
			</li>
		))}
	</ul>
</section>

<style>
	.editorial-read-also {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--surface-border, rgba(15, 23, 42, 0.12));
	}
	.editorial-read-also h2 {
		font-size: 1.15rem;
		margin: 0 0 0.75rem;
	}
	.editorial-read-also ul {
		margin: 0;
		padding-left: 1.25rem;
	}
	.editorial-read-also li {
		margin: 0.35rem 0;
	}
</style>