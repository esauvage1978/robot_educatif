---
import { PINTEREST_ENABLED } from '../consts';

interface Props {
	/** URL de la page à partager */
	url: string;
	/** Description pour Pinterest */
	description: string;
	/** Image à épingler (URL absolue) */
	media?: string;
	/** Variante : 'button' pour bouton fixe, 'hover' pour bouton sur image */
	variant?: 'button' | 'hover';
	/** Classes CSS supplémentaires */
	class?: string;
}

const { url, description, media = '', variant = 'button', class: className = '' } = Astro.props;

if (!PINTEREST_ENABLED) return null;

const pinterestUrl = new URL('https://www.pinterest.com/pin/create/button/');
pinterestUrl.searchParams.set('url', url);
pinterestUrl.searchParams.set('description', description);
if (media) {
	pinterestUrl.searchParams.set('media', media);
}
---

<a
	href={pinterestUrl.toString()}
	class:list={['pinterest-share', `pinterest-share--${variant}`, className]}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Épingler sur Pinterest"
	data-pin-do="skip"
>
	<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z" fill="currentColor"/>
	</svg>
	<span>Enregistrer</span>
</a>

<style>
	.pinterest-share {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		font-size: 0.9rem;
		font-weight: 600;
		font-family: var(--font-body, system-ui);
		text-decoration: none;
		color: #fff;
		background: #E60023;
		border: none;
		border-radius: 24px;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.1s ease;
		white-space: nowrap;
	}
	
	.pinterest-share:hover {
		background: #AD081B;
		transform: translateY(-1px);
	}
	
	.pinterest-share:active {
		transform: translateY(0);
	}
	
	.pinterest-share svg {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}
	
	.pinterest-share--button {
		/* Style par défaut pour les boutons fixes */
	}
	
	.pinterest-share--hover {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
		z-index: 10;
	}
	
	@media (max-width: 720px) {
		.pinterest-share {
			padding: 0.4rem 0.85rem;
			font-size: 0.85rem;
		}
		
		.pinterest-share svg {
			width: 16px;
			height: 16px;
		}
		
		.pinterest-share--hover {
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
