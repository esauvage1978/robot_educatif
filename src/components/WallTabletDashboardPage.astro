<script>
	function wtSituation(eco) {
		if (eco === 'maker-esp32') return 'b';
		if (eco === 'wifi-sans-box') return 'c';
		return 'a';
	}

	function wtSummary(eco, tech, qty) {
		const q =
			qty === '2'
				? 'deux tablettes'
				: qty === '3-5'
					? 'le palier 3 à 5 tablettes'
					: qty === '6+'
						? 'le palier 6 tablettes ou plus'
						: 'une tablette';
		if (eco === 'wifi-sans-box') {
			const radar =
				tech === 'reveil-mmwave'
					? ' Un radar de réveil est ajouté. Il ne sert pas à afficher le dashboard.'
					: ' Aucun capteur de présence n’est ajouté.';
			return (
				'Situation C, profil Économique. La tablette et Home Assistant sont supposés déjà possédés. Achats : support et câble, pour ' +
				q +
				'.' +
				radar +
				' Le serveur n’est pas dans la liste.'
			);
		}
		if (eco === 'maker-esp32') {
			const tablet =
				tech === 'tablette-recyclee'
					? 'La tablette n’est pas rachetée.'
					: 'Une tablette d’affichage est ajoutée, distincte du serveur.';
			const extra =
				tech === 'reveil-mmwave'
					? ' Radar de réveil en plus.'
					: tech === 'plug-play-green'
						? ' Un capteur de mouvement Zigbee facultatif est listé pour le réveil, pas pour l’affichage.'
						: ' Pas de capteur de présence.';
			return (
				'Situation B, profil Évolutif. Un Home Assistant Green est listé en un seul exemplaire, seulement si vous n’avez pas encore de serveur. ' +
				tablet +
				' Support et câble pour ' +
				q +
				'.' +
				extra +
				' Pas de dongle Zigbee.'
			);
		}
		const owned =
			tech === 'plug-play-green'
				? 'La variante Green signifie que le serveur (Green ou un équivalent) est déjà en place : il n’est pas acheté.'
				: 'Le serveur Home Assistant est supposé déjà en place et n’est pas dans les achats.';
		const buy =
			tech === 'tablette-recyclee'
				? 'Achats : support et câble, pour ' + q + '.'
				: 'Achats : tablette, support et câble, pour ' + q + '.';
		const extra =
			tech === 'plug-play-green'
				? ' Un capteur PIR est facultatif, pour le réveil uniquement, et seulement si un coordinateur Zigbee existe déjà.'
				: tech === 'reveil-mmwave'
					? ' Un radar mmWave est ajouté pour le réveil. Ce n’est pas du Zigbee.'
					: ' Pas de capteur de présence : on touche l’écran pour le rallumer.';
		return 'Situation A, profil Recommandé. ' + owned + ' ' + buy + extra;
	}

	function wtApply(detail) {
		const params = new URLSearchParams(window.location.search);
		const eco = detail?.ecosystem || params.get('eco') || 'ha-zigbee';
		const tech = detail?.techId || params.get('tech') || 'plug-play-green';
		const qty = detail?.qtyId || params.get('qty') || '1';
		const summary = document.querySelector('[data-wt-summary]');
		if (summary) summary.textContent = wtSummary(eco, tech, qty);
		const current = wtSituation(eco);
		document.querySelectorAll('[data-wt-situation]').forEach((node) => {
			node.classList.toggle('is-current', node.getAttribute('data-wt-situation') === current);
		});
	}

	document.addEventListener('shpp-config-change', (event) => {
		wtApply(event.detail);
	});
	wtApply();
</script>

