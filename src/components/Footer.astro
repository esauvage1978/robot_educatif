---
import CookieConsentBanner from './CookieConsentBanner.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';
import PagePathViewTracker from './PagePathViewTracker.astro';
import { withBase } from '../lib/siteUrl';

interface Props {
	/** Pages article : true pour ne pas doubler les vues (déjà comptées par ArticleEngagement). */
	suppressPagePathTracking?: boolean;
}

const { suppressPagePathTracking = false } = Astro.props;
const today = new Date();
---

<footer>
	<nav class="footer-links" aria-label="Liens du site et mentions">
		<a href={withBase('/blog/')}>Blog</a>
		<a href={withBase('/recherche/')}>Recherche</a>
		<a href={withBase('/categorie/')}>Catégories</a>
		<a href={withBase('/partenariat/')}>Partenariat</a>
		<a href={withBase('/contact/')}>Contact</a>
		<a href={withBase('/mentions-legales/')}>Mentions légales</a>
		<a href={withBase('/politique-de-confidentialite/')}>Politique de confidentialité</a>
		<a href={withBase('/gestion-des-cookies/')}>Gestion des cookies</a>
	</nav>
	<p class="copyright">&copy; {today.getFullYear()} ROBOT éducatif - Développé par Emmanuel SAUVAGE</p>
</footer>
<style>
	footer {
		padding: 2.25em 1em;
		background: var(--surface-2);
		color: rgb(var(--gray-dark));
		text-align: center;
		border-top: 1px solid var(--surface-border);
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 0.65rem;
	}
	.footer-links a {
		text-decoration: none;
		font-weight: 600;
		font-size: 0.94rem;
		padding: 0.38rem 0.75rem;
		border-radius: 6px;
		color: rgb(var(--gray-dark));
		border: 1px solid var(--surface-border);
		background: var(--surface);
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.footer-links a:hover {
		color: var(--accent-dark);
		border-color: color-mix(in oklab, var(--accent-dark) 42%, transparent);
	}
	.copyright {
		margin: 0;
	}
</style>
{!suppressPagePathTracking && <PagePathViewTracker />}
<CookieConsentBanner />
<GoogleAnalytics />
