<style>
	footer {
		background: color-mix(in oklab, var(--primary) 5%, var(--page-bg));
		border-top: 3px solid var(--primary);
		color: rgb(var(--gray));
	}

	.footer-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 2.25rem clamp(1rem, 4vw, 2rem) 1.75rem;
		display: grid;
		grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
		gap: 2.5rem 3rem;
		align-items: start;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.footer-brand img {
		height: 40px;
		width: auto;
		margin: 0;
	}

	.footer-tagline {
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
		line-height: 1.45;
		margin: 0;
		max-width: 16rem;
	}

	.social-links {
		display: flex;
		gap: 0.5rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		color: rgb(var(--gray-dark));
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.social-links a svg {
		width: 16px;
		height: 16px;
	}

	.social-links a:hover {
		background: var(--primary);
		border-color: var(--primary);
		color: white;
	}

	.social-links a:focus-visible,
	.footer-col a:focus-visible,
	.footer-francophonie a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.footer-columns {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.75rem 1.5rem;
	}

	.footer-col h3 {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 800;
		color: rgb(var(--black));
		margin: 0 0 0.75rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid color-mix(in oklab, var(--primary) 70%, white);
		line-height: 1.2;
	}

	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.footer-col li {
		margin: 0;
	}

	.footer-guide-label {
		margin-top: 0.55rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.footer-col a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.9rem;
		line-height: 1.35;
		transition: color 0.2s ease;
