---
import { Image } from 'astro:assets';
import CookieConsentBanner from './CookieConsentBanner.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';
import AffiliateClickTracker from './AffiliateClickTracker.astro';
import ManusoOutboundClickTracker from './ManusoOutboundClickTracker.astro';
import ManusoAmazonChoice from './ManusoAmazonChoice.astro';
import PagePathViewTracker from './PagePathViewTracker.astro';
import { withBase } from '../lib/siteUrl';
import logoA from '../assets/logo-a.svg';

interface Props {
	/** Pages article : true pour ne pas doubler les vues (déjà comptées par ArticleEngagement). */
	suppressPagePathTracking?: boolean;
}

const { suppressPagePathTracking = false } = Astro.props;
const today = new Date();
const _p = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const isUk = _p === '/uk' || _p.startsWith('/uk/');
const isCa = _p === '/ca' || _p.startsWith('/ca/');
const isUs = _p === '/us' || _p.startsWith('/us/');
const isEn = (_p === '/en' || _p.startsWith('/en/')) && !isUk && !isCa && !isUs;
const isAnglo = isEn || isUk || isCa || isUs;
const isDe = _p === '/de' || _p.startsWith('/de/');
const isIt = _p === '/it' || _p.startsWith('/it/');
const isEs = _p === '/es' || _p.startsWith('/es/');
const isFr = !isAnglo && !isDe && !isIt && !isEs;
const partenairesHref = isDe
	? withBase('/de/partner/')
	: isIt
		? withBase('/it/partner/')
		: isEs
			? withBase('/es/socios/')
			: isAnglo
				? withBase('/en/partners/')
				: withBase('/partenaires/');
const partenairesLabel = isEs ? 'Socios' : isAnglo ? 'Partners' : isDe || isIt ? 'Partner' : 'Partenaires';
const bfHref = isDe
	? '/de/black-friday/'
	: isIt
		? '/it/black-friday/'
		: isEs
			? '/es/black-friday/'
			: isCa
				? '/ca/black-friday/'
				: isUk
					? '/uk/black-friday/'
					: isAnglo
						? '/en/black-friday/'
						: '/black-friday/';
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<Image
				src={logoA}
				alt="ROBOT éducatif"
				width={230}
				height={45}
				loading="lazy"
				decoding="async"
			/>
			<p class="footer-tagline">{isIt ? "Scegliere e imparare con i robot educativi giusti" : isEs ? "Elegir y aprender con los robots educativos adecuados" : isDe ? "Mit den richtigen Lernrobotern auswählen und lernen" : isAnglo ? "Choosing and learning with the right educational robots" : "Choisir et apprendre avec les bons robots éducatifs"}</p>
			<div class="social-links">
				<a href="https://youtube.com/@roboteducatif6268" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
					<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
