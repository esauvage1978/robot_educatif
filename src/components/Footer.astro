---
import { Image } from 'astro:assets';
import CookieConsentBanner from './CookieConsentBanner.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';
import PagePathViewTracker from './PagePathViewTracker.astro';
import { withBase } from '../lib/siteUrl';
import logoA from '../assets/logo-a.svg';

interface Props {
	/** Pages article : true pour ne pas doubler les vues (déjà comptées par ArticleEngagement). */
	suppressPagePathTracking?: boolean;
}

const { suppressPagePathTracking = false } = Astro.props;
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<Image
				src={logoA}
				alt="ROBOT éducatif"
				width={230}
				height={45}
				loading="lazy"
				decoding="async"
			/>
			<p class="footer-tagline">Choisir et apprendre avec les bons robots éducatifs</p>
			<div class="social-links">
				<a href="https://youtube.com/@roboteducatif6268" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
					<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
						<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
					</svg>
				</a>
				<a href="https://www.pinterest.fr/roboteducatif/" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
					<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
						<path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
					</svg>
				</a>
				<a href="https://www.facebook.com/roboteducatif.info" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
						<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
					</svg>
				</a>
			</div>
		</div>
		
		<div class="footer-columns">
			<div class="footer-col">
				<h3>Guides d'achat</h3>
				<ul>
					<li><a href={withBase('/robot-educatif-cadeau-noel-2026/')}>Guide Noël 2026</a></li>
					<li><a href={withBase('/meilleur-robot-programmable-enfant-2026/')}>Par âge</a></li>
					<li><a href={withBase('/robot-enfant-4-ans/')}>4-5 ans</a></li>
					<li><a href={withBase('/quel-robot-acheter-enfant-10-ans-guide-achat/')}>10-12 ans</a></li>
					<li><a href={withBase('/blog/')}>Tous les articles</a></li>
				</ul>
			</div>
			
			<div class="footer-col">
				<h3>Programmation</h3>
				<ul>
					<li><a href={withBase('/10-projets-mbot-gratuits-classe-faciles/')}>Projets mBot</a></li>
					<li><a href={withBase('/programmation/')}>Tutoriels Python</a></li>
					<li><a href={withBase('/installer-mblock-5-sous-windows-10/')}>Installer mBlock</a></li>
					<li><a href={withBase('/categorie/')}>Catégories</a></li>
				</ul>
			</div>
			
			<div class="footer-col">
				<h3>À propos</h3>
				<ul>
					<li><a href={withBase('/about/')}>À propos</a></li>
					<li><a href={withBase('/partenariat/')}>Partenariat</a></li>
					<li><a href={withBase('/contact/')}>Contact</a></li>
				</ul>
			</div>
			
			<div class="footer-col">
				<h3>Légal</h3>
				<ul>
					<li><a href={withBase('/mentions-legales/')}>Mentions légales</a></li>
					<li><a href={withBase('/politique-de-confidentialite/')}>Confidentialité</a></li>
					<li><a href={withBase('/gestion-des-cookies/')}>Cookies</a></li>
				</ul>
			</div>
		</div>
	</div>
	
	<div class="footer-bottom">
		<p class="affiliate-notice">
			En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises.
		</p>
		<p class="copyright">&copy; {today.getFullYear()} ROBOT éducatif · Développé par Emmanuel SAUVAGE</p>
	</div>
</footer>
<style>
	footer {
		background: var(--surface);
		border-top: 1px solid var(--surface-border);
		color: rgb(var(--gray));
	}
	
	.footer-inner {
		max-width: 1320px;
		margin: 0 auto;
		padding: 3rem clamp(1rem, 5vw, 2rem) 2rem;
		display: grid;
		grid-template-columns: 1.2fr 2fr;
		gap: 3rem;
	}
	
	.footer-brand img {
		height: 45px;
		width: auto;
		margin-bottom: 1rem;
	}
	
	.footer-tagline {
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0 0 1.5rem 0;
		max-width: 280px;
	}
	
	.social-links {
		display: flex;
		gap: 1rem;
	}
	
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--surface-2);
		color: rgb(var(--gray-dark));
		transition: all 0.2s ease;
	}
	
	.social-links a:hover {
		background: var(--primary);
		color: white;
		transform: translateY(-2px);
	}
	
	.footer-columns {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}
	
	.footer-col h3 {
		font-size: 0.9rem;
		font-weight: 700;
		color: rgb(var(--black));
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 1rem 0;
	}
	
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	
	.footer-col li {
		margin-bottom: 0.65rem;
	}
	
	.footer-col a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.94rem;
		transition: color 0.2s ease;
	}
	
	.footer-col a:hover {
		color: var(--primary);
	}
	
	.footer-bottom {
		max-width: 1320px;
		margin: 0 auto;
		padding: 2rem clamp(1rem, 5vw, 2rem);
		border-top: 1px solid var(--surface-border);
		text-align: center;
	}
	
	.affiliate-notice {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0 0 0.75rem 0;
		font-style: italic;
	}
	
	.copyright {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0;
	}
	
	@media (max-width: 1024px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		
		.footer-columns {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	
	@media (max-width: 640px) {
		.footer-columns {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		
		.footer-inner {
			padding: 2rem 1rem 1.5rem;
		}
	}
</style>
{!suppressPagePathTracking && <PagePathViewTracker />}
<CookieConsentBanner />
<GoogleAnalytics />
