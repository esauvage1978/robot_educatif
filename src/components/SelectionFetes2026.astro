---
import { withBase } from '../lib/siteUrl';
import { HOME_FETES_COPY } from '../data/homeFetesI18n.mjs';

interface Props {
	compact?: boolean;
	locale?: keyof typeof HOME_FETES_COPY;
}

const { compact = false, locale = 'fr' } = Astro.props;
const copy = HOME_FETES_COPY[locale] || HOME_FETES_COPY.fr;
const ages = copy.ages;
const noelHref = copy.noelHref;
---

<section class="fetes26" aria-labelledby="fetes26-t">
	<div class="fetes26-head">
		<h2 id="fetes26-t">{copy.title}</h2>
		{
			!compact && <p>{copy.lead}</p>
		}
	</div>
	<ul class="fetes26-grid">
		{
			ages.map((item) => (
				<li>
					<a href={withBase(item.href)}>
						<span class="fetes26-age">{item.age}</span>
						<strong>{item.titre}</strong>
						<small>{item.texte}</small>
					</a>
				</li>
			))
		}
	</ul>
	{locale === 'fr' && (
		<a class="fetes26-home" href={withBase('/domotique/')}>
			<span class="fetes26-age fetes26-age--home">Maison</span>
			<span class="fetes26-home-copy">
				<strong>Domotique et maison connectée</strong>
				<small>Box, capteurs Zigbee, robots aspirateurs.</small>
			</span>
			<em>Voir les guides</em>
		</a>
	)}
	<p class="fetes26-all">
		<a href={withBase(`${noelHref}#noel-matrix-title`)}>{copy.all}</a>
	</p>
</section>

<style>
	.fetes26 {
		max-width: 1320px;
		margin: 2rem auto;
		padding: 1.5rem clamp(1rem, 3vw, 1.75rem) 1.35rem;
		border-radius: 16px;
		background: linear-gradient(145deg, #fff8f0 0%, #f0f7ff 55%, #fff 100%);
		border: 1px solid rgba(15, 23, 42, 0.08);
		box-shadow: 0 12px 40px rgba(15, 23, 42, 0.06);
	}
	.fetes26-head h2 {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.55rem);
		line-height: 1.25;
	}
	.fetes26-head p {
		margin: 0;
		color: #334155;
		font-size: 0.98rem;
		max-width: 62ch;
	}
	.fetes26-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr));
		gap: 0.65rem;
		list-style: none;
		margin: 1.1rem 0 0.85rem;
		padding: 0;
	}
	.fetes26-grid a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		height: 100%;
		padding: 0.75rem 0.85rem;
		border-radius: 12px;
		background: #fff;
		border: 1px solid rgba(15, 23, 42, 0.1);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.fetes26-grid a:hover {
		border-color: #2563eb;
		box-shadow: 0 4px 16px rgba(37, 99, 235, 0.12);
	}
	.fetes26-age {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #b45309;
	}
	.fetes26-grid strong {
		font-size: 0.95rem;
		line-height: 1.25;
	}
	.fetes26-grid small {
		font-size: 0.82rem;
		color: #64748b;
		line-height: 1.35;
	}
	.fetes26-home {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.75rem 1rem;
		align-items: center;
		padding: 0.85rem 1rem;
		margin-bottom: 0.5rem;
		border-radius: 12px;
		background: #0f172a;
		color: #f8fafc;
		text-decoration: none;
	}
	.fetes26-age--home {
		color: #93c5fd;
	}
	.fetes26-home em {
		font-style: normal;
		font-size: 0.88rem;
		font-weight: 600;
		color: #fde68a;
	}
	.fetes26-home-copy strong {
		display: block;
		font-size: 0.95rem;
	}
	.fetes26-home-copy small {
		color: #cbd5e1;
		font-size: 0.82rem;
	}
	.fetes26-all {
		margin: 0.35rem 0 0;
		font-weight: 600;
	}
	.fetes26-all a {
		color: #1d4ed8;
	}
</style>