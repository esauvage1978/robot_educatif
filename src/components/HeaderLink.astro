---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../lib/siteUrl';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const resolvedHref = typeof href === 'string' ? withBase(href) : href;
// Normalize paths: remove base and ensure leading slash, normalize trailing slash
const pathname = ('/' + Astro.url.pathname.replace(import.meta.env.BASE_URL, '')).replace(/\/+/g, '/');
const hrefForActive = typeof href === 'string' ? href : '';
const subpath = pathname.match(/[^\/]+/g);

// Match exact path (with or without trailing slash), root section, or any sub-path
const normalizedPathname = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
const normalizedHref = hrefForActive.endsWith('/') && hrefForActive !== '/' ? hrefForActive.slice(0, -1) : hrefForActive;

const isActive =
	normalizedPathname === normalizedHref || 
	hrefForActive === '/' + (subpath?.[0] || '') ||
	(normalizedHref !== '/' && normalizedHref !== '/en' && normalizedPathname.startsWith(normalizedHref + '/'));
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
