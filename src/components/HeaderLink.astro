---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../lib/siteUrl';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const resolvedHref = typeof href === 'string' ? withBase(href) : href;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const hrefForActive = typeof href === 'string' ? href : '';
const isActive =
	hrefForActive === pathname || hrefForActive === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
