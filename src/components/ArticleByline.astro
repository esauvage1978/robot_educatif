---
import { withBase } from '../lib/siteUrl';

const labels = {
	fr: { by: 'Par', role: 'Éditeur de ROBOT éducatif', read: 'min de lecture', updated: 'Mis à jour le' },
	en: { by: 'By', role: 'Editor of ROBOT éducatif', read: 'min read', updated: 'Updated' },
	de: { by: 'Von', role: 'Herausgeber von ROBOT éducatif', read: 'Min. Lesezeit', updated: 'Aktualisiert am' },
	it: { by: 'Di', role: 'Editore di ROBOT éducatif', read: 'min di lettura', updated: 'Aggiornato il' },
	es: { by: 'Por', role: 'Editor de ROBOT éducatif', read: 'min de lectura', updated: 'Actualizado el' },
} as const;

const locales = { fr: 'fr-FR', en: 'en-GB', de: 'de-DE', it: 'it-IT', es: 'es-ES' } as const;

interface Props {
	lang?: keyof typeof labels;
	date?: Date;
	dateText?: string;
	updated?: boolean;
	minutes?: number;
}

const { lang = 'fr', date, dateText, updated = false, minutes } = Astro.props;
const L = labels[lang] ?? labels.fr;
const formatted = date
	? date.toLocaleDateString(locales[lang] ?? 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
	: dateText?.trim();
const when = formatted ? (updated ? `${L.updated} ${formatted}` : formatted) : '';
const shownMinutes = typeof minutes === 'number' && minutes > 0 ? minutes : undefined;
---

<div class="article-byline">
	<img
		class="article-byline__photo"
		src={withBase('/images/authors/emmanuel-sauvage.webp')}
		alt=""
		width="56"
		height="56"
	/>
	<div class="article-byline__text">
		<p class="article-byline__name">
			{L.by} <a href={withBase('/about/')}>Emmanuel Sauvage</a>
		</p>
		<p class="article-byline__role">{L.role}</p>
		<p class="article-byline__meta">
			{when && <span>{when}</span>}
			<span class="article-byline__read" data-label={L.read} data-minutes={shownMinutes ?? ''} hidden={!shownMinutes && !when}>
				{when && <span class="article-byline__sep" aria-hidden="true">·</span>}
				<svg class="article-byline__clock" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
					<path d="M12 8.2V12l2.6 1.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
				<span class="article-byline__minutes">{shownMinutes ? `${shownMinutes} ${L.read}` : ''}</span>
			</span>
		</p>
	</div>
</div>

<script>
	const nodes = document.querySelectorAll<HTMLElement>('.article-byline__read');
	for (const node of nodes) {
		const minutesEl = node.querySelector('.article-byline__minutes');
		if (!minutesEl || minutesEl.textContent?.trim()) {
			node.hidden = false;
			continue;
		}
		const prose = node.closest('main')?.querySelector('.prose, .article-content');
		if (!prose) continue;
		const words = (prose.textContent || '').trim().split(/\s+/).filter(Boolean).length;
		if (!words) continue;
		const minutes = Math.max(1, Math.round(words / 200));
		const label = node.dataset.label || 'min';
		minutesEl.textContent = `${minutes} ${label}`;
		node.hidden = false;
	}
</script>

<style>
	.article-byline {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin: 1.1rem 0 0.35rem;
		padding: 0.8rem 1rem;
		max-width: 34rem;
		background: var(--page-bg-elevated, #fff);
		border: 1px solid var(--surface-border, #e2e8f0);
		border-radius: 1rem;
		box-shadow: 0 1px 2px rgba(11, 31, 42, 0.04);
	}
	.article-byline__photo {
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 18%;
		flex-shrink: 0;
		background: #fff;
	}
	.article-byline__text {
		min-width: 0;
	}
	.article-byline__name {
		margin: 0;
		font-family: var(--font-body, system-ui);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		color: rgb(var(--black, 11 31 42));
	}
	.article-byline__name a {
		color: inherit;
		text-decoration: none;
	}
	.article-byline__name a:hover {
		color: var(--accent, #0f766e);
	}
	.article-byline__role {
		margin: 0.12rem 0 0;
		font-size: 0.9rem;
		line-height: 1.35;
		color: rgb(var(--gray, 71 85 105));
	}
	.article-byline__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.45rem;
		margin: 0.28rem 0 0;
		font-size: 0.86rem;
		line-height: 1.35;
		color: rgb(var(--gray, 71 85 105));
	}
	.article-byline__read {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.article-byline__clock {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
	}
	.article-byline__sep {
		margin-right: 0.05rem;
	}
</style>
