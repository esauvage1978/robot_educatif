---
import Sidebar from './Sidebar.astro';
import EditorialReadAlso from './EditorialReadAlso.astro';

const { sommaire = true } = Astro.props;
---

<div class:list={['page-layout', sommaire ? 'page-layout--with-sidebar' : 'page-layout--sans-sommaire']}>
	<article>
		<div class="prose">
			<slot />
			<EditorialReadAlso />
		</div>
	</article>
	{sommaire && <Sidebar variant="guide" />}
</div>
