<script>
	document.querySelectorAll('[data-shpp-copy-yaml]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const code = document.querySelector('[data-shuc-yaml] code')?.textContent;
			if (code) navigator.clipboard?.writeText(code);
		});
	});
	document.querySelectorAll('[data-shpp-copy-list]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const cfg = document.querySelector('[data-shpp-config]');
			const billRaw = cfg?.dataset.shppBill;
			if (!billRaw) return;
			const bill = JSON.parse(billRaw);
			let t = `${bill.useCaseTitle}\n\n`;
			for (const line of bill.lines) t += `- ${line.label} × ${line.qty}\n`;
			t += `\nBudget : ~${bill.meta.budgetEur} €\n`;
			navigator.clipboard?.writeText(t);
		});
	});
	document.querySelectorAll('[data-shpp-print]').forEach((btn) => {
		btn.addEventListener('click', () => window.print());
	});
	document.querySelectorAll('[data-shpp-zoom-schema]').forEach((btn) => {
		const dlg = document.querySelector('[data-shpp-schema-dialog]');
		btn.addEventListener('click', () => dlg?.showModal?.());
	});
	document.querySelectorAll('[data-shpp-zoom-functional]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const dlg = document.querySelector('[data-shpp-schema-dialog]');
			const src = document.querySelector('[data-shpp-functional-svg]');
			const zoom = dlg?.querySelector('.shpp-ref-svg-wrap--zoom');
			if (dlg && zoom && src) {
				zoom.innerHTML = src.innerHTML;
				dlg.showModal?.();
			}
		});
	});
	document.querySelectorAll('[data-shpp-close-schema]').forEach((btn) => {
		btn.addEventListener('click', () => btn.closest('dialog')?.close());
	});
</script>

