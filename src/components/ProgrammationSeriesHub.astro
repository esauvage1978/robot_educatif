---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { getCollection } from 'astro:content';
import { articleSlugFromId } from '../lib/articleSlug';
import { withBase } from '../lib/siteUrl';

/** Comparaison robuste (YAML / CRLF / espaces / Unicode). */
function normSeries(value: unknown): string {
	return String(value ?? '')
		.replace(/\r/g, '')
		.trim()
		.normalize('NFC');
}

export interface SeriesHubFallbackLesson {
	href: string;
	order: number;
	title: string;
	desc: string;
}

interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	metaTitle: string;
	metaDescription: string;
	/** Valeur de `series` dans le frontmatter des articles */
	series: string;
	breadcrumbLast: string;
	pageTitle: string;
	/** Si aucun article ne matche (après normalisation), afficher ces liens à la place */
	fallbackLessons?: SeriesHubFallbackLesson[];
	/** JSON-LD FAQPage (rich results) — optionnel */
	faqSchema?: FaqItem[];
}

const { metaTitle, metaDescription, series, breadcrumbLast, pageTitle, fallbackLessons = [], faqSchema } = Astro.props;

const faqJsonLd =
	faqSchema && faqSchema.length > 0
		? JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faqSchema.map((item) => ({
					'@type': 'Question',
					name: item.question,
					acceptedAnswer: {
						'@type': 'Answer',
						text: item.answer,
					},
				})),
			})
		: null;

const all = await getCollection('blog');
const posts = all
	.filter((p) => normSeries(p.data.series) === normSeries(series))
	.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));

const useFallback = posts.length === 0 && fallbackLessons.length > 0;

const slug = articleSlugFromId;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={metaTitle} description={metaDescription} />
		{
			faqJsonLd && (
				<script type="application/ld+json" set:html={faqJsonLd} />
			)
		}
	</head>
	<body>
		<Header />
		<main class="series-hub">
			<nav class="breadcrumb" aria-label="Fil d’Ariane">
				<a href={withBase('/programmation')}>Programmation</a>
				<span aria-hidden="true"> / </span>
				<span>{breadcrumbLast}</span>
			</nav>
			<h1>{pageTitle}</h1>
			<div class="lead-block">
				<slot />
			</div>
			<ol class="lesson-list">
				{
					useFallback
						? fallbackLessons.map((row) => (
								<li>
									<a href={withBase(row.href)}>
										<span class="num">{row.order}</span>
										<span class="meta">
											<span class="title">{row.title}</span>
											<span class="desc">{row.desc}</span>
										</span>
									</a>
								</li>
							))
						: posts.map((post) => (
								<li>
									<a href={withBase(`/${slug(post.id)}/`)}>
										<span class="num">{post.data.seriesOrder ?? '—'}</span>
										<span class="meta">
											<span class="title">{post.data.title}</span>
											<span class="desc">{post.data.description}</span>
										</span>
									</a>
								</li>
							))
				}
			</ol>
			<p class="back">
				<a href={withBase('/programmation')}>← Toutes les rubriques programmation</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.series-hub {
		width: min(720px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}
	.breadcrumb {
		font-size: 0.88rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}
	.breadcrumb a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}
	.series-hub h1 {
		font-size: clamp(1.65rem, 3vw, 2rem);
		margin: 0 0 0.75rem;
		color: color-mix(in oklab, var(--accent) 78%, var(--accent-warm) 22%);
	}
	.lead-block {
		margin-bottom: 1.75rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}
	.lead-block :global(p) {
		margin: 0 0 0.75rem;
	}
	.lead-block :global(p:last-child) {
		margin-bottom: 0;
	}
	.lead-block :global(a) {
		color: var(--accent);
		font-weight: 600;
	}
	.lead-block :global(h2) {
		font-size: clamp(1.15rem, 2.2vw, 1.35rem);
		margin: 1.75rem 0 0.65rem;
		color: rgb(var(--gray-dark));
		line-height: 1.25;
	}
	.lead-block :global(h2:first-child) {
		margin-top: 0;
	}
	.lead-block :global(h3) {
		font-size: 1.05rem;
		margin: 1.25rem 0 0.5rem;
		color: rgb(var(--gray-dark));
	}
	.lead-block :global(ul),
	.lead-block :global(ol) {
		margin: 0.5rem 0 0.75rem;
		padding-left: 1.35rem;
	}
	.lead-block :global(li) {
		margin-bottom: 0.35rem;
	}
	.lead-block :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.92rem;
		margin: 0.75rem 0 1rem;
	}
	.lead-block :global(th),
	.lead-block :global(td) {
		border: 1px solid var(--surface-border);
		padding: 0.45rem 0.55rem;
		text-align: left;
		vertical-align: top;
	}
	.lead-block :global(thead th) {
		background: color-mix(in oklab, var(--accent) 8%, var(--surface));
	}
	.lesson-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.lesson-list li {
		margin-bottom: 0.65rem;
	}
	.lesson-list a {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		border: 1px solid var(--surface-border);
		background: var(--surface);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.lesson-list a:hover {
		border-color: color-mix(in oklab, var(--accent) 38%, transparent);
		background: color-mix(in oklab, var(--accent) 5%, var(--surface));
	}
	.num {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
		background: linear-gradient(135deg, #1a3a5c, #2d6a4f);
		color: #fff;
		font-weight: 800;
		font-size: 0.95rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}
	.meta .title {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.lesson-list a:hover .title {
		color: var(--accent);
	}
	.meta .desc {
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.45;
	}
	.back {
		margin-top: 2rem;
	}
	.back a {
		color: var(--accent);
		font-weight: 600;
	}
</style>
