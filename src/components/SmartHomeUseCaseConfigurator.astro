</style>

<script>
	import { computeBill } from '../data/smartHomeUseCaseConfigurator.mjs';

	function initShuc(root) {
		const useCases = JSON.parse(root.dataset.useCases || '[]');
		const ecosystems = JSON.parse(root.dataset.ecosystems || '[]');
		const qtyOptions = JSON.parse(root.dataset.qty || '[]');
		const base = root.dataset.base || '';
		const totalUseCases = Number(root.dataset.useCaseCount) || useCases.length;

		const state = {
			useCaseId: null,
			ecosystem: 'wifi-sans-box',
			qtyId: '1',
			techId: null,
			step: 1,
			category: 'all',
			searchQuery: '',
		};

		const pills = root.querySelectorAll('[data-shuc-pill]');
		const panels = {
			1: root.querySelector('[data-shuc-step="1"]'),
			2: root.querySelector('[data-shuc-step="2"]'),
			3: root.querySelector('[data-shuc-step="3"]'),
		};
		const step2Title = root.querySelector('[data-shuc-step2-title]');
		const ecoWrap = root.querySelector('[data-shuc-ecosystem]');
		const qtyWrap = root.querySelector('[data-shuc-qty]');
		const qtyHeading = root.querySelector('[data-shuc-qty-heading]');
		const techWrap = root.querySelector('[data-shuc-tech-wrap]');
		const techChoices = root.querySelector('[data-shuc-tech]');
		const resultEl = root.querySelector('[data-shuc-result]');
		const searchInput = root.querySelector('[data-shuc-search]');
		const filterMeta = root.querySelector('[data-shuc-filter-meta]');
		const cardButtons = root.querySelectorAll('[data-shuc-pick]');

		function normalizeSearch(s) {
			return s
				.toLowerCase()
				.normalize('NFD')
				.replace(/\p{M}/gu, '')
				.trim();
		}

		function applyFilters() {
			const q = normalizeSearch(state.searchQuery);
			const cat = state.category;
			let visible = 0;
			cardButtons.forEach((btn) => {
				const btnCat = btn.dataset.shucCategory || '';
				const hay = btn.dataset.shucKeywords || '';
				const catOk = cat === 'all' || btnCat === cat;
				const searchOk = !q || hay.includes(q);
				const show = catOk && searchOk;
				btn.hidden = !show;
				if (show) visible += 1;
			});
			if (filterMeta) {
				if (visible < totalUseCases && (q || cat !== 'all')) {
					filterMeta.hidden = false;
					filterMeta.textContent = `${visible} cas affiché${visible > 1 ? 's' : ''} sur ${totalUseCases}`;
				} else {
					filterMeta.hidden = true;
				}
			}
		}

		function href(path) {
			const p = path.startsWith('/') ? path : `/${path}`;
			if (!base || base === '/') return p;
			const b = base.endsWith('/') ? base.slice(0, -1) : base;
			return `${b}${p}`;
		}

		function currentUseCase() {
			return useCases.find((u) => u.id === state.useCaseId);
		}

		function updatePills() {
			pills.forEach((pill) => {
				const n = Number(pill.dataset.shucPill);
				pill.classList.remove('is-active', 'is-done');
				if (n === state.step) pill.classList.add('is-active');
				else if (n < state.step) pill.classList.add('is-done');
			});
		}

		function goStep(n) {
			state.step = n;
			Object.entries(panels).forEach(([k, el]) => {
				if (el) el.hidden = Number(k) !== n;
			});
			updatePills();
			if (n === 3) renderResult();
		}

		function renderStep2() {
			const uc = currentUseCase();
			if (!uc) return;
			step2Title.textContent = uc.title;
			qtyHeading.textContent = uc.qtyLabel;

			ecoWrap.innerHTML = ecosystems
				.map(
					(e) =>
						`<button type="button" class="shuc-choice${state.ecosystem === e.id ? ' is-selected' : ''}" data-shuc-eco="${e.id}">${e.label}</button>`,
				)
				.join('');
			ecoWrap.querySelectorAll('[data-shuc-eco]').forEach((btn) => {
				btn.addEventListener('click', () => {
					state.ecosystem = btn.dataset.shucEco;
					renderStep2();
				});
			});

			qtyWrap.innerHTML = qtyOptions
				.map(
					(q) =>
						`<button type="button" class="shuc-qty-btn${state.qtyId === q.id ? ' is-selected' : ''}" data-shuc-q="${q.id}">${q.label}</button>`,
				)
				.join('');
			qtyWrap.querySelectorAll('[data-shuc-q]').forEach((btn) => {
				btn.addEventListener('click', () => {
					state.qtyId = btn.dataset.shucQ;
					renderStep2();
				});
			});

			if (uc.techOptions?.length) {
				techWrap.hidden = false;
				if (!state.techId) state.techId = uc.techOptions[0].id;
				techChoices.innerHTML = uc.techOptions
					.map(
						(t) =>
							`<button type="button" class="shuc-choice${state.techId === t.id ? ' is-selected' : ''}" data-shuc-tech="${t.id}">${t.label}</button>`,
					)
					.join('');
				techChoices.querySelectorAll('[data-shuc-tech]').forEach((btn) => {
					btn.addEventListener('click', () => {
						state.techId = btn.dataset.shucTech;
						renderStep2();
					});
				});
			} else {
				techWrap.hidden = true;
				state.techId = null;
			}
		}

		function diffLabel(d) {
			if (d <= 2) return `${d}/5 — Facile`;
			if (d === 3) return `${d}/5 — Moyen`;
			if (d === 4) return `${d}/5 — Difficile`;
			return `${d}/5 — Expert`;
		}

		function escapeHtml(s) {
			return String(s)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function renderResult() {
			const bill = computeBill({
				useCaseId: state.useCaseId,
				ecosystem: state.ecosystem,
				qtyId: state.qtyId,
				techId: state.techId,
			});
			if (!bill) {
				resultEl.innerHTML = '<p>Configuration invalide.</p>';
				return;
			}

			const mainLine = bill.lines.find((l) => l.role === 'main') ?? bill.lines[0];
			const heroBuy = mainLine
				? `<div class="shuc-hero-buy">
					<strong>Module principal : ${escapeHtml(mainLine.label)} × ${mainLine.qty}</strong>
					<p class="shuc-role">${escapeHtml(mainLine.note || bill.useCaseTitle)}</p>
					<a href="${escapeHtml(mainLine.buyUrl)}" rel="sponsored nofollow noopener" target="_blank">${escapeHtml(mainLine.buyLabel)}</a>
				</div>`
				: '';

			const linesHtml = bill.lines
				.map((line) => {
					const isMain = line.role === 'main';
					const imgSrc = href(line.image);
					return `
					<article class="shuc-line${isMain ? ' shuc-line--main' : ''}">
						<img src="${imgSrc}" alt="${escapeHtml(line.label)}" width="72" height="72" loading="lazy" />
						<div>
							<h4>${isMain ? 'Module principal — ' : ''}${escapeHtml(line.label)} × ${line.qty}</h4>
							<p class="shuc-role">${escapeHtml(line.note || (isMain ? bill.useCaseTitle : 'Accessoire'))}</p>
							<p class="shuc-price">${line.lineText} (${line.unitText} / u.)</p>
						</div>
						<div class="shuc-buy-wrap">
							<a class="shuc-buy" href="${escapeHtml(line.buyUrl)}" rel="sponsored nofollow noopener" target="_blank">${escapeHtml(line.buyLabel)}</a>
						</div>
					</article>`;
				})
				.join('');

			const wiringHtml = bill.wiring.map((w) => `<li>${escapeHtml(w)}</li>`).join('');

			const g = bill.guide;
			const explainHtml = g.explanation.map((p) => `<p>${escapeHtml(p)}</p>`).join('');
			const bornierRows = g.bornier
				.map(
					(r) =>
						`<tr><td><code>${escapeHtml(r.terminal)}</code></td><td>${escapeHtml(r.wire)}</td><td>${escapeHtml(r.role)}</td></tr>`,
				)
				.join('');
			const stepsHtml = g.installSteps
				.map((s) => `<li><strong>${escapeHtml(s.title)}</strong>${escapeHtml(s.body)}</li>`)
				.join('');

			resultEl.innerHTML = `
				<div class="shuc-indicators">
					<div><span>Difficulté</span>${diffLabel(bill.meta.difficulty)}</div>
					<div><span>Temps d'installation</span>${escapeHtml(bill.meta.time)}</div>
					<div><span>Outils requis</span>${escapeHtml(bill.meta.tools)}</div>
					<div><span>Budget total</span>${bill.meta.budgetText}</div>
				</div>
				${heroBuy}
				<div class="shuc-tech-block">
					<h3>Fonctionnement &amp; choix matériel (${escapeHtml(g.schemeTitle)})</h3>
					${explainHtml}
				</div>
				<h3>Schéma de câblage</h3>
				<div class="shuc-ref-svg-wrap">${g.svg}</div>
				<h3>Tableau bornier (repérage fil par fil)</h3>
				<table class="shuc-bornier">
					<thead><tr><th scope="col">Borne du module</th><th scope="col">Fil à raccorder</th><th scope="col">Rôle &amp; vérification multimètre</th></tr></thead>
					<tbody>${bornierRows}</tbody>
				</table>
				<h3>Installation &amp; Home Assistant (5 étapes)</h3>
				<ol class="shuc-steps-list">${stepsHtml}</ol>
				<h3>Automatisation YAML (copier-coller)</h3>
				<pre class="shuc-yaml">${escapeHtml(g.yaml)}</pre>
				<h3>Rappel branchement (3 points)</h3>
				<ol class="shuc-wiring">${wiringHtml}</ol>
				<p class="shuc-tutorial"><a href="${href(bill.tutorialHref)}">${escapeHtml(bill.tutorialLabel)} — tutoriel complet sur robot-educatif.info</a></p>
				<h3>Liste complète du matériel</h3>
				<div class="shuc-lines">${linesHtml}</div>
				<p class="shuc-total">Budget matériel : ${bill.meta.budgetText} (hors câbles et main-d'œuvre)</p>
			`;
		}

		function copyList() {
			const bill = computeBill({
				useCaseId: state.useCaseId,
				ecosystem: state.ecosystem,
				qtyId: state.qtyId,
				techId: state.techId,
			});
			if (!bill) return;
			let t = `Liste matériel — ${bill.useCaseTitle}\n`;
			t += `Source : robot-educatif.info/domotique/configurateur-projet-domotique/\n\n`;
			for (const line of bill.lines) {
				t += `- ${line.label} × ${line.qty} (~${line.lineTotal} €)\n`;
			}
			t += `\nBudget indicatif : ~${bill.meta.budgetEur.toFixed(0)} €\n`;
			t += `Tutoriel : ${bill.tutorialHref}\n`;
			navigator.clipboard?.writeText(t);
		}

		cardButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				state.useCaseId = btn.dataset.shucPick;
				state.techId = null;
				state.qtyId = '1';
				state.ecosystem = 'wifi-sans-box';
				renderStep2();
				goStep(2);
			});
		});

		searchInput?.addEventListener('input', () => {
			state.searchQuery = searchInput.value;
			applyFilters();
		});

		root.querySelectorAll('[data-shuc-cat]').forEach((btn) => {
			btn.addEventListener('click', () => {
				state.category = btn.dataset.shucCat || 'all';
				root.querySelectorAll('[data-shuc-cat]').forEach((b) => {
					b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
				});
				applyFilters();
			});
		});

		applyFilters();

		root.querySelectorAll('[data-shuc-goto]').forEach((btn) => {
			btn.addEventListener('click', () => goStep(Number(btn.dataset.shucGoto)));
		});

		root.querySelector('[data-shuc-show-result]')?.addEventListener('click', () => goStep(3));

		root.querySelector('[data-shuc-copy]')?.addEventListener('click', copyList);
		root.querySelector('[data-shuc-print]')?.addEventListener('click', () => window.print());

		updatePills();
	}

	document.querySelectorAll('[data-shuc]').forEach(initShuc);
</script>
