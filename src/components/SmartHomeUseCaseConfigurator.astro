---
import RepairComplianceSections from './RepairComplianceSections.astro';
import {
	USE_CASES,
	USE_CASE_CATEGORIES,
	ECOSYSTEMS,
	QTY_OPTIONS,
} from '../data/smartHomeUseCaseConfigurator.mjs';
import { withBase } from '../lib/siteUrl';

const useCaseCount = USE_CASES.length;
const useCasesJson = JSON.stringify(USE_CASES);
const categoriesJson = JSON.stringify(USE_CASE_CATEGORIES);
const ecosystemsJson = JSON.stringify(ECOSYSTEMS);
const qtyJson = JSON.stringify(QTY_OPTIONS);
const siteBase = withBase('');
---

<div
	class="shuc"
	data-shuc
	data-use-cases={useCasesJson}
	data-categories={categoriesJson}
	data-ecosystems={ecosystemsJson}
	data-qty={qtyJson}
	data-base={siteBase}
	data-use-case-count={String(useCaseCount)}
>
	<nav class="shuc-steps" aria-label="Étapes du configurateur">
		<span class="shuc-step-pill" data-shuc-pill="1">1. Projet</span>
		<span class="shuc-step-pill" data-shuc-pill="2">2. Installation</span>
		<span class="shuc-step-pill" data-shuc-pill="3">3. Matériel &amp; câblage</span>
	</nav>

	<section class="shuc-panel" data-shuc-step="1">
		<h2 class="shuc-heading">Quel projet domotique voulez-vous réaliser ?</h2>
		<p class="shuc-lead">
			<strong>{useCaseCount} cas d’usage concrets</strong> configurables en 3 étapes — filtrez par catégorie ou
			recherchez un mot-clé (garage, sans neutre, chauffe-eau…).
		</p>
		<div class="shuc-filters">
			<label class="shuc-search-wrap">
				<span class="visually-hidden">Rechercher un cas d’usage</span>
				<input
					type="search"
					class="shuc-search"
					data-shuc-search
					placeholder="Ex : porte de garage, volet roulant, sans neutre, chauffe-eau, lave-linge…"
					autocomplete="off"
					spellcheck="false"
				/>
			</label>
			<div class="shuc-filter-row" data-shuc-category-filters role="group" aria-label="Catégories">
				{USE_CASE_CATEGORIES.map((cat) => (
					<button
						type="button"
						class="shuc-filter-btn"
						data-shuc-cat={cat.id}
						aria-pressed={cat.id === 'all' ? 'true' : 'false'}
					>
						{cat.id === 'all' ? `${cat.label} (${useCaseCount})` : cat.label}
					</button>
				))}
			</div>
			<p class="shuc-filter-meta" data-shuc-filter-meta hidden></p>
		</div>
		<div class="shuc-cards" data-shuc-cards>
			{USE_CASES.map((uc) => (
				<button
					type="button"
					class="shuc-card"
					data-shuc-pick={uc.id}
					data-shuc-category={uc.category}
					data-shuc-keywords={`${uc.title} ${uc.shortDesc} ${uc.keywords ?? ''}`.toLowerCase()}
				>
					<span class="shuc-card-emoji" aria-hidden="true">{uc.emoji}</span>
					<span class="shuc-card-title">{uc.title}</span>
					<span class="shuc-card-desc">{uc.shortDesc}</span>
				</button>
			))}
		</div>
	</section>

	<section class="shuc-panel" data-shuc-step="2" hidden>
		<button type="button" class="shuc-back" data-shuc-goto="1">← Changer de projet</button>
		<h2 class="shuc-heading" data-shuc-step2-title></h2>

		<div class="shuc-block">
			<h3>Écosystème souhaité</h3>
			<div class="shuc-choices" data-shuc-ecosystem></div>
		</div>

		<div class="shuc-block">
			<h3 data-shuc-qty-heading>Quantité</h3>
			<div class="shuc-qty-row" data-shuc-qty></div>
		</div>

		<div class="shuc-block" data-shuc-tech-wrap hidden>
			<h3>Configuration électrique / technique</h3>
			<div class="shuc-choices" data-shuc-tech></div>
		</div>

		<button type="button" class="shuc-btn shuc-btn--primary" data-shuc-show-result>Voir schéma, guide HA et matériel</button>
	</section>

	<section class="shuc-panel" data-shuc-step="3" hidden>
		<button type="button" class="shuc-back" data-shuc-goto="2">← Ajuster l’installation</button>
		<h2 class="shuc-heading">Schéma de câblage, guide Home Assistant et matériel</h2>
		<div data-shuc-result></div>
		<div class="shuc-result-actions">
			<button type="button" class="shuc-btn" data-shuc-copy>Copier ma liste de matériel</button>
			<button type="button" class="shuc-btn shuc-btn--secondary" data-shuc-print>Imprimer / PDF</button>
		</div>
	</section>
</div>

<RepairComplianceSections lang="fr" variant="smart-home" />

<p class="shuc-assist">
	En cas de doute, contactez l'assistance officielle ou faites réparer par le constructeur. Coupez toujours le disjoncteur
	concerné avant toute intervention sur le 230 V.
</p>

<style is:global>
