		color: rgb(var(--gray-dark));
		margin: 0 0 1.25rem;
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
	.shuc-filters {
		margin: 0 0 1.25rem;
	}
	.shuc-search-wrap {
		display: block;
