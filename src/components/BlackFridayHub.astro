	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: c.faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<!doctype html>
<html lang={c.html}>
	<head>
		<BaseHead title={c.title} description={c.description} />
		<script type="application/ld+json" set:html={JSON.stringify(faqJson)} />
		<style>
			.bf-wrap { max-width: 960px; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 2rem) 3rem; }
			.bf-wrap h1 { font-family: var(--font-heading); font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 .75rem; }
			.bf-lead, .bf-note { color: var(--text-muted, #444); }
			.bf-note { background: #fff8e6; border-left: 4px solid #f5a623; padding: .75rem 1rem; border-radius: 6px; }
			.bf-wrap h2 { font-size: 1.35rem; margin: 2rem 0 .75rem; }
			.bf-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .8rem; }
			.bf-grid a, .bf-card { display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: 1rem; border-radius: 12px; background: #fff; border: 1px solid #e3e6ea; color: inherit; text-decoration: none; }
			.bf-age { align-self: flex-start; font-size: .75rem; font-weight: 700; color: #fff; background: #111827; padding: .12rem .55rem; border-radius: 99px; }
			.bf-price { font-weight: 800; margin: .2rem 0; }
			.bf-price a { color: #1d4ed8; }
			.bf-btn { display: inline-flex; justify-content: center; margin-top: auto; padding: .5rem .75rem; border-radius: 8px; font-weight: 700; text-decoration: none !important; background: #ff9900; color: #111 !important; }
			.bf-links { display: flex; flex-direction: column; gap: .35rem; font-weight: 700; }
			.bf-links a { color: #1d4ed8; }
			.bf-faq details { border-top: 1px solid #e3e6ea; padding: .7rem 0; }
			.bf-faq summary { font-weight: 700; cursor: pointer; }
			.promo-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
			.promo-card { background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1rem 1.1rem; display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; justify-content: space-between; }
			.promo-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; background: #eef4ff; border: 1px dashed #4a7bd0; border-radius: 6px; padding: .3rem .6rem; }
			.promo-cta { display: inline-block; background: var(--primary, #1f5fbf); color: #fff !important; text-decoration: none; font-weight: 700; padding: .55rem 1rem; border-radius: 8px; }
		</style>
	</head>
	<body>
		<Header />
		<main class="bf-wrap">
			<PageColumns>
			<nav class="breadcrumb" aria-label={c.crumb}>
				<a href={withBase(locale === 'en' ? (prefix || '/en/') : `/${locale}/`)}>{c.home}</a>
				<span aria-hidden="true"> / </span>
				<span>{c.crumb}</span>
			</nav>
			<h1>{c.h1}</h1>
			<p class="bf-lead">{c.lead}</p>
			<p class="bf-note">{c.note}</p>
			<p>{priceNote}</p>

			<h2>{c.guidesTitle}</h2>
			<p>{c.guidesLead}</p>
			<ul class="bf-grid">
				{c.ages.map((age) => (
					<li><a href={withBase(hrefFor(age.href))}><span class="bf-age">{age.age}</span><strong>{age.label}</strong></a></li>
				))}
			</ul>
			<p class="bf-links">
				<a href={withBase(hrefFor(c.xmas))}>{c.more}</a>
				<a href={withBase(hrefFor(c.compareHref))}>{c.compare}</a>
			</p>

			<h2>{c.robotsTitle}</h2>
			<ul class="bf-grid">
				{robotCards.map((card) => (
					<li class="bf-card">
						<span class="bf-age">{card.badge}</span>
						<strong>{card.name}</strong>
						<p>{card.desc}</p>
						<p class="bf-price" data-amazon-price="1">
							<a href={card.url} data-amazon-query={card.query} target="_blank" rel="sponsored nofollow noopener">{c.priceLabel}: {card.price}</a>
						</p>
						<a class="bf-btn" href={card.url} data-amazon-query={card.query} target="_blank" rel="sponsored nofollow noopener">{c.amazonCta}</a>
					</li>
				))}
			</ul>

			<h2>{c.homeTitle}</h2>
			<ul class="bf-grid">
				{homeCards.map((card) => (
					<li class="bf-card">
						<span class="bf-age">{card.badge}</span>
						<strong>{card.name}</strong>
						<p>{card.desc}</p>
						<p class="bf-price" data-amazon-price="1">
							<a href={card.url} data-amazon-query={card.query} target="_blank" rel="sponsored nofollow noopener">{c.priceLabel}: {card.price}</a>
						</p>
						<a class="bf-btn" href={card.url} data-amazon-query={card.query} target="_blank" rel="sponsored nofollow noopener">{c.amazonCta}</a>
					</li>
				))}
				<li class="bf-card">
					<span class="bf-age">{homeCards[0]?.badge}</span>
					<strong>{c.shellyName}</strong>
					<p>{c.shellyDesc}</p>
					<p class="bf-price">{c.shellyPrice}</p>
					<a class="bf-btn" href={shellyUrl} target="_blank" rel="sponsored nofollow noopener">{c.shellyCta}</a>
				</li>
			</ul>
			<p class="bf-links"><a href={withBase(hrefFor(c.hubHref))}>{c.hub}</a></p>

			<h2>{c.codesTitle}</h2>
			{offers.length === 0 ? (
				<p>{c.emptyCodes}</p>
			) : (
				<ul class="promo-list">
					{offers.map((o) => (
						<li class="promo-card">
							<div>
								<p><a href={o.url} rel="sponsored nofollow noopener" target="_blank">{o.title}</a></p>
								<p>{c.valid} {fmt(o.start)} {c.to} {fmt(o.end)} · {c.verified} {fmt(o.verified)}</p>
							</div>
							<div>
								{o.code ? <span class="promo-code">{o.code}</span> : <span>{c.direct}</span>}
								<a class="promo-cta" href={o.url} rel="sponsored nofollow noopener" target="_blank">{c.seeOffer}</a>
							</div>
						</li>
					))}
				</ul>
			)}
			{c.extraUrl && (
				<ul class="promo-list">
					<li class="promo-card">
						<div>
							<p><strong>{c.extraTitle}</strong></p>
							<p>{c.extraText}</p>
						</div>
						<a class="promo-cta" href={c.extraUrl} rel="sponsored nofollow noopener" target="_blank">{c.extraCta}</a>
					</li>
				</ul>
			)}

			<section class="bf-faq">
				<h2>{c.faqTitle}</h2>
				{c.faq.map((item) => (
					<details>
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))}
			</section>
			</PageColumns>
		</main>
		<Footer />
	</body>
</html>
