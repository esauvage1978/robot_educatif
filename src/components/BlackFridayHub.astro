const c = copy[locale];
const prefix = market === 'ca' ? '/ca/' : path.startsWith('/uk/') ? '/uk/' : null;
const hrefFor = (href: string) => (prefix && href.startsWith('/en/') ? href.replace(/^\/en\//, prefix) : href);
const shellyShop =
	locale === 'de'
		? 'https://www.shelly.com/de'
		: locale === 'it'
			? 'https://www.shelly.com/it'
			: locale === 'es'
				? 'https://www.shelly.com/es'
				: 'https://www.shelly.com/en';
const shellyUrl = `https://www.awin1.com/cread.php?awinmid=114660&awinaffid=3126073&ued=${encodeURIComponent(shellyShop)}`;
const priceNote = market === 'ca' ? c.caNote : market === 'uk' || locale === 'en' ? c.ukNote : c.priceNote;

const cards = PRODUCTS.map((p) => {
	const offer = amazonOffer(market, p.asin);
	const meta = c.cards[p.key];
	return {
		...meta,
		asin: p.asin,
		query: p.query,
		price: offer ? offer.label : CHECK_PRICE[locale],
		url: amazonDpUrl(p.asin, market),
		group: p.key === 'dongle' || p.key === 'sensor' ? 'home' : 'robot',
	};
});
const robotCards = cards.filter((card) => card.group === 'robot');
const homeCards = cards.filter((card) => card.group === 'home');

