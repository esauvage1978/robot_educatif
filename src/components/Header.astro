---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/siteUrl';
import HeaderLink from './HeaderLink.astro';
import logoA from '../assets/logo-a.svg';
---

<header>
	<nav>
		<a class="brand" href={withBase('/')}>
			<Image
				class="brand-logo"
				src={logoA}
				alt={SITE_TITLE}
				width={230}
				height={45}
				densities={[1, 2]}
				loading="eager"
				decoding="async"
			/>
		</a>
		<div class="internal-links desktop-only">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/meilleur-robot-programmable-enfant-2026/" class="highlight">Guides d'achat</HeaderLink>
			<HeaderLink href="/10-projets-mbot-gratuits-classe-faciles/">Projets mBot</HeaderLink>
			<HeaderLink href="/programmation/">Python</HeaderLink>
			<HeaderLink href="/blog/">Blog</HeaderLink>
		</div>
		<button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<path d="M3 12h18M3 6h18M3 18h18"/>
			</svg>
		</button>
	</nav>
	<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
		<a href={withBase('/')}>Accueil</a>
		<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="highlight">Guides d'achat</a>
		<a href={withBase('/10-projets-mbot-gratuits-classe-faciles/')}>Projets mBot</a>
		<a href={withBase('/programmation/')}>Python</a>
		<a href={withBase('/blog/')}>Blog</a>
		<a href={withBase('/partenariat/')}>Partenariat</a>
		<a href={withBase('/contact/')}>Contact</a>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 clamp(1rem, 5vw, 2rem);
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		box-shadow: 0 1px 3px rgba(11, 31, 42, 0.05);
		backdrop-filter: blur(10px);
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 1320px;
		margin: 0 auto;
	}
	
	.brand {
		display: flex;
		align-items: center;
		padding: 1rem 0;
		flex-shrink: 0;
		text-decoration: none;
	}
	
	.brand img {
		height: 45px;
		width: auto;
		max-width: min(230px, 55vw);
		display: block;
	}
	
	.internal-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}
	
	.internal-links :global(a) {
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		transition: color 0.2s ease;
		position: relative;
	}
	
	.internal-links :global(a:hover) {
		color: var(--primary);
	}
	
	.internal-links :global(a.highlight) {
		color: var(--primary);
		font-weight: 700;
	}
	
	.internal-links :global(a.active::after) {
		content: '';
		position: absolute;
		bottom: -0.5rem;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--accent-warm);
	}
	
	.mobile-menu-toggle {
		display: none;
		background: none;
		border: none;
		padding: 0.5rem;
		cursor: pointer;
		color: var(--ink);
	}
	
	.mobile-menu-toggle svg {
		width: 24px;
		height: 24px;
	}
	
	.mobile-menu {
		display: none;
		flex-direction: column;
		gap: 0;
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		max-width: 1320px;
		margin: 0 auto;
	}
	
	.mobile-menu[aria-hidden="false"] {
		display: flex;
	}
	
	.mobile-menu a {
		padding: 1rem clamp(1rem, 5vw, 2rem);
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1px solid var(--surface-border);
		transition: background 0.2s ease;
	}
	
	.mobile-menu a:hover,
	.mobile-menu a.highlight {
		background: var(--surface-2);
		color: var(--primary);
	}
	
	.mobile-menu a:last-child {
		border-bottom: none;
	}
	
	@media (max-width: 768px) {
		.desktop-only {
			display: none;
		}
		
		.mobile-menu-toggle {
			display: block;
		}
		
		.brand img {
			height: 40px;
			max-width: min(200px, 60vw);
		}
	}
</style>

<script>
	(() => {
		const button = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		
		if (!button || !menu) return;
		
		button.addEventListener('click', () => {
			const isOpen = menu.getAttribute('aria-hidden') === 'false';
			menu.setAttribute('aria-hidden', isOpen ? 'true' : 'false');
			button.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
			button.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
		});
		
		menu.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				menu.setAttribute('aria-hidden', 'true');
				button.setAttribute('aria-expanded', 'false');
				button.setAttribute('aria-label', 'Ouvrir le menu');
			});
		});
	})();
</script>
