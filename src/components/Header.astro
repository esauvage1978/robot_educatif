---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/siteUrl';
import HeaderLink from './HeaderLink.astro';
import NavGuides from './NavGuides.astro';
import Drapeau from './Drapeau.astro';
import logoA from '../assets/logo-a.svg';
import { findPair, OMIT_US_HREFLANG } from '../lib/i18n.mjs';
import { SMART_HOME_TOOL_PATHS } from '../lib/smartHomeToolPaths.mjs';
import {
	URL_CODES_ERREURS_DOMOTIQUE,
	URL_CONFIGURATEUR_DOMOTIQUE,
	URL_PIECES_SAV_DOMOTIQUE,
	URL_QUIZ_ROBOT_ENFANT,
} from '../lib/siteToolUrls.mjs';
import ChristmasBanner from './ChristmasBanner.astro';

const _p = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const isUk = _p === '/uk' || _p.startsWith('/uk/');
const isCa = _p === '/ca' || _p.startsWith('/ca/');
const isUs = _p === '/us' || _p.startsWith('/us/');
const isEn = (_p === '/en' || _p.startsWith('/en/')) && !isUk && !isCa && !isUs;
const isAnglo = isEn || isUk || isCa || isUs;
const pair = findPair(_p);
const frHref = pair && pair.fr ? pair.fr : '/';
const enHref = pair && pair.en ? pair.en : '/en/';
const geoFromEn = (loc: string) => {
	if (!enHref || enHref === '/en/') return `/${loc}/`;
	if (enHref.startsWith('/en/')) return enHref.replace(/^\/en\//, `/${loc}/`);
	return `/${loc}/`;
};
const ukHref = pair && pair.uk ? pair.uk : geoFromEn('uk');
const caHref = pair && pair.ca ? pair.ca : geoFromEn('ca');
const usHref = pair && pair.us ? pair.us : OMIT_US_HREFLANG ? enHref : geoFromEn('us');
const isDe = _p === '/de' || _p.startsWith('/de/');
const deHref = pair && pair.de ? pair.de : '/de/';
const isIt = _p === '/it' || _p.startsWith('/it/');
const isEs = _p === '/es' || _p.startsWith('/es/');
const itHref = pair && pair.it ? pair.it : '/it/';
const esHref = pair && pair.es ? pair.es : '/es/';
const isFr = !isAnglo && !isDe && !isIt && !isEs;

const homeHref = isAnglo ? (isUs ? '/us/' : isUk ? '/uk/' : isCa ? '/ca/' : '/en/') : isDe ? '/de/' : isIt ? '/it/' : isEs ? '/es/' : '/';

const navMainFr: [string, string][] = [
	['/10-projets-mbot-gratuits-classe-faciles/', 'mBot'],
	['/programmation/', 'Python'],
	['/blog/', 'Blog'],
];
const navMainEn: [string, string][] = [
	['/en/tutorials/', 'mBot'],
	['/en/arduino/', 'Python'],
	['/blog/', 'Blog'],
];
const navMainDe: [string, string][] = [
	['/de/anleitungen/', 'mBot'],
	['/de/arduino/', 'Python'],
	['/blog/', 'Blog'],
];
const navMainIt: [string, string][] = [
	['/it/installare-mblock-5-windows/', 'mBot'],
	['/it/kit-robot-arduino-per-bambini/', 'Python'],
	['/blog/', 'Blog'],
];
const navMainEs: [string, string][] = [
	['/marque-makeblock/', 'mBot'],
	['/es/kit-robot-arduino-para-ninos/', 'Python'],
	['/blog/', 'Blog'],
];
const navMain = isAnglo ? navMainEn : isDe ? navMainDe : isIt ? navMainIt : isEs ? navMainEs : navMainFr;
const baissesHref = isDe
	? '/de/preissenkungen/'
	: isIt
		? '/it/ribassi-prezzo/'
		: isEs
			? '/es/bajadas-de-precio/'
			: isCa
				? '/ca/price-drops/'
				: isUk
					? '/uk/price-drops/'
					: isAnglo
						? '/en/price-drops/'
						: '/baisses-de-prix/';
const baissesLib = isDe ? 'Preissenkungen' : isIt ? 'Ribassi di prezzo' : isEs ? 'Bajadas de precio' : isAnglo ? 'Price drops' : 'Baisses de prix';
const accHref = isDe ? '/de/zubehoer/' : isIt ? '/it/accessori/' : isEs ? '/es/accesorios/' : isCa ? '/ca/accessories/' : isUk ? '/uk/accessories/' : isAnglo ? '/en/accessories/' : '/accessoires/';
const accLib = isDe ? 'Zubehör' : isIt ? 'Accessori' : isEs ? 'Accesorios' : isAnglo ? 'Accessories' : 'Accessoires';
const bfHref = isDe
	? '/de/black-friday/'
	: isIt
		? '/it/black-friday/'
		: isEs
			? '/es/black-friday/'
			: isCa
				? '/ca/black-friday/'
				: isUk
					? '/uk/black-friday/'
					: isAnglo
						? '/en/black-friday/'
						: '/black-friday/';
const mobileExtra = isAnglo || isDe || isIt || isEs ? [] : [['/partenariat/', 'Partenariat'], ['/contact/', 'Contact']];

const outilsTrigger = isAnglo ? 'Tools' : isDe ? 'Werkzeuge' : isIt ? 'Strumenti' : isEs ? 'Herramientas' : 'Outils';

const outilsMenuFr: [string, string][] = [
	[URL_CONFIGURATEUR_DOMOTIQUE, '⚡ Configurateur Domotique'],
	[URL_CODES_ERREURS_DOMOTIQUE, '🔧 Codes erreurs'],
	[URL_PIECES_SAV_DOMOTIQUE, 'Pièces détachées & SAV'],
	[URL_QUIZ_ROBOT_ENFANT, 'Quel robot éducatif choisir ?'],
	['/configurateur-kit-robotique-classe/', 'Configurateur kit classe'],
	['/calculateur-budget-robot-classe/', 'Calculateur budget classe'],
	['/compatibilite-makeblock/', 'Compatibilité Makeblock mBot'],
	['/tableau-reglages-capteurs-mbot2-depannage/', 'Réglages capteurs mBot2'],
	['/mblock-depannage-codes-erreurs-mbot-arduino/', 'Dépannage mBlock & codes mBot'],
];
const outilsMenuEn: [string, string][] = [
	['/en/smart-home/', '⚡ Smart home tools'],
	[SMART_HOME_TOOL_PATHS.troubleshooting.en, '🔧 Error codes'],
	[SMART_HOME_TOOL_PATHS.spareParts.en, 'Spare parts & sensors'],
	[SMART_HOME_TOOL_PATHS.compatMatrix.en, 'Compatibility matrix'],
	['/en/best-programmable-robot-for-kids/', 'Robot buying guide'],
];
const outilsMenuDe: [string, string][] = [
	['/de/smart-home/', '⚡ Smart Home'],
	[SMART_HOME_TOOL_PATHS.troubleshooting.de, '🔧 Fehlercodes'],
	[SMART_HOME_TOOL_PATHS.spareParts.de, 'Ersatzteile & Sensoren'],
	[SMART_HOME_TOOL_PATHS.compatMatrix.de, 'Kompatibilitätsmatrix'],
	['/de/bester-programmierbarer-roboter-fuer-kinder/', 'Kaufberater Roboter'],
];
const outilsMenuIt: [string, string][] = [
	['/it/domotica/', '⚡ Domotica'],
	[SMART_HOME_TOOL_PATHS.troubleshooting.it, '🔧 Codici errore'],
	[SMART_HOME_TOOL_PATHS.spareParts.it, 'Ricambi e sensori'],
	[SMART_HOME_TOOL_PATHS.compatMatrix.it, 'Matrice compatibilità'],
	['/it/miglior-robot-programmabile-per-bambini/', 'Guida robot'],
];
const outilsMenuEs: [string, string][] = [
	['/es/domotica/', '⚡ Domótica'],
	[SMART_HOME_TOOL_PATHS.troubleshooting.es, '🔧 Códigos error'],
	[SMART_HOME_TOOL_PATHS.spareParts.es, 'Repuestos y sensores'],
	[SMART_HOME_TOOL_PATHS.compatMatrix.es, 'Matriz compatibilidad'],
	['/es/mejor-robot-programable-para-ninos/', 'Guía robots'],
];
const outilsMenu = isAnglo ? outilsMenuEn : isDe ? outilsMenuDe : isIt ? outilsMenuIt : isEs ? outilsMenuEs : outilsMenuFr;

const ctaConfigHref = isAnglo ? '/en/smart-home/' : isDe ? '/de/smart-home/' : isIt ? '/it/domotica/' : isEs ? '/es/domotica/' : URL_CONFIGURATEUR_DOMOTIQUE;
const ctaConfigLabel = isAnglo ? '⚡ Configurator' : isDe ? '⚡ Konfigurator' : isIt ? '⚡ Configuratore' : isEs ? '⚡ Configurador' : '⚡ Configurateur';

const langNavLabel = isAnglo ? 'Language' : isDe ? 'Sprache' : isIt ? 'Lingua' : isEs ? 'Idioma' : 'Langue';

type LangOption = {
	code: string;
	href: string;
	hreflang: string;
	lang: string;
	label: string;
	current: boolean;
};
const langOptions: LangOption[] = [
	{ code: 'FR', href: frHref, hreflang: 'fr', lang: 'fr', label: 'Français', current: isFr },
	{ code: 'EN', href: enHref, hreflang: 'en', lang: 'en', label: 'English', current: isEn },
	{ code: 'US', href: usHref, hreflang: 'en-us', lang: 'en-US', label: 'English (US)', current: isUs },
	{ code: 'UK', href: ukHref, hreflang: 'en-gb', lang: 'en-GB', label: 'English (UK)', current: isUk },
	{ code: 'CA', href: caHref, hreflang: 'en-ca', lang: 'en-CA', label: 'English (CA)', current: isCa },
	{ code: 'DE', href: deHref, hreflang: 'de', lang: 'de', label: 'Deutsch', current: isDe },
	{ code: 'IT', href: itHref, hreflang: 'it', lang: 'it', label: 'Italiano', current: isIt },
	{ code: 'ES', href: esHref, hreflang: 'es', lang: 'es', label: 'Español', current: isEs },
];
const activeLang = langOptions.find((l) => l.current) ?? langOptions[0];

const menuOpenLabel = isIt ? 'Apri il menu' : isEs ? 'Abrir el menú' : isDe ? 'Menü öffnen' : isAnglo ? 'Open menu' : 'Ouvrir le menu';
const menuCloseLabel = isIt ? 'Chiudi il menu' : isEs ? 'Cerrar el menú' : isDe ? 'Menü schließen' : isAnglo ? 'Close menu' : 'Fermer le menu';
---

<header class="site-header">
	<nav class="header-bar" aria-label={isAnglo ? 'Main' : isDe ? 'Hauptnavigation' : isIt ? 'Principale' : isEs ? 'Principal' : 'Principale'}>
		<a class="brand" href={withBase(homeHref)}>
			<Image
				class="brand-logo"
				src={logoA}
				alt={SITE_TITLE}
				width={230}
				height={45}
				densities={[1, 2]}
				loading="eager"
				decoding="async"
			/>
		</a>

		<div class="internal-links desktop-only">
			<HeaderLink class="nav-bf" href={bfHref}>Black Friday</HeaderLink>
			<HeaderLink href={baissesHref}>{baissesLib}</HeaderLink>
			<HeaderLink href={accHref}>{accLib}</HeaderLink>
			<NavGuides variant="desktop" />
			<NavGuides variant="desktop" menu="domotique" />
			{navMain.map(([href, label]) => (
				<HeaderLink href={href}>{label}</HeaderLink>
			))}
			<div class="header-dropdown nav-outils" data-header-dropdown>
				<button
					type="button"
					id="nav-outils-trigger"
					class="nav-dropdown__trigger"
					data-dropdown-trigger
					aria-expanded="false"
					aria-controls="nav-outils-panel"
					aria-haspopup="true"
				>
					{outilsTrigger}
					<span class="nav-dropdown__caret" aria-hidden="true">▾</span>
				</button>
				<div id="nav-outils-panel" class="nav-outils__panel" data-dropdown-panel hidden role="menu">
					{outilsMenu.map(([href, label]) => (
						<a href={withBase(href)} role="menuitem">{label}</a>
					))}
				</div>
			</div>
		</div>

		<div class="header-actions">
			<a class="header-cta desktop-only" href={withBase(ctaConfigHref)}>{ctaConfigLabel}</a>

			<div class="lang-dropdown header-dropdown" data-header-dropdown role="navigation" aria-label={langNavLabel}>
				<button
					type="button"
					id="lang-switch-btn"
					class="lang-dropdown__trigger"
					data-dropdown-trigger
					aria-expanded="false"
					aria-controls="lang-switch-menu"
					aria-haspopup="true"
					aria-label={activeLang.label}
				>
					<Drapeau code={activeLang.code} />
					<span class="nav-dropdown__caret" aria-hidden="true">▾</span>
				</button>
				<div id="lang-switch-menu" class="lang-dropdown__menu" data-dropdown-panel hidden role="menu">
					{langOptions.map((opt) => (
						<a
							href={withBase(opt.href)}
							hreflang={opt.hreflang}
							lang={opt.lang}
							role="menuitem"
							aria-current={opt.current ? 'true' : undefined}
							class:list={[{ 'is-current': opt.current }]}
						>
							<Drapeau code={opt.code} />{opt.label}
						</a>
					))}
				</div>
			</div>

			<button
				class="mobile-menu-toggle header-icon-btn"
				id="mobile-menu-toggle"
				type="button"
				aria-label={menuOpenLabel}
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<span aria-hidden="true">☰</span>
			</button>
		</div>
	</nav>

	<div class="mobile-menu" id="mobile-menu" hidden>
		<a class="nav-bf" href={withBase(bfHref)}>Black Friday</a>
		<a href={withBase(baissesHref)}>{baissesLib}</a>
		<a href={withBase(accHref)}>{accLib}</a>
		<a class="mobile-menu-cta" href={withBase(ctaConfigHref)}>{ctaConfigLabel}</a>
		<NavGuides variant="mobile" />
		<NavGuides variant="mobile" menu="domotique" />
		{navMain.map(([href, label]) => (
			<a href={withBase(href)}>{label}</a>
		))}
		<div class="mobile-menu-section">
			<p class="mobile-menu-section__title">{outilsTrigger}</p>
			{outilsMenu.map(([href, label]) => (
				<a href={withBase(href)}>{label}</a>
			))}
		</div>
		{mobileExtra.map(([href, label]) => (
			<a href={withBase(href)}>{label}</a>
		))}
	</div>
</header>
<ChristmasBanner />

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 clamp(0.875rem, 3vw, 1.5rem);
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		box-shadow: 0 1px 3px rgba(11, 31, 42, 0.05);
		backdrop-filter: blur(10px);
	}

	.header-bar {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		max-width: 1280px;
		margin: 0 auto;
		min-height: 64px;
		min-width: 0;
	}

	.brand {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		text-decoration: none;
		padding: 0.35rem 0;
	}

	.brand :global(img) {
		height: 30px;
		width: auto;
		max-width: min(180px, 42vw);
		display: block;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		min-width: 0;
		flex: 1 1 auto;
		margin-left: 0.35rem;
	}

	.internal-links :global(a),
	.nav-dropdown__trigger {
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
		padding: 0.35rem 0.55rem;
		border-radius: 8px;
		white-space: nowrap;
	}

	.internal-links :global(a:hover),
	.nav-dropdown__trigger:hover,
	.nav-dropdown__trigger[aria-expanded='true'] {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.internal-links :global(a.active) {
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		color: var(--primary);
	}

	.internal-links :global(a.nav-bf) {
		background: #111827;
		color: #ffb020 !important;
		border-radius: 999px;
		font-weight: 800;
		margin-right: 0.35rem;
	}

	.internal-links :global(a.nav-bf:hover),
	.internal-links :global(a.nav-bf.active) {
		background: #1f2937;
		color: #ffe08a !important;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		background: var(--primary);
		color: #fff !important;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.8125rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.header-cta:hover {
		background: var(--primary-light);
		color: #fff !important;
	}

	.header-cta:focus-visible {
		outline: 2px solid var(--accent-warm);
		outline-offset: 2px;
	}

	.header-icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--surface-border);
		border-radius: 50%;
		background: var(--surface);
		cursor: pointer;
		color: var(--ink);
		padding: 0;
		flex-shrink: 0;
		font-size: 1.05rem;
		line-height: 1;
	}

	.header-icon-btn:focus-visible,
	.nav-dropdown__trigger:focus-visible,
	.lang-dropdown__trigger:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	.nav-dropdown__trigger {
		border: none;
		background: transparent;
		cursor: pointer;
		font-family: inherit;
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
	}

	.nav-dropdown__caret {
		font-size: 0.65rem;
		opacity: 0.85;
	}

	.nav-outils {
		position: relative;
	}

	.nav-outils__panel[hidden] {
		display: none !important;
	}
	.nav-outils__panel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		min-width: 260px;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
		padding: 0.35rem;
		z-index: 120;
	}

	.nav-outils__panel a {
		display: block;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.875rem;
	}

	.nav-outils__panel a:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.nav-outils__panel a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

	.lang-dropdown {
		position: relative;
	}

	.lang-dropdown__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 1px solid var(--surface-border);
		background: var(--surface);
		border-radius: 999px;
		padding: 0.35rem 0.65rem;
		font-weight: 700;
		font-size: 0.8125rem;
		color: var(--primary);
		cursor: pointer;
		font-family: inherit;
		white-space: nowrap;
	}

	.lang-dropdown__menu[hidden] {
		display: none !important;
	}
	.lang-dropdown__menu {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		min-width: 190px;
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
		padding: 0.35rem;
		z-index: 130;
	}

	.lang-dropdown__menu a {
		display: flex;
		align-items: center;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		text-decoration: none;
		color: var(--ink);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.lang-dropdown__menu a:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
	}

	.lang-dropdown__menu a.is-current,
	.lang-dropdown__menu a[aria-current='true'] {
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		color: var(--primary);
		font-weight: 700;
	}

	.lang-dropdown__menu a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

	.mobile-menu-toggle {
		display: none;
	}

	.mobile-menu {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border-bottom: 1px solid var(--surface-border);
		max-width: 1280px;
		margin: 0 auto;
	}

	.mobile-menu[hidden] {
		display: none !important;
	}

	.mobile-menu a {
		padding: 0.85rem clamp(0.875rem, 3vw, 1.5rem);
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1px solid var(--surface-border);
	}

	.mobile-menu a:hover {
		background: var(--surface-2);
		color: var(--primary);
	}

	.mobile-menu a.nav-bf {
		margin: 0.65rem clamp(0.875rem, 3vw, 1.5rem) 0.15rem;
		padding: 0.55rem 0.9rem;
		width: fit-content;
		border-radius: 999px;
		background: #111827;
		color: #ffb020 !important;
		font-weight: 800;
		border-bottom: none;
	}

	.mobile-menu a.nav-bf:hover {
		background: #1f2937;
		color: #ffe08a !important;
	}

	.mobile-menu-cta {
		background: color-mix(in oklab, var(--primary) 10%, var(--surface)) !important;
		color: var(--primary) !important;
		font-weight: 700 !important;
	}

	.mobile-menu-section__title {
		margin: 0;
		padding: 0.65rem clamp(0.875rem, 3vw, 1.5rem) 0.25rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 768px) {
		.desktop-only {
			display: none !important;
		}

		.mobile-menu-toggle {
			display: inline-flex;
		}

		.brand :global(img) {
			height: 24px;
			max-width: min(130px, 34vw);
		}

		.header-bar {
			gap: 0.35rem;
		}

		.lang-dropdown__trigger {
			padding: 0.3rem 0.5rem;
			font-size: 0.75rem;
		}
	}

	@media (min-width: 769px) and (max-width: 1320px) {
		:global(html[lang='de']) .internal-links :global(a),
		:global(html[lang='de']) .nav-dropdown__trigger {
			font-size: 0.82rem;
			padding-inline: 0.4rem;
		}
		:global(html[lang='de']) .header-cta {
			font-size: 0.75rem;
			padding-inline: 0.65rem;
		}
	}
</style>

<script>
	(() => {
		const dropdowns = Array.from(document.querySelectorAll('[data-header-dropdown]'));

		function focusables(panel: Element) {
			return Array.from(
				panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
			).filter((el) => !el.closest('[hidden]'));
		}

		function closeDropdown(wrapper: Element) {
			const trigger = wrapper.querySelector<HTMLElement>('[data-dropdown-trigger]');
			const panel = wrapper.querySelector<HTMLElement>('[data-dropdown-panel]');
			if (!trigger || !panel) return;
			panel.hidden = true;
			trigger.setAttribute('aria-expanded', 'false');
		}

		function openDropdown(wrapper: Element) {
			dropdowns.forEach((d) => {
				if (d !== wrapper) closeDropdown(d);
			});
			const trigger = wrapper.querySelector<HTMLElement>('[data-dropdown-trigger]');
			const panel = wrapper.querySelector<HTMLElement>('[data-dropdown-panel]');
			if (!trigger || !panel) return;
			panel.hidden = false;
			trigger.setAttribute('aria-expanded', 'true');
		}

		dropdowns.forEach((wrapper) => {
			const trigger = wrapper.querySelector<HTMLElement>('[data-dropdown-trigger]');
			const panel = wrapper.querySelector<HTMLElement>('[data-dropdown-panel]');
			if (!trigger || !panel) return;

			const toggle = () => {
				if (panel.hidden) openDropdown(wrapper);
				else closeDropdown(wrapper);
			};

			trigger.addEventListener('click', toggle);

			trigger.addEventListener('keydown', (e) => {
				const ev = e as KeyboardEvent;
				if (ev.key === 'Enter' || ev.key === ' ') {
					ev.preventDefault();
					toggle();
				}
				if (ev.key === 'ArrowDown' && panel.hidden) {
					ev.preventDefault();
					openDropdown(wrapper);
					focusables(panel)[0]?.focus();
				}
			});

			panel.addEventListener('keydown', (e) => {
				const ev = e as KeyboardEvent;
				const items = focusables(panel);
				const idx = items.indexOf(document.activeElement as HTMLElement);
				if (ev.key === 'Escape') {
					ev.preventDefault();
					closeDropdown(wrapper);
					trigger.focus();
				}
				if (ev.key === 'ArrowDown') {
					ev.preventDefault();
					items[(idx + 1 + items.length) % items.length]?.focus();
				}
				if (ev.key === 'ArrowUp') {
					ev.preventDefault();
					items[(idx - 1 + items.length) % items.length]?.focus();
				}
			});

			trigger.addEventListener('keydown', (e) => {
				const ev = e as KeyboardEvent;
				if (ev.key === 'Escape' && !panel.hidden) {
					ev.preventDefault();
					closeDropdown(wrapper);
					trigger.focus();
				}
			});
		});

		document.addEventListener('click', (e) => {
			const t = e.target as Node;
			dropdowns.forEach((wrapper) => {
				if (!wrapper.contains(t)) closeDropdown(wrapper);
			});
		});

		const button = document.getElementById('mobile-menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (button && menu) {
			const openLabel = button.getAttribute('aria-label') || 'Menu';
			const closeLabels: Record<string, [string, string]> = {
				en: ['Open menu', 'Close menu'],
				de: ['Menü öffnen', 'Menü schließen'],
				it: ['Apri il menu', 'Chiudi il menu'],
				es: ['Abrir el menú', 'Cerrar el menú'],
			};
			const lang = document.documentElement.lang || 'fr';
			const pair = closeLabels[lang] || ['Ouvrir le menu', 'Fermer le menu'];

			button.addEventListener('click', () => {
				const isOpen = !menu.hidden;
				menu.hidden = isOpen;
				button.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
				button.setAttribute('aria-label', isOpen ? pair[0] : pair[1]);
			});

			menu.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', () => {
					menu.hidden = true;
					button.setAttribute('aria-expanded', 'false');
					button.setAttribute('aria-label', pair[0]);
				});
			});
		}
	})();
</script>
