---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, PINTEREST_ENABLED, PINTEREST_DOMAIN_VERIFY, ARTICLE_AUTHOR } from '../consts';
import { withBase } from '../lib/siteUrl';
import GoogleConsentDefault from './GoogleConsentDefault.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Préchargement image LCP (ex. hero accueil) — URL absolue ou chemin /public */
	preloadLcpImage?: string;
	/** Ne pas indexer (pages internes, brouillons, etc.) */
	noIndex?: boolean;
	/** Type Open Graph (article | website) */
	ogType?: 'article' | 'website';
	/** Date de publication (articles) */
	pubDate?: Date;
	/** Date de mise à jour (articles) */
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage, preloadLcpImage, noIndex = false, ogType = 'website', pubDate, updatedDate } = Astro.props;
const ogImageUrl = new URL(image.src, Astro.site).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<GoogleConsentDefault />
{preloadLcpImage && (
	<link rel="preload" as="image" href={preloadLcpImage} type="image/webp" fetchpriority="high" />
)}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon-a.svg')} sizes="any" />
<link rel="icon" type="image/png" href={withBase('/favicon-a-512.png')} sizes="512x512" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={withBase('/rss.xml')}
/>
<meta name="generator" content={Astro.generator} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Font preloads (Nunito + Nunito Sans auto-hébergés) -->
<link rel="preload" href={withBase('/fonts/nunito-800-0.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={withBase('/fonts/nunito-sans-400-0.woff2')} as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
{ogType === 'article' && pubDate && (
	<>
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Pinterest -->
{PINTEREST_ENABLED && (
	<>
		<meta name="pinterest-rich-pin" content="true" />
		{PINTEREST_DOMAIN_VERIFY && <meta name="p:domain_verify" content={PINTEREST_DOMAIN_VERIFY} />}
		{ogType === 'article' && (
			<>
				<meta property="article:author" content={ARTICLE_AUTHOR} />
				<meta property="og:image:width" content="1200" />
				<meta property="og:image:height" content="630" />
			</>
		)}
	</>
)}

<!-- Theme initialization (respects prefers-color-scheme by default) -->
<script is:inline>
	(() => {
		const stored = localStorage.getItem('robot-educatif-theme');
		const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		document.documentElement.dataset.theme = theme;
	})();
</script>
