---
// Feuilles globales : import ?inline pour garantir le bloc <style is:global> sur
// toutes les pages (dont src/pages/**/*.md + layouts *Post.astro).
import globalCss from '../styles/global.css?inline';
import darkMobileFix from '../styles/dark-mobile-surfaces-fix.css?inline';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, PINTEREST_ENABLED, PINTEREST_DOMAIN_VERIFY, ARTICLE_AUTHOR } from '../consts';
import { withBase } from '../lib/siteUrl';
import GoogleConsentDefault from './GoogleConsentDefault.astro';
import { expandLangPair, findPair, OMIT_US_HREFLANG } from '../lib/i18n.mjs';
import { ensureMetaDescription } from '../lib/metaDescription';
import { fitPageTitle } from '../lib/pageTitle';

const HREFLANG_CODES = {
	fr: 'fr',
	en: 'en',
	us: 'en-US',
	uk: 'en-GB',
	ca: 'en-CA',
	de: 'de',
	it: 'it',
	es: 'es',
	nl: 'nl',
};

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** Préchargement image LCP (ex. hero accueil) — URL absolue ou chemin /public */
	preloadLcpImage?: string;
	/** Ne pas indexer (pages internes, brouillons, etc.) */
	noIndex?: boolean;
	/** Type Open Graph (article | website) */
	ogType?: 'article' | 'website';
	/** Date de publication (articles) */
	pubDate?: Date;
	/** Date de mise à jour (articles) */
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title: rawTitle, description: rawDescription, image = FallbackImage, preloadLcpImage, noIndex = false, ogType = 'website', pubDate, updatedDate } = Astro.props;
const title = fitPageTitle(rawTitle);
const description = ensureMetaDescription(rawDescription, { title: rawTitle, pathname: Astro.url.pathname });
// Handle both ImageMetadata objects and plain string paths
const imagePath = typeof image === 'string' ? image : (image?.src || FallbackImage.src);
const ogImageUrl = new URL(imagePath, Astro.site).toString();
const isIllustration = imagePath.includes('/images/illustrations/');
const ogW = isIllustration ? '960' : '1200';
const ogH = isIllustration ? '540' : '630';
const _p = Astro.url.pathname.replace(/^\/site_vitrine\/robot_educatif/, '');
const langPair = expandLangPair(findPair(_p));
const isUk = _p === '/uk' || _p.startsWith('/uk/');
const isCa = _p === '/ca' || _p.startsWith('/ca/');
const isUs = _p === '/us' || _p.startsWith('/us/');
const isEn = (_p === '/en' || _p.startsWith('/en/')) && !isUk && !isCa && !isUs;
const isDe = _p === '/de' || _p.startsWith('/de/');
const isIt = _p === '/it/' || _p.startsWith('/it/');
const isEs = _p === '/es/' || _p.startsWith('/es/');
const isNl = _p === '/nl' || _p.startsWith('/nl/');
const xDefault = langPair ? (langPair.fr || langPair.en || langPair.it) : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="color-scheme" content="light" />
<style is:global set:html={globalCss + darkMobileFix} />
<GoogleConsentDefault />
{preloadLcpImage && (
	<link rel="preload" as="image" href={preloadLcpImage} type="image/webp" fetchpriority="high" />
)}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon-a.svg')} sizes="any" />
<link rel="icon" type="image/png" href={withBase('/favicon-a-512.png')} sizes="512x512" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={withBase('/rss.xml')}
/>
<meta name="generator" content={Astro.generator} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Font preloads (Nunito + Nunito Sans auto-hébergés) -->
<link rel="preload" href={withBase('/fonts/nunito-800-0.woff2')} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={withBase('/fonts/nunito-sans-400-0.woff2')} as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{langPair && (
	<>
		{Object.entries(HREFLANG_CODES).map(([loc, code]) =>
			langPair[loc] && !(OMIT_US_HREFLANG && loc === 'us') ? (
				<link rel="alternate" hreflang={code} href={new URL(langPair[loc], Astro.site).toString()} />
			) : null,
		)}
		<link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site).toString()} />
	</>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={isUk ? "en_GB" : isCa ? "en_CA" : isEn || isUs ? "en_US" : isDe ? "de_DE" : isIt ? "it_IT" : isEs ? "es_ES" : isNl ? "nl_NL" : "fr_FR"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
{ogType === 'article' && pubDate && (
	<>
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Pinterest -->
{PINTEREST_ENABLED && (
	<>
		<meta name="pinterest-rich-pin" content="true" />
		{PINTEREST_DOMAIN_VERIFY && <meta name="p:domain_verify" content={PINTEREST_DOMAIN_VERIFY} />}
		{ogType === 'article' && (
			<>
				<meta property="article:author" content={ARTICLE_AUTHOR} />
				<meta property="og:image:width" content={ogW} />
				<meta property="og:image:height" content={ogH} />
			</>
		)}
	</>
)}

<script is:inline>
	document.documentElement.dataset.theme = 'light';
	document.documentElement.style.colorScheme = 'light';
	try { localStorage.removeItem('robot-educatif-theme'); } catch (e) {}
</script>
