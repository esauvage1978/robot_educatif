---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/siteUrl';
import GoogleConsentDefault from './GoogleConsentDefault.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Préchargement image LCP (ex. hero accueil) — URL absolue ou chemin /public */
	preloadLcpImage?: string;
	/** Ne pas indexer (pages internes, brouillons, etc.) */
	noIndex?: boolean;
	/** Type Open Graph (article | website) */
	ogType?: 'article' | 'website';
	/** Date de publication (articles) */
	pubDate?: Date;
	/** Date de mise à jour (articles) */
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image = FallbackImage, preloadLcpImage, noIndex = false, ogType = 'website', pubDate, updatedDate } = Astro.props;
const ogImageUrl = new URL(image.src, Astro.site).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<GoogleConsentDefault />
{preloadLcpImage && (
	<link rel="preload" as="image" href={preloadLcpImage} type="image/webp" fetchpriority="high" />
)}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} sizes="any" />
<link rel="icon" type="image/png" href={withBase('/favicon.png')} sizes="32x32" />
<link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" type="image/x-icon" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={withBase('/rss.xml')}
/>
<meta name="generator" content={Astro.generator} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<!-- Typographie : chargement non bloquant (évite de retarder FCP/LCP) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	is:inline
	href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
	rel="stylesheet"
	media="print"
	onload="this.media='all'"
/>
<noscript>
	<link
		rel="stylesheet"
		href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
	/>
</noscript>
<!-- Font preloads (withBase : chemin absolu depuis la racine du site, cf. page 404 servie sous une autre URL) -->
<link rel="preload" href={withBase('/fonts/atkinson-regular.woff')} as="font" type="font/woff" crossorigin />
<link rel="preload" href={withBase('/fonts/atkinson-bold.woff')} as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
{ogType === 'article' && pubDate && (
	<>
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
	</>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Theme initialization (évite un flash) -->
<script is:inline>
	(() => {
		const key = 'robot-educatif-theme';
		const saved = window.localStorage.getItem(key);
		const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
		const theme = saved || (prefersLight ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme;
	})();
</script>
