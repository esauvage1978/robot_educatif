---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import DomotiqueSubNav from './DomotiqueSubNav.astro';
import { withBase } from '../lib/siteUrl';
import { DOMOTIQUE_RUB, DOMOTIQUE_HUB } from '../lib/domotiqueI18n.mjs';
import { EN_PAGES, DE_PAGES } from '../lib/i18n.mjs';
import { withImageVersion } from '../lib/imageVersion';

interface Props { lang: 'en' | 'de' | 'it' | 'es' }
const { lang } = Astro.props;
const hub = (DOMOTIQUE_HUB as Record<string, string>)[lang];
const TXT = {
	en: {
		title: 'Smart home guides: Home Assistant, Zigbee, ESP32 and robot vacuums',
		description: 'Practical smart home guides for UK and US homes: getting started, Home Assistant, Zigbee, ESP32 projects, buying guides and robot vacuums, plus our Homey Pro mini review.',
		h1: 'The smart home, for families and makers',
		lead: 'Home Assistant on a Raspberry Pi, Zigbee sensors, ESP32 projects and robot vacuums: understand it, build it, buy wisely. Where plugs, mains voltage or certification differ in the UK and US, we say so.',
		rubs: 'Browse by topic', all: 'All smart home guides', extra: [] as [string, string][],
	},
	de: {
		title: 'Smart-Home-Ratgeber: Home Assistant, Zigbee, ESP32 und Saugroboter',
		description: 'Praktische Smart-Home-Ratgeber für Deutschland, Österreich und die Schweiz: Einstieg, Home Assistant, Zigbee, ESP32-Projekte, Kaufberatung und Saugroboter, dazu unser Test des Homey Pro mini.',
		h1: 'Smart Home für Familien und Bastler',
		lead: 'Home Assistant auf dem Raspberry Pi, Zigbee-Sensoren, ESP32-Projekte und Saugroboter: verstehen, selbst bauen, gut einkaufen. Arbeiten an der festen Elektroinstallation gehören in die Hände einer Elektrofachkraft.',
		rubs: 'Nach Thema stöbern', all: 'Alle Smart-Home-Ratgeber', extra: [] as [string, string][],
	},
	it: {
		title: 'Domotica: guide a Home Assistant, Zigbee, ESP32 e robot aspirapolvere',
		description: 'Guide pratiche alla domotica: come iniziare, Home Assistant, Zigbee, progetti ESP32, guide all\'acquisto e robot aspirapolvere, con il nostro test dell\'Homey Pro mini.',
		h1: 'La casa smart, per famiglie e maker',
		lead: 'Home Assistant su Raspberry Pi, sensori Zigbee, progetti ESP32 e robot aspirapolvere: capire, costruire, comprare bene. Per i lavori sull\'impianto elettrico fisso rivolgetevi a un elettricista abilitato.',
		rubs: 'Sfoglia per argomento', all: 'Tutte le guide di domotica', extra: [['/it/shelly-gen4-quale-modulo-scegliere/', 'Shelly Gen4: quale modulo scegliere']] as [string, string][],
	},
	es: {
		title: 'Domótica: guías de Home Assistant, Zigbee, ESP32 y robots aspiradores',
		description: 'Guías prácticas de domótica: por dónde empezar, Home Assistant, Zigbee, proyectos ESP32, guías de compra y robots aspiradores, con nuestra prueba del Homey Pro mini.',
		h1: 'El hogar conectado, para familias y makers',
		lead: 'Home Assistant en una Raspberry Pi, sensores Zigbee, proyectos ESP32 y robots aspiradores: entenderlo, montarlo y comprar bien. Los trabajos en la instalación eléctrica fija, mejor con un instalador autorizado.',
		rubs: 'Explorar por tema', all: 'Todas las guías de domótica', extra: [['/es/shelly-gen4-que-modulo-elegir/', 'Shelly Gen4: qué módulo elegir']] as [string, string][],
	},
}[lang];
const posts = (await getCollection('domotiqueI18n')).filter((e) => e.data.lang === lang)
	.sort((a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99) || a.data.title.localeCompare(b.data.title, lang));
const statics = (lang === 'en' ? EN_PAGES : lang === 'de' ? DE_PAGES : []).filter((p: any) => p.href.startsWith(hub) && p.href !== hub);
const items = [
	...posts.map((p) => ({ href: hub + p.id.replace(/^\w\w\//, '') + '/', title: p.data.title, description: p.data.description })),
	...statics.map((p: any) => ({ href: p.href, title: p.title, description: '' })),
	...TXT.extra.map(([href, title]) => ({ href, title, description: '' })),
];
const ogImage = withImageVersion('/images/blog-thumbnails/domotique-hub.png');
---
<!doctype html>
<html lang={lang}>
<head>
	<BaseHead title={TXT.title} description={TXT.description} image={ogImage} />
	<style>
		.hero-domotique { background: linear-gradient(135deg, #0B1F2A 0%, #0F766E 100%); color: white; padding: 3rem 1.25rem; text-align: center; }
		.hero-domotique h1 { font-size: clamp(1.7rem, 5vw, 2.5rem); margin: 0 0 1rem; color: white; }
		.hero-domotique p { font-size: 1.1rem; max-width: 800px; margin: 0 auto; }
		.section { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem; box-sizing: border-box; }
		.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
		.card { border: 1px solid var(--surface-border, #e2e8f0); border-radius: 12px; padding: 1rem 1.1rem; background: var(--surface, #fff); }
		.card a { font-weight: 700; }
		.all-guides { list-style: none; padding: 0; display: grid; gap: 0.9rem; }
		.all-guides li { border-bottom: 1px solid var(--surface-border, #e2e8f0); padding-bottom: 0.8rem; }
		.all-guides a { font-weight: 700; }
		.all-guides p { margin: 0.25rem 0 0; color: rgb(var(--gray-dark)); font-size: 0.95rem; }
	</style>
</head>
<body>
	<Header />
	<DomotiqueSubNav lang={lang} />
	<main>
		<section class="hero-domotique">
			<h1>{TXT.h1}</h1>
			<p>{TXT.lead}</p>
		</section>
		<section class="section">
			<h2>{TXT.rubs}</h2>
			<div class="cards-grid">
				{Object.values(DOMOTIQUE_RUB).map((r: any) => (
					<div class="card"><a href={withBase(r[lang])}>{r.label[lang]}</a></div>
				))}
			</div>
		</section>
		<section class="section">
			<h2>{TXT.all}</h2>
			<ul class="all-guides">
				{items.map((it) => (
					<li><a href={withBase(it.href)}>{it.title}</a>{it.description && <p>{it.description}</p>}</li>
				))}
			</ul>
		</section>
	</main>
	<Footer />
</body>
</html>
