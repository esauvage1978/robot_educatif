---
/** Drapeau dessiné : les emojis s’affichent en deux lettres sur Windows. */
interface Props { code: string }
const key = Astro.props.code.toLowerCase();
const pays =
	key === 'us' || key === 'en-us' ? 'us'
	: key === 'ca' || key === 'en-ca' ? 'ca'
	: key === 'nl' ? 'nl'
	: key === 'de' ? 'de'
	: key === 'it' ? 'it'
	: key === 'es' ? 'es'
	: key === 'fr' ? 'fr'
	: 'gb';
---
<span class="drapeau" data-pays={pays} aria-hidden="true">
  {pays === 'fr' && (
    <svg viewBox="0 0 18 12"><rect width="6" height="12" fill="#0055a4"/><rect x="6" width="6" height="12" fill="#fff"/><rect x="12" width="6" height="12" fill="#ef4135"/></svg>
  )}
  {pays === 'de' && (
    <svg viewBox="0 0 18 12"><rect width="18" height="4" fill="#000"/><rect y="4" width="18" height="4" fill="#dd0000"/><rect y="8" width="18" height="4" fill="#ffce00"/></svg>
  )}
  {pays === 'it' && (
    <svg viewBox="0 0 18 12"><rect width="6" height="12" fill="#009246"/><rect x="6" width="6" height="12" fill="#fff"/><rect x="12" width="6" height="12" fill="#ce2b37"/></svg>
  )}
  {pays === 'es' && (
    <svg viewBox="0 0 18 12"><rect width="18" height="12" fill="#c60b1e"/><rect y="3" width="18" height="6" fill="#ffc400"/></svg>
  )}
  {pays === 'nl' && (
    <svg viewBox="0 0 18 12"><rect width="18" height="4" fill="#ae1c28"/><rect y="4" width="18" height="4" fill="#fff"/><rect y="8" width="18" height="4" fill="#21468b"/></svg>
  )}
