<style>
  .drapeau {
    display: inline-block;
    width: 18px;
    height: 12px;
    margin-right: .4rem;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / .18);
