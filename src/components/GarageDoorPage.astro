<script>
	function gdSituation(eco) {
		if (eco === 'maker-esp32') return 'b';
		if (eco === 'wifi-sans-box') return 'c';
		return 'a';
	}

	function gdSummary(eco, tech, qty) {
		const q =
			qty === '2'
				? 'deux portes'
				: qty === '3-5'
					? 'le palier 3 à 5 portes'
					: qty === '6+'
						? 'le palier 6 portes ou plus'
						: 'une porte';
		const variante =
			tech === 'dry-only'
				? ' Variante contact sec seul : aucun 230 V sur l’entrée de la motorisation.'
				: ' Variante contact sec : la notice montre le bornier du bouton poussoir.';
		if (eco === 'wifi-sans-box') {
			return (
				'Situation C, profil Économique, ' +
				q +
				'.' +
				variante +
				' L’application Shelly envoie l’impulsion. Home Assistant et le capteur d’état ne sont pas dans la liste.'
			);
		}
		if (eco === 'maker-esp32') {
			return (
				'Situation B, profil Évolutif, ' +
				q +
				'.' +
				variante +
				' La liste montre la carte ESP32. Le relais à contact sec et le reed filaire sont dans le tutoriel ESPHome. Home Assistant n’est pas ajouté.'
			);
		}
		return (
			'Situation A, profil Recommandé, ' +
			q +
			'.' +
			variante +
			' Home Assistant est supposé déjà en place. Le Shelly est en Wi-Fi. Le capteur d’ouverture est en Zigbee, si l’écart mesure 20 mm ou moins. Le coordinateur ne s’achète que s’il n’y en a pas déjà un.'
		);
	}

	function gdApply(detail) {
		const params = new URLSearchParams(window.location.search);
		const eco = detail?.ecosystem || params.get('eco') || 'ha-zigbee';
		const tech = detail?.techId || params.get('tech') || 'contact-sec';
		const qty = detail?.qtyId || params.get('qty') || '1';
		const summary = document.querySelector('[data-gd-summary]');
		if (summary) summary.textContent = gdSummary(eco, tech, qty);
		const current = gdSituation(eco);
		document.querySelectorAll('[data-gd-situation]').forEach((node) => {
			node.classList.toggle('is-current', node.getAttribute('data-gd-situation') === current);
		});
	}

	document.addEventListener('shpp-config-change', (event) => {
		gdApply(event.detail);
	});
	gdApply();
</script>

