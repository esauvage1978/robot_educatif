---
import { withBase } from '../lib/siteUrl';
import {
	URL_CODES_ERREURS_DOMOTIQUE,
	URL_CONFIGURATEUR_DOMOTIQUE,
} from '../lib/siteToolUrls.mjs';

interface Props {
	variant: 'to-troubleshooting' | 'to-configurator';
}

const { variant } = Astro.props;

const isToTroubleshooting = variant === 'to-troubleshooting';
const href = withBase(isToTroubleshooting ? URL_CODES_ERREURS_DOMOTIQUE : URL_CONFIGURATEUR_DOMOTIQUE);
const ctaLabel = isToTroubleshooting ? 'Ouvrir le diagnostic' : 'Ouvrir le configurateur';
const emoji = isToTroubleshooting ? '🔧' : '⚡';
---

<aside class="tool-resolution-banner" aria-label="Outil complémentaire">
	<p>
		<span class="tool-resolution-banner__emoji" aria-hidden="true">{emoji}</span>
		{isToTroubleshooting ? 'Une panne ou un code erreur ?' : 'Besoin de dimensionner votre installation ?'}
	</p>
	<a class="tool-resolution-banner__cta" href={href}>{ctaLabel}</a>
</aside>

<style>
	.tool-resolution-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		margin: 0 0 1.5rem;
		padding: 1rem 1.15rem;
		border-radius: 14px;
		border: 1px solid color-mix(in oklab, var(--primary) 35%, var(--surface-border));
		background: color-mix(in oklab, var(--primary) 8%, var(--surface-2));
	}
	.tool-resolution-banner p {
		margin: 0;
		font-weight: 600;
		color: rgb(var(--black));
		font-size: 0.98rem;
	}
	.tool-resolution-banner__emoji {
		margin-right: 0.35rem;
	}
	.tool-resolution-banner__cta {
		display: inline-flex;
		align-items: center;
		padding: 0.55rem 1rem;
		border-radius: 10px;
		background: var(--primary);
		color: #fff;
		font-weight: 700;
		font-size: 0.92rem;
		text-decoration: none;
		white-space: nowrap;
		transition: background 0.15s ease, transform 0.15s ease;
	}
	.tool-resolution-banner__cta:hover {
		background: color-mix(in oklab, var(--primary) 85%, #000);
		transform: translateY(-1px);
	}
</style>
