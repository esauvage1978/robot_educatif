---
import BaseHead from '../components/BaseHead.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, CONTACT_FORM_WEBHOOK_URL } from '../consts';
import { withBase } from '../lib/siteUrl';

const mailtoHref = `mailto:${CONTACT_EMAIL}`;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Contact"
			description="Écrire à ROBOT éducatif : formulaire ou courriel contact@robot-educatif.info."
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="contact-page">
				<h1>Contact</h1>
				<p class="contact-lead">
					Une question sur la robotique éducative, Scratch ou mBlock ? Utilisez le formulaire ci-dessous ou
					écrivez directement à
					<a href={mailtoHref}>{CONTACT_EMAIL}</a>.
				</p>

				<section class="contact-card" aria-labelledby="contact-form-title">
					<h2 id="contact-form-title">Envoyer un message</h2>
					<p class="contact-hint">
						Les champs marqués d’un astérisque (<span class="req" aria-hidden="true">*</span>) sont obligatoires.
						Vos données sont traitées pour répondre à votre demande, conformément à notre politique de confidentialité.
					</p>

					<form id="contact-form" class="contact-form" novalidate>
						<input type="hidden" name="source" id="contact-source" value="robot-educatif" />
						<div class="field">
							<label for="contact-name">Nom ou pseudo <span class="req" aria-hidden="true">*</span></label>
							<input
								id="contact-name"
								name="name"
								type="text"
								autocomplete="name"
								required
								maxlength="120"
							/>
						</div>
						<div class="field">
							<label for="contact-email">Adresse e-mail <span class="req" aria-hidden="true">*</span></label>
							<input
								id="contact-email"
								name="email"
								type="email"
								autocomplete="email"
								required
								maxlength="254"
							/>
						</div>
						<div class="field">
							<label for="contact-company">Société <span class="optional-hint">(facultatif)</span></label>
							<input
								id="contact-company"
								name="company"
								type="text"
								autocomplete="organization"
								maxlength="200"
							/>
						</div>
						<div class="field">
							<label for="contact-objet">Objet <span class="req" aria-hidden="true">*</span></label>
							<select id="contact-objet" name="objet" required autocomplete="off">
								<option value="">Choisir un thème…</option>
								<option value="general">Question générale</option>
								<option value="mbot-mblock">mBot / mBot 2 / matériel Makeblock</option>
								<option value="mblock-scratch">mBlock, Scratch et programmation par blocs</option>
								<option value="programmation">Programmation (Python, C/Arduino, parcours du site)</option>
								<option value="raspberry-pi">Raspberry Pi</option>
								<option value="robots-autres">Autres robots éducatifs (comparatifs, Tale-Bot, CyberPi, etc.)</option>
								<option value="partenariat">Partenariat (école, essai produit, contenu)</option>
								<option value="erreur-contenu">Erreur ou correction sur une page</option>
								<option value="suggestion">Idée d’article ou suggestion de contenu</option>
								<option value="donnees-rgpd">Données personnelles / confidentialité / RGPD</option>
								<option value="autre">Autre</option>
							</select>
						</div>
						<div class="field">
							<label for="contact-message">Message <span class="req" aria-hidden="true">*</span></label>
							<textarea id="contact-message" name="message" rows="6" required maxlength="8000"></textarea>
						</div>
						<div class="field field-checkbox">
							<input
								id="contact-privacy"
								name="privacy_accepted"
								type="checkbox"
								value="yes"
								required
								aria-required="true"
							/>
							<label for="contact-privacy" class="label-checkbox">
								J’ai lu et j’accepte la{' '}
								<a href={withBase('/politique-de-confidentialite/')} target="_blank" rel="noopener noreferrer"
									>politique de confidentialité</a
								>
								<span class="req" aria-hidden="true"> *</span>
								<span class="sr-only"> (obligatoire)</span>
							</label>
						</div>
						<p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>
						<div class="contact-form__actions">
							<Button type="submit" id="contact-submit">Envoyer</Button>
						</div>
					</form>
				</section>

				<section class="contact-alt" aria-labelledby="contact-email-title">
					<h2 id="contact-email-title">Courriel</h2>
					<p>
						<a class="contact-mailto" href={mailtoHref}>{CONTACT_EMAIL}</a>
					</p>
				</section>
			</article>
		</main>
		<Footer />
		<script is:inline define:vars={{ CONTACT_FORM_WEBHOOK_URL, CONTACT_EMAIL }}>
			(() => {
				const form = document.getElementById('contact-form');
				const statusEl = document.getElementById('contact-status');
				const submitBtn = document.getElementById('contact-submit');
				if (!form || !statusEl || !submitBtn) return;

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					statusEl.textContent = '';
					statusEl.classList.remove('is-error', 'is-success');

					const name = /** @type {HTMLInputElement} */ (document.getElementById('contact-name')).value.trim();
					const email = /** @type {HTMLInputElement} */ (document.getElementById('contact-email')).value.trim();
					const company = /** @type {HTMLInputElement} */ (document.getElementById('contact-company')).value.trim();
					const objetEl = /** @type {HTMLSelectElement | null} */ (document.getElementById('contact-objet'));
					const objet = (objetEl && objetEl.value.trim()) || '';
					let objet_label = '';
					if (objetEl && objet) {
						const opt = objetEl.options[objetEl.selectedIndex];
						if (opt) objet_label = opt.text.trim();
						if (!objet_label) objet_label = objet;
					}
					const message = /** @type {HTMLTextAreaElement} */ (document.getElementById('contact-message')).value.trim();
					const privacy = /** @type {HTMLInputElement} */ (document.getElementById('contact-privacy'));

					if (!name || !email || !objet || !message) {
						statusEl.classList.add('is-error');
						statusEl.textContent = 'Merci de remplir tous les champs obligatoires.';
						if (!objet && objetEl) objetEl.focus();
						else if (!name) document.getElementById('contact-name')?.focus();
						else if (!email) document.getElementById('contact-email')?.focus();
						else if (!message) document.getElementById('contact-message')?.focus();
						return;
					}
					if (!privacy.checked) {
						statusEl.classList.add('is-error');
						statusEl.textContent =
							'Vous devez accepter la politique de confidentialité pour envoyer ce formulaire (RGPD).';
						privacy.focus();
						return;
					}

					submitBtn.disabled = true;
					submitBtn.textContent = 'Envoi en cours…';

					const sourceEl = /** @type {HTMLInputElement | null} */ (document.getElementById('contact-source'));
					const source = (sourceEl && sourceEl.value.trim()) || 'robot-educatif';

					const submittedAt = new Date().toISOString();
					/* URL-encoded = requête « simple » (pas de préflight). mode no-cors : le webhook n’envoie pas
					   Access-Control-Allow-Origin ; sans cela le navigateur masque la réponse et fetch échoue
					   alors que le POST est bien reçu. La réponse est opaque : on ne peut pas lire le statut HTTP. */
					const body = new URLSearchParams({
						name,
						email,
						company,
						objet,
						objet_label,
						message,
						privacy_policy_accepted: 'true',
						privacy_policy_accepted_at: submittedAt,
						submitted_at: submittedAt,
						source,
						page: typeof location !== 'undefined' ? location.href : '',
					}).toString();

					try {
						await fetch(CONTACT_FORM_WEBHOOK_URL, {
							method: 'POST',
							mode: 'no-cors',
							headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
							body,
						});
						statusEl.classList.add('is-success');
						statusEl.textContent = 'Message envoyé. Merci ! Nous vous répondrons dès que possible.';
						form.reset();
					} catch (err) {
						statusEl.classList.add('is-error');
						const isNetwork =
							err instanceof TypeError ||
							(typeof err === 'object' &&
								err !== null &&
								String(/** @type {Error} */ (err).message || '').toLowerCase().includes('fetch'));
						statusEl.textContent = isNetwork
							? 'Envoi impossible (réseau, pare-feu, bloqueur de pubs, ou blocage navigateur vers un service tiers). Essayez sans extension ou écrivez à ' +
								CONTACT_EMAIL +
								'.'
							: "L'envoi a échoué (" +
								(/** @type {Error} */ (err).message || 'erreur') +
								'). Réessayez plus tard ou écrivez à ' +
								CONTACT_EMAIL +
								'.';
					} finally {
						submitBtn.disabled = false;
						submitBtn.textContent = 'Envoyer';
					}
				});
			})();
		</script>
	</body>
</html>

<style>
	main {
		width: min(640px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}
	.contact-page h1 {
		font-size: clamp(1.65rem, 4vw, 2.1rem);
		margin: 0 0 0.75rem;
		color: color-mix(in oklab, var(--accent) 82%, var(--accent-warm) 18%);
	}
	.contact-lead {
		margin: 0 0 2rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}
	.contact-lead a {
		color: var(--accent);
		font-weight: 600;
	}
	.contact-card {
		background: var(--surface);
		border: 1px solid var(--surface-border);
		border-radius: 12px;
		padding: 1.5rem 1.35rem 1.75rem;
		margin-bottom: 2rem;
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04);
	}
	.contact-card h2 {
		font-size: 1.2rem;
		margin: 0 0 0.5rem;
	}
	.contact-hint {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin: 0 0 1.25rem;
		line-height: 1.5;
	}
	.contact-hint a {
		color: var(--accent);
		font-weight: 600;
	}
	.contact-form .field {
		margin-bottom: 1.1rem;
	}
	.field-checkbox {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		margin-top: 1.25rem;
		padding: 0.85rem 0.75rem;
		border-radius: 8px;
		border: 1px solid var(--surface-border);
		background: color-mix(in oklab, var(--page-bg-elevated, var(--surface-2)) 100%, transparent);
	}
	.field-checkbox input[type='checkbox'] {
		width: 1.15rem;
		height: 1.15rem;
		margin-top: 0.2rem;
		flex-shrink: 0;
		accent-color: var(--accent);
		cursor: pointer;
	}
	.label-checkbox {
		font-weight: 400;
		font-size: 0.92rem;
		line-height: 1.45;
		margin: 0;
		cursor: pointer;
		color: rgb(var(--gray-dark));
	}
	.label-checkbox a {
		font-weight: 600;
		color: var(--accent);
	}
	.contact-form label {
		display: block;
		font-weight: 600;
		font-size: 0.92rem;
		margin-bottom: 0.35rem;
		color: rgb(var(--gray-dark));
	}
	.req {
		color: var(--accent-warm, #c45c26);
	}
	.optional-hint {
		font-weight: 400;
		color: rgb(var(--gray));
		font-size: 0.88em;
	}
	.contact-form input,
	.contact-form textarea,
	.contact-form select {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--surface-border);
		border-radius: 8px;
		background: var(--page-bg-elevated, var(--surface-2));
		color: rgb(var(--gray-dark));
		font: inherit;
	}
	.contact-form select {
		cursor: pointer;
		appearance: auto;
	}
	.contact-form textarea {
		resize: vertical;
		min-height: 8rem;
	}
	.contact-form input:focus-visible,
	.contact-form textarea:focus-visible,
	.contact-form select:focus-visible {
		outline: 3px solid rgba(40, 157, 204, 0.35);
		outline-offset: 1px;
		border-color: color-mix(in oklab, var(--accent) 45%, transparent);
	}
	.contact-status {
		min-height: 1.35em;
		margin: 0.5rem 0 1rem;
		font-size: 0.94rem;
		font-weight: 600;
	}
	.contact-status.is-success {
		color: color-mix(in oklab, #1a7f37 70%, var(--accent) 30%);
	}
	.contact-status.is-error {
		color: color-mix(in oklab, #b42318 75%, var(--accent-warm) 25%);
	}
	.contact-form__actions {
		margin-top: 0.35rem;
	}
	.contact-form__actions :global(.ui-btn) {
		min-width: 11rem;
	}
	.contact-alt h2 {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}
	.contact-mailto {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
		word-break: break-all;
	}
</style>
