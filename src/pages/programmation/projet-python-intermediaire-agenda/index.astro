---
import ProgrammationSeriesHub from '../../../components/ProgrammationSeriesHub.astro';
import type { SeriesHubFallbackLesson } from '../../../components/ProgrammationSeriesHub.astro';
import { withBase } from '../../../lib/siteUrl';

const fallbackAgenda: SeriesHubFallbackLesson[] = [
	{
		href: '/projet-inter-agenda-1-cahier-des-charges/',
		order: 1,
		title: 'Projet Agenda CLI (1/6) — cahier des charges et arborescence',
		desc: 'Objectifs fonctionnels, structure de dossiers src/, format JSON des événements, critères de réussite ; 12 exercices.',
	},
	{
		href: '/projet-inter-agenda-2-donnees-pathlib/',
		order: 2,
		title: 'Projet Agenda CLI (2/6) — données, pathlib et JSON',
		desc: 'Chemin du fichier agenda, pathlib.Path, lecture et écriture atomique, encodage UTF-8 ; 12 exercices.',
	},
	{
		href: '/projet-inter-agenda-3-modele-poo/',
		order: 3,
		title: 'Projet Agenda CLI (3/6) — modèle métier et classes',
		desc: 'Classe Event, validation des dates avec datetime, service AgendaService ; séparation storage ; 12 exercices.',
	},
	{
		href: '/projet-inter-agenda-4-tests-pytest/',
		order: 4,
		title: 'Projet Agenda CLI (4/6) — tests avec pytest',
		desc: 'Fixtures tmp_path, tests du service, mocks de stockage, couverture des erreurs ; 12 exercices.',
	},
	{
		href: '/projet-inter-agenda-5-cli-argparse/',
		order: 5,
		title: 'Projet Agenda CLI (5/6) — argparse et interface ligne de commande',
		desc: 'Sous-commandes add, list, remove ; dates ; codes de sortie ; messages utilisateur ; 12 exercices.',
	},
	{
		href: '/projet-inter-agenda-6-livraison-extensions/',
		order: 6,
		title: 'Projet Agenda CLI (6/6) — livraison, qualité et extensions',
		desc: 'requirements.txt ou pyproject, entrée console, README, idées d’extensions (export ICS, rappels) ; 12 exercices.',
	},
];
---

<ProgrammationSeriesHub
	metaTitle="Projet Python — Agenda personnel en CLI"
	metaDescription="Projet guidé en six parties : cahier des charges, JSON et pathlib, classes, pytest, argparse, livraison. Prérequis intermédiaire Python."
	series="Projet Python intermédiaire — Agenda CLI"
	breadcrumbLast="Projet Agenda CLI"
	pageTitle="Projet — Agenda personnel (CLI)"
	fallbackLessons={fallbackAgenda}
>
	<p>
		<strong>Réponse directe</strong> — Vous allez construire un <strong>agenda en ligne de commande</strong> (
		<abbr title="Command Line Interface">CLI</abbr>, interface texte dans le terminal) : événements datés, fichier
		<strong>JSON</strong> (<em>JavaScript Object Notation</em>, format texte lisible) local, commandes{' '}
		<code>add</code>, <code>list</code>, <code>remove</code>. Ce hub regroupe les <strong>six chapitres</strong> dans
		l’ordre ; commencez par le <a href={withBase('/projet-inter-agenda-1-cahier-des-charges/')}>cahier des charges (1/6)</a>.
	</p>
	<p>
		Le projet <strong>synthétise</strong> le{' '}
		<a href={withBase('/programmation/python-intermediaire/')}>parcours intermédiaire</a> : modules,{' '}
		<strong>pathlib</strong>, <strong>classes</strong>, <strong>pytest</strong>, <code>argparse</code>. Prérequis
		minimum : <a href={withBase('/python-inter-modules-imports/')}>modules et imports</a>,{' '}
		<a href={withBase('/python-inter-pathlib/')}>pathlib</a>,{' '}
		<a href={withBase('/python-inter-poo-classes/')}>POO</a>,{' '}
		<a href={withBase('/python-inter-venv-pip/')}>venv et pip</a>.
	</p>
	<h2>Présentation de chaque partie</h2>
	<ul>
		<li><strong>Partie 1</strong> — Cahier des charges : périmètre, structure <code>src/</code>, format JSON des événements.</li>
		<li><strong>Partie 2</strong> — Module <code>storage</code> : chemins fiables, lecture/écriture UTF-8, fichier agenda.</li>
		<li><strong>Partie 3</strong> — Modèle métier : classe <code>Event</code>, validation <code>datetime</code>, service.</li>
		<li><strong>Partie 4</strong> — Tests <strong>pytest</strong> : fixtures, erreurs, non-régression.</li>
		<li><strong>Partie 5</strong> — CLI <code>argparse</code> : sous-commandes, messages clairs, codes de sortie.</li>
		<li><strong>Partie 6</strong> — Livraison : <code>main()</code>, README, extensions possibles (export ICS).</li>
	</ul>
	<p>
		Autres projets du même niveau :{' '}
		<a href={withBase('/programmation/carnet-todo/')}>Carnet Todo + JSON</a>,{' '}
		<a href={withBase('/programmation/bataille-navale/')}>Bataille navale</a>,{' '}
		<a href={withBase('/programmation/pendu/')}>Le pendu</a>. Index :{' '}
		<a href={withBase('/programmation/')}>Programmation</a>. Ressource complémentaire :{' '}
		<a href="/go/az-fr-649f8f9ae5/">livres Python projet CLI</a> (partenaire).
	</p>
</ProgrammationSeriesHub>
