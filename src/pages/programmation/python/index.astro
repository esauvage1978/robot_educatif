---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { getCollection } from 'astro:content';
import { articleSlugFromId } from '../../../lib/articleSlug';
import StructuredDataBreadcrumb from '../../../components/StructuredDataBreadcrumb.astro';
import { withBase } from '../../../lib/siteUrl';
import PageColumns from '../../../components/PageColumns.astro';
const all = await getCollection('blog');
const posts = all
	.filter((p) => p.data.series === 'Python')
	.sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99));

const itemListLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Parcours Python débutant — robot-educatif.info',
	description: 'Dix leçons Python 3 progressives avec exercices.',
	numberOfItems: posts.length,
	itemListElement: posts.map((post, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: post.data.title,
		url: new URL(`/${articleSlugFromId(post.id)}/`, Astro.site).href,
	})),
};
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Python débutant — parcours gratuit en 10 leçons (2026)"
			description="Parcours Python 3 débutant : variables, conditions, boucles, listes, fonctions et un mini-projet. Exercices corrigés, puis le niveau intermédiaire, à la maison."
		/>
		<script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
		<StructuredDataBreadcrumb
			items={[
				{ name: 'Accueil', url: withBase('/') },
				{ name: 'Programmation', url: withBase('/programmation/') },
				{ name: 'Python', url: withBase('/programmation/python/') },
			]}
		/>
	</head>
	<body>
		<Header />
		<main class="py-series">
<PageColumns>
			<nav class="breadcrumb" aria-label="Fil d’Ariane">
				<a href={withBase('/programmation/')}>Programmation</a>
				<span aria-hidden="true"> / </span>
				<span>Python</span>
			</nav>
			<h1>Python — parcours progressif</h1>
			<h2 class="visually-hidden">Sommaire des 10 leçons</h2>
			<blockquote class="geo-direct" style="margin: 0 0 1.25rem; padding: 1rem 1.15rem; border-left: 4px solid #0d9488; background: #f0fdfa; line-height: 1.55;">
				<strong>Réponse directe (novembre 2026)</strong> — Ce parcours propose <strong>10 leçons Python 3</strong> gratuites : variables, conditions, boucles, fonctions (<a href={withBase('/python-fonctions/')}>return</a>), listes, fichiers, puis mini-projet. Installez <strong>Python 3.10 ou plus récent</strong> et un éditeur (Thonny ou VS Code). Suite logique : <a href={withBase('/programmation/python-intermediaire/')}>Python intermédiaire</a> (venv, pip, POO).
			</blockquote>
			<h2 id="objectifs">Objectifs du parcours</h2>
			<p class="lead">
				Chaque leçon propose des <strong>exemples</strong> à taper, du <strong>code</strong> commenté et des <strong>exercices</strong> avec solutions masquées.
				Vous apprenez à lire une erreur Python, structurer un petit programme et préparer des projets guidés (pendu, bataille navale, carnet todo).
			</p>
			<h2 id="prerequis">Matériel et prérequis</h2>
			<p class="lead">
				Un ordinateur Windows, macOS ou Linux suffit. Aucune expérience en programmation n’est requise ; une bonne lecture du clavier et de l’écran est utile. Aucun livre n’est lié : une recherche « python 3 apprendre » ne désigne pas un titre.
			</p>
			<h2 id="suite">Après le parcours débutant</h2>
			<p class="lead">
				<img src={withBase('/images/blog-thumbnails/python-variables-affichage.webp')} alt="Leçon Python : variables et affichage" width="320" height="180" loading="lazy" style="max-width:100%;height:auto;border-radius:10px;margin:0 0 1rem;" />
			</p>
			<p class="extra-series">
				Bloc suivant :{' '}
				<a href={withBase('/programmation/python-intermediaire/')}>Python intermédiaire</a> (modules, venv, pathlib, POO, tests,
				regex), puis <a href={withBase('/programmation/python-avance/')}>Python avancé</a> (générateurs, décorateurs, context
				managers, asyncio, typage, packaging). — Projet sur l’intermédiaire :{' '}
				<a href={withBase('/programmation/projet-python-intermediaire-agenda/')}>Agenda CLI</a>. — Projet sur l’avancé :{' '}
				<a href={withBase('/programmation/projet-python-avance-journal/')}>Journal CLI</a>. — Autres projets guidés :{' '}
				<a href={withBase('/programmation/bataille-navale/')}>Bataille navale</a>,{' '}
				<a href={withBase('/programmation/pendu/')}>Le pendu</a> (fichier de mots),{' '}
				<a href={withBase('/programmation/puissance-4/')}>Puissance 4</a>,{' '}
				<a href={withBase('/programmation/carnet-todo/')}>Carnet Todo + JSON</a>.
			</p>
			<ol class="lesson-list">
				{
					posts.map((post) => (
						<li>
							<a href={withBase(`/${articleSlugFromId(post.id)}/`)}>
								<span class="num">{post.data.seriesOrder ?? '—'}</span>
								<span class="meta">
									<span class="title">{post.data.title}</span>
									<span class="desc">{post.data.description}</span>
								</span>
							</a>
						</li>
					))
				}
			</ol>
			<p class="back">
				<a href={withBase('/programmation')}>← Toutes les rubriques programmation</a>
			</p>
		</PageColumns>
</main>
		<Footer />
	</body>
</html>

<style>
	.py-series {
		width: min(720px, calc(100% - 2rem));
		margin: 0 auto;
		padding: 2rem 0 3rem;
	}
	.breadcrumb {
		font-size: 0.88rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}
	.breadcrumb a {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
	}
	.py-series h1 {
		font-size: clamp(1.65rem, 3vw, 2rem);
		margin: 0 0 0.75rem;
		color: color-mix(in oklab, var(--accent) 78%, var(--accent-warm) 22%);
	}
	.py-series h2 {
		font-size: 1.2rem;
		margin: 1.5rem 0 0.65rem;
		color: rgb(var(--gray-dark));
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		border: 0;
	}
	.lead {
		margin: 0 0 1.75rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
	}
	.lead a {
		color: var(--accent);
		font-weight: 600;
	}
	.extra-series {
		margin: 0 0 1.25rem;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		border: 1px solid var(--surface-border);
		background: color-mix(in oklab, var(--accent) 6%, var(--surface));
		font-size: 0.92rem;
		line-height: 1.5;
		color: rgb(var(--gray-dark));
	}
	.extra-series a {
		color: var(--accent);
		font-weight: 700;
	}
	.lesson-list {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: lesson;
	}
	.lesson-list li {
		margin-bottom: 0.65rem;
	}
	.lesson-list a {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		border: 1px solid var(--surface-border);
		background: var(--surface);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.lesson-list a:hover {
		border-color: color-mix(in oklab, var(--accent) 38%, transparent);
		background: color-mix(in oklab, var(--accent) 5%, var(--surface));
	}
	.num {
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
		background: var(--brand-gradient, linear-gradient(135deg, var(--accent), var(--accent-warm)));
		color: #fff;
		font-weight: 800;
		font-size: 0.95rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}
	.meta .title {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.lesson-list a:hover .title {
		color: var(--accent);
	}
	.meta .desc {
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.45;
	}
	.back {
		margin-top: 2rem;
	}
	.back a {
		color: var(--accent);
		font-weight: 600;
	}
</style>
