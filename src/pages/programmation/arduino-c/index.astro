		color: #fff;
		font-weight: 800;
		font-size: 0.95rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}
	.meta .title {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.lesson-list a:hover .title {
		color: var(--accent);
	}
	.meta .desc {
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.45;
	}
	.resource-grid a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem;
		border-radius: 14px;
		background: color-mix(in oklab, var(--accent-warm) 10%, var(--surface));
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.resource-grid span {
		color: var(--accent);
		font-weight: 800;
	}
	.check-list {
		padding-left: 1.25rem;
	}
	.faq-section {
		display: grid;
		gap: 1rem;
	}
	.back {
		margin-top: 2rem;
	}
	.back a {
		color: var(--accent);
		font-weight: 600;
	}
	@media (max-width: 760px) {
		.info-grid,
		.level-grid,
		.project-grid,
		.resource-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

