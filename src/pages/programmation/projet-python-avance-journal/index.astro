---
import ProgrammationSeriesHub from '../../../components/ProgrammationSeriesHub.astro';
import type { SeriesHubFallbackLesson } from '../../../components/ProgrammationSeriesHub.astro';
import { AMAZON_AFFILIATE_TAG } from '../../../consts';
import { withBase } from '../../../lib/siteUrl';

const tag = AMAZON_AFFILIATE_TAG;

const fallbackJournal: SeriesHubFallbackLesson[] = [
	{
		href: '/projet-av-journal-1-architecture/',
		order: 1,
		title: 'Projet Journal CLI (1/6) — architecture et périmètre',
		desc: 'Analyse de fichiers log ligne à ligne, modules parser/stats/cli, objectifs et livrables ; 12 exercices.',
	},
	{
		href: '/projet-av-journal-2-parse-generateurs/',
		order: 2,
		title: 'Projet Journal CLI (2/6) — parsing par générateurs',
		desc: 'Lecture ligne à ligne, yield, regex ou split, lignes ignorées ; 12 exercices.',
	},
	{
		href: '/projet-av-journal-3-decorateurs/',
		order: 3,
		title: 'Projet Journal CLI (3/6) — décorateurs pour métriques et journalisation',
		desc: 'Mesurer le temps de parsing, journaliser le nombre de lignes, functools.wraps ; 12 exercices.',
	},
	{
		href: '/projet-av-journal-4-asyncio-batch/',
		order: 4,
		title: 'Projet Journal CLI (4/6) — asyncio et traitement de plusieurs fichiers',
		desc: 'gather, semaphore, run_in_executor pour lecture disque ; pas de blocage ; 12 exercices.',
	},
	{
		href: '/projet-av-journal-5-typing-mypy/',
		order: 5,
		title: 'Projet Journal CLI (5/6) — typage et vérification mypy',
		desc: 'Protocol, TypedDict, Literal pour niveaux de log ; mypy strict progressif ; 12 exercices.',
	},
	{
		href: '/projet-av-journal-6-package-pyproject/',
		order: 6,
		title: 'Projet Journal CLI (6/6) — package, pyproject et livraison',
		desc: 'pyproject.toml, setuptools, entrée journal-stats, README, tests et publication ; 12 exercices.',
	},
];
---

<ProgrammationSeriesHub
	metaTitle="Projet Python avancé — Analyseur de journal CLI"
	metaDescription="Projet Python avancé : un analyseur de journaux en ligne de commande, en six parties. Générateurs, décorateurs, asyncio, typage et packaging, pas à pas."
	series="Projet Python avancé — Journal CLI"
	breadcrumbLast="Projet Journal CLI"
	pageTitle="Projet — Analyseur de journal (CLI)"
	fallbackLessons={fallbackJournal}
>
	<p>
		<strong>Réponse rapide</strong> — Vous construisez un outil en ligne de commande qui lit des fichiers <strong>log</strong> (journaux
		texte), calcule des statistiques et peut traiter plusieurs fichiers en parallèle. Ce hub regroupe les <strong>six parties</strong>{' '}
		du parcours ; prérequis : <a href={withBase('/programmation/python-intermediaire/')}>Python intermédiaire</a> et{' '}
		<a href={withBase('/programmation/python-avance/')}>Python avancé</a>.
	</p>
	<p>
		Ce projet <strong>synthétise</strong> le <a href={withBase('/programmation/python-avance/')}>parcours avancé</a> : générateurs pour
		lire de gros fichiers ligne à ligne, <strong>décorateurs</strong> pour mesurer ou journaliser, <strong>asyncio</strong> pour traiter
		plusieurs fichiers sans bloquer inutilement (schémas avec <code>asyncio</code> + exécuteur pour I/O disque), <strong>typage</strong>{' '}
		et <strong>pyproject.toml</strong> pour livrer un paquet installable avec commande <code>journal-stats</code> — fictive dans le
		tutoriel, mais structurée comme un vrai outil.
	</p>
	<p>
		Maillage : <a href={withBase('/programmation/')}>hub programmation</a> ·{' '}
		<a href={withBase('/programmation/projet-inter-agenda-cli/')}>projet Agenda CLI</a> (autre parcours guidé) ·{' '}
		<a href={withBase('/python-inter-modules-imports/')}>modules et imports</a> ·{' '}
		<a href={withBase('/python-inter-regex-re/')}>expressions régulières</a>.
	</p>
	<h2>Présentation de chaque partie</h2>
	<ul>
		<li>
			<strong>Partie 1 — Architecture</strong> : découper le projet en modules <code>parser</code>, <code>stats</code>,{' '}
			<code>cli</code> ; définir le périmètre (lignes ignorées, encodage UTF-8).
		</li>
		<li>
			<strong>Partie 2 — Générateurs</strong> : lire un gros log sans charger tout en RAM ; <code>yield</code> et nettoyage des lignes.
		</li>
		<li>
			<strong>Partie 3 — Décorateurs</strong> : chronométrer le parsing et journaliser le nombre de lignes traitées.
		</li>
		<li>
			<strong>Partie 4 — Asyncio</strong> : traiter un dossier de logs avec <code>asyncio.gather</code> et sémaphore.
		</li>
		<li>
			<strong>Partie 5 — Typage</strong> : <code>TypedDict</code>, <code>Protocol</code>, vérification <code>mypy</code>.
		</li>
		<li>
			<strong>Partie 6 — Packaging</strong> : <code>pyproject.toml</code>, point d’entrée console, README et tests.
		</li>
	</ul>
	<p>
		Ressource papier (partenaire) :{' '}
		<a
			href={`https://www.amazon.fr/s?k=python+asyncio+avanc%C3%A9+livre&tag=${tag}`}
			target="_blank"
			rel="noopener noreferrer sponsored">Python avancé</a>.
	</p>
</ProgrammationSeriesHub>
