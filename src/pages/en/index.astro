---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getIllustration } from '../../lib/illustration';
import { withBase } from '../../lib/siteUrl';
import { withImageVersion } from '../../lib/imageVersion';
import { EN_PAGES, slugOf } from '../../lib/i18n.mjs';

const TITLE = 'Robot Éducatif: coding robots, Arduino and Raspberry Pi guides for kids';
const DESCRIPTION = 'Independent guides for parents and teachers in the UK and US: choosing a coding robot by age, Arduino kits, Raspberry Pi comparisons and mBlock tutorials.';
const card = (href) => {
	const p = EN_PAGES.find((x) => x.href === href);
	const ill = getIllustration(slugOf(p.fr));
	return { ...p, img: ill ? withImageVersion(withBase(ill.src)) : null, alt: ill ? `Illustration: ${p.title}` : '' };
};
const hero = card('/en/best-programmable-robot-for-kids/');
const comparisons = ['/en/mbot-vs-mbot2/', '/en/raspberry-pi-3-vs-4-vs-5/', '/en/raspberry-pi-5-which-ram/'].map(card);
const smartHome = ['/en/smart-home/getting-started/', '/en/smart-home/home-assistant-green-vs-raspberry-pi-5/', '/en/smart-home/best-zigbee-dongle-home-assistant/', '/en/smart-home/smart-plugs-uk-us/'].map(card);
const tutorials = ['/en/install-mblock-5-windows/', '/en/first-mbot-program/', '/en/arduino-robot-kit-for-kids/'].map(card);
const ages = [
	{ badge: 'Ages 6–8', title: 'First coding robot', text: 'Block coding, ready-built robot, simple sensor challenges', href: '/en/best-programmable-robot-for-kids/' },
	{ badge: 'Ages 9–12', title: 'Blocks to Python', text: 'Scratch-style blocks first, then typed Python on mBot2', href: '/en/best-programmable-robot-for-kids/' },
	{ badge: 'Ages 13+', title: 'Arduino robot kits', text: 'Wiring, C/C++ in the Arduino IDE, longer projects', href: '/en/arduino-robot-kit-for-kids/' },
	{ badge: 'Ages 12+', title: 'Raspberry Pi', text: 'A real Linux computer for Python, cameras and home projects', href: '/en/raspberry-pi-3-vs-4-vs-5/' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={TITLE} description={DESCRIPTION} image={hero.img ?? undefined} />
		<style>
			body {
				background: var(--page-bg);
			}
			
			.hero {
				background: linear-gradient(180deg, var(--surface-2) 0%, var(--page-bg) 100%);
				padding: 3.5rem clamp(1rem, 5vw, 2rem) 4rem;
			}
			
			.hero-inner {
				max-width: 1320px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3rem;
				align-items: center;
			}
			
	.hero-content .badge {
		display: inline-block;
		background: #FFEDD5;
		color: #9A3412;
		font-weight: 700;
		padding: 6px 14px;
		border-radius: 99px;
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}
	
	html[data-theme="light"] .hero-content .badge {
		background: #FFEDD5;
		color: #9A3412;
	}
	
	@media (prefers-color-scheme: dark) {
		.hero-content .badge {
			background: #C2410C;
			color: #FFFFFF;
		}
	}

	html[data-theme="dark"] .hero-content .badge {
		background: #C2410C;
		color: #FFFFFF;
	}
			
			.hero-content h1 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(2.2rem, 4.2vw, 3.25rem);
				line-height: 1.08;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--black));
			}
			
			.hero-content h1 em {
				font-style: normal;
				color: var(--primary);
			}
			
			.hero-lead {
				font-size: clamp(1.05rem, 1.35vw, 1.2rem);
				line-height: 1.55;
				color: rgb(var(--gray-dark));
				max-width: 560px;
				margin-bottom: 1.75rem;
			}
			
			.hero-ctas {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}
			
			.btn {
				display: inline-block;
				padding: 15px 24px;
				border-radius: 12px;
				font-weight: 700;
				text-decoration: none;
				font-size: 1.05rem;
				transition: all 0.2s ease;
			}
			
		.btn-primary {
			background: #C2410C;
			color: white;
			box-shadow: 0 6px 16px rgba(249, 115, 22, 0.35);
		}
		
		html[data-theme="light"] .btn-primary {
			background: #C2410C;
		}
		
		@media (prefers-color-scheme: dark) {
			.btn-primary {
				background: #C2410C;
			}
		}
		
		html[data-theme="dark"] .btn-primary {
			background: #C2410C;
		}
		
		.btn-primary:hover {
			background: #ea580c;
			transform: translateY(-1px);
			box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
		}
		
		@media (prefers-color-scheme: dark) {
			.btn-primary:hover {
				background: #9A3412;
			}
		}
		
		html[data-theme="dark"] .btn-primary:hover {
			background: #9A3412;
		}
			
			.btn-secondary {
				border: 2px solid var(--primary);
				color: var(--primary);
				background: transparent;
			}
			
		.btn-secondary:hover {
			background: var(--primary);
			color: white;
		}
		
		.show-m { display: none; }
		.trust-signals {
			display: flex;
			gap: 1.5rem;
			flex-wrap: wrap;
			font-size: 0.95rem;
			color: rgb(var(--gray-dark));
		}
			
			.trust-signals span {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			
			.trust-signals b {
				color: var(--primary);
				font-weight: 700;
			}
			
		.hero-card {
			position: relative;
			background: var(--card);
			border-radius: 24px;
			padding: 18px;
			box-shadow: 0 20px 40px rgba(11, 31, 42, 0.12);
		}
		
		@media (prefers-color-scheme: dark) {
			.hero-card {
				background: #ffffff;
			}
			.hero-card .card-info strong,
			.hero-card .card-info small {
				color: #0B1F2A;
			}
		}
			
			.hero-card img {
				width: 100%;
				aspect-ratio: 500/320;
				object-fit: cover;
				border-radius: 16px;
				display: block;
			}
			
		.card-tag {
			position: absolute;
			top: 28px;
			left: 28px;
			background: var(--primary);
			color: white;
			font-weight: 700;
			padding: 6px 12px;
			border-radius: 8px;
			font-size: 0.9rem;
		}
		
		@media (prefers-color-scheme: dark) {
			.hero-card .card-tag {
				background: #0F766E;
				color: white;
			}
		}
			
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 14px;
				gap: 1rem;
			}
			
			.card-info strong {
				font-family: var(--font-heading);
				font-size: 1.25rem;
				font-weight: 800;
				display: block;
				color: rgb(var(--black));
			}
			
			.card-info small {
				color: rgb(var(--gray));
				display: block;
				font-size: 0.9rem;
			}
			
		.card-cta {
			background: var(--ink);
			color: white;
			padding: 12px 18px;
			border-radius: 10px;
			text-decoration: none;
			font-weight: 700;
			font-size: 0.95rem;
			white-space: nowrap;
			transition: all 0.2s ease;
		}
		
		@media (prefers-color-scheme: dark) {
			.hero-card .card-cta {
				background: #0B1F2A;
				color: white;
			}
			.hero-card .card-cta:hover {
				background: #0F766E;
			}
		}
		
		.card-cta:hover {
			background: var(--primary);
			transform: translateY(-1px);
		}
			
			.container {
				max-width: 1320px;
				margin: 0 auto;
				padding: 0 clamp(1rem, 5vw, 2rem);
			}
			
			.section {
				padding: 4rem 0;
			}
			
			.section-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			
			.section-header h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				color: rgb(var(--black));
				margin: 0 0 0.75rem 0;
			}
			
			.section-header p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 0 auto;
			}
			
			.age-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			
			.age-card {
				background: var(--surface);
				border: 2px solid var(--surface-border);
				border-radius: 16px;
				padding: 1.75rem 1.5rem;
				text-decoration: none;
				transition: all 0.3s ease;
				display: block;
			}
			
			.age-card:hover {
				border-color: var(--primary);
				box-shadow: 0 8px 24px rgba(15, 118, 110, 0.15);
				transform: translateY(-4px);
			}
			
			.age-badge {
				display: inline-block;
				background: var(--primary);
				color: white;
				font-weight: 700;
				padding: 6px 14px;
				border-radius: 8px;
				font-size: 0.85rem;
				margin-bottom: 0.75rem;
			}
			
			.age-card h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.35rem;
				color: rgb(var(--black));
				margin: 0.5rem 0 0.75rem 0;
			}
			
			.age-card p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.5;
				margin: 0;
			}
			
			.best-sellers {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 20px;
				padding: 2.5rem 2rem;
				margin-bottom: 3rem;
			}
			
			.best-sellers h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.75rem;
				margin: 0 0 1.5rem 0;
				color: rgb(var(--black));
			}
			
			.product-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
				gap: 1.5rem;
			}
			
			.product-card {
				background: var(--page-bg);
				border: 1px solid var(--surface-border);
				border-radius: 12px;
				transition: all 0.2s ease;
				overflow: hidden;
			}
			
			.product-card:hover {
				box-shadow: 0 4px 12px rgba(11, 31, 42, 0.1);
				transform: translateY(-2px);
			}
			
			.product-card-link {
				display: block;
				text-decoration: none;
				padding: 1.25rem;
				text-align: center;
			}
			
			.product-card-img {
				width: 100%;
				max-width: 200px;
				height: auto;
				aspect-ratio: 1;
				object-fit: contain;
				margin: 0 auto 1rem;
				background: white;
				border-radius: 8px;
				border: 1px solid var(--surface-border);
			}
			
			.product-card h3 {
				font-weight: 700;
				font-size: 1.05rem;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}
			
			.product-card-cta {
				display: inline-block;
				background: var(--accent-warm);
				color: white;
				padding: 10px 18px;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.9rem;
				transition: all 0.2s ease;
			}
			
			.product-card-link:hover .product-card-cta {
				background: #ea580c;
			}
			
		.articles-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 2rem;
		}
		
		@media (max-width: 640px) {
			.articles-grid {
				grid-template-columns: 1fr;
			}
		}
			
			.article-card {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 16px;
				overflow: hidden;
				text-decoration: none;
				display: block;
				transition: all 0.3s ease;
			}
			
			.article-card:hover {
				box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
				transform: translateY(-4px);
			}
			
			.article-card img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16/9;
				object-fit: contain;
				background: var(--surface);
				border-radius: 0;
			}
			
			.article-content {
				padding: 1.5rem;
			}
			
			.article-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5rem;
			}
			
			.article-card h3 {
				font-weight: 700;
				font-size: 1.15rem;
				color: rgb(var(--black));
				margin: 0;
				line-height: 1.4;
			}
			
			.cta-banner {
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
				color: white;
				border-radius: 20px;
				padding: 3rem 2.5rem;
				text-align: center;
				margin: 3rem 0;
			}
			
			.cta-banner h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.25rem);
				margin: 0 0 1rem 0;
			}
			
			.cta-banner p {
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				opacity: 0.95;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
			}
			
			.cta-banner .btn {
				background: white;
				color: var(--primary);
			}
			
			.cta-banner .btn:hover {
				background: var(--page-bg);
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
			}
			
		@media (max-width: 768px) {
			.hero {
				padding-top: 0.75rem;
				padding-bottom: 2rem;
			}
			.hero-inner {
				grid-template-columns: 1fr;
				gap: 1.25rem !important;
				padding-top: 0.5rem !important;
				padding-bottom: 2.5rem;
			}
			.hero-content .badge {
				font-size: 0.8rem;
				margin-bottom: 0.6rem;
			}
			.hero-content h1 {
				font-size: 1.85rem;
				margin-bottom: 0.75rem;
			}
			.hero-lead {
				font-size: 1rem;
				margin-bottom: 1.1rem;
			}
			.hero-ctas {
				flex-wrap: nowrap;
				gap: 0.6rem;
				margin-bottom: 1rem;
			}
			.hero-ctas .btn {
				padding: 12px 10px;
				font-size: 0.98rem;
				white-space: nowrap;
			}
			.trust-signals {
				gap: 1rem;
				font-size: 0.88rem;
			}
			.hide-m { display: none; }
			.show-m { display: inline; }
			
			.hero-card {
				order: 2;
				padding: 12px;
			}
			.hero-card img {
				aspect-ratio: 16/9;
			}
			
			.btn {
				flex: 1;
				text-align: center;
			}
				
				.section {
					padding: 2.5rem 0;
				}
			}
		</style>
		<style>
			.hero-content { min-width: 0; }
			.hero-ctas { flex-wrap: wrap; }
			.hero h1 { overflow-wrap: break-word; }
			.hero-card img.hero-ill { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; display: block; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-content">
						<span class="badge">New: our guides in English</span>
						<h1>The right <em>coding robot</em> for your child, explained clearly</h1>
						<p class="hero-lead">
							mBot, Arduino robot kits, Raspberry Pi: independent guides for parents and teachers in the UK and the US, built on manufacturers' official specifications.
						</p>
						<div class="hero-ctas">
							<a href={withBase('/en/best-programmable-robot-for-kids/')} class="btn btn-primary">Choose by age →</a>
							<a href={withBase('/en/raspberry-pi-3-vs-4-vs-5/')} class="btn btn-secondary">Compare Raspberry Pi</a>
						</div>
						<div class="trust-signals">
							<span>📚 <b>{EN_PAGES.length} guides</b> in English</span>
							<span>🔎 Specs sourced and dated</span>
						</div>
					</div>
					<a class="hero-card" href={withBase(hero.href)} style="text-decoration:none;color:inherit;">
						<span class="card-tag">⭐ Most-read guide</span>
						{hero.img && <img class="hero-ill" src={hero.img} width="960" height="540" alt={hero.alt} loading="eager" fetchpriority="high" />}
						<div class="card-footer">
							<div class="card-info">
								<strong>Best programmable robot for kids</strong>
								<small>mBot, mBot2, ELEGOO compared · ages 6 to 13+</small>
							</div>
							<span class="card-cta">Read →</span>
						</div>
					</a>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Guides by age</h2>
						<p>Every age group has different needs. Pick the one that fits:</p>
					</div>
					<div class="age-grid">
						{ages.map((a) => (
							<a href={withBase(a.href)} class="age-card">
								<span class="age-badge">{a.badge}</span>
								<h3>{a.title}</h3>
								<p>{a.text}</p>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="section" style="background: var(--surface-2); padding: 4rem 0;">
				<div class="container">
					<div class="section-header">
						<h2>Comparisons</h2>
						<p>Side-by-side specification tables to help you decide</p>
					</div>
					<div class="articles-grid">
						{comparisons.map((c) => (
							<a href={withBase(c.href)} class="article-card">
								{c.img && <img src={c.img} alt={c.alt} width="448" height="252" loading="lazy" decoding="async" />}
								<div class="article-content"><h3>{c.title}</h3></div>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Tutorials</h2>
						<p>Step-by-step help to get started</p>
					</div>
					<div class="articles-grid">
						{tutorials.map((c) => (
							<a href={withBase(c.href)} class="article-card">
								{c.img && <img src={c.img} alt={c.alt} width="448" height="252" loading="lazy" decoding="async" />}
								<div class="article-content"><h3>{c.title}</h3></div>
							</a>
						))}
					</div>
					<div class="cta-banner">
						<h2>Prefer French?</h2>
						<p>Robot Éducatif publishes over 130 guides in French, including age-by-age buying guides and mBot projects.</p>
						<a href={withBase('/')} class="btn" hreflang="fr" lang="fr">Version française →</a>
					</div>
				</div>
			</section>
			<section class="section" style="background: var(--surface-2); padding: 4rem 0;">
				<div class="container">
					<div class="section-header">
						<h2>Smart home</h2>
						<p>Home Assistant, Zigbee and smart plugs, adapted for UK (230 V, Type G) and US (120 V, Type A/B) homes · <a href={withBase('/en/smart-home/')}>All smart home guides →</a></p>
					</div>
					<div class="articles-grid">
						{smartHome.map((c) => (
							<a href={withBase(c.href)} class="article-card">
								{c.img && <img src={c.img} alt={c.alt} width="448" height="252" loading="lazy" decoding="async" />}
								<div class="article-content"><h3>{c.title}</h3></div>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
