				<p class="noel26-sub">Accès direct aux robots programmables les plus demandés par tranche d'âge (boutons marchands accessibles sans défilement horizontal sur mobile) :</p>
				<div class="noel26-grid">
					{noelStarProducts.map((it) => (
						<article class="noel26-card">
							<div class="noel26-badge">{it.badge}</div>
							<h3 class="noel26-name"><a href={it.amzUrl} target="_blank" rel="nofollow sponsored noopener">{it.name}</a></h3>
							<p class="noel26-desc">{it.desc}</p>
							<p class="noel26-price"><a href={it.amzUrl} target="_blank" rel="nofollow sponsored noopener">Tarif indicatif : {it.price} (voir prix du jour)</a></p>
							<div class="noel26-btns">
								<a href={it.amzUrl} target="_blank" rel="nofollow sponsored noopener" class="noel26-btn noel26-btn--amz">🛒 Voir sur Amazon →</a>
								<a href={it.culturaUrl} target="_blank" rel="nofollow sponsored noopener" class="noel26-btn noel26-btn--cultura">🎨 Voir chez Cultura →</a>
								<a href={it.partnerUrl} target="_blank" rel="nofollow sponsored noopener" class="noel26-btn noel26-btn--partner">⚡ {it.partnerLabel} →</a>
							</div>
						</article>
					))}
				</div>
			</section>
			{groups.map((g) => (
				<section class="promo-group">
					<h2>{g} <small style="font-weight:400;color:#5b6470">· {offers.find((o) => o.merchant === g)?.topic}</small></h2>
					<ul class="promo-list">
						{offers.filter((o) => o.merchant === g).map((o) => (
							<li class="promo-card">
								<div class="promo-main">
									<p class="promo-title"><a href={o.url} rel="sponsored nofollow noopener" target="_blank" style="color:inherit;text-decoration:underline;">{o.title}</a></p>
									<p class="promo-meta">Valable du {fmt(o.start)} au {fmt(o.end)} · vérifié le {fmt(o.verified)}</p>
								</div>
								<div class="promo-side">
									{o.code ? <span class="promo-code">{o.code}</span> : <span class="promo-meta">Offre directe</span>}
									<a class="promo-cta" href={o.url} rel="sponsored nofollow noopener" target="_blank">Voir l'offre →</a>
								</div>
							</li>
						))}
					</ul>
				</section>
			))}
			
			<section class="promo-group" data-integration-20261102b-partners-fr aria-label="Partenaires affiliés sans code vérifié">
				<h2>Partenaires (France) — sans code inventé</h2>
