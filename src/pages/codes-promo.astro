---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import SelectionFetes2026 from '../components/SelectionFetes2026.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/siteUrl';
import promos from '../data/promos.json';
import PageColumns from '../components/PageColumns.astro';

// Les offres expirées disparaissent au build (fin incluse, heure de Paris).
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });
const offers = promos.filter((p) => p.lang === 'fr' && p.start <= today && p.end >= today);
const fmt = (d: string) => d.split('-').reverse().join('/');
const groups = [...new Set(offers.map((o) => o.merchant))];
const pageUpdated = today.split('-').reverse().join('/');

const itemListJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Codes promo robots et domotique — sélection Noël 2026',
	dateModified: `${today}T12:00:00+01:00`,
	numberOfItems: offers.length,
	itemListElement: offers.map((o, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'Offer',
			name: o.title,
			url: o.url,
			validFrom: o.start,
			validThrough: o.end,
			priceCurrency: 'EUR',
			availability: 'https://schema.org/InStock',
		},
	})),
};

const noelStarProducts = [
	{
		badge: '6–8 ans • Sans écran',
		name: 'Learning Resources Botley 2.0 (kit 46 pièces)',
		desc: 'Robot programmable par télécommande à flèches, détection d’obstacles et parcours.',
		price: '~69–89 €',
		amzUrl: 'https://www.amazon.fr/dp/B083T5G5ZK?tag=manuso06-21',
		culturaUrl: 'https://www.awin1.com/cread.php?awinmid=113876&awinaffid=3126073&ued=https%3A%2F%2Fwww.cultura.com%2Fsearch%2Fresults%3Fsearch_query%3Dbotley%2Brobot%2Bprogrammable',
		partnerLabel: 'Voir chez Eurekakids',
		partnerUrl: 'https://www.awin1.com/cread.php?awinmid=131482&awinaffid=3126073&ued=https%3A%2F%2Fwww.eurekakids.fr%2F',
	},
	{
		badge: '8–12 ans • Référence Scratch',
		name: 'Makeblock mBot v1.1 (Bluetooth)',
		desc: 'Le robot éducatif le plus utilisé à l’école et à la maison : montage 15 min, mBlock 5 & Arduino.',
		price: '~85–109 €',
		amzUrl: 'https://www.amazon.fr/dp/B07XR98YYQ?tag=manuso06-21',
		culturaUrl: 'https://www.awin1.com/cread.php?awinmid=113876&awinaffid=3126073&ued=https%3A%2F%2Fwww.cultura.com%2Fsearch%2Fresults%3Fsearch_query%3Dmbot%2Bmakeblock',
		partnerLabel: 'Voir chez Makerfire',
		partnerUrl: 'https://www.awin1.com/cread.php?awinmid=127267&awinaffid=3126073&ued=https%3A%2F%2Fshop.makerfire.com%2F',
	},
	{
		badge: '10–14 ans • Scratch & Python',
		name: 'Makeblock mBot2 (avec carte CyberPi Wi-Fi)',
		desc: 'Écran couleur, batterie 5 h intégrée, Wi-Fi IoT, capteurs avancés et programmation Python.',
		price: '~159–179 €',
		amzUrl: 'https://www.amazon.fr/dp/B0919F9CKS?tag=manuso06-21',
		culturaUrl: 'https://www.awin1.com/cread.php?awinmid=113876&awinaffid=3126073&ued=https%3A%2F%2Fwww.cultura.com%2Fsearch%2Fresults%3Fsearch_query%3Dmbot2%2Bmakeblock',
		partnerLabel: 'Voir chez Makerfire',
		partnerUrl: 'https://www.awin1.com/cread.php?awinmid=127267&awinaffid=3126073&ued=https%3A%2F%2Fshop.makerfire.com%2F',
	},
	{
		badge: '12+ ans • Arduino & Makers',
		name: 'ELEGOO Smart Robot Car V4.0 (Caméra Wi-Fi)',
		desc: 'Kit voiture robot Arduino UNO R3 complet avec caméra FPV, suivi de ligne et connecteurs détrompés.',
		price: '~75–95 €',
		amzUrl: 'https://www.amazon.fr/dp/B078Y9RYM2?tag=manuso06-21',
		culturaUrl: 'https://www.awin1.com/cread.php?awinmid=113876&awinaffid=3126073&ued=https%3A%2F%2Fwww.cultura.com%2Fsearch%2Fresults%3Fsearch_query%3Dkit%2Brobot%2Bprogrammable%2Barduino',
		partnerLabel: 'Voir chez SparkBlocks',
		partnerUrl: 'https://www.awin1.com/cread.php?awinmid=130419&awinaffid=3126073&ued=https%3A%2F%2Fsparkblocks.ca%2F',
	},
];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Codes promo Noël 2026 — robots & domotique"
			description="Codes promo vérifiés : Cultura, Amazon, Creality, EcoFlow, Shelly. Sélection Noël 2026 robots éducatifs et domotique (mise à jour quotidienne)."
		/>
		<script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
		<style>
			.promo-wrap { max-width: 960px; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 2rem) 3rem; }
			.promo-wrap h1 { font-family: var(--font-heading); font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 .75rem; }
			.promo-intro { color: var(--text-muted, #555); margin: 0 0 1.5rem; }
			.promo-note { background: #fff8e6; border-left: 4px solid #f5a623; padding: .75rem 1rem; border-radius: 6px; font-size: .95rem; margin: 0 0 2rem; }
			.promo-group h2 { font-size: 1.35rem; margin: 2rem 0 .75rem; }
			.promo-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
			.promo-card { background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1rem 1.1rem; display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; justify-content: space-between; }
			.promo-main { flex: 1 1 260px; min-width: 0; }
			.promo-title { font-weight: 700; margin: 0 0 .3rem; overflow-wrap: anywhere; }
			.promo-meta { font-size: .88rem; color: #5b6470; margin: 0; }
			.promo-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; background: #eef4ff; border: 1px dashed #4a7bd0; border-radius: 6px; padding: .3rem .6rem; letter-spacing: .03em; white-space: nowrap; }
			.promo-cta { display: inline-block; background: var(--primary, #1f5fbf); color: #fff !important; text-decoration: none; font-weight: 700; padding: .55rem 1rem; border-radius: 8px; white-space: nowrap; }
			.promo-side { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
			.promo-foot { margin-top: 2.5rem; font-size: .9rem; color: #5b6470; }
			.noel26-selection { margin: 1.75rem 0 2.25rem; padding: 1.25rem; border-radius: 14px; border: 2px solid #2563eb; background: #f8fafc; }
			.noel26-title { margin: 0 0 .35rem; font-size: 1.35rem; color: #0f172a; }
			.noel26-sub { margin: 0 0 1rem; font-size: .94rem; color: #475569; }
			.noel26-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
			.noel26-card { background: #fff; border: 1px solid #dce3ee; border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: .45rem; }
			.noel26-badge { align-self: flex-start; background: #dbeafe; color: #1e40af; font-size: .75rem; font-weight: 700; padding: .2rem .6rem; border-radius: 99px; }
			.noel26-name { margin: 0; font-size: 1.08rem; line-height: 1.3; }
			.noel26-name a { color: #0f172a; text-decoration: underline; }
			.noel26-desc { margin: 0; font-size: .88rem; color: #475569; }
			.noel26-price { margin: .15rem 0 .35rem; font-weight: 700; font-size: .92rem; white-space: nowrap; }
			.noel26-price a { color: #1d4ed8; text-decoration: underline; white-space: nowrap; }
			.noel26-btns { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: auto; }
			.noel26-btn { display: inline-flex; align-items: center; justify-content: center; padding: .48rem .75rem; border-radius: 8px; font-weight: 700; font-size: .84rem; text-decoration: none !important; flex: 1 1 calc(50% - .3rem); min-width: 125px; text-align: center; }
			.noel26-btn--amz { background: #ff9900; color: #111 !important; }
			.noel26-btn--cultura { background: #004b93; color: #fff !important; }
			.noel26-btn--partner { background: #0f766e; color: #fff !important; }
		</style>
	</head>
	<body>
		<Header />
		<main class="promo-wrap">
<PageColumns>
			<h1>Codes promo et bons plans Noël 2026</h1>
			<p class="promo-intro">Robots éducatifs, Cultura FR, Amazon, imprimantes 3D Creality, stations EcoFlow et domotique Shelly : sélection Noël 2026 et réductions vérifiées. <strong>Dernière vérification globale : {pageUpdated}</strong> (fuseau Europe/Paris).</p>
			<p class="promo-note">Liens affiliés : si vous achetez via ces liens, ROBOT Éducatif peut toucher une commission, sans surcoût pour vous. Les conditions (montant minimum, produits exclus, cumul) sont fixées par chaque marchand : relisez-les sur sa boutique avant de payer.</p>
			<SelectionFetes2026 compact />
			<section class="noel26-selection" aria-label="Sélection cadeaux Noël 2026 multi-marchands">
