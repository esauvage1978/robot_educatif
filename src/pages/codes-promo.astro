---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { withBase } from '../lib/siteUrl';
import promos from '../data/promos.json';

// Les offres expirées disparaissent au build (fin incluse, heure de Paris).
const today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });
const offers = promos.filter((p) => p.lang === 'fr' && p.start <= today && p.end >= today);
const fmt = (d: string) => d.split('-').reverse().join('/');
const groups = [...new Set(offers.map((o) => o.merchant))];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Codes promo et bons plans robotique, 3D et makers"
			description="Codes promo vérifiés de nos partenaires (Creality, Creality Falcon, Batterie-Boutique) : dates de validité, conditions et liens directs. Mise à jour régulière."
		/>
		<style>
			.promo-wrap { max-width: 960px; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 2rem) 3rem; }
			.promo-wrap h1 { font-family: var(--font-heading); font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 .75rem; }
			.promo-intro { color: var(--text-muted, #555); margin: 0 0 1.5rem; }
			.promo-note { background: #fff8e6; border-left: 4px solid #f5a623; padding: .75rem 1rem; border-radius: 6px; font-size: .95rem; margin: 0 0 2rem; }
			.promo-group h2 { font-size: 1.35rem; margin: 2rem 0 .75rem; }
			.promo-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
			.promo-card { background: #fff; border: 1px solid #e3e6ea; border-radius: 10px; padding: 1rem 1.1rem; display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; justify-content: space-between; }
			.promo-main { flex: 1 1 260px; min-width: 0; }
			.promo-title { font-weight: 700; margin: 0 0 .3rem; overflow-wrap: anywhere; }
			.promo-meta { font-size: .88rem; color: #5b6470; margin: 0; }
			.promo-code { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; background: #eef4ff; border: 1px dashed #4a7bd0; border-radius: 6px; padding: .3rem .6rem; letter-spacing: .03em; white-space: nowrap; }
			.promo-cta { display: inline-block; background: var(--primary, #1f5fbf); color: #fff !important; text-decoration: none; font-weight: 700; padding: .55rem 1rem; border-radius: 8px; white-space: nowrap; }
			.promo-side { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
			.promo-foot { margin-top: 2.5rem; font-size: .9rem; color: #5b6470; }
		</style>
	</head>
	<body>
		<Header />
		<main class="promo-wrap">
			<h1>Codes promo et bons plans</h1>
			<p class="promo-intro">Uniquement des offres réelles de nos partenaires, relevées dans leurs programmes d'affiliation. Chaque offre indique sa période de validité et la date de notre dernière vérification ; elle est retirée de la page dès qu'elle expire.</p>
			<p class="promo-note">Liens affiliés : si vous achetez via ces liens, ROBOT Éducatif peut toucher une commission, sans surcoût pour vous. Les conditions (montant minimum, produits exclus, cumul) sont fixées par chaque marchand et vérifiables sur sa boutique au moment du paiement.</p>
			{groups.map((g) => (
				<section class="promo-group">
					<h2>{g} <small style="font-weight:400;color:#5b6470">· {offers.find((o) => o.merchant === g)?.topic}</small></h2>
					<ul class="promo-list">
						{offers.filter((o) => o.merchant === g).map((o) => (
							<li class="promo-card">
								<div class="promo-main">
									<p class="promo-title">{o.title}</p>
									<p class="promo-meta">Valable du {fmt(o.start)} au {fmt(o.end)} · vérifiée le {fmt(o.verified)}</p>
								</div>
								<div class="promo-side">
									{o.code ? <span class="promo-code">{o.code}</span> : <span class="promo-meta">Sans code</span>}
									<a class="promo-cta" href={o.url} rel="sponsored nofollow noopener" target="_blank">Voir l'offre</a>
								</div>
							</li>
						))}
					</ul>
				</section>
			))}
			<p class="promo-foot">Vous cherchez d'abord un robot ou un kit ? Voir notre <a href={withBase('/categorie/')}>index des catégories</a> et les <a href={withBase('/marques/')}>pages marques</a>.</p>
		</main>
		<Footer />
	</body>
</html>
