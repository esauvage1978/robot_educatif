	{entry.slug === 'shelly-pro-3em-negative-power' && (
		<section class="error-section">
			<h2>Réponse rapide (mesure au tableau)</h2>
			<p>
				Le <strong>Shelly Pro 3EM</strong> (module de mesure triphasé au tableau électrique) affiche parfois une{' '}
				<strong>puissance négative</strong> sur une phase : l’énergie semble « produite » alors que vous consommez. Cause
				habituelle : <strong>pince CT</strong> (transformateur de courant) mal orientée ou phase L1/L2/L3 permutée par
				rapport au schéma Shelly.
			</p>
			<img
				src="/images/models/shelly-pro-3em.webp"
				alt="Module Shelly Pro 3EM pour mesure triphasée"
				width="320"
				height="240"
				loading="lazy"
				decoding="async"
				class="error-hero__img"
			/>
			<p class="img-credit" style="font-size:0.85rem;color:rgb(var(--gray-dark));">
				Visuel produit Shelly Pro 3EM — Shelly / usage éditorial.
			</p>
			<h2>Procédure pas à pas (230 V — coupure obligatoire)</h2>
			<ol>
				<li>
					<strong>Couper le disjoncteur général</strong> — aucune mesure de continuité sous tension sur les CT ; port
					EPI (équipement de protection individuelle) si vous ouvrez le tableau.
				</li>
				<li>
					<strong>Photographier l’existant</strong> — repérez L1, L2, L3 sur le bornier Shelly et la couleur des fils
					phase (norme locale).
				</li>
				<li>
					<strong>Pinces CT A / B / C</strong> — la flèche gravée sur la pince doit pointer vers le <strong>tableau /
					consommation</strong> (sens du courant import). Une flèche inversée = kW négatifs.
				</li>
				<li>
					<strong>Correspondance CT ↔ phase</strong> — CT1 sur L1, CT2 sur L2, CT3 sur L3 ; un croisement CT2/L3
					affiche des signes incohérents entre phases.
				</li>
				<li>
					<strong>Remise sous tension</strong> — ouvrez l’app Shelly → Pro 3EM → <em>Settings → Calibration</em> (ou
					équivalent firmware) et lancez la calibration des CT si proposée.
				</li>
				<li>
					<strong>Contrôle de bon sens</strong> — allumez un convecteur connu (2–3 kW) sur la phase testée : la puissance
					doit être <strong>positive</strong> et du bon ordre de grandeur.
				</li>
			</ol>
			<table>
				<thead>
					<tr><th>Observation</th><th>Action probable</th></tr>
				</thead>
				<tbody>
					<tr><td>Une seule phase négative</td><td>Inverser la pince CT de cette phase ou corriger le fil L correspondant</td></tr>
					<tr><td>Deux phases négatives</td><td>Vérifier permutations CT2/CT3 et schéma triphasé</td></tr>
					<tr><td>Total cohérent mais signe global inversé</td><td>Option « reverse direction » dans l’app si disponible, après validation électricien</td></tr>
				</tbody>
			</table>
			<p>
				Intégration domotique :{' '}
				<a href={withBase('/domotique/home-assistant-raspberry-pi-5-installation/')}>installer Home Assistant sur Pi 5</a>
				· projet ESP32 + mesure :{' '}
				<a href={withBase('/domotique/projets-esp32-domotique/')}>projets ESP32 domotique</a>
				· hub : <a href={withBase('/domotique/')}>domotique débutant</a>.
			</p>
		</section>
	)}

	{entry.slug === 'tapo-p110-offline' && (
		<section class="error-section">
			<h2>Guide pas à pas dans Home Assistant (Tapo P110)</h2>
			<ol>
				<li>
					<strong>Vérifier le cloud Tapo</strong> — ouvrez l’application mobile Tapo : si la prise y est « hors ligne », corrigez
					d’abord le Wi-Fi (2,4 GHz, mot de passe, distance au routeur).
				</li>
				<li>
					<strong>IP locale stable</strong> — dans l’app ou le routeur, notez l’adresse IPv4 de la P110 et créez une
					réservation DHCP (même adresse après reboot).
				</li>
				<li>
					<strong>Recharger l’intégration</strong> — Home Assistant → Paramètres → Appareils et services →{' '}
					<strong>TP-Link Tapo</strong> → menu ⋮ → <em>Recharger</em>. Attendez 30 s puis testez l’interrupteur.
				</li>
				<li>
					<strong>Isolement Wi-Fi</strong> — désactivez « AP isolation » / « isolation client » sur le SSID IoT ; sans cela
					Home Assistant ne joint pas la prise malgré un ping OK depuis un autre VLAN.
				</li>
				<li>
					<strong>Compte cloud</strong> — après changement de mot de passe Tapo, supprimez puis re-ajoutez l’intégration avec
					le compte à jour (2FA activée si possible).
				</li>
			</ol>
			<p>
				Pour le maillage domotique : voir le{' '}
				<a href={withBase('/domotique/codes-erreurs-depannage-zigbee-home-assistant-shelly/')}>
					répertoire codes erreurs & dépannage
				</a>{' '}
				et le{' '}
				<a href={withBase('/domotique/debuter-en-domotique-guide-complet/')}>guide débuter en domotique</a>.
			</p>
		</section>
	)}

	{entry.caution?.fr && <RepairCaution lang={lang} text={entry.caution.fr} />}

	{entry.savNote?.fr && (
		<p class="error-sav">
			<strong>{ui.savNote}</strong> — {entry.savNote.fr}
		</p>
	)}

	<p class="error-assist">{assistText}</p>

	{entry.brand_slug === 'arduino' ? (
		<>
			<aside class="repair-compliance repair-compliance--disclaimer" role="note">
				<strong>Clause de non-responsabilité</strong>
				<p>
					Ce guide décrit un problème de téléversement sur carte Arduino (USB, mode DFU). Coupez l’alimentation USB
					avant de changer de câble ou de port. Robot Éducatif décline toute responsabilité en cas de mauvaise
					manipulation. Pour une carte sous garantie, contactez le{' '}
					<a href="https://support.arduino.cc/" rel="noopener noreferrer" target="_blank">support Arduino</a>.
				</p>
			</aside>
			<p>
				Voir aussi le{' '}
				<a href={withBase('/c-arduino-environnement-structure-sketch/')}>cours Arduino en C</a>, le{' '}
				<a href={withBase('/programmation/')}>hub programmation</a> et le{' '}
				<a href={withBase(hubTroubleshootPath)}>répertoire codes erreurs</a>.
				(Les robots Makeblock mBot relèvent d’une autre rubrique :{' '}
				<a href="https://support.makeblock.com/" rel="noopener noreferrer" target="_blank">support Makeblock</a>.)
			</p>
		</>
	) : (
		<RepairComplianceSections lang={lang} variant={complianceVariant} showAssist={false} />
	)}

	{relatedSameBrand.length > 0 && (
		<section class="error-related" aria-labelledby="related-errors-heading">
			<h2 id="related-errors-heading">
				Autres codes erreur {brand?.name ?? entry.brand_slug}
			</h2>
			<ul>
				{relatedSameBrand.map((rel) => (
					<li>
						<a href={withBase(`/domotique/code-erreur/${rel.slug}/`)}>
							<code>{rel.error_code}</code> — {rel.title.fr}
						</a>
					</li>
				))}
			</ul>
		</section>
	)}
</DomotiqueToolLayout>

