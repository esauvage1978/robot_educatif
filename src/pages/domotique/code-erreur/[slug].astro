---
import DomotiqueToolLayout from '../../../layouts/DomotiqueToolLayout.astro';
import RepairIndicators from '../../../components/RepairIndicators.astro';
import RepairCaution from '../../../components/RepairCaution.astro';
import RepairComplianceSections from '../../../components/RepairComplianceSections.astro';
import { PROFESSIONAL_ASSISTANCE, PROFESSIONAL_ASSISTANCE_ROBOT, PROFESSIONAL_ASSISTANCE_LOW_VOLTAGE } from '../../../data/repairCompliance.mjs';
import { TROUBLE_UI } from '../../../data/smartHomeTroubleshooting.mjs';
import {
	BRANDS,
	PRODUCTS,
	getAllCatalogEntries,
} from '../../../data/unifiedErrorCatalog.mjs';
import { withBase } from '../../../lib/siteUrl';
import { ARTICLE_AUTHOR } from '../../../consts';
import { buildErrorCodeSeoTitle } from '../../../lib/pageTitle';

export function getStaticPaths() {
	const entries = getAllCatalogEntries();
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

type Props = {
	entry: ReturnType<typeof getAllCatalogEntries>[number];
};

const { entry } = Astro.props as Props;
const lang = 'fr';
const ui = TROUBLE_UI[lang];
const productBySlug = Object.fromEntries(PRODUCTS.map((p) => [p.slug, p]));
const brandBySlug = Object.fromEntries(BRANDS.map((b) => [b.slug, b]));

const primaryProduct = entry.product_slug ? productBySlug[entry.product_slug] : null;
const productLabel = primaryProduct?.name ?? entry.product_slug ?? '';
const brand = brandBySlug[entry.brand_slug];
const imageSrc = primaryProduct?.image_url ?? `/images/models/${entry.product_slug}.webp`;

const pageTitle = buildErrorCodeSeoTitle(
	entry.error_code,
	entry.title.fr,
	productLabel,
	entry.brand_slug,
);
const META_DESCRIPTIONS: Record<string, string> = {
	'z2m-205':
		"Error 205 Zigbee2MQTT à l'appairage : rapprochez le capteur, relancez l'interview ZDO, canal Zigbee fixe. Pas à pas Sonoff dongle et FAQ.",
	'aqara-thermostat-e1-e2':
		'Codes E1 ou E2 sur tête Aqara T1 : calibrage vanne M30, adaptateur compatible, piston grippé. Étapes copiables dans Aqara Home.',
	'aqara-p2-matter-pase-timeout':
		'PASE timeout Matter sur Aqara P2 : border router Thread, reset 10 s, même compte. Pas à pas Home Assistant et Aqara Home.',
	'hue-motion-red-led-zigbee':
		'LED rouge Hue Motion à chaque passage : pile CR2450, canal Zigbee, Bridge injoignable. Diagnostic pas à pas.',
	'arduino-permission-denied-linux':
		'Permission denied sur /dev/ttyUSB0 (Linux) : groupe dialout, nouvelle session, pas de mBlock en root. Commandes copiables Arduino IDE.',
	'sonoff-zbmini-l2-led-blink':
		'ZBMini-L2 : lampe qui clignote sans neutre. Coupure disjoncteur, bypass Sonoff, charge min 3 W. Pas à pas Zigbee.',
	'homey-pro-red-ring-recovery':
		'Anneau rouge pulse sur Homey Pro : laisser refroidir, recovery USB Athom, libérer eMMC. Pas à pas sans ouvrir le boîtier.',
	'z2m-interview-failed':
		'Interview failed Zigbee2MQTT : converters à jour, reset fabricant, réappairage à 50 cm du dongle. Pas à pas Z2M vérifiable.',
};
const description =
	META_DESCRIPTIONS[entry.slug] ?? `${entry.symptoms.fr}`.slice(0, 158).trim();
const articlePath = `/domotique/code-erreur/${entry.slug}/`;
const hubTroubleshootPath = '/domotique/codes-erreurs-depannage-zigbee-home-assistant-shelly/';
const pubDate = new Date('2026-10-24T00:00:00Z');

const modelSlugs = [
	...(entry.product_slug ? [entry.product_slug] : []),
	...(entry.applicable_products || []),
];
const applicableNames = [...new Set(modelSlugs)]
	.map((slug) => productBySlug[slug]?.name ?? slug)
	.filter(Boolean);

const relatedSameBrand = getAllCatalogEntries()
	.filter((e) => e.brand_slug === entry.brand_slug && e.slug !== entry.slug)
	.slice(0, 8);

const toolsStr =
	typeof entry.tools === 'string' ? entry.tools : entry.tools?.fr ?? '';

const MAINS_CATEGORIES = new Set(['micromodules-relais']);
const isMakeblockRobot =
	entry.brand_slug === 'makeblock' || (entry.ecosystem?.includes('makeblock') ?? false);
const isEducRobot = entry.category_slug === 'robots-educatifs';
const isLowVoltageDomotique =
	(!isEducRobot && !MAINS_CATEGORIES.has(entry.category_slug)) ||
	(isEducRobot && entry.brand_slug === 'arduino');
const complianceVariant = isMakeblockRobot
	? 'makeblock-only'
	: isLowVoltageDomotique
		? 'low-voltage-domotique'
		: 'smart-home';
const assistText = isMakeblockRobot
	? PROFESSIONAL_ASSISTANCE_ROBOT[lang]
	: isLowVoltageDomotique
		? PROFESSIONAL_ASSISTANCE_LOW_VOLTAGE[lang]
		: PROFESSIONAL_ASSISTANCE[lang];

const pageUrl = new URL(withBase(articlePath), Astro.site).toString();
const faqItems = [
	{
		question: `Que signifie le code ou symptôme « ${entry.error_code} » sur ${productLabel} ?`,
		answer: entry.symptoms.fr,
	},
	{
		question: `Comment résoudre « ${entry.error_code} » (${entry.title.fr}) ?`,
		answer: entry.fix.fr,
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'TechArticle',
			headline: pageTitle,
			description,
			datePublished: pubDate.toISOString(),
			author: { '@type': 'Person', name: ARTICLE_AUTHOR },
			image: new URL(withBase(imageSrc), Astro.site).toString(),
			mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: { '@type': 'Answer', text: item.answer },
			})),
		},
	],
};
---

<DomotiqueToolLayout
	title={pageTitle}
	description={description}
	lang={lang}
	pubDate={pubDate}
	articlePath={articlePath}
	hubLabel="Domotique"
	repairGuide={true}
	skipDefaultBreadcrumb={true}
	breadcrumbItems={[
		{ name: 'Accueil', url: withBase('/') },
		{ name: 'Domotique', url: withBase('/domotique/') },
		{ name: 'Codes erreurs & dépannage', url: withBase(hubTroubleshootPath) },
		{ name: entry.error_code, url: withBase(articlePath) },
	]}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<nav class="breadcrumb error-breadcrumb" aria-label="Fil d'Ariane">
		<a href={withBase('/')}>Accueil</a> · <a href={withBase('/domotique/')}>Domotique</a> · <a href={withBase(hubTroubleshootPath)}>Codes erreurs & dépannage</a> · {entry.error_code}
	</nav>

	<p class="error-hub-intro">
		Cette fiche fait partie du <a href={withBase('/domotique/')}>hub domotique</a> et du{' '}
		<a href={withBase(hubTroubleshootPath)}>répertoire codes erreurs Zigbee & Home Assistant</a>.
		Pour choisir une clé USB : <a href={withBase('/domotique/meilleur-dongle-zigbee-home-assistant/')}>comparatif dongles Zigbee</a>.
	</p>

	<div class="error-hero">
		<img
			src={imageSrc}
			alt={productLabel}
			width="240"
			height="180"
			loading="eager"
			decoding="async"
			class="error-hero__img"
		/>
		<div class="error-hero__text">
			<p class="error-hero__code"><code>{entry.error_code}</code></p>
			<p class="error-hero__brand">
				<strong>Marque :</strong> {brand?.name ?? entry.brand_slug}
			</p>
			{applicableNames.length > 0 && (
				<p class="error-hero__models">
					<strong>Modèles concernés :</strong> {applicableNames.join(', ')}
				</p>
			)}
		</div>
	</div>

	<RepairIndicators
		lang={lang}
		difficulty={entry.difficulty as 1 | 2 | 3 | 4 | 5}
		time={entry.time}
		cost={entry.cost}
		tools={toolsStr}
	/>

	{entry.slug === 'z2m-205' && (
		<section class="error-section">
			<h2>Réponse rapide (Error 205)</h2>
			<p>
				<strong>Symptôme :</strong> l’appairage Zigbee s’arrête avec « <strong>Error 205</strong> » ou un timeout{' '}
				<strong>ZDO</strong> (Zigbee Device Object — échange de découverte entre capteur et coordinateur) après environ
				10 secondes dans les journaux <strong>Zigbee2MQTT</strong> (Z2M — passerelle logicielle qui fait dialoguer vos
				capteurs Zigbee avec Home Assistant).
			</p>
			<p>
				<strong>Cause la plus fréquente :</strong> le capteur est trop loin du dongle USB, dort sur pile avant la fin de
				l’« interview », ou le canal <strong>2,4 GHz</strong> est saturé (Wi-Fi + Zigbee partagent la bande).
			</p>
			<ol>
				<li>
					Placez l’appareil à <strong>moins d’1 m</strong> du coordinateur (clé Sonoff ZBDongle-E/P ou équivalent).
				</li>
				<li>
					Activez le mode appairage sur le capteur (bouton fabricant jusqu’au clignotement rapide).
				</li>
				<li>
					Dans l’interface Z2M, supprimez l’appareil « fantôme » puis relancez l’appairage.
				</li>
				<li>
					Fixez un <strong>canal Zigbee</strong> (15, 20 ou 25) loin du Wi-Fi ; évitez le canal 11 si votre box Wi-Fi
					est aussi sur 11.
				</li>
				<li>
					Sur <strong>ZBDongle-E</strong> : firmware <strong>Ember</strong> à jour (<code>adapter: ember</code> dans
					configuration.yaml).
				</li>
			</ol>
			<p>
				Hub domotique : <a href={withBase('/domotique/')}>guide domotique</a> · répertoire :{' '}
				<a href={withBase(hubTroubleshootPath)}>codes erreurs Zigbee &amp; Home Assistant</a> ·{' '}
				<a href={withBase('/domotique/meilleur-dongle-zigbee-home-assistant/')}>comparatif dongles Zigbee</a> ·{' '}
				<a href={withBase('/domotique/home-assistant-zigbee2mqtt-ou-zha/')}>Zigbee2MQTT ou ZHA</a> · fiche liée :{' '}
				<a href={withBase('/domotique/code-erreur/z2m-interview-failed/')}>Interview failed</a>.
			</p>
			<h3>Exemple de journal</h3>
			<pre class="error-log"><code>{`z2m: Interview failed because Error: AREQ - ZDO response after 10000ms
z2m: Failed to configure 'capteur_porte', attempt 1/5, error: Error 205`}</code></pre>
			<h3>FAQ Error 205</h3>
			<ul>
				<li>
					<strong>Capteur sur pile Aqara ?</strong> Réveillez-le (ouvrez la porte / passez devant le PIR) pendant
					l’appairage.
				</li>
				<li>
					<strong>Prise Sonoff routeur ?</strong> Coupez temporairement une prise Zigbee instable qui flood le réseau.
				</li>
				<li>
					<strong>Toujours bloqué ?</strong> Mettez Z2M à jour (converters) puis réinitialisez le capteur (procédure
					constructeur).
				</li>
			</ul>
		</section>
	)}

	{entry.slug === 'z2m-interview-failed' && (
		<section class="error-section">
			<h2>Réponse rapide (« Interview failed » — Zigbee2MQTT)</h2>
			<p>
				<strong>Symptôme :</strong> l’appareil apparaît dans <strong>Zigbee2MQTT</strong> (Z2M — passerelle logicielle entre capteurs Zigbee et{' '}
				<strong>Home Assistant</strong>) mais l’« <strong>interview</strong> » (échange ZCL où le coordinateur lit les clusters du capteur) échoue :
				entités manquantes, statut <code>unsupported</code>, ou message <code>Interview failed</code> dans les journaux.
			</p>
			<p>
				<img src={withBase('/images/models/aqara-motion-p2.webp')} alt="Capteur Zigbee Aqara — exemple d’appareil concerné par interview failed" width="640" height="360" loading="lazy" />
				<em>Exemple de capteur Zigbee (Aqara Motion P2) — le même type d’erreur touche aussi Sonoff, Tuya sans hub, etc.</em>
			</p>
			<h3>Pas à pas (15 min, 0 € si dongle déjà en place)</h3>
			<ol>
				<li>
					<strong>Mettre Z2M à jour</strong> (conteneur Docker ou add-on HA) — les <strong>converters</strong> (fichiers qui décrivent chaque
					modèle) corrigent souvent les « unsupported ».
				</li>
				<li>
					<strong>Supprimer l’appareil</strong> dans l’interface Z2M (pas seulement dans Home Assistant) — évite les doublons « fantômes ».
				</li>
				<li>
					<strong>Réinitialisation fabricant</strong> — bouton 5–10 s (Aqara : ouvrir capteur + appui long ; Tuya sans gateway : clignotement
					rapide jusqu’à relâcher).
				</li>
				<li>
					<strong>Réappairer à &lt; 50 cm</strong> du dongle USB (Sonoff ZBDongle-E/P ou ConBee) — pas depuis un autre étage.
				</li>
				<li>
					<strong>Capteur sur pile :</strong> réveillez-le pendant l’interview (mouvement PIR, ouverture porte) — sinon il dort et l’interview
					échoue.
				</li>
				<li>
					<strong>Canal Zigbee fixe</strong> (15, 20 ou 25) loin du Wi-Fi 2,4 GHz — voir{' '}
					<a href={withBase('/domotique/code-erreur/z2m-205/')}>Error 205</a> pour le même principe de proximité.
				</li>
			</ol>
			<table>
				<thead>
					<tr>
						<th>Cause fréquente</th>
						<th>Indice dans les logs</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Converter manquant / obsolète</td>
						<td><code>Unsupported device</code></td>
						<td>MAJ Z2M + issue GitHub zigbee-herdsman-converters</td>
					</tr>
					<tr>
						<td>Capteur endormi (pile)</td>
						<td>Timeout ZDO 10 s</td>
						<td>Réveil physique pendant appairage</td>
					</tr>
					<tr>
						<td>Trop loin du coordinateur</td>
						<td><code>No network route</code> puis failed</td>
						<td>Rapprocher + routeur Zigbee alimenté</td>
					</tr>
				</tbody>
			</table>
			<h3>Exemple de journal</h3>
			<pre class="error-log"><code>{`z2m: Interview failed for '0x…' (model XYZ)
z2m: Device 'capteur_salon' supported: false`}</code></pre>
			<p>
				<a href={withBase('/domotique/')}>Hub domotique</a> ·{' '}
				<a href={withBase(hubTroubleshootPath)}>répertoire codes erreurs</a> ·{' '}
				<a href={withBase('/domotique/home-assistant-zigbee2mqtt-ou-zha/')}>Zigbee2MQTT ou ZHA</a> ·{' '}
				<a href={withBase('/domotique/meilleur-dongle-zigbee-home-assistant/')}>comparatif dongles Zigbee</a> ·{' '}
				<a href={withBase('/domotique/code-erreur/z2m-no-route/')}>No network route</a> ·{' '}
				<a href={withBase('/domotique/code-erreur/z2m-205/')}>Error 205</a>.
			</p>
			<h3>FAQ Interview failed</h3>
			<ul>
				<li>
					<strong>ZHA au lieu de Z2M ?</strong> Même logique d’interview — voir{' '}
					<a href={withBase('/domotique/code-erreur/zha-probe-failed/')}>Failed to probe (ZHA)</a>.
				</li>
				<li>
					<strong>Toujours unsupported après MAJ ?</strong> Vérifiez la garantie constructeur avant d’ouvrir le boîtier (SAV Aqara,
					Sonoff…).
				</li>
				<li>
					<strong>Home Assistant Yellow / Green ?</strong> Le coordinateur intégré ou USB suit les mêmes règles de proximité et de
					firmware Ember/EZSP — voir{' '}
					<a href={withBase('/domotique/raspberry-pi-station-meteo-bme280-historique/')}>autres projets Pi</a> si vous testez sur Pi 5.
				</li>
			</ul>
		</section>
	)}

	{entry.slug === 'aqara-thermostat-e1-e2' && (
		<section class="error-section">
			<h2>Réponse rapide (E1 / E2 — vanne M30)</h2>
			<p>
				<strong>E1 ou E2</strong> sur l’écran de la <strong>tête thermostatique Aqara T1</strong> signifie en général que
				la <strong>course de vanne M30×1,5</strong> (filetage standard des radiateurs en France) n’est pas calibrée, ou que
				le <strong>piston</strong> est grippé / bloqué.
			</p>
			<h3>Calibrage M30 — pas à pas (Aqara Home)</h3>
			<ol>
				<li>
					<strong>Chauffage coupé</strong> — attendez que le radiateur soit tiède ; notez la température ambiante.
				</li>
				<li>
					<strong>Démontez la tête</strong> — tournez le corps sans forcer ; vérifiez l’<strong>adaptateur M30</strong>{' '}
					(livré avec la tête : RA, RAV, Giacomini…).
				</li>
				<li>
					<strong>Tournez la vanne à la main</strong> — ouverture / fermeture complète sans outil électrique ; si ça
					grince, purgez le radiateur ou remplacez l’insert.
				</li>
				<li>
					<strong>Remontez la tête</strong> — vissez jusqu’au contact, sans écraser le joint.
				</li>
				<li>
					<strong>App Aqara Home</strong> — appareil → <em>Paramètres</em> → <strong>Calibrage vanne / Valve
					calibration</strong> → lancez la procédure (2–3 min, bruit moteur normal).
				</li>
				<li>
					<strong>Test consigne</strong> — baissez à 18 °C puis remontez à 21 °C : la vanne doit claquer une fois, pas en
					boucle.
				</li>
			</ol>
			<p>
				Comparatif têtes connectées :{' '}
				<a href={withBase('/domotique/debuter-en-domotique-guide-complet/')}>guide débuter en domotique</a> ·{' '}
				<a href={withBase(hubTroubleshootPath)}>répertoire dépannage</a> ·{' '}
				<a href={withBase('/domotique/')}>hub domotique</a> ·{' '}
				<a href={withBase('/domotique/code-erreur/aqara-thermostat-calibration/')}>écart de température T1</a>.
			</p>
			<h3>FAQ E1 / E2</h3>
			<ul>
				<li>
					<strong>Adaptateur incorrect ?</strong> Mesurez le filetage (M30 vs M28) avant d’acheter un adaptateur tiers.
				</li>
				<li>
					<strong>Erreur après purge ?</strong> Relancez un calibrage : l’air dans le corps peut bloquer le piston.
				</li>
				<li>
					<strong>Sous garantie ?</strong> Contact Aqara si le moteur ne bouge plus après calibrage (ne pas ouvrir la
					tête sous garantie sans accord SAV).
				</li>
			</ul>
		</section>
	)}

	{entry.slug === 'aqara-p2-matter-pase-timeout' && (
		<section class="error-section">
			<h2>Réponse rapide (PASE timeout — Matter / Thread)</h2>
			<p>
				<strong>Symptôme :</strong> l’ajout Matter du capteur <strong>Aqara P2</strong> (portes/fenêtres ou mouvement) échoue avec «{' '}
				<strong>PASE timeout</strong> » ou « setup failed ». <strong>PASE</strong> (*Password Authenticated Session Establishment*) est
				la première étape chiffrée du protocole <strong>Matter</strong> (standard maison connectée inter-marques). Sans{' '}
				<strong>border router Thread</strong> (routeur filaire IPv6 pour le maillage Thread), la session expire — le Wi-Fi seul ne suffit pas.
			</p>
			<p>
				<img src={withBase('/images/products/aqara-door-window-p2.webp')} alt="Capteur Aqara Door and Window P2" width="640" height="360" loading="lazy" />
				<em>Photo produit Aqara P2 — usage éditorial robot-educatif.info.</em>
			</p>
			<h3>Matter vs Zigbee sur le même P2</h3>
			<table>
				<thead>
					<tr>
						<th>Stack</th>
						<th>Prérequis</th>
						<th>Symptôme si manquant</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td><strong>Matter</strong></td>
						<td>Border router Thread + même compte</td>
						<td>PASE timeout, pairing failed</td>
					</tr>
					<tr>
						<td><strong>Zigbee</strong></td>
						<td>Hub Aqara / dongle ZHA ou Z2M</td>
						<td>Interview failed (autre fiche)</td>
					</tr>
				</tbody>
			</table>
			<h3>Marche à suivre (20 min)</h3>
			<ol>
				<li>
					Listez vos border routers : <strong>Hub Aqara M3</strong>, <strong>Homey Pro</strong>, <strong>Apple TV 4K</strong>{' '}
					(Thread), ou intégration Matter de votre box — au moins un doit être <em>En ligne</em>.
				</li>
				<li>
					Même « maison » Matter / même compte Aqara — supprimez un ancien appairage Google Home seul si le QR est déjà consommé.
				</li>
				<li>
					Rapprochez le P2 à <strong>moins de 3 m</strong> du routeur Thread (pas du Wi-Fi seulement).
				</li>
				<li>
					<strong>Reset usine</strong> : bouton 10 s → clignotement rapide (voir notice P2).
				</li>
				<li>
					Désactivez VPN / DNS filtrant sur le téléphone pendant le scan du QR Matter.
				</li>
				<li>
					Relancez l’ajout dans <strong>Aqara Home</strong> ou <strong>Home Assistant</strong> (Matter) — attendez la fin sans
					verrouiller l’écran.
				</li>
			</ol>
			<p>
				<a href={withBase('/domotique/')}>Hub domotique</a> ·{' '}
				<a href={withBase(hubTroubleshootPath)}>codes erreurs Zigbee et Home Assistant</a> ·{' '}
				<a href={withBase('/domotique/protocoles-domotique-zigbee-wifi-thread-matter/')}>Zigbee, Wi-Fi, Thread, Matter</a> ·{' '}
				<a href={withBase('/domotique/code-erreur/homey-matter-failed/')}>Matter pairing failed (Homey)</a> ·{' '}
				<a href={withBase('/domotique/meilleur-dongle-zigbee-home-assistant/')}>comparatif dongles Zigbee</a> ·{' '}
				<a href={withBase('/domotique/code-erreur/aqara-interview-sleep/')}>Aqara interview failed</a>.
			</p>
			<h3>FAQ P2 Matter</h3>
			<ul>
				<li>
					<strong>P2 en Zigbee OK mais Matter KO ?</strong> Deux stacks : migrez Matter seulement quand Thread est stable.
				</li>
				<li>
					<strong>Pas de border router ?</strong> Ajoutez un M3 ou Homey — le Wi-Fi seul ne suffit pas à Thread.
				</li>
				<li>
