---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DomotiquePost from '../../layouts/DomotiquePost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('domotique');
	return posts.map((entry) => ({
		params: { slug: entry.id.replace(/\.mdx?$/, '') },
		props: { entry },
	}));
}

type Props = {
	entry: CollectionEntry<'domotique'>;
};

const { entry } = Astro.props as Props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const articleSlug = entry.id.replace(/\.mdx?$/, '');
const fromRemark = Number(remarkPluginFrontmatter?.minutesRead);
const rawBody = typeof entry.body === 'string' ? entry.body : '';
const fromBody = rawBody
	? Math.max(1, Math.round(rawBody.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length / 200))
	: NaN;
const minutesRead = Number.isFinite(fromRemark) && fromRemark > 0 ? fromRemark : fromBody;
---

<DomotiquePost {...entry.data} articleSlug={articleSlug} faqSchema={remarkPluginFrontmatter?.faqSchema} minutes={Number.isFinite(minutesRead) ? minutesRead : undefined}>
	<Content />
</DomotiquePost>
