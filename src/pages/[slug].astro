---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { articleSlugFromId } from '../lib/articleSlug';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: articleSlugFromId(post.id) },
		props: { post },
	}));
}

type Props = {
	post: CollectionEntry<'blog'>;
};

const { post } = Astro.props as Props;
const { Content, remarkPluginFrontmatter } = await render(post);
const articleSlug = articleSlugFromId(post.id);
const fromRemark = Number(remarkPluginFrontmatter?.minutesRead);
const rawBody = typeof post.body === 'string' ? post.body : '';
const fromBody = rawBody
	? Math.max(1, Math.round(rawBody.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length / 200))
	: NaN;
const minutesRead = Number.isFinite(fromRemark) && fromRemark > 0 ? fromRemark : fromBody;
---

<BlogPost {...post.data} articleSlug={articleSlug} faqSchema={remarkPluginFrontmatter?.faqSchema} minutes={Number.isFinite(minutesRead) ? minutesRead : undefined}>
	<Content />
</BlogPost>
