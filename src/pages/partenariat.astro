---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { ARTICLE_AUTHOR, CONTACT_EMAIL } from '../consts';
import { withBase } from '../lib/siteUrl';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const guideCount = allPosts.length;

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Partenariat — ROBOT éducatif')}`;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Partenariat marques — Testez vos produits avec nous"
			description="Partenariat : tests produits, tutoriels détaillés, présence YouTube et Pinterest. Audience qualifiée de parents, enseignants et passionnés de robotique éducative."
		/>
		<style>
			body {
				background: var(--page-bg);
			}
			
			.hero {
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
				color: white;
				padding: 4rem clamp(1rem, 5vw, 2rem) 4.5rem;
				text-align: center;
			}
			
			.hero h1 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(2rem, 4vw, 3rem);
				margin: 0 0 1.25rem 0;
				color: white;
			}
			
			.hero p {
				font-size: clamp(1.1rem, 1.5vw, 1.3rem);
				max-width: 700px;
				margin: 0 auto 2rem;
				opacity: 0.95;
				line-height: 1.6;
			}
			
			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 clamp(1rem, 5vw, 2rem);
			}
			
			.section {
				padding: 4rem 0;
			}
			
			.section-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			
			.section-header h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				color: rgb(var(--black));
				margin: 0 0 1rem 0;
			}
			
			.section-header p {
				font-size: 1.15rem;
				color: rgb(var(--gray-dark));
				max-width: 650px;
				margin: 0 auto;
			}
			
			.stats-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
				gap: 2rem;
				margin-bottom: 3rem;
			}
			
			.stat-card {
				background: var(--surface);
				border: 2px solid var(--surface-border);
				border-radius: 16px;
				padding: 2rem 1.75rem;
				text-align: center;
				transition: all 0.3s ease;
			}
			
			.stat-card:hover {
				border-color: var(--primary);
				transform: translateY(-4px);
				box-shadow: 0 8px 24px rgba(15, 118, 110, 0.15);
			}
			
			.stat-value {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 2.5rem;
				color: var(--primary);
				display: block;
				margin-bottom: 0.5rem;
			}
			
			.stat-label {
				color: rgb(var(--gray-dark));
				font-size: 1.05rem;
				font-weight: 600;
			}
			
			.offerings-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
				gap: 2rem;
			}
			
			.offering-card {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 16px;
				padding: 2rem;
			}
			
			.offering-icon {
				width: 48px;
				height: 48px;
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
				border-radius: 12px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				margin-bottom: 1.25rem;
			}
			
			.offering-card h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.35rem;
				color: rgb(var(--black));
				margin: 0 0 0.75rem 0;
			}
			
			.offering-card p {
				color: rgb(var(--gray-dark));
				line-height: 1.65;
				margin: 0;
			}
			
			.channels {
				background: var(--surface);
				border-radius: 20px;
				padding: 3rem 2.5rem;
				margin: 3rem 0;
			}
			
			.channels h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.75rem;
				color: rgb(var(--black));
				margin: 0 0 2rem 0;
				text-align: center;
			}
			
			.channels-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
				gap: 2rem;
				text-align: center;
			}
			
			.channel-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 1rem;
			}
			
			.channel-icon {
				width: 64px;
				height: 64px;
				background: var(--surface-2);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--primary);
			}
			
			.channel-icon svg {
				width: 32px;
				height: 32px;
			}
			
			.channel-name {
				font-weight: 700;
				font-size: 1.1rem;
				color: rgb(var(--black));
			}
			
			.channel-link {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				word-break: break-all;
			}
			
			.cta-section {
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
				color: white;
				border-radius: 20px;
				padding: 3.5rem 2.5rem;
				text-align: center;
				margin: 3rem 0;
			}
			
			.cta-section h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				margin: 0 0 1rem 0;
			}
			
			.cta-section p {
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				opacity: 0.95;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
			}
			
			.cta-buttons {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			
			.btn {
				display: inline-block;
				padding: 15px 30px;
				border-radius: 12px;
				font-weight: 700;
				text-decoration: none;
				font-size: 1.05rem;
				transition: all 0.2s ease;
			}
			
			.btn-white {
				background: white;
				color: var(--primary);
			}
			
			.btn-white:hover {
				background: var(--page-bg);
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
			}
			
			.btn-outline {
				background: transparent;
				color: white;
				border: 2px solid white;
			}
			
			.btn-outline:hover {
				background: white;
				color: var(--primary);
			}
			
			.transparency {
				background: var(--surface-2);
				border-left: 4px solid var(--primary);
				border-radius: 12px;
				padding: 2rem;
				margin: 3rem 0;
			}
			
			.transparency h3 {
				font-weight: 700;
				font-size: 1.25rem;
				color: rgb(var(--black));
				margin: 0 0 1rem 0;
			}
			
			.transparency p {
				color: rgb(var(--gray-dark));
				line-height: 1.7;
				margin: 0;
			}
			
			@media (max-width: 768px) {
				.section {
					padding: 2.5rem 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Partenariat marques</h1>
				<p>
					Faites découvrir vos produits de robotique éducative à une audience qualifiée de parents, 
					enseignants et passionnés. Tests détaillés, tutoriels pratiques, présence multi-canaux.
				</p>
			</section>
			
			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Notre audience</h2>
						<p>Une communauté engagée autour de la robotique et de la programmation éducative</p>
					</div>
					
					<div class="stats-grid">
						<div class="stat-card">
							<span class="stat-value">{guideCount}</span>
							<span class="stat-label">Guides détaillés</span>
						</div>
						<div class="stat-card">
							<span class="stat-value">6-15</span>
							<span class="stat-label">Tranches d'âge couvertes</span>
						</div>
						<div class="stat-card">
							<span class="stat-value">100%</span>
							<span class="stat-label">Tests en conditions réelles</span>
						</div>
					</div>
					
					<div class="channels">
						<h3>Notre présence multi-canaux</h3>
						<div class="channels-grid">
							<div class="channel-item">
								<div class="channel-icon">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm4.441 16.892c-2.102.144-6.784.144-8.883 0-2.276-.156-2.541-1.27-2.558-4.892.017-3.629.285-4.736 2.558-4.892 2.099-.144 6.782-.144 8.883 0 2.277.156 2.541 1.27 2.559 4.892-.018 3.629-.285 4.736-2.559 4.892zM10 9.658l4.917 2.338L10 14.342V9.658z"/>
									</svg>
								</div>
								<div>
									<div class="channel-name">YouTube</div>
									<div class="channel-link">@roboteducatif6268</div>
								</div>
							</div>
							<div class="channel-item">
								<div class="channel-icon">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
									</svg>
								</div>
								<div>
									<div class="channel-name">Pinterest</div>
									<div class="channel-link">@roboteducatif</div>
								</div>
							</div>
							<div class="channel-item">
								<div class="channel-icon">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
									</svg>
								</div>
								<div>
									<div class="channel-name">Facebook</div>
									<div class="channel-link">roboteducatif.info</div>
								</div>
							</div>
							<div class="channel-item">
								<div class="channel-icon">
									<svg viewBox="0 0 24 24" fill="currentColor">
										<path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121L7.113 13.72l-2.907-.909c-.632-.198-.644-.632.133-.93l11.356-4.377c.528-.176.99.128.82.917z"/>
									</svg>
								</div>
								<div>
									<div class="channel-name">Site web</div>
									<div class="channel-link">robot-educatif.info</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			
			<section class="section" style="background: var(--surface-2);">
				<div class="container">
					<div class="section-header">
						<h2>Ce que nous proposons</h2>
						<p>Des collaborations authentiques et transparentes</p>
					</div>
					
					<div class="offerings-grid">
						<div class="offering-card">
							<div class="offering-icon">📝</div>
							<h3>Tests produits détaillés</h3>
							<p>
								Articles approfondis avec installation, utilisation en conditions réelles, points forts 
								et limites. Pas de complaisance : nous testons vraiment.
							</p>
						</div>
						
						<div class="offering-card">
							<div class="offering-icon">📚</div>
							<h3>Tutoriels pratiques</h3>
							<p>
								Guides pas à pas pour vos produits : installation, premiers projets, résolution 
								de problèmes courants. Valeur ajoutée pour vos clients.
							</p>
						</div>
						
						<div class="offering-card">
							<div class="offering-icon">🎥</div>
							<h3>Contenus vidéo</h3>
							<p>
								Présence sur YouTube avec démos, unboxing et tutoriels vidéo. Format engageant 
								pour montrer vos produits en action.
							</p>
						</div>
						
						<div class="offering-card">
							<div class="offering-icon">📊</div>
							<h3>Comparatifs objectifs</h3>
							<p>
								Comparaisons entre produits similaires pour aider les parents et enseignants 
								à choisir ce qui leur convient le mieux.
							</p>
						</div>
						
						<div class="offering-card">
							<div class="offering-icon">👥</div>
							<h3>Retours terrain</h3>
							<p>
								Tests avec des enfants et en situation d'enseignement quand c'est possible. 
								Retours authentiques d'utilisation réelle.
							</p>
						</div>
						
						<div class="offering-card">
							<div class="offering-icon">🔗</div>
							<h3>Visibilité longue durée</h3>
							<p>
								Articles pérennes qui continuent d'être consultés. Pas de contenu éphémère : 
								visibilité qui dure dans le temps.
							</p>
						</div>
					</div>
					
					<div class="transparency">
						<h3>🛡️ Transparence et éthique</h3>
						<p>
							Tous nos partenariats sont clairement mentionnés. Nous gardons notre indépendance éditoriale : 
							un produit qui ne convainc pas sera critiqué constructivement. Notre crédibilité auprès de notre 
							audience est notre premier atout, et nous la préservons par l'honnêteté.
						</p>
					</div>
				</div>
			</section>
			
			<section class="section">
				<div class="container">
					<div class="cta-section">
						<h2>Travaillons ensemble</h2>
						<p>
							Vous souhaitez faire connaître votre produit de robotique éducative ? 
							Contactez-nous pour discuter d'un partenariat sur mesure.
						</p>
						<div class="cta-buttons">
							<a href={mailtoHref} class="btn btn-white">
								Nous contacter par email
							</a>
							<a href={withBase('/contact/')} class="btn btn-outline">
								Formulaire de contact
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
