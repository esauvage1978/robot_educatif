---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { buildCategoryIndex } from '../../lib/categories';
import { SITE_TITLE } from '../../consts';
import PageColumns from '../../components/PageColumns.astro';

const posts = await getCollection('blog');
const index = buildCategoryIndex(posts);
const entries = [...index.values()].sort((a, b) => a.label.localeCompare(b.label, 'fr'));

type ThemedBlock = { title: string; intro: string; slugs: string[] };

const THEME_BLOCKS: ThemedBlock[] = [
	{
		title: 'Robots éducatifs & kits',
		intro:
			'mBot, Makeblock, Matatalab, comparatifs d’achat et activités en classe ou à la maison — idéal pour choisir un robot par âge.',
		slugs: [
			'mbot',
			'a-partir-de-4-ans',
			'a-partir-de-5-ans',
			'a-partir-de-6-ans',
			'a-partir-de-8-ans',
			'a-partir-de-10-ans',
			'a-partir-de-12-ans',
			'matatalab',
			'makeblock',
			'lego',
			'guide',
		],
	},
	{
		title: 'Programmation & logiciels',
		intro:
			'mBlock, Scratch, Python et Arduino : tutoriels pas à pas pour apprendre la programmation sans jargon inutile.',
		slugs: ['mblock', 'scratch', 'python', 'programmation', 'arduino', 'activite'],
	},
	{
		title: 'Raspberry Pi & électronique',
		intro: 'Cartes Raspberry Pi, kits, comparatifs mémoire et projets pour adolescents curieux du Linux.',
		slugs: ['raspberry-pi', 'electronique', 'kit'],
	},
	{
		title: 'Autres thèmes',
		intro: 'Catégories transverses (cadeaux, actualités, marques) — parcourez ou filtrez ci-dessous.',
		slugs: [],
	},
];

const usedSlugs = new Set<string>();
for (const block of THEME_BLOCKS) {
	for (const s of block.slugs) usedSlugs.add(s);
}
const otherEntries = entries.filter((e) => !usedSlugs.has(e.slug));

function entriesForBlock(block: ThemedBlock) {
	if (block.slugs.length === 0) return otherEntries;
	return block.slugs
		.map((slug) => entries.find((e) => e.slug === slug))
		.filter((e): e is (typeof entries)[number] => Boolean(e));
}

const pageTitle = `Catégories — ${SITE_TITLE}`;
const pageDesc =
	'Index des rubriques : robots Makeblock, mBlock, Python, Raspberry Pi et guides. Choisissez un thème ou cherchez un article par mot-clé, un thème à la fois.';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		<style>
			.hero-cat {
				width: 100vw;
				margin: 0 calc(50% - 50vw) 2rem calc(50% - 50vw);
				padding: clamp(1.75rem, 4vw, 2.5rem) 0;
				border-bottom: 1px solid var(--surface-border);
				background: var(--surface);
			}
			.hero-cat-inner {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.hero-cat h1 {
				margin: 0 0 0.65rem 0;
				font-size: clamp(1.65rem, 2.8vw, 2.15rem);
			}
			.hero-cat p {
				margin: 0 0 1rem 0;
				color: rgb(var(--gray-dark));
				max-width: 42rem;
				line-height: 1.6;
			}
			.cat-search {
				width: 100%;
				max-width: 28rem;
				padding: 0.65rem 0.85rem;
				border: 1px solid var(--surface-border);
				border-radius: 8px;
				font-size: 1rem;
			}
			.list-wrap {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto 3rem auto;
			}
			.theme-block {
				margin-bottom: 2.5rem;
			}
			.theme-block h2 {
				margin: 0 0 0.35rem 0;
				font-size: 1.25rem;
			}
			.theme-block .theme-intro {
				margin: 0 0 1rem 0;
				color: rgb(var(--gray-dark));
				max-width: 40rem;
				line-height: 1.55;
				font-size: 0.95rem;
			}
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.cat-grid li a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				padding: 0.85rem 1rem;
				border: 1px solid var(--surface-border);
				border-radius: 10px;
				background: var(--surface-2);
				text-decoration: none;
				color: var(--accent);
				font-weight: 600;
				transition: background 0.12s ease;
			}
			.cat-grid li a:hover {
				background: color-mix(in oklab, var(--accent) 10%, transparent);
			}
			.cat-grid .count {
				font-size: 0.82rem;
				font-weight: 600;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.cat-grid li.is-hidden {
				display: none;
			}
			.theme-block.is-hidden {
				display: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
<PageColumns>
			<nav class="breadcrumb" aria-label="Fil d'Ariane" style="width:min(1140px,calc(100% - 2.5rem));margin:0 auto 1rem auto;font-size:0.9rem;">
				<a href="/">Accueil</a> · Catégories
			</nav>
			<section class="hero-cat">
				<div class="hero-cat-inner">
					<h1>Catégories</h1>
					<p>
						<strong>Réponse directe</strong> — chaque article du blog est rangé dans une ou plusieurs rubriques.
						Utilisez les <strong>sections thématiques</strong> ci-dessous ou la <strong>recherche</strong> pour trouver
						mBlock, mBot, Python ou Raspberry Pi. Point d’entrée :{' '}
						<a href="/meilleur-robot-programmable-enfant-2026/">guides robots 2026</a>,{' '}
						<a href="/programmation/">hub programmation</a> et{' '}
						<a href="/domotique/debuter-en-domotique-guide-complet/">domotique débutant</a>.
					</p>
					<figure style="margin:1rem 0;max-width:36rem;">
						<img src="/images/illustrations/mbot-mon-premier-robot-educatif.webp" alt="Robot mBot Makeblock — exemple d’activité catégorie mBot" width="640" height="360" loading="lazy" decoding="async" />
						<figcaption style="font-size:0.85rem;color:rgb(var(--gray-dark));">Exemple de parcours robotique (catégorie mBot).</figcaption>
					</figure>
					<figure style="margin:1rem 0;max-width:36rem;">
						<img src="/images/illustrations/python-av-asyncio.webp" alt="Schéma tutoriel Python avancé" width="640" height="360" loading="lazy" decoding="async" />
						<figcaption style="font-size:0.85rem;color:rgb(var(--gray-dark));">Tutoriels Python avancé (catégorie Programmation).</figcaption>
					</figure>
					<figure style="margin:1rem 0;max-width:36rem;">
						<img src="/images/illustrations/raspberry-pi-ou-kit-robot-ado-guide.webp" alt="Raspberry Pi et robot éducatif — deux catégories d’articles" width="640" height="360" loading="lazy" decoding="async" />
						<figcaption style="font-size:0.85rem;color:rgb(var(--gray-dark));">Guides Raspberry Pi et robots (catégories dédiées).</figcaption>
					</figure>
					<label for="cat-filter" class="visually-hidden">Filtrer les catégories</label>
					<input
						id="cat-filter"
						class="cat-search"
						type="search"
						placeholder="Rechercher une catégorie (ex. mBot, Python…)"
						autocomplete="off"
					/>
				</div>
			</section>
			<div class="list-wrap">
				<p style="max-width:42rem;line-height:1.6;margin-bottom:1.5rem;">
					Cet index complète l’<a href="/">accueil Robot éducatif</a>, le{' '}
					<a href="/programmation/">hub programmation</a> et les{' '}
					<a href="/domotique/debuter-en-domotique-guide-complet/">guides domotique</a> — parcourez les thèmes ou filtrez par mot-clé.
				</p>
				{
					THEME_BLOCKS.map((block) => {
						const blockEntries = entriesForBlock(block);
						if (blockEntries.length === 0) return null;
						return (
							<section class="theme-block" data-theme-block>
								<h2>{block.title}</h2>
								<p class="theme-intro">{block.intro}</p>
								<ul class="cat-grid">
									{blockEntries.map((e) => (
										<li data-cat-label={e.label.toLowerCase()} data-cat-slug={e.slug}>
											<a href={`/categorie/${e.slug}/`}>
												<span>{e.label}</span>
												<span class="count">
													{e.posts.length} article{e.posts.length > 1 ? 's' : ''}
												</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						);
					})
				}
			</div>
		</PageColumns>
</main>
		<Footer />
		<script is:inline>
			(function () {
				const input = document.getElementById('cat-filter');
				if (!input) return;
				input.addEventListener('input', function () {
					const q = (input.value || '').trim().toLowerCase();
					document.querySelectorAll('[data-cat-label]').forEach(function (li) {
						const label = li.getAttribute('data-cat-label') || '';
						const slug = li.getAttribute('data-cat-slug') || '';
						const show = !q || label.includes(q) || slug.includes(q);
						li.classList.toggle('is-hidden', !show);
					});
					document.querySelectorAll('[data-theme-block]').forEach(function (sec) {
						const visible = sec.querySelector('[data-cat-label]:not(.is-hidden)');
						sec.classList.toggle('is-hidden', !visible);
					});
				});
			})();
		</script>
	</body>
</html>
