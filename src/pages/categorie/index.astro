---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { buildCategoryIndex } from '../../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const index = buildCategoryIndex(posts);
const entries = [...index.values()].sort((a, b) => a.label.localeCompare(b.label, 'fr'));
const pageTitle = `Catégories — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
		<style>
			.hero-cat {
				width: 100vw;
				margin: 0 calc(50% - 50vw) 2rem calc(50% - 50vw);
				padding: clamp(1.75rem, 4vw, 2.5rem) 0;
				border-bottom: 1px solid var(--surface-border);
				background: var(--surface);
			}
			.hero-cat-inner {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.hero-cat h1 {
				margin: 0 0 0.65rem 0;
				font-size: clamp(1.65rem, 2.8vw, 2.15rem);
			}
			.hero-cat p {
				margin: 0;
				color: rgb(var(--gray-dark));
				max-width: 40rem;
			}
			.list-wrap {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto 3rem auto;
			}
			.cat-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.cat-grid li a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				padding: 0.85rem 1rem;
				border: 1px solid var(--surface-border);
				border-radius: 10px;
				background: var(--surface-2);
				text-decoration: none;
				color: var(--accent);
				font-weight: 600;
				transition: background 0.12s ease;
			}
			.cat-grid li a:hover {
				background: color-mix(in oklab, var(--accent) 10%, transparent);
			}
			.cat-grid .count {
				font-size: 0.82rem;
				font-weight: 600;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-cat">
				<div class="hero-cat-inner">
					<h1>Catégories</h1>
					<p>
						Chaque article est classé dans quatre catégories. Cliquez sur un libellé pour voir tous les articles
						associés.
					</p>
				</div>
			</section>
			<div class="list-wrap">
				<ul class="cat-grid">
					{
						entries.map((e) => (
							<li>
								<a href={`/categorie/${e.slug}/`}>
									<span>{e.label}</span>
									<span class="count">{e.posts.length} article{e.posts.length > 1 ? 's' : ''}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
