---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { buildCategoryIndex } from '../../lib/categories';
import { withBase } from '../../lib/siteUrl';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const index = buildCategoryIndex(posts);
	return [...index.values()].map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const pageTitle = `Catégorie « ${entry.label} »`;
const pageDesc = `Articles du blog classés sous « ${entry.label} » — robotique et programmation éducatives.`;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
		<style>
			.hero-cat {
				width: 100vw;
				margin: 0 calc(50% - 50vw) 2rem calc(50% - 50vw);
				padding: clamp(1.75rem, 4vw, 2.5rem) 0;
				border-bottom: 1px solid var(--surface-border);
				background: var(--surface);
			}
			.hero-cat-inner {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.hero-cat .kicker {
				margin: 0 0 0.5rem 0;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.hero-cat h1 {
				margin: 0 0 0.75rem 0;
				font-size: clamp(1.65rem, 2.8vw, 2.15rem);
				line-height: 1.2;
			}
			.hero-cat p {
				margin: 0;
				color: rgb(var(--gray-dark));
				max-width: 40rem;
			}
			.list-wrap {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto 3rem auto;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 1rem;
			}
			.post-list li {
				border: 1px solid var(--surface-border);
				border-radius: 10px;
				background: var(--surface-2);
			}
			.post-list a {
				display: block;
				padding: 1rem 1.15rem;
				text-decoration: none;
				color: inherit;
				border-radius: 10px;
				transition: background 0.12s ease;
			}
			.post-list a:hover {
				background: color-mix(in oklab, var(--accent) 8%, transparent);
			}
			.post-list a:hover h2 {
				color: var(--accent);
			}
			.post-list h2 {
				margin: 0 0 0.35rem 0;
				font-size: 1.15rem;
				font-weight: 600;
				line-height: 1.3;
			}
			.post-list .date {
				margin: 0;
				font-size: 0.88rem;
				color: rgb(var(--gray));
			}
			.back {
				display: inline-block;
				margin-bottom: 1.25rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
			}
			.back:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-cat">
				<div class="hero-cat-inner">
					<p class="kicker">Catégorie</p>
					<h1>{entry.label}</h1>
					<p>{entry.posts.length} article{entry.posts.length > 1 ? 's' : ''} dans cette catégorie.</p>
				</div>
			</section>
			<div class="list-wrap">
				<a class="back" href={withBase('/categorie/')}>← Toutes les catégories</a>
				<ul class="post-list">
					{
						entry.posts.map((p) => (
							<li>
								<a href={withBase(`/${p.slug}/`)}>
									<h2>{p.title}</h2>
									<p class="date">
										<FormattedDate date={p.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
