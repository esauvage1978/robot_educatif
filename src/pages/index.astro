				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Derniers articles</h2>
						<p>Guides, tutoriels et comparatifs pour bien démarrer</p>
					</div>
					
				<div class="articles-grid">
					{latestPosts.map((post) => {
						const heroImage = resolveHeroImage(post.data.heroImage);
						const thumbnail = resolveArticleThumbnail(post, heroImage);
						
						return (
							<a href={withBase(`/${articleSlugFromId(post.id)}/`)} class="article-card">
								{thumbnail.type === 'illustration' && (
									<img src={withImageVersion(withBase(thumbnail.src))} alt={thumbnail.alt} width="448" height="252" loading="lazy" decoding="async" />
								)}
								{thumbnail.type === 'image' && (
									<Image
										src={thumbnail.src}
										alt={post.data.title}
										width={448}
										height={250}
										loading="lazy"
										decoding="async"
									/>
								)}
								{thumbnail.type === 'pinterest' && (
									<img
										src={withBase(`/pinterest/${thumbnail.slug}-1.jpg`)}
										alt={post.data.title}
										width="400"
										height="250"
										loading="lazy"
										decoding="async"
										style="object-fit: cover; object-position: top;"
									/>
								)}
							{thumbnail.type === 'generated' && (
								<img
									src={withImageVersion(withBase(getGeneratedThumbnailPath(post.id.replace(/\.mdx?$/, '')).replace('.png', '.webp')))}
									alt={post.data.title}
									width="400"
									height="250"
									loading="lazy"
									decoding="async"
								/>
							)}
								<div class="article-content">
									<div class="article-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3>{post.data.title}</h3>
								</div>
							</a>
						);
					})}
					{domotiqueLatest.map((post) => {
						const slug = post.id.replace(/\.mdx?$/, '');
						const ill = getIllustration(slug);
						return (
							<a href={withBase(`/domotique/${slug}/`)} class="article-card">
								{ill && (
									<img src={withImageVersion(withBase(ill.src))} alt={ill.alt} width="448" height="252" loading="lazy" decoding="async" />
								)}
								<div class="article-content">
									<div class="article-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3>{post.data.title}</h3>
								</div>
							</a>
						);
					})}
				</div>
					
					<div style="text-align: center; margin-top: 2.5rem;">
						<a href={withBase('/blog/')} class="btn btn-secondary">
							Voir tous les articles →
						</a>
					</div>
				</div>
			</section>
			
			<section class="section" style="background: var(--surface); padding: 3rem 0;">
				<div class="container">
					<div class="section-header">
						<h2>Vous êtes une marque ?</h2>
						<p>Découvrez nos offres de partenariat : tests produits, tutoriels, présence sur YouTube et Pinterest.</p>
					</div>
					<div style="text-align: center;">
						<a href={withBase('/partenariat/')} class="btn btn-primary">
							En savoir plus sur le partenariat →
						</a>
					</div>
				</div>
			</section>
</main>
		<Footer />
	</body>
</html>
