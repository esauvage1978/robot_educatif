---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SelectionFetes2026 from '../components/SelectionFetes2026.astro';
import Header from '../components/Header.astro';
import HomeIntentPaths from '../components/HomeIntentPaths.astro';
import HomeSmartHome from '../components/HomeSmartHome.astro';
import { getIllustration } from '../lib/illustration';
import SiteQuickAccess from '../components/SiteQuickAccess.astro';
import StructuredDataWebsite from '../components/StructuredDataWebsite.astro';
import { SITE_TITLE, AMAZON_AFFILIATE_TAG } from '../consts';
import { articleSlugFromId } from '../lib/articleSlug';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { resolveArticleThumbnail, getGeneratedThumbnailPath } from '../lib/articleThumbnail';
import { compareBlogPostsByPublicationDesc } from '../lib/sortBlogPosts';
import { withBase } from '../lib/siteUrl';
import { getProductImage } from '../lib/amazonImage';
import { withImageVersion } from '../lib/imageVersion';
import { catalogForMarket } from '../lib/marketProducts.mjs';
import { buildHomePopularProducts } from '../lib/homePopularProducts.mjs';

const { catalog } = await catalogForMarket('fr', 'fr');
const heroMbot2 = catalog.mbot2;
const popularProducts = await buildHomePopularProducts('fr', 'fr');
const heroMbot2Price = heroMbot2 && !heroMbot2.amazonIndispo ? heroMbot2.priceRange : '';

const allPosts = await getCollection('blog');
const latestPosts = [...allPosts].sort(compareBlogPostsByPublicationDesc).slice(0, 4);
const domotiqueLatest = (await getCollection('domotique'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id))
	.slice(0, 2);

const HOME_TITLE = "Robot programmable enfant : guides d'achat, mBlock et tutos 2026";

const HOME_DESCRIPTION =
	'Quel robot programmable offrir à un enfant ? Guides par âge (5, 8, 10, 12 ans), mBlock 5 en ligne ou à télécharger, mBot, Arduino et programmation pour la maison et la classe.';

const guideCount = allPosts.length;
---

<!doctype html>
<html lang="fr">
	<head>
		<Fragment set:html={'<meta name="fo-verify" content="e4b7801e-8207-4fc7-9e89-688ae147b550" />'} />
		<BaseHead title={HOME_TITLE} description={HOME_DESCRIPTION} />
		<StructuredDataWebsite />
		<style>
			body {
				background: var(--page-bg);
			}
			
			.hero {
				background: linear-gradient(180deg, var(--surface-2) 0%, var(--page-bg) 100%);
				padding: 3.5rem clamp(1rem, 5vw, 2rem) 4rem;
			}
			
			.hero-inner {
				max-width: 1320px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3rem;
				align-items: center;
			}
			
	.hero-content .badge {
		display: inline-block;
		background: #FFEDD5;
		color: #9A3412;
		font-weight: 700;
		padding: 6px 14px;
		border-radius: 99px;
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}
	
	html[data-theme="light"] .hero-content .badge {
		background: #FFEDD5;
		color: #9A3412;
	}
	
	

	
			
			.hero-content h1 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(2.2rem, 4.2vw, 3.25rem);
				line-height: 1.08;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--black));
			}
			
			.hero-content h1 em {
				font-style: normal;
				color: var(--primary);
			}
			
			.hero-lead {
				font-size: clamp(1.05rem, 1.35vw, 1.2rem);
				line-height: 1.55;
				color: rgb(var(--gray-dark));
				max-width: 560px;
				margin-bottom: 1.75rem;
			}
			
			.hero-ctas {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}
			
			.btn {
				display: inline-block;
				padding: 15px 24px;
				border-radius: 12px;
				font-weight: 700;
				text-decoration: none;
				font-size: 1.05rem;
				transition: all 0.2s ease;
			}
			
		.btn-primary {
			background: #C2410C;
			color: white;
			box-shadow: 0 6px 16px rgba(249, 115, 22, 0.35);
		}
		
		html[data-theme="light"] .btn-primary {
			background: #C2410C;
		}
		
		
		
		
		
		.btn-primary:hover {
			background: #ea580c;
			transform: translateY(-1px);
			box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
		}
		
		
		
		
			
			.btn-secondary {
				border: 2px solid var(--primary);
				color: var(--primary);
				background: transparent;
			}
			
		.btn-secondary:hover {
			background: var(--primary);
			color: white;
		}
		
		.show-m { display: none; }
		.trust-signals {
			display: flex;
			gap: 1.5rem;
			flex-wrap: wrap;
			font-size: 0.95rem;
			color: rgb(var(--gray-dark));
		}
			
			.trust-signals span {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			
			.trust-signals b {
				color: var(--primary);
				font-weight: 700;
			}
			
		.hero-card {
			position: relative;
			background: var(--card);
			border-radius: 24px;
			padding: 18px;
			box-shadow: 0 20px 40px rgba(11, 31, 42, 0.12);
		}
		
		
			
			.hero-card img {
				width: 100%;
				aspect-ratio: 500/320;
				object-fit: cover;
				border-radius: 16px;
				display: block;
			}
			
		.card-tag {
			position: absolute;
			top: 28px;
			left: 28px;
			background: var(--primary);
			color: white;
			font-weight: 700;
			padding: 6px 12px;
			border-radius: 8px;
			font-size: 0.9rem;
		}
		
		
			
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 14px;
				gap: 1rem;
			}
			
			.card-info strong {
				font-family: var(--font-heading);
				font-size: 1.25rem;
				font-weight: 800;
				display: block;
				color: rgb(var(--black));
			}
			
			.card-info small {
				color: rgb(var(--gray));
				display: block;
				font-size: 0.9rem;
			}
			
		.card-cta {
			background: var(--ink);
			color: white;
			padding: 12px 18px;
			border-radius: 10px;
			text-decoration: none;
			font-weight: 700;
			font-size: 0.95rem;
			white-space: nowrap;
			transition: all 0.2s ease;
		}
		
		
		
		.card-cta:hover {
			background: var(--primary);
			transform: translateY(-1px);
		}
			
			.container {
				max-width: 1320px;
				margin: 0 auto;
				padding: 0 clamp(1rem, 5vw, 2rem);
			}
			
			.section {
				padding: 4rem 0;
			}
			
			.section-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			
			.section-header h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				color: rgb(var(--black));
				margin: 0 0 0.75rem 0;
			}
			
			.section-header p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 0 auto;
			}
			
			.age-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			
			.age-card {
				background: var(--surface);
				border: 2px solid var(--surface-border);
				border-radius: 16px;
				padding: 1.75rem 1.5rem;
				text-decoration: none;
				transition: all 0.3s ease;
				display: block;
			}
			
			.age-card:hover {
				border-color: var(--primary);
				box-shadow: 0 8px 24px rgba(15, 118, 110, 0.15);
				transform: translateY(-4px);
			}
			
			.age-badge {
				display: inline-block;
				background: var(--primary);
				color: white;
				font-weight: 700;
				padding: 6px 14px;
				border-radius: 8px;
				font-size: 0.85rem;
				margin-bottom: 0.75rem;
			}
			
			.age-card h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.35rem;
				color: rgb(var(--black));
				margin: 0.5rem 0 0.75rem 0;
			}
			
			.age-card p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.5;
				margin: 0;
			}
			
			.best-sellers {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 20px;
				padding: 2.5rem 2rem;
				margin-bottom: 3rem;
			}
			
			.best-sellers h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.75rem;
				margin: 0 0 1.5rem 0;
				color: rgb(var(--black));
			}
			
			.product-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
				gap: 1.5rem;
			}
			
			.product-card {
				background: #fff;
				border: 1px solid #e5edf3;
				border-left: 4px solid #0f766e;
				border-radius: 18px;
				box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
				transition: box-shadow 0.2s ease;
				overflow: hidden;
			}
			
			.product-card:hover {
				box-shadow: 0 4px 12px rgba(11, 31, 42, 0.1);
				transform: translateY(-2px);
			}
			
			.product-card-link {
				display: block;
				text-decoration: none;
				padding: 1.25rem;
				text-align: center;
			}
			
			.product-card-img {
				width: 100%;
				max-width: 200px;
				height: auto;
				aspect-ratio: 1;
				object-fit: contain;
				margin: 0 auto 1rem;
				background: #f4f7fb;
				border-radius: 14px;
				border: 0;
				padding: 0.65rem;
			}
			
			.product-card h3 {
				font-weight: 700;
				font-size: 1.05rem;
				margin: 0 0 0.35rem 0;
				color: rgb(var(--black));
			}

			.product-card-price {
				display: block;
				margin: 0 0 0.65rem;
				font-weight: 800;
				font-size: 1.35rem;
				letter-spacing: -0.02em;
				color: #0f172a;
			}
			.product-card-price .price-eur,
			.card-info .price-eur {
				white-space: nowrap;
			}
			
			.product-card-cta {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				background: #f59e0b;
				color: #0f172a;
				padding: 0.65rem 1.15rem;
				border-radius: 8px;
				border: 1px solid #d97706;
				font-weight: 700;
				font-size: 0.95rem;
				transition: background 0.15s ease;
			}
			
			.product-card-link:hover .product-card-cta {
				background: #d97706;
				color: #0f172a;
			}
			
		.articles-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 2rem;
		}
		
		@media (max-width: 640px) {
			.articles-grid {
				grid-template-columns: 1fr;
			}
		}
			
			.article-card {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 16px;
				overflow: hidden;
				text-decoration: none;
				display: block;
				transition: all 0.3s ease;
			}
			
			.article-card:hover {
				box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
				transform: translateY(-4px);
			}
			
			.article-card img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16/9;
				object-fit: contain;
				background: var(--surface);
				border-radius: 0;
			}
			
			.article-content {
				padding: 1.5rem;
			}
			
			.article-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5rem;
			}
			
			.article-card h3 {
				font-weight: 700;
				font-size: 1.15rem;
				color: rgb(var(--black));
				margin: 0;
				line-height: 1.4;
			}
			
			.cta-banner {
				/* #134e4a → #0f766e : le blanc reste ≥ 5,3:1 sur toute la surface (le dégradé #14b8a6 tombait à ~2,5:1). */
				background: linear-gradient(135deg, #134e4a 0%, #0f766e 100%);
				color: #f8fafc;
				border-radius: 20px;
				padding: 3rem 2.5rem;
				text-align: center;
				margin: 3rem 0;
			}
			
			.cta-banner h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.25rem);
				margin: 0 0 1rem 0;
				color: #f8fafc;
			}
			
			.cta-banner p {
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				color: #f8fafc;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
			}

			.cta-banner a:not(.btn) {
				color: #ffffff;
				font-weight: 700;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.cta-banner a:not(.btn):hover,
			.cta-banner a:not(.btn):focus-visible {
				color: #ccfbf1;
			}
			
			.cta-banner .btn {
				background: #ffffff;
				color: #115e59;
			}
			
			.cta-banner .btn:hover,
			.cta-banner .btn:focus-visible {
				background: #f0fdfa;
				color: #134e4a;
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
			}
			
		@media (max-width: 768px) {
			.hero {
				padding-top: 0.75rem;
				padding-bottom: 2rem;
			}
			.hero-inner {
				grid-template-columns: 1fr;
				gap: 1.25rem !important;
				padding-top: 0.5rem !important;
				padding-bottom: 2.5rem;
			}
			.hero-content .badge {
				font-size: 0.8rem;
				margin-bottom: 0.6rem;
			}
			.hero-content h1 {
				font-size: 1.85rem;
				margin-bottom: 0.75rem;
			}
			.hero-lead {
				font-size: 1rem;
				margin-bottom: 1.1rem;
			}
			.hero-ctas {
				flex-wrap: nowrap;
				gap: 0.6rem;
				margin-bottom: 1rem;
			}
			.hero-ctas .btn {
				padding: 12px 10px;
				font-size: 0.98rem;
				white-space: nowrap;
			}
			.trust-signals {
				gap: 1rem;
				font-size: 0.88rem;
			}
			.hide-m { display: none; }
			.show-m { display: inline; }
			
			.hero-card {
				order: 2;
				padding: 12px;
			}
			.hero-card img {
				aspect-ratio: 16/9;
			}
			
			.btn {
				flex: 1;
				text-align: center;
			}
				
				.section {
					padding: 2.5rem 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-content">
						<span class="badge">🎄 Guide Noël 2026 mis à jour</span>
						<h1>Le bon robot éducatif, <em>choisi selon l'âge</em> pour votre enfant</h1>
						<p class="hero-lead">
							mBot, robots programmables, kits Arduino : nos comparatifs par âge (6 à 15 ans) pour offrir un cadeau qui apprend vraiment à coder.
						</p>
						<div class="hero-ctas">
						<a href={withBase('/robot-educatif-cadeau-noel-2026/')} class="btn btn-primary">
							<span class="hide-m">Voir le guide cadeaux </span><span class="show-m">Guide </span>Noël →
						</a>
							<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="btn btn-secondary">
								Choisir par âge
							</a>
						</div>
					<div class="trust-signals">
						<span>📚 <b>{guideCount} guides</b> détaillés</span>
					</div>
					</div>
					<div class="hero-card">
					<span class="card-tag">⭐ Notre choix 8-12 ans</span>
					<img src={withBase('/mbot2-hero-v2.webp')} width="500" height="320" alt="Robot mBot2" loading="eager" />
						<div class="card-footer">
							<div class="card-info">
								<strong>Makeblock mBot2</strong>
								<small>Scratch puis Python · idéal dès 8 ans</small>
								{heroMbot2Price && (
									<small class="product-card-price">
										<span class="price-eur">{heroMbot2Price}</span>
									</small>
								)}
							</div>
							<a href={`https://www.amazon.fr/dp/B0919F9CKS?tag=${AMAZON_AFFILIATE_TAG}`} class="card-cta" rel="sponsored nofollow noopener" target="_blank">
								Voir sur Amazon
							</a>
						</div>
					</div>
				</div>
			</section>
			<HomeIntentPaths />
			<SiteQuickAccess layout="home" />
			<SelectionFetes2026 />
			
			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Choisir un robot par âge</h2>
						<p>Chaque tranche d'âge a ses besoins. Sélectionnez l'âge qui vous intéresse :</p>
					</div>
					
					<div class="age-grid">
						<a href={withBase('/robot-enfant-4-ans/')} class="age-card">
							<span class="age-badge">4-5 ans</span>
							<h3>Robots sans écran</h3>
							<p>Découverte sensorielle, manipulation, séquences simples</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-5-ans-guide-achat/')} class="age-card">
							<span class="age-badge">5-7 ans</span>
							<h3>Premières bases</h3>
							<p>Scratch Jr, blocs visuels, découverte de la logique</p>
						</a>
						<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="age-card">
							<span class="age-badge">8-9 ans</span>
							<h3>mBot & Scratch</h3>
							<p>Programmation par blocs, capteurs, projets concrets</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-10-ans-guide-achat/')} class="age-card">
							<span class="age-badge">10-12 ans</span>
							<h3>Python & IoT</h3>
							<p>Transition vers le code texte, Wi-Fi, capteurs avancés</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-12-ans-guide-achat/')} class="age-card">
							<span class="age-badge">12-14 ans</span>
							<h3>Collège & Arduino</h3>
							<p>C++, électronique, projets longs, documentation technique</p>
						</a>
						<a href={withBase('/robot-programmable-14-ans-ado/')} class="age-card">
							<span class="age-badge">14+ ans</span>
							<h3>Lycée & Raspberry Pi</h3>
							<p>IA, vision par ordinateur, Linux, projets autonomes</p>
						</a>
					</div>
				</div>
			</section>

			<HomeSmartHome lang="fr" />
			
			<section class="section" style="background: var(--surface-2); padding: 4rem 0;">
				<div class="container">
					<div class="best-sellers">
						<h2>🔥 Les plus populaires</h2>
						<div class="product-grid">
							{popularProducts.map((product) => (
								<div class="product-card">
									<a 
										href={product.href}
										rel={product.rel}
										target="_blank"
										class="product-card-link"
									>
										<img 
											src={product.imageAmazon || getProductImage(product.asin, product.name, 200, 200)} 
											alt={product.name}
											width="200"
											height="200"
											loading="lazy"
											class="product-card-img"
										/>
										<h3>{product.name}</h3>
										{product.price && (
											<span class="product-card-price"><span class="price-eur">{product.price}</span></span>
										)}
										<span class="product-card-cta">Voir sur Amazon →</span>
									</a>
								</div>
							))}
						</div>
					</div>
					
					<div class="cta-banner">
						<h2>Nouveautés robots 2026–2027</h2>
						<p>
							<a href={withBase('/robots-educatifs-2026-2027-nouveautes-calendrier-comparatif/')}>Calendrier complet</a>
							{' · '}
							<a href={withBase('/thymio-3-nouveautes-prix-avis-comparatif-mbot2/')}>Thymio 3 vs mBot2</a>
							{' · '}
							<a href={withBase('/mbot3-date-sortie-rumeurs-mbot2-rover-alternatives/')}>mBot3 et alternatives</a>
							{' · '}
							<a href={withBase('/mbot-vs-mbot2-comparaison-des-robots-educatifs-pour-enfants/')}>mBot vs mBot2</a>
						</p>
					</div>
					<div class="cta-banner">
						<h2>Besoin d'aide pour choisir ?</h2>
						<p>Découvrez <a href={withBase('/meilleur-robot-programmable-enfant-2026/')}>notre guide complet</a> pour trouver le robot idéal selon l'âge, le budget et les objectifs pédagogiques.</p>
						<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="btn">
							Voir le guide complet →
						</a>
					</div>
				</div>
			</section>
			
			<section class="section">
				<div class="container">
					<div class="section-header">
