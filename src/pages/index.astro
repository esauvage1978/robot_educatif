---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import StructuredDataWebsite from '../components/StructuredDataWebsite.astro';
import { SITE_TITLE, AMAZON_AFFILIATE_TAG } from '../consts';
import { articleSlugFromId } from '../lib/articleSlug';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { compareBlogPostsByPublicationDesc } from '../lib/sortBlogPosts';
import { withBase } from '../lib/siteUrl';

const allPosts = await getCollection('blog');
const latestPosts = [...allPosts].sort(compareBlogPostsByPublicationDesc).slice(0, 4);

const HOME_DESCRIPTION =
	'Robots éducatifs pour enfants, ados et écoles : guides d\'achat par âge, comparatifs mBot/LEGO, tutoriels mBlock, Scratch et Python.';

const guideCount = allPosts.length;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={HOME_DESCRIPTION} />
		<StructuredDataWebsite />
		<style>
			body {
				background: var(--page-bg);
			}
			
			.hero {
				background: linear-gradient(180deg, var(--surface-2) 0%, var(--page-bg) 100%);
				padding: 3.5rem clamp(1rem, 5vw, 2rem) 4rem;
			}
			
			.hero-inner {
				max-width: 1320px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3rem;
				align-items: center;
			}
			
			.hero-content .badge {
				display: inline-block;
				background: #FFEDD5;
				color: #C2410C;
				font-weight: 700;
				padding: 6px 14px;
				border-radius: 99px;
				font-size: 0.9rem;
				margin-bottom: 1rem;
			}
			
			.hero-content h1 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(2.2rem, 4.2vw, 3.25rem);
				line-height: 1.08;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--black));
			}
			
			.hero-content h1 em {
				font-style: normal;
				color: var(--primary);
			}
			
			.hero-lead {
				font-size: clamp(1.05rem, 1.35vw, 1.2rem);
				line-height: 1.55;
				color: rgb(var(--gray-dark));
				max-width: 560px;
				margin-bottom: 1.75rem;
			}
			
			.hero-ctas {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}
			
			.btn {
				display: inline-block;
				padding: 15px 24px;
				border-radius: 12px;
				font-weight: 700;
				text-decoration: none;
				font-size: 1.05rem;
				transition: all 0.2s ease;
			}
			
			.btn-primary {
				background: var(--accent-warm);
				color: white;
				box-shadow: 0 6px 16px rgba(249, 115, 22, 0.35);
			}
			
			.btn-primary:hover {
				background: #ea580c;
				transform: translateY(-1px);
				box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
			}
			
			.btn-secondary {
				border: 2px solid var(--primary);
				color: var(--primary);
				background: transparent;
			}
			
			.btn-secondary:hover {
				background: var(--primary);
				color: white;
			}
			
			.trust-signals {
				display: flex;
				gap: 1.5rem;
				flex-wrap: wrap;
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
			}
			
			.trust-signals span {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			
			.trust-signals b {
				color: var(--primary);
				font-weight: 700;
			}
			
			.hero-card {
				position: relative;
				background: white;
				border-radius: 24px;
				padding: 18px;
				box-shadow: 0 20px 40px rgba(11, 31, 42, 0.12);
			}
			
			.hero-card img {
				width: 100%;
				aspect-ratio: 500/320;
				object-fit: cover;
				border-radius: 16px;
				display: block;
			}
			
			.card-tag {
				position: absolute;
				top: 28px;
				left: 28px;
				background: var(--primary);
				color: white;
				font-weight: 700;
				padding: 6px 12px;
				border-radius: 8px;
				font-size: 0.9rem;
			}
			
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 14px;
				gap: 1rem;
			}
			
			.card-info strong {
				font-family: var(--font-heading);
				font-size: 1.25rem;
				font-weight: 800;
				display: block;
				color: rgb(var(--black));
			}
			
			.card-info small {
				color: rgb(var(--gray));
				display: block;
				font-size: 0.9rem;
			}
			
			.card-cta {
				background: var(--ink);
				color: white;
				padding: 12px 18px;
				border-radius: 10px;
				text-decoration: none;
				font-weight: 700;
				font-size: 0.95rem;
				white-space: nowrap;
				transition: all 0.2s ease;
			}
			
			.card-cta:hover {
				background: var(--primary);
				transform: translateY(-1px);
			}
			
			.container {
				max-width: 1320px;
				margin: 0 auto;
				padding: 0 clamp(1rem, 5vw, 2rem);
			}
			
			.section {
				padding: 4rem 0;
			}
			
			.section-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			
			.section-header h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				color: rgb(var(--black));
				margin: 0 0 0.75rem 0;
			}
			
			.section-header p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 0 auto;
			}
			
			.age-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			
			.age-card {
				background: var(--surface);
				border: 2px solid var(--surface-border);
				border-radius: 16px;
				padding: 1.75rem 1.5rem;
				text-decoration: none;
				transition: all 0.3s ease;
				display: block;
			}
			
			.age-card:hover {
				border-color: var(--primary);
				box-shadow: 0 8px 24px rgba(15, 118, 110, 0.15);
				transform: translateY(-4px);
			}
			
			.age-badge {
				display: inline-block;
				background: var(--primary);
				color: white;
				font-weight: 700;
				padding: 6px 14px;
				border-radius: 8px;
				font-size: 0.85rem;
				margin-bottom: 0.75rem;
			}
			
			.age-card h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.35rem;
				color: rgb(var(--black));
				margin: 0.5rem 0 0.75rem 0;
			}
			
			.age-card p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.5;
				margin: 0;
			}
			
			.best-sellers {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 20px;
				padding: 2.5rem 2rem;
				margin-bottom: 3rem;
			}
			
			.best-sellers h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.75rem;
				margin: 0 0 1.5rem 0;
				color: rgb(var(--black));
			}
			
			.product-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
				gap: 1.5rem;
			}
			
			.product-card {
				background: var(--page-bg);
				border: 1px solid var(--surface-border);
				border-radius: 12px;
				padding: 1.25rem;
				text-align: center;
				transition: all 0.2s ease;
			}
			
			.product-card:hover {
				box-shadow: 0 4px 12px rgba(11, 31, 42, 0.1);
			}
			
			.product-card h3 {
				font-weight: 700;
				font-size: 1.05rem;
				margin: 1rem 0 0.5rem 0;
				color: rgb(var(--black));
			}
			
			.product-card a {
				display: inline-block;
				background: var(--accent-warm);
				color: white;
				padding: 12px 22px;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 700;
				font-size: 0.95rem;
				transition: all 0.2s ease;
				margin-top: 0.75rem;
			}
			
			.product-card a:hover {
				background: #ea580c;
				transform: scale(1.05);
			}
			
			.articles-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 2rem;
			}
			
			.article-card {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 16px;
				overflow: hidden;
				text-decoration: none;
				display: block;
				transition: all 0.3s ease;
			}
			
			.article-card:hover {
				box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
				transform: translateY(-4px);
			}
			
			.article-card img {
				width: 100%;
				aspect-ratio: 16/10;
				object-fit: cover;
			}
			
			.article-content {
				padding: 1.5rem;
			}
			
			.article-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5rem;
			}
			
			.article-card h3 {
				font-weight: 700;
				font-size: 1.15rem;
				color: rgb(var(--black));
				margin: 0;
				line-height: 1.4;
			}
			
			.cta-banner {
				background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
				color: white;
				border-radius: 20px;
				padding: 3rem 2.5rem;
				text-align: center;
				margin: 3rem 0;
			}
			
			.cta-banner h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.25rem);
				margin: 0 0 1rem 0;
			}
			
			.cta-banner p {
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				opacity: 0.95;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
			}
			
			.cta-banner .btn {
				background: white;
				color: var(--primary);
			}
			
			.cta-banner .btn:hover {
				background: var(--page-bg);
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
			}
			
			@media (max-width: 768px) {
				.hero-inner {
					grid-template-columns: 1fr;
					gap: 2rem;
					padding-top: 2rem;
					padding-bottom: 2.5rem;
				}
				
				.hero-card {
					order: -1;
				}
				
				.btn {
					flex: 1;
					text-align: center;
				}
				
				.section {
					padding: 2.5rem 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-content">
						<span class="badge">🎄 Guide Noël 2026 mis à jour</span>
						<h1>Le bon robot éducatif, <em>choisi et testé</em> pour votre enfant</h1>
						<p class="hero-lead">
							mBot, robots programmables, kits Arduino : nos comparatifs par âge (6 à 15 ans) pour offrir un cadeau qui apprend vraiment à coder.
						</p>
						<div class="hero-ctas">
							<a href={withBase('/robot-educatif-cadeau-noel-2026/')} class="btn btn-primary">
								Voir le guide cadeaux Noël →
							</a>
							<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="btn btn-secondary">
								Choisir par âge
							</a>
						</div>
						<div class="trust-signals">
							<span>🔄 <b>Prix mis à jour</b></span>
							<span>📚 <b>{guideCount} guides</b> détaillés</span>
						</div>
					</div>
					<div class="hero-card">
						<span class="card-tag">⭐ Notre choix 8-12 ans</span>
						<img src={withBase('/mbot2-hero.webp')} width="500" height="320" alt="Robot mBot2" loading="eager" />
						<div class="card-footer">
							<div class="card-info">
								<strong>Makeblock mBot2</strong>
								<small>Scratch puis Python · idéal dès 8 ans</small>
							</div>
							<a href={`https://www.amazon.fr/s?k=mbot2&tag=${AMAZON_AFFILIATE_TAG}`} class="card-cta" rel="sponsored nofollow noopener" target="_blank">
								Voir le prix
							</a>
						</div>
					</div>
				</div>
			</section>
			
			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Choisir un robot par âge</h2>
						<p>Chaque tranche d'âge a ses besoins. Sélectionnez l'âge qui vous intéresse :</p>
					</div>
					
					<div class="age-grid">
						<a href={withBase('/robot-enfant-4-ans/')} class="age-card">
							<span class="age-badge">4-5 ans</span>
							<h3>Robots sans écran</h3>
							<p>Découverte sensorielle, manipulation, séquences simples</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-5-ans-guide-achat/')} class="age-card">
							<span class="age-badge">5-7 ans</span>
							<h3>Premières bases</h3>
							<p>Scratch Jr, blocs visuels, découverte de la logique</p>
						</a>
						<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="age-card">
							<span class="age-badge">8-9 ans</span>
							<h3>mBot & Scratch</h3>
							<p>Programmation par blocs, capteurs, projets concrets</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-10-ans-guide-achat/')} class="age-card">
							<span class="age-badge">10-12 ans</span>
							<h3>Python & IoT</h3>
							<p>Transition vers le code texte, Wi-Fi, capteurs avancés</p>
						</a>
						<a href={withBase('/quel-robot-acheter-enfant-12-ans-guide-achat/')} class="age-card">
							<span class="age-badge">12-14 ans</span>
							<h3>Collège & Arduino</h3>
							<p>C++, électronique, projets longs, documentation technique</p>
						</a>
						<a href={withBase('/robot-programmable-14-ans-ado/')} class="age-card">
							<span class="age-badge">14+ ans</span>
							<h3>Lycée & Raspberry Pi</h3>
							<p>IA, vision par ordinateur, Linux, projets autonomes</p>
						</a>
					</div>
				</div>
			</section>
			
			<section class="section" style="background: var(--surface-2); padding: 4rem 0;">
				<div class="container">
					<div class="best-sellers">
						<h2>🔥 Les plus populaires</h2>
						<div class="product-grid">
							<div class="product-card">
								<h3>Makeblock mBot Neo</h3>
								<a href={`https://www.amazon.fr/dp/B0CQXKX64J?tag=${AMAZON_AFFILIATE_TAG}`} rel="sponsored nofollow noopener" target="_blank">
									Voir le prix sur Amazon
								</a>
							</div>
							<div class="product-card">
								<h3>Makeblock mBot2</h3>
								<a href={`https://www.amazon.fr/dp/B09BYYMF7R?tag=${AMAZON_AFFILIATE_TAG}`} rel="sponsored nofollow noopener" target="_blank">
									Voir le prix sur Amazon
								</a>
							</div>
							<div class="product-card">
								<h3>LEGO Boost 17101</h3>
								<a href={`https://www.amazon.fr/dp/B06X6GN2VQ?tag=${AMAZON_AFFILIATE_TAG}`} rel="sponsored nofollow noopener" target="_blank">
									Voir le prix sur Amazon
								</a>
							</div>
							<div class="product-card">
								<h3>Arduino Starter Kit Officiel</h3>
								<a href={`https://www.amazon.fr/dp/B009UKZV0A?tag=${AMAZON_AFFILIATE_TAG}`} rel="sponsored nofollow noopener" target="_blank">
									Voir le prix sur Amazon
								</a>
							</div>
						</div>
					</div>
					
					<div class="cta-banner">
						<h2>Besoin d'aide pour choisir ?</h2>
						<p>Découvrez notre guide complet pour trouver le robot idéal selon l'âge, le budget et les objectifs pédagogiques.</p>
						<a href={withBase('/meilleur-robot-programmable-enfant-2026/')} class="btn">
							Voir le guide complet →
						</a>
					</div>
				</div>
			</section>
			
			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Derniers articles</h2>
						<p>Guides, tutoriels et comparatifs pour bien démarrer</p>
					</div>
					
					<div class="articles-grid">
						{latestPosts.map((post) => {
							const thumb = resolveHeroImage(post.data.heroImage);
							return (
								<a href={withBase(`/${articleSlugFromId(post.id)}/`)} class="article-card">
									{thumb && (
										<Image
											src={thumb}
											alt={post.data.title}
											width={400}
											height={250}
											loading="lazy"
											decoding="async"
										/>
									)}
									<div class="article-content">
										<div class="article-date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h3>{post.data.title}</h3>
									</div>
								</a>
							);
						})}
					</div>
					
					<div style="text-align: center; margin-top: 2.5rem;">
						<a href={withBase('/blog/')} class="btn btn-secondary">
							Voir tous les articles →
						</a>
					</div>
				</div>
			</section>
			
			<section class="section" style="background: var(--surface); padding: 3rem 0;">
				<div class="container">
					<div class="section-header">
						<h2>Vous êtes une marque ?</h2>
						<p>Découvrez nos offres de partenariat : tests produits, tutoriels, présence sur YouTube et Pinterest.</p>
					</div>
					<div style="text-align: center;">
						<a href={withBase('/partenariat/')} class="btn btn-primary">
							En savoir plus sur le partenariat →
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
