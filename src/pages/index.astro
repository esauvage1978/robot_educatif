---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE } from '../consts';
import { articleSlugFromId } from '../lib/articleSlug';
import { topCategoriesByCount } from '../lib/categories';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { compareBlogPostsByPublicationDesc } from '../lib/sortBlogPosts';
import { withBase } from '../lib/siteUrl';

const allPosts = await getCollection('blog');
const latestPosts = [...allPosts].sort(compareBlogPostsByPublicationDesc).slice(0, 5);
const topCategories = topCategoriesByCount(allPosts, 15);

/** Meta accueil : couvre les intentions Search Console (mBlock, mBot, robot éducatif) sans keyword stuffing. */
const HOME_DESCRIPTION =
	'Robot éducatif et robot pédagogique : guides pour télécharger mBlock 5 (Windows, gratuit), installer le logiciel, programmer le mBot (mBot vs mBot 2), premiers programmes et activités — au collège, au lycée ou à la maison.';

/** FAQ visible + JSON-LD (questions formulées comme des recherches réelles). */
const FAQ_ITEMS: { q: string; aHtml: string; aPlain: string }[] = [
	{
		q: 'À quoi sert ce site « ROBOT éducatif » ?',
		aHtml:
			'Ce site rassemble des <strong>guides pratiques</strong> pour passer de la recherche (« robot éducatif », « mblock 5 télécharger », « mbot programmation »…) à des <strong>étapes concrètes</strong> : installer mBlock sur PC, choisir entre robots pédagogiques (mBot, mBot 2, Tale-Bot…), comprendre les capteurs et lire ou corriger un premier programme.',
		aPlain:
			"Ce site propose des guides pour installer mBlock, choisir un robot éducatif comme le mBot, démarrer la programmation et comprendre les capteurs, avec un ton pratique pour la classe ou la maison.",
	},
	{
		q: 'Où télécharger mBlock 5 sur Windows, gratuitement ?',
		aHtml:
			'La distribution officielle est celle de <strong>Makeblock</strong> (mBlock 5, parfois noté mblock5, m block 5 ou mblock v5). Sur ce site : guide pas à pas pour <a href="' +
			withBase('/installer-mblock-5-sous-windows-10/') +
			'">télécharger mBlock 5 pour Windows</a> (installateur, versions récentes type 5.4.x, dépannage). « Gratuit » signifie en général <strong>sans achat du logiciel</strong> ; un compte peut être utile pour certaines fonctions.',
		aPlain:
			"Téléchargez mBlock 5 depuis la page officielle Makeblock. Le site propose un guide pour Windows (téléchargement, installation, versions 5.4.x). Le logiciel est en usage gratuit courant ; un compte peut être requis pour certaines options.",
	},
	{
		q: 'Comment installer mBlock sur mon PC (installer mblock, mblock installer) ?',
		aHtml:
			'Après le téléchargement, lancez l’installateur, acceptez les options matérielles si demandé, puis ouvrez mBlock. Détails et erreurs fréquentes : <a href="' +
			withBase('/installer-mblock-5-sous-windows-10/') +
			'">installer mBlock 5 sous Windows</a> et <a href="' +
			withBase('/premier-pas-avec-mblock-5/') +
			'">premiers pas avec mBlock 5</a>.',
		aPlain:
			"Après téléchargement, exécutez l’installateur Windows puis ouvrez mBlock. Des articles détaillent l’installation et les premiers pas.",
	},
	{
		q: 'mBlock 5 en ligne, version web ou PC : quelle différence ?',
		aHtml:
			'Il existe une <strong>application mBlock 5</strong> installée sur l’ordinateur et une <strong>version navigateur</strong> (mblock en ligne / mblock 5 web). Leurs fonctions se chevauchent mais ne sont pas toujours identiques (connexion Bluetooth/USB, extensions, matériel). Voir : <a href="' +
			withBase('/premier-pas-avec-mblock-5/') +
			'">mBlock 5 web vs application</a> et <a href="' +
			withBase('/logiciel-mblock-makeblock-mbot-quel-choisir/') +
			'">quel logiciel Makeblock choisir</a>.',
		aPlain:
			"mBlock existe en application desktop et en version en ligne ; les possibilités (USB, Bluetooth, matériel) peuvent varier. Des articles du site comparent ces usages.",
	},
	{
		q: 'Qu’est-ce que mBlock Planet ou mBlock « Panda » ?',
		aHtml:
			'<strong>mBlock Planet</strong> désigne l’écosystème / plateforme autour de mBlock (évolutions selon les années et régions). Une recherche « mblock panda » pointe souvent vers l’<strong>interface</strong> ou une variante de branding, pas un autre Minecraft. Pour s’y retrouver : <a href="' +
			withBase('/logiciel-mblock-makeblock-mbot-quel-choisir/') +
			'">logiciel mBlock et mBot : quel choisir</a>.',
		aPlain:
			"mBlock Planet est lié à l'écosystème Makeblock/mBlock. mBlock Panda renvoie souvent à l'interface ou au branding officiel, pas à Minecraft.",
	},
	{
		q: 'mBlock et Minecraft : c’est le même logiciel ?',
		aHtml:
			'Non. <strong>Minecraft</strong> est un jeu ; <strong>mBlock</strong> est l’environnement de programmation type Scratch pour robots Makeblock. Si vous cherchiez « minecraft mblock », vous êtes probablement sur la bonne page uniquement pour la partie <strong>robotique / mBot</strong> — pas pour le jeu.',
		aPlain:
			"Non : Minecraft est un jeu, mBlock est le logiciel de programmation pour robots Makeblock (mBot, etc.).",
	},
	{
		q: 'Où trouver le logo mBlock ou des images officielles (logo mblock, image mblock) ?',
		aHtml:
			'Les visuels officiels (logo, captures) relèvent de <strong>Makeblock</strong> et de leur site de téléchargement ou de communication. Ce site indépendant n’est pas l’éditeur de mBlock ; il oriente vers les <a href="' +
			withBase('/installer-mblock-5-sous-windows-10/') +
			'">sources utiles</a> pour installer et utiliser le logiciel.',
		aPlain:
			"Les logos et images officiels mBlock sont publiés par Makeblock. Ce site est un guide tiers qui renvoie vers les ressources d'installation.",
	},
	{
		q: 'Qu’est-ce qu’un robot éducatif, robot pédagogique ou cobot « éducatif » ?',
		aHtml:
			'On parle de <strong>robot éducatif</strong> ou <strong>robot pédagogique</strong> pour du matériel pensé pour <strong>apprendre la programmation, la robotique ou la logique</strong> (souvent en STEM), pas pour la production industrielle — même si le mot « cobot » apparaît parfois dans les recherches. Pistes de choix : <a href="' +
			withBase('/robot-educatif-pas-cher-compromis/') +
			'">robot éducatif : compromis et critères</a>.',
		aPlain:
			"Un robot éducatif sert à apprendre la programmation et la robotique en contexte pédagogique. Le site propose des critères pour choisir un modèle adapté.",
	},
	{
		q: 'Comment choisir un robot éducatif (âge, budget, objectif) ?',
		aHtml:
			'Retenez : <strong>tranche d’âge</strong>, <strong>budget</strong>, <strong>plug-and-play vs montage</strong>, <strong>langage</strong> (blocs, Python…), et <strong>communauté / ressources</strong>. Articles : <a href="' +
			withBase('/robot-educatif-pas-cher-compromis/') +
			'">comment choisir un robot éducatif</a>, comparatifs mBot sur le blog.',
		aPlain:
			"Pour choisir : âge, budget, facilité de prise en main, type de programmation et ressources disponibles. Le site propose un guide de compromis et des comparatifs.",
	},
	{
		q: 'Qu’est-ce que le robot mBot et comment fonctionne-t-il ?',
		aHtml:
			'Le <strong>mBot</strong> (recherches : robot mbot, mbot robot, mbot png…) est un <strong>robot Makeblock</strong> programmable en blocs (mBlock) puis en texte pour aller plus loin. Il se déplace, lit des <strong>capteurs</strong> (ultrason, ligne…) et actionne moteurs ou LEDs. Introduction : <a href="' +
			withBase('/mbot-mon-premier-robot-educatif/') +
			'">mBot, premier robot éducatif</a>.',
		aPlain:
			"Le mBot est un robot Makeblock programmable avec mBlock ; il utilise des capteurs et des moteurs pour des activités pédagogiques.",
	},
	{
		q: 'mBot vs mBot 2 : que choisir ?',
		aHtml:
			'Les deux sont des robots Makeblock pour l’école et la maison, avec des différences de carte, capteurs et logiciels possibles. Comparaison : <a href="' +
			withBase('/mbot-vs-mbot2-comparaison-des-robots-educatifs-pour-enfants/') +
			'">mBot vs mBot 2</a>.',
		aPlain:
			"mBot et mBot 2 diffèrent notamment par la carte et les fonctionnalités ; une page du site les compare pour aider au choix.",
	},
	{
		q: 'Programme mBot, programme mBlock : où commencer, y compris un « programme corrigé » ?',
		aHtml:
			'Un programme se sauvegarde souvent en <strong>.mblock</strong> dans l’appli. Pour un <strong>premier téléversement</strong> et des vérifications (câble, mode, pilotes) : <a href="' +
			withBase('/mon-premier-programme-mbot/') +
			'">mon premier programme mBot</a>. S’il « ne marche pas », ce n’est pas qu’une histoire de « corrigé » : revoir l’ordre des blocs, la connexion et les messages du logiciel — voir aussi <a href="' +
			withBase('/mbot-mon-premier-robot-educatif/') +
			'">programme mBot : dépannage</a> dans la FAQ de l’article.',
		aPlain:
			"Commencez par le tutoriel premier programme mBot ; les fichiers sont souvent en .mblock. En cas d'échec, vérifier connexion, mode et logique du programme plutôt que chercher uniquement un corrigé.",
	},
	{
		q: 'Capteur mBot (ultrason, etc.) : par où commencer ?',
		aHtml:
			'Série progressive sur le <strong>capteur à ultrasons</strong> avec mBot : mesure de distance, radar de recul, cadence, obstacle. Première partie : <a href="' +
			withBase('/serie-capteur-ultrason-mbot-1-mesurer-distance/') +
			'">série capteur ultrason mBot (1)</a>.',
		aPlain:
			"Le site propose une série d'articles sur le capteur ultrason du mBot, de la mesure de distance à l'évitement d'obstacle.",
	},
	{
		q: '« Robot tale bot », Tale-Bot Pro : de quoi s’agit-il ?',
		aHtml:
			'Il s’agit souvent des robots <strong>Matatalab</strong> (Tale-Bot, Tale-Bot Pro), orientés <strong>jeunes enfants</strong> et déplacements ou activités sans écran selon les modèles. Présentation et FAQ : <a href="' +
			withBase('/le-robot-tale-bot-de-chez-matatalab-questions-reponses/') +
			'">robot Tale-Bot Matatalab</a>.',
		aPlain:
			"Les recherches tale bot ou tale bot pro pointent souvent vers les robots éducatifs Matatalab Tale-Bot, présentés dans un article dédié.",
	},
	{
		q: 'J’ai tapé mbloc, mblok, mabuot, m bots ou m block : c’est quoi au juste ?',
		aHtml:
			'Souvent vous cherchez <strong>mBlock</strong> (logiciel) ou <strong>mBot</strong> (robot). Les requêtes <strong>m bots</strong> ou <strong>m block</strong> sont des variantes courantes — les guides mBlock 5 et mBot sur ce site utilisent l’orthographe officielle pour vous retrouver dans les tutoriels.',
		aPlain:
			"Ces fautes de frappe renvoient généralement à mBlock (logiciel Makeblock) ou au robot mBot. Les articles utilisent les noms officiels.",
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ_ITEMS.map(({ q, aPlain }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: aPlain },
	})),
};
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={HOME_DESCRIPTION} preloadLcpImage={withBase('/hero-home.webp')} />
		<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
		<style>
			.hero-home {
				position: relative;
				width: 100vw;
				margin: 0 calc(50% - 50vw) 2rem calc(50% - 50vw);
				min-height: clamp(440px, 56vh, 620px);
				display: flex;
				align-items: flex-end;
				background-color: #060a10;
				overflow: hidden;
			}
			.hero-home-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 40%;
				z-index: 0;
			}
			.hero-home-overlay {
				position: absolute;
				inset: 0;
				z-index: 1;
				pointer-events: none;
				background-image:
					linear-gradient(180deg, rgba(6, 10, 16, 0.45) 0%, rgba(6, 10, 16, 0.82) 100%),
					linear-gradient(90deg, rgba(6, 10, 16, 0.88) 0%, rgba(6, 10, 16, 0.55) 45%, rgba(6, 10, 16, 0.35) 100%);
			}
			.hero-home-inner {
				position: relative;
				z-index: 2;
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 2.75rem 0 3rem 0;
			}
			.hero-home .hero-kicker {
				display: inline-block;
				margin: 0 0 0.85rem 0;
				font-size: 0.82rem;
				font-weight: 600;
				font-family: var(--font-body, system-ui);
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.72);
			}
			.hero-home h1 {
				margin: 0 0 1rem 0;
				color: #fff;
				max-width: 20ch;
				font-size: clamp(2.1rem, 4.2vw, 3.35rem);
				line-height: 1.12;
				font-weight: 700;
				text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
			}
			.hero-home .hero-lead {
				margin: 0 0 1.35rem 0;
				max-width: 38rem;
				color: rgba(255, 255, 255, 0.92);
				font-size: clamp(1.05rem, 1.35vw, 1.2rem);
				line-height: 1.6;
				font-family: var(--font-body, system-ui);
			}
			.hero-actions {
				display: flex;
				gap: 0.85rem;
				flex-wrap: wrap;
			}
			.hero-actions :global(.ui-btn) {
				font-weight: 600;
			}
			.page-layout {
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
				gap: 1.25rem;
				align-items: start;
			}
			.main-column {
				min-width: 0;
			}
			.intro-block {
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--surface-border);
				margin-bottom: 1.75rem;
			}
			.intro-block .lead {
				font-size: 1.125rem;
				color: rgb(var(--gray-dark));
				max-width: var(--prose-width, 42rem);
				line-height: 1.75;
				margin-bottom: 0.85rem;
			}
			.latest-posts {
				margin-top: 2.25rem;
				padding: 1.5rem 1.35rem;
				background: var(--surface-2);
				border: 1px solid var(--surface-border);
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.latest-posts h2 {
				margin-bottom: 1rem;
				font-size: 1.5rem;
			}
			.latest-posts ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: 0.75rem;
			}
			.latest-posts li a {
				display: flex;
				align-items: center;
				gap: 1rem;
				padding: 0.75rem;
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 10px;
				text-decoration: none;
				transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
			}
			.latest-posts li a img {
				width: 92px;
				height: 58px;
				object-fit: cover;
				border-radius: 8px;
				flex-shrink: 0;
			}
			.latest-posts li a:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
				transform: translateY(-1px);
			}
			.latest-posts .title {
				color: var(--accent-dark);
				font-weight: 700;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
				flex: 1;
			}
			.latest-posts .date {
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.latest-posts .all-posts {
				display: inline-block;
				margin-top: 1rem;
				font-weight: 700;
				padding: 0.4rem 0.75rem;
				border-radius: 999px;
				border: 1px solid color-mix(in oklab, var(--accent) 45%, transparent);
				background: color-mix(in oklab, var(--accent) 16%, transparent);
				text-decoration: none;
				color: var(--accent-dark);
			}
			html[data-theme='light'] .latest-posts .all-posts {
				border-color: color-mix(in oklab, var(--accent-dark) 40%, transparent);
				background: color-mix(in oklab, var(--accent-dark) 10%, transparent);
			}
			.home-faq-page-bottom {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 2rem 0 2.75rem;
				box-sizing: border-box;
			}
			.home-faq {
				margin-top: 0;
				padding: 1.5rem 1.35rem;
				background: var(--surface-2);
				border: 1px solid var(--surface-border);
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.home-faq h2 {
				margin: 0 0 0.35rem 0;
				font-size: 1.45rem;
				color: color-mix(in oklab, var(--accent) 78%, var(--accent-warm) 22%);
			}
			.home-faq .home-faq-intro {
				margin: 0 0 1.25rem 0;
				font-size: 0.98rem;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
				max-width: var(--prose-width, 42rem);
			}
			.home-faq-list {
				margin: 0;
				padding: 0;
				list-style: none;
				display: grid;
				gap: 0.5rem;
			}
			.home-faq details {
				border: 1px solid var(--surface-border);
				border-radius: 10px;
				background: var(--surface);
				overflow: hidden;
			}
			.home-faq summary {
				cursor: pointer;
				font-weight: 700;
				padding: 0.85rem 1rem;
				color: rgb(var(--gray-dark));
				list-style: none;
			}
			.home-faq summary::-webkit-details-marker {
				display: none;
			}
			.home-faq details[open] summary {
				border-bottom: 1px solid var(--surface-border);
				background: color-mix(in oklab, var(--accent) 5%, var(--surface));
			}
			.home-faq .home-faq-answer {
				margin: 0;
				padding: 0.85rem 1rem 1rem;
				font-size: 0.95rem;
				line-height: 1.65;
				color: rgb(var(--gray-dark));
			}
			.home-faq .home-faq-answer a {
				color: var(--accent);
				font-weight: 600;
			}
			@media (max-width: 720px) {
				.hero-home {
					min-height: 380px;
					margin-bottom: 1.35rem;
					background-position: center center;
				}
				.hero-home-inner {
					padding: 1.75rem 0 2rem 0;
				}
				.page-layout {
					grid-template-columns: 1fr;
				}
				.latest-posts li a {
					flex-direction: column;
					gap: 0.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-home" aria-label="Présentation">
				<img
					class="hero-home-bg"
					src={withBase('/hero-home.webp')}
					alt=""
					width="683"
					height="435"
					fetchpriority="high"
					decoding="async"
				/>
				<div class="hero-home-overlay" aria-hidden="true"></div>
				<div class="hero-home-inner">
					<p class="hero-kicker">Robotique &amp; pédagogie</p>
					<h1>Apprendre la robotique en s'amusant</h1>
					<p class="hero-lead">
						Guides détaillés, retours d’expérience et idées d’activités pour enseigner la programmation et la
						robotique avec du matériel adapté aux collégiens, lycéens et autodidactes motivés.
					</p>
					<div class="hero-actions">
						<Button href={withBase('/blog/')} variant="primary" tone="inverse">
							Articles à la une
						</Button>
						<Button
							href={withBase('/mbot2-de-makeblock-le-robot-educatif-pour-apprendre-la-robotique/')}
							variant="secondary"
							tone="inverse"
						>
							Focus mBot2
						</Button>
					</div>
				</div>
			</section>
			<div class="page-layout">
				<div class="main-column">
					<div class="intro-block">
						<p class="lead">
							<strong>ROBOT éducatif</strong>, ce sont des guides pour comparer et choisir un robot pédagogique,
							installer les logiciels (mBlock, Scratch…), puis lancer vos premières activités — en classe comme
							à la maison — sans oublier ce que le matériel sait faire (ou pas) et des idées d’exercices à
							reprendre telles quelles.
						</p>
						<p class="lead" style="margin-bottom: 0;">
							On privilégie le concret : faits utiles, pas à pas et ressources directes, pour raccourcir le
							trajet entre « quel robot pour mon groupe ou mon enfant ? » et « le programme tourne sur le
							robot ».
						</p>
					</div>
					<section class="latest-posts">
						<h2>Les 5 derniers articles</h2>
						<ul>
							{
								latestPosts.map((post) => {
									const thumb = resolveHeroImage(post.data.heroImage);
									return (
									<li>
										<a href={withBase(`/${articleSlugFromId(post.id)}/`)}>
											{thumb && (
												<Image
													src={thumb}
													alt={post.data.title}
													width={184}
													height={116}
													sizes="92px"
													quality={72}
													loading="lazy"
													decoding="async"
												/>
											)}
											<span class="title">{post.data.title}</span>
											<span class="date">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</a>
									</li>
									);
								})
							}
						</ul>
						<a class="all-posts" href={withBase('/blog/')}>Voir tous les articles</a>
					</section>
					<HomeShowcase />
				</div>
				<Sidebar topCategories={topCategories} />
			</div>
			<div class="home-faq-page-bottom">
				<section class="home-faq" aria-labelledby="home-faq-title">
					<h2 id="home-faq-title">Questions fréquentes</h2>
					<p class="home-faq-intro">
