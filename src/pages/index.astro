---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HomeRefonte from '../components/home/HomeRefonte.astro';
import StructuredDataWebsite from '../components/StructuredDataWebsite.astro';
import { getIllustration } from '../lib/illustration';
import { articleSlugFromId } from '../lib/articleSlug';
import { resolveHeroImage } from '../lib/contentHeroImage';
import { resolveArticleThumbnail, getGeneratedThumbnailPath } from '../lib/articleThumbnail';
import { withBase } from '../lib/siteUrl';
import { withImageVersion } from '../lib/imageVersion';
import { amazonDpUrl } from '../lib/amazonMarket.mjs';
import { catalogForMarket } from '../lib/marketProducts.mjs';
import { buildHomeProductCards } from '../lib/homePopularProducts.mjs';
import { groupLatest } from '../lib/homeLatest';

const { catalog } = await catalogForMarket('fr', 'fr');
const heroMbot2 = catalog.mbot2;
const products = await buildHomeProductCards('fr', 'fr');

const allPosts = await getCollection('blog');
const guideCount = allPosts.length;

async function blogCard(post) {
	const heroImage = resolveHeroImage(post.data.heroImage);
	const th = resolveArticleThumbnail(post, heroImage);
	const slug = articleSlugFromId(post.id);
	let img = null;
	let alt = '';
	if (th.type === 'illustration') { img = withImageVersion(withBase(th.src)); alt = th.alt; }
	else if (th.type === 'image') { img = (await getImage({ src: th.src, width: 448, format: 'webp' })).src; }
	else if (th.type === 'pinterest') { img = withBase(`/pinterest/${th.slug}-1.jpg`); }
	else { img = withImageVersion(withBase(getGeneratedThumbnailPath(post.id.replace(/\.mdx?$/, '')).replace('.png', '.webp'))); }
	return { href: `/${slug}/`, title: post.data.title, date: post.data.pubDate, img, alt, slug };
}
const blogRecent = [...allPosts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 12);
const domoRecent = (await getCollection('domotique'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id))
	.slice(0, 6);
const latest = groupLatest([
	...(await Promise.all(blogRecent.map(blogCard))),
	...domoRecent.map((post) => {
		const slug = post.id.replace(/\.mdx?$/, '');
		const ill = getIllustration(slug);
		const hero = typeof post.data.heroImage === 'string' && post.data.heroImage.startsWith('/') ? post.data.heroImage : null;
		const img = ill ? withImageVersion(withBase(ill.src)) : hero ? withImageVersion(withBase(hero)) : null;
		return { href: `/domotique/${slug}/`, title: post.data.title, date: post.data.pubDate, img, alt: ill?.alt || '', slug };
	}),
]);

const HOME_TITLE = "Robot programmable enfant : guides d'achat, mBlock et tutos 2026";

const HOME_DESCRIPTION =
	'Quel robot programmable offrir à un enfant ? Guides par âge (5, 8, 10, 12 ans), mBlock 5 en ligne ou à télécharger, mBot, Arduino et programmation pour la maison et la classe.';
---

<!doctype html>
<html lang="fr">
	<head>
		<Fragment set:html={'<meta name="fo-verify" content="e4b7801e-8207-4fc7-9e89-688ae147b550" />'} />
		<BaseHead title={HOME_TITLE} description={HOME_DESCRIPTION} />
		<StructuredDataWebsite />
		<link rel="preload" as="image" href={withBase("/images/editorial/re-hero-projet-800.webp")} imagesrcset={["480","800","1200"].map((w) => `${withBase(`/images/editorial/re-hero-projet-${w}.webp`)} ${w}w`).join(", ")} imagesizes="(min-width: 960px) 520px, 92vw" fetchpriority="high" />
		<style>body { background: var(--re-bg); }</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<HomeRefonte
				lang="fr"
				h1="Le bon robot éducatif,"
				h1Em="choisi selon l'âge"
				h1After="pour votre enfant"
				guideCount={guideCount}
				hero={heroMbot2 ? { name: heroMbot2.shortName || heroMbot2.name, ages: heroMbot2.ages, image: '/images/products/mbot2.webp', href: heroMbot2.asin && !heroMbot2.amazonIndispo ? amazonDpUrl(heroMbot2.asin, 'fr') : undefined, buyLabel: 'Voir sur Amazon' } : null}
				products={products}
				latest={latest}
			/>
		</main>
		<Footer />
	</body>
</html>
