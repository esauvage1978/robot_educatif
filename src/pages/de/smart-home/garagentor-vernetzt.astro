---
import DomotiqueToolLayout from '../../../layouts/DomotiqueToolLayout.astro';
import GarageDoorLocalizedPage from '../../../components/GarageDoorLocalizedPage.astro';
import { GARAGE_DOOR_LOCALES } from '../../../data/garageDoorLocales/index.mjs';
import { GARAGE_DOOR_PATHS } from '../../../data/garageDoorLocales/paths.mjs';
import { USE_CASES } from '../../../data/smartHomeUseCaseConfigurator.mjs';
import { withBase } from '../../../lib/siteUrl';

const guide = GARAGE_DOOR_LOCALES.de;
const useCase = USE_CASES.find((u) => u.id === 'garage-porte-smartphone');
const articlePath = GARAGE_DOOR_PATHS.de;
const pubDate = new Date('2026-10-29T00:00:00Z');
const articleUrl = `https://robot-educatif.info${articlePath}`;
---

<DomotiqueToolLayout
	title={guide.title}
	description={guide.description}
	lang="de"
	pubDate={pubDate}
	articlePath={articlePath}
	hubLabel="Smart Home"
	repairGuide={false}
	breadcrumbItems={[
		{ name: 'Startseite', url: withBase('/de/') },
		{ name: 'Smart Home', url: withBase('/de/smart-home/') },
		{ name: guide.title, url: withBase(articlePath) },
	]}
>
	<GarageDoorLocalizedPage guide={guide} articleUrl={articleUrl} useCase={useCase} lang="de" />
</DomotiqueToolLayout>
