---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeIntentPaths from '../../components/HomeIntentPaths.astro';
import HomeSmartHome from '../../components/HomeSmartHome.astro';
import { getIllustration } from '../../lib/illustration';
import { withBase } from '../../lib/siteUrl';
import { withImageVersion } from '../../lib/imageVersion';
import { amazonDpUrl } from '../../lib/amazonMarket.mjs';
import { catalogForMarket } from '../../lib/marketProducts.mjs';
import { DE_PAGES, slugOf } from '../../lib/i18n.mjs';

const TITLE = 'Robot Éducatif: Ratgeber zu Programmierrobotern, Arduino und Raspberry Pi für Kinder';
const DESCRIPTION = 'Unabhängige Ratgeber für Eltern und Lehrkräfte in Deutschland, Österreich und de. mBot, Arduino-Roboterbausätze, Raspberry Pi: unabhängige Ratgeber für Eltern';
const card = (href) => {
	const p = DE_PAGES.find((x) => x.href === href);
	const ill = getIllustration(slugOf(p.fr));
	return { ...p, img: ill ? withImageVersion(withBase(ill.src)) : null, alt: ill ? `Illustration: ${p.title}` : '' };
};
const { catalog } = await catalogForMarket('de', 'de');
const heroMbot2 = catalog.mbot2;
const heroMbot2Price = heroMbot2 && !heroMbot2.amazonIndispo ? heroMbot2.priceRange : '';
const heroMbot2Href = heroMbot2?.asin && !heroMbot2.amazonIndispo ? amazonDpUrl(heroMbot2.asin, 'de') : '';
const heroImage = withImageVersion(withBase('/mbot2-hero-v2.webp'));
const comparisons = ['/de/lernroboter-weihnachtsgeschenke-2026/', '/de/mbot-vs-mbot2/', '/de/raspberry-pi-3-vs-4-vs-5/', '/de/raspberry-pi-5-welcher-ram/'].map(card);
const tutorials = ['/de/mblock-5-installieren-windows/', '/de/erstes-mbot-programm/', '/de/arduino-roboter-bausatz-fuer-kinder/'].map(card);
const ages = [
	{ badge: '6–8 Jahre', title: 'Erster Programmierroboter', text: 'Blockprogrammierung, fertig montierter Roboter, einfache Sensoraufgaben', href: '/de/bester-programmierbarer-roboter-fuer-kinder/' },
	{ badge: '9–12 Jahre', title: 'Von Blöcken zu Python', text: 'Erst Blöcke im Scratch-Stil, dann getipptes Python auf dem mBot2', href: '/de/bester-programmierbarer-roboter-fuer-kinder/' },
	{ badge: 'Ab 13 Jahren', title: 'Arduino-Roboterbausätze', text: 'Verkabelung, C/C++ in der Arduino IDE, längere Projekte', href: '/de/arduino-roboter-bausatz-fuer-kinder/' },
	{ badge: 'Ab 12 Jahren', title: 'Raspberry Pi', text: 'Ein echter Linux-Computer für Python, Kameras und Projekte zu Hause', href: '/de/raspberry-pi-3-vs-4-vs-5/' },
];

import { getProductImage } from '../../lib/amazonImage';
import { buildHomePopularProducts } from '../../lib/homePopularProducts.mjs';

const popularProducts = await buildHomePopularProducts('de', 'de');
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={TITLE} description={DESCRIPTION} image={heroImage} />
		<style>
			body {
				background: var(--page-bg);
			}
			
			.hero {
				background: linear-gradient(180deg, var(--surface-2) 0%, var(--page-bg) 100%);
				padding: 3.5rem clamp(1rem, 5vw, 2rem) 4rem;
			}
			
			.hero-inner {
				max-width: 1320px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 3rem;
				align-items: center;
			}
			
	.hero-content .badge {
		display: inline-block;
		background: #FFEDD5;
		color: #9A3412;
		font-weight: 700;
		padding: 6px 14px;
		border-radius: 99px;
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}
	
	html[data-theme="light"] .hero-content .badge {
		background: #FFEDD5;
		color: #9A3412;
	}
	
	

	
			
			.hero-content h1 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(2.2rem, 4.2vw, 3.25rem);
				line-height: 1.08;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--black));
			}
			
			.hero-content h1 em {
				font-style: normal;
				color: var(--primary);
			}
			
			.hero-lead {
				font-size: clamp(1.05rem, 1.35vw, 1.2rem);
				line-height: 1.55;
				color: rgb(var(--gray-dark));
				max-width: 560px;
				margin-bottom: 1.75rem;
			}
			
			.hero-ctas {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 2rem;
			}
			
			.btn {
				display: inline-block;
				padding: 15px 24px;
				border-radius: 12px;
				font-weight: 700;
				text-decoration: none;
				font-size: 1.05rem;
				transition: all 0.2s ease;
			}
			
		.btn-primary {
			background: #C2410C;
			color: white;
			box-shadow: 0 6px 16px rgba(249, 115, 22, 0.35);
		}
		
		html[data-theme="light"] .btn-primary {
			background: #C2410C;
		}
		
		
		
		
		
		.btn-primary:hover {
			background: #ea580c;
			transform: translateY(-1px);
			box-shadow: 0 8px 20px rgba(249, 115, 22, 0.4);
		}
		
		
		
		
			
			.btn-secondary {
				border: 2px solid var(--primary);
				color: var(--primary);
				background: transparent;
			}
			
		.btn-secondary:hover {
			background: var(--primary);
			color: white;
		}
		
		.show-m { display: none; }
		.trust-signals {
			display: flex;
			gap: 1.5rem;
			flex-wrap: wrap;
			font-size: 0.95rem;
			color: rgb(var(--gray-dark));
		}
			
			.trust-signals span {
				display: flex;
				align-items: center;
				gap: 0.35rem;
			}
			
			.trust-signals b {
				color: var(--primary);
				font-weight: 700;
			}
			
		.hero-card {
			position: relative;
			background: var(--card);
			border-radius: 24px;
			padding: 18px;
			box-shadow: 0 20px 40px rgba(11, 31, 42, 0.12);
		}
		
		
			
			.hero-card img {
				width: 100%;
				aspect-ratio: 500/320;
				object-fit: cover;
				border-radius: 16px;
				display: block;
			}
			
		.card-tag {
			position: absolute;
			top: 28px;
			left: 28px;
			background: var(--primary);
			color: white;
			font-weight: 700;
			padding: 6px 12px;
			border-radius: 8px;
			font-size: 0.9rem;
		}
		
		
			
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 14px;
				gap: 1rem;
			}
			
			.card-info strong {
				font-family: var(--font-heading);
				font-size: 1.25rem;
				font-weight: 800;
				display: block;
				color: rgb(var(--black));
			}
			
			.card-info small {
				color: rgb(var(--gray));
				display: block;
				font-size: 0.9rem;
			}
			
		.card-cta {
			background: var(--ink);
			color: white;
			padding: 12px 18px;
			border-radius: 10px;
			text-decoration: none;
			font-weight: 700;
			font-size: 0.95rem;
			white-space: nowrap;
			transition: all 0.2s ease;
		}
		
		
		
		.card-cta:hover {
			background: var(--primary);
			transform: translateY(-1px);
		}
			
			.container {
				max-width: 1320px;
				margin: 0 auto;
				padding: 0 clamp(1rem, 5vw, 2rem);
			}
			
			.section {
				padding: 4rem 0;
			}
			
			.section-header {
				text-align: center;
				margin-bottom: 3rem;
			}
			
			.section-header h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				color: rgb(var(--black));
				margin: 0 0 0.75rem 0;
			}
			
			.section-header p {
				font-size: 1.1rem;
				color: rgb(var(--gray-dark));
				max-width: 600px;
				margin: 0 auto;
			}
			
			.age-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			
			.age-card {
				background: var(--surface);
				border: 2px solid var(--surface-border);
				border-radius: 16px;
				padding: 1.75rem 1.5rem;
				text-decoration: none;
				transition: all 0.3s ease;
				display: block;
			}
			
			.age-card:hover {
				border-color: var(--primary);
				box-shadow: 0 8px 24px rgba(15, 118, 110, 0.15);
				transform: translateY(-4px);
			}
			
			.age-badge {
				display: inline-block;
				background: var(--primary);
				color: white;
				font-weight: 700;
				padding: 6px 14px;
				border-radius: 8px;
				font-size: 0.85rem;
				margin-bottom: 0.75rem;
			}
			
			.age-card h3 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.35rem;
				color: rgb(var(--black));
				margin: 0.5rem 0 0.75rem 0;
			}
			
			.age-card p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				line-height: 1.5;
				margin: 0;
			}
			
			.best-sellers {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 20px;
				padding: 2.5rem 2rem;
				margin-bottom: 3rem;
			}
			
			.best-sellers h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: 1.75rem;
				margin: 0 0 1.5rem 0;
				color: rgb(var(--black));
			}
			
			.product-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
				gap: 1.5rem;
			}
			
			.product-card {
				background: #fff;
				border: 1px solid #e5edf3;
				border-left: 4px solid #0f766e;
				border-radius: 18px;
				box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
				transition: box-shadow 0.2s ease;
				overflow: hidden;
			}
			
			.product-card:hover {
				box-shadow: 0 4px 12px rgba(11, 31, 42, 0.1);
				transform: translateY(-2px);
			}
			
			.product-card-link {
				display: block;
				text-decoration: none;
				padding: 1.25rem;
				text-align: center;
			}
			
			.product-card-img {
				width: 100%;
				max-width: 200px;
				height: auto;
				aspect-ratio: 1;
				object-fit: contain;
				margin: 0 auto 1rem;
				background: #f4f7fb;
				border-radius: 14px;
				border: 0;
				padding: 0.65rem;
			}
			
			.product-card h3 {
				font-weight: 700;
				font-size: 1.05rem;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}
			
			.product-card-price {
				display: block;
				margin: 0 0 0.65rem;
				font-weight: 800;
				font-size: 1.35rem;
				letter-spacing: -0.02em;
				color: #0f172a;
			}
			.product-card-price .price-eur,
			.card-info .price-eur {
				white-space: nowrap;
			}
			.product-card-cta {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				background: #f59e0b;
				color: #0f172a;
				padding: 0.65rem 1.15rem;
				border-radius: 8px;
				border: 1px solid #d97706;
				font-weight: 700;
				font-size: 0.95rem;
				transition: background 0.15s ease;
			}
			
			.product-card-link:hover .product-card-cta {
				background: #d97706;
				color: #0f172a;
			}
			
		.articles-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
			gap: 2rem;
		}
		
		@media (max-width: 640px) {
			.articles-grid {
				grid-template-columns: 1fr;
			}
		}
			
			.article-card {
				background: var(--surface);
				border: 1px solid var(--surface-border);
				border-radius: 16px;
				overflow: hidden;
				text-decoration: none;
				display: block;
				transition: all 0.3s ease;
			}
			
			.article-card:hover {
				box-shadow: 0 8px 24px rgba(11, 31, 42, 0.12);
				transform: translateY(-4px);
			}
			
			.article-card img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16/9;
				object-fit: contain;
				background: var(--surface);
				border-radius: 0;
			}
			
			.article-content {
				padding: 1.5rem;
			}
			
			.article-date {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin-bottom: 0.5rem;
			}
			
			.article-card h3 {
				font-weight: 700;
				font-size: 1.15rem;
				color: rgb(var(--black));
				margin: 0;
				line-height: 1.4;
			}
			
			.cta-banner {
				/* #134e4a → #0f766e : le blanc reste ≥ 5,3:1 sur toute la surface (le dégradé #14b8a6 tombait à ~2,5:1). */
				background: linear-gradient(135deg, #134e4a 0%, #0f766e 100%);
				color: #f8fafc;
				border-radius: 20px;
				padding: 3rem 2.5rem;
				text-align: center;
				margin: 3rem 0;
			}
			
			.cta-banner h2 {
				font-family: var(--font-heading);
				font-weight: 800;
				font-size: clamp(1.8rem, 3vw, 2.25rem);
				margin: 0 0 1rem 0;
				color: #f8fafc;
			}
			
			.cta-banner p {
				font-size: 1.15rem;
				margin: 0 0 2rem 0;
				color: #f8fafc;
				max-width: 600px;
				margin-left: auto;
				margin-right: auto;
			}

			.cta-banner a:not(.btn) {
				color: #ffffff;
				font-weight: 700;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
			}

			.cta-banner a:not(.btn):hover,
			.cta-banner a:not(.btn):focus-visible {
				color: #ccfbf1;
			}
			
			.cta-banner .btn {
				background: #ffffff;
				color: #115e59;
			}
			
			.cta-banner .btn:hover,
			.cta-banner .btn:focus-visible {
				background: #f0fdfa;
				color: #134e4a;
				transform: translateY(-2px);
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
			}
			
		@media (max-width: 768px) {
			.hero {
				padding-top: 0.75rem;
				padding-bottom: 2rem;
			}
			.hero-inner {
				grid-template-columns: 1fr;
				gap: 1.25rem !important;
				padding-top: 0.5rem !important;
				padding-bottom: 2.5rem;
			}
			.hero-content .badge {
				font-size: 0.8rem;
				margin-bottom: 0.6rem;
			}
			.hero-content h1 {
				font-size: 1.85rem;
				margin-bottom: 0.75rem;
			}
			.hero-lead {
				font-size: 1rem;
				margin-bottom: 1.1rem;
			}
			.hero-ctas {
				flex-wrap: nowrap;
				gap: 0.6rem;
				margin-bottom: 1rem;
			}
			.hero-ctas .btn {
				padding: 12px 10px;
				font-size: 0.98rem;
				white-space: nowrap;
			}
			.trust-signals {
				gap: 1rem;
				font-size: 0.88rem;
			}
			.hide-m { display: none; }
			.show-m { display: inline; }
			
			.hero-card {
				order: 2;
				padding: 12px;
			}
			.hero-card img {
				aspect-ratio: 16/9;
			}
			
			.btn {
				flex: 1;
				text-align: center;
			}
				
				.section {
					padding: 2.5rem 0;
				}
			}
		</style>
		<style>
			.hero-content { min-width: 0; }
			.hero h1 { overflow-wrap: break-word; }
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-content">
						<span class="badge">🎄 Weihnachtsguide 2026 aktualisiert</span>
						<h1>Der richtige Lernroboter, <em>nach Alter ausgewählt</em> für Ihr Kind</h1>
						<p class="hero-lead">
							mBot, programmierbare Roboter, Arduino-Bausätze: unsere Vergleiche nach Alter (6 bis 15 Jahre), damit das Geschenk wirklich Programmieren beibringt.
						</p>
						<div class="hero-ctas">
							<a href={withBase('/de/lernroboter-weihnachtsgeschenke-2026/')} class="btn btn-primary">
								<span class="hide-m">Zum Weihnachts</span><span class="show-m">Weihnachts</span>guide →
							</a>
							<a href={withBase('/de/bester-programmierbarer-roboter-fuer-kinder/')} class="btn btn-secondary">
								Nach Alter wählen
							</a>
						</div>
						<div class="trust-signals">
							<span>📚 <b>{DE_PAGES.length} Ratgeber</b> auf Deutsch</span>
						</div>
					</div>
					<div class="hero-card">
						<span class="card-tag">⭐ Unsere Wahl, ab 8 Jahren</span>
						<img src={heroImage} width="500" height="320" alt="Makeblock mBot2 Programmierroboter" loading="eager" />
						<div class="card-footer">
							<div class="card-info">
								<strong>Makeblock mBot2</strong>
								<small>Scratch, dann Python · passend ab 8 Jahren</small>
								{heroMbot2Price && (
									<small class="product-card-price">
										<span class="price-eur">{heroMbot2Price}</span>
									</small>
								)}
							</div>
							{heroMbot2Href && (
								<a href={heroMbot2Href} class="card-cta" rel="sponsored nofollow noopener" target="_blank">
									Bei Amazon ansehen
								</a>
							)}
						</div>
					</div>
				</div>
			</section>

			<HomeIntentPaths lang="de" />

			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Ratgeber nach Alter</h2>
						<p>Jede Altersgruppe hat andere Bedürfnisse. Wählen Sie die passende:</p>
					</div>
					<div class="age-grid">
						{ages.map((a) => (
							<a href={withBase(a.href)} class="age-card">
								<span class="age-badge">{a.badge}</span>
								<h3>{a.title}</h3>
								<p>{a.text}</p>
							</a>
						))}
					</div>
				</div>
			</section>

			<HomeSmartHome lang="de" />

			<section class="section">
				<div class="container">
					<div class="best-sellers">
						<h2>🔥 Beliebte Modelle</h2>
						<p style="font-size:.85rem;opacity:.75;margin:-.4rem 0 1rem;">Werbelinks: Bei einem Kauf über Amazon.de erhalten wir eine Provision, für Sie ändert sich der Preis nicht.</p>
						<div class="product-grid">
							{popularProducts.map((product) => (
								<div class="product-card">
									<a href={product.href} rel={product.rel} target="_blank" class="product-card-link">
										<img src={product.imageAmazon || getProductImage(product.asin, product.name, 200, 200)} alt={product.name} width="200" height="200" loading="lazy" class="product-card-img" />
										<h3>{product.name}</h3>
										{product.price && (
											<span class="product-card-price"><span class="price-eur">{product.price}</span></span>
										)}
										<span class="product-card-cta">Bei Amazon.de ansehen →</span>
									</a>
								</div>
							))}
						</div>
					</div>
				</div>
			</section>
			<section class="section" style="background: var(--surface-2); padding: 4rem 0;">
				<div class="container">
					<div class="section-header">
						<h2>Vergleiche</h2>
						<p>Datentabellen im direkten Vergleich als Entscheidungshilfe</p>
					</div>
					<div class="articles-grid">
						{comparisons.map((c) => (
							<a href={withBase(c.href)} class="article-card">
								{c.img && <img src={c.img} alt={c.alt} width="448" height="252" loading="lazy" decoding="async" />}
								<div class="article-content"><h3>{c.title}</h3></div>
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="section">
				<div class="container">
					<div class="section-header">
						<h2>Anleitungen</h2>
						<p>Schritt-für-Schritt-Hilfe für den Einstieg</p>
					</div>
					<div class="articles-grid">
						{tutorials.map((c) => (
							<a href={withBase(c.href)} class="article-card">
								{c.img && <img src={c.img} alt={c.alt} width="448" height="252" loading="lazy" decoding="async" />}
								<div class="article-content"><h3>{c.title}</h3></div>
							</a>
						))}
					</div>
					<div class="cta-banner">
						<h2>Lieber auf Französisch?</h2>
						<p>Robot Éducatif veröffentlicht über 130 Ratgeber auf Französisch, darunter Kaufberater nach Alter und mBot-Projekte. Unsere Ratgeber gibt es auch <a href={withBase('/en/')} hreflang="en" lang="en">auf Englisch</a>.</p>
