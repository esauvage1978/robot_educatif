---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SelectionFetes2026 from '../../components/SelectionFetes2026.astro';
import HomeIntentPaths from '../../components/HomeIntentPaths.astro';
import HomeSmartHome from '../../components/HomeSmartHome.astro';
import { getIllustration } from '../../lib/illustration';
import { withBase } from '../../lib/siteUrl';
import { withImageVersion } from '../../lib/imageVersion';
import { amazonDpUrl } from '../../lib/amazonMarket.mjs';
import { catalogForMarket } from '../../lib/marketProducts.mjs';
import { IT_PAGES, slugOf } from '../../lib/i18n.mjs';

const TITLE = 'Robot programmabili per bambini: guide Arduino e Raspberry Pi';
const DESCRIPTION =
	'Guide indipendenti per genitori e insegnanti in Italia: robot programmabili mBot, kit Arduino, Raspberry Pi e domotica Home Assistant.';
const card = (href) => {
	const p = IT_PAGES.find((x) => x.href === href);
	const ill = p.fr ? getIllustration(slugOf(p.fr)) : null;
	const fb = p.href.includes('shelly') ? '/images/illustrations/debuter-domotique-par-ou-commencer.webp' : /\/(marchi|marcas)\/$/.test(p.href) ? '/images/blog-thumbnails/marques.webp' : null;
	const src = ill ? ill.src : fb;
	return { ...p, img: src ? withImageVersion(withBase(src)) : null, alt: src ? `Illustrazione: ${p.title}` : '' };
};
const { catalog } = await catalogForMarket('it', 'it');
const heroMbot2 = catalog.mbot2;
const heroMbot2Price = heroMbot2 && !heroMbot2.amazonIndispo ? heroMbot2.priceRange : '';
const heroMbot2Href = heroMbot2?.asin && !heroMbot2.amazonIndispo ? amazonDpUrl(heroMbot2.asin, 'it') : '';
const heroImage = withImageVersion(withBase('/mbot2-hero-v2.webp'));
const comparisons = ['/it/regalo-natale-robot-educativo-2026/', '/it/raspberry-pi-3-vs-4-vs-5/', '/it/shelly-gen4-quale-modulo-scegliere/'].map(card);
const tutorials = ['/it/kit-robot-arduino-per-bambini/', '/it/marchi/'].map(card);
const ages = [
	{ badge: '6–8 anni', title: 'Primo robot programmabile', text: 'Programmazione a blocchi, robot quasi montato, attività semplici con i sensori', href: '/it/miglior-robot-programmabile-per-bambini/' },
	{ badge: '9–12 anni', title: 'Dai blocchi a Python', text: 'Prima blocchi stile Scratch, poi Python sul mBot2', href: '/it/miglior-robot-programmabile-per-bambini/' },
	{ badge: 'Dai 13 anni', title: 'Kit robot Arduino', text: "Cablaggio, C/C++ nell'Arduino IDE, progetti più lunghi", href: '/it/kit-robot-arduino-per-bambini/' },
	{ badge: 'Dai 12 anni', title: 'Raspberry Pi', text: 'Un vero computer Linux per Python, fotocamere e progetti a casa', href: '/it/raspberry-pi-3-vs-4-vs-5/' },
];

import { getProductImage } from '../../lib/amazonImage';
import { buildHomePopularProducts } from '../../lib/homePopularProducts.mjs';

const popularProducts = await buildHomePopularProducts('it', 'it');

const siteUrl = 'https://robot-educatif.info/it/';
const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Robot Éducatif — Italia',
	description: DESCRIPTION,
	url: siteUrl,
	inLanguage: 'it-IT',
	potentialAction: {
		'@type': 'SearchAction',
		target: {
			'@type': 'EntryPoint',
			urlTemplate: 'https://robot-educatif.info/it/?q={search_term_string}',
		},
		'query-input': 'required name=search_term_string',
	},
};
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Robot Éducatif',
	url: 'https://robot-educatif.info/',
	logo: 'https://robot-educatif.info/favicon-a-512.png',
};
import HomeRefonte from '../../components/home/HomeRefonte.astro';
import { buildHomeProductCards } from '../../lib/homePopularProducts.mjs';
import { amazonDpUrl as reDpUrl } from '../../lib/amazonMarket.mjs';
const reMarket = 'it';
const reProducts = await buildHomeProductCards(reMarket, 'it');
const reHero = heroMbot2 && heroMbot2.asin
	? { name: heroMbot2.shortName || heroMbot2.name, ages: reProducts.find((x) => x.key === 'mbot2')?.ages || '', image: '/images/products/mbot2.webp', href: heroMbot2.amazonIndispo ? undefined : reDpUrl(heroMbot2.asin, reMarket), buyLabel: 'Vedi su Amazon' }
	: null;
const reLatest = [...comparisons.slice(1), ...tutorials].filter(Boolean).map((x) => ({ href: x.href, title: x.title, img: x.img, alt: x.alt }));
const rePreload = ['480', '800', '1200'].map((w) => `${withBase(`/images/editorial/re-hero-projet-${w}.webp`)} ${w}w`).join(', ');
---

<!doctype html>
<html lang="it">
	<head>
		<BaseHead title={TITLE} description={DESCRIPTION} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		<link rel="preload" as="image" href={withBase("/images/editorial/re-hero-projet-800.webp")} imagesrcset={rePreload} imagesizes="(min-width: 960px) 520px, 92vw" fetchpriority="high" />
		<style>body { background: var(--re-bg); }</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<HomeRefonte
				lang="it"
				h1="Il robot educativo giusto,"
				h1Em="scelto in base all'età"
				h1After="per vostro figlio"
				hero={reHero}
				products={reProducts}
				latest={reLatest}
			/>
		</main>
		<Footer />
	</body>
</html>
