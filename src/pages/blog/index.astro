---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { articleSlugFromId } from '../../lib/articleSlug';
import { categoryToSlug } from '../../lib/categories';
import { resolveHeroImage } from '../../lib/contentHeroImage';
import { resolveArticleThumbnail, getGeneratedThumbnailPath } from '../../lib/articleThumbnail';
import { withImageVersion } from '../../lib/imageVersion';
import { isProgrammingSeriesArticle } from '../../lib/blogScope';
import { compareBlogPostsByLastActivityDesc } from '../../lib/sortBlogPosts';
import { withBase } from '../../lib/siteUrl';

const allPosts = await getCollection('blog');
const posts = [...allPosts]
	.filter((p) => !isProgrammingSeriesArticle(p))
	.sort(compareBlogPostsByLastActivityDesc);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Blog ROBOT éducatif"
			description="Blog ROBOT éducatif : tutoriels mBlock et Scratch, comparatifs de robots et idées d’activités pour programmer à la maison ou en classe. Des articles concrets."
		/>
		<style>
			.hero-blog {
				width: 100%;
				margin: 0 0 2rem;
				padding: clamp(2rem, 5vw, 3rem) 0;
				border-bottom: 1px solid var(--surface-border);
				background: var(--surface);
			}
			.hero-blog-inner {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
				border-left: 4px solid var(--accent);
				padding-left: 1.25rem;
			}
			.hero-blog .hero-kicker {
				margin: 0 0 0.5rem 0;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.11em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.hero-blog h1 {
				margin: 0 0 0.65rem 0;
				font-size: clamp(1.85rem, 3vw, 2.5rem);
			}
			.hero-blog p {
				margin: 0;
				max-width: 36rem;
				color: rgb(var(--gray-dark));
				font-size: 1.08rem;
				line-height: 1.65;
				font-family: var(--font-body, system-ui);
			}
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0 0 2.5rem;
			}
			.blog-wrap {
				width: min(1140px, calc(100% - 2.5rem));
				margin: 0 auto;
			}
			.posts-list {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.posts-list li {
				width: calc(50% - 1rem);
			}
			.posts-list li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.posts-list li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			.posts-list li:first-child img {
				width: 100%;
			}
			.posts-list li:first-child .title {
				font-size: 2.369rem;
			}
			.posts-list li img {
				display: block;
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: contain;
				background: var(--surface);
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.posts-list li a {
				display: block;
				padding: 0.35rem 0;
				border-radius: 6px;
				transition: background 0.12s ease;
			}
			.posts-list li a:hover {
				background: color-mix(in oklab, var(--accent) 6%, transparent);
			}
			.posts-list li a:hover .title {
				color: var(--accent);
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.25;
				text-decoration: none;
				font-family: var(--font-heading);
				font-weight: 600;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-categories {
				margin: 0.15rem 0 0.75rem;
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				justify-content: flex-start;
			}
			.posts-list li:first-child .post-categories {
				justify-content: center;
			}
		.post-categories a {
			display: inline-block;
			padding: 0.15rem 0.45rem;
			font-size: 0.72rem;
			font-weight: 600;
			text-decoration: none;
			color: var(--accent);
			background: color-mix(in oklab, var(--accent) 10%, transparent);
			border-radius: 999px;
			border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--surface-border));
		}
		
		.post-categories a:hover {
			background: color-mix(in oklab, var(--accent) 18%, transparent);
		}
			.posts-list li a:hover h4,
			.posts-list li a:hover .date {
				color: rgb(var(--accent));
			}
			.posts-list a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				.hero-blog {
					padding: 1.5rem 0;
					margin-bottom: 1.25rem;
				}
				.hero-blog-inner,
				.blog-wrap {
					width: calc(100% - 2rem);
				}
				.posts-list li .post-categories {
					justify-content: center;
				}
				.posts-list {
					gap: 0.5em;
				}
				.posts-list li {
					width: 100%;
					text-align: center;
				}
				.posts-list li:first-child {
					margin-bottom: 0;
				}
				.posts-list li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-blog">
				<div class="hero-blog-inner">
					<p class="hero-kicker">Publications</p>
					<h1>Blog — robotique éducative</h1>
					<p>
						Retours terrain, comparatifs et activités pour enseigner ou apprendre la programmation et la
						robotique avec du matériel grand public et des kits pédagogiques.
					</p>
				</div>
			</section>
			<div class="blog-wrap">
					<section>
						<h2 style="margin: 0 0 1rem 0;">Articles</h2>
						<p style="margin: 0 0 1.5rem 0; color: rgb(var(--gray-dark));">
							Des tests, des idées d’activités et des guides pour la robotique et le matériel pédagogique. Les tutoriels
							de programmation (Python, projets) sont regroupés sous{' '}
							<a href={withBase('/programmation/')} style="font-weight: 600; color: var(--accent);">Programmation</a>
							{' '}— parcourez aussi par{' '}
							<a href={withBase('/categorie/')} style="font-weight: 600; color: var(--accent);">thème (catégories)</a>.{' '}Pour les fêtes, consultez notre{' '}
							<a href={withBase('/robot-educatif-cadeau-noel-2026/')} style="font-weight: 600; color: var(--accent);">guide cadeaux de Noël 2026</a>.
						</p>
					</section>
				<section>
					<ul class="posts-list">
						{posts.map((post) => {
							const heroImage = resolveHeroImage(post.data.heroImage);
							const thumbnail = resolveArticleThumbnail(post, heroImage);
							return (
								<li>
									<a href={withBase(`/${articleSlugFromId(post.id)}/`)}>
										{thumbnail.type === 'illustration' && (
									<img src={withImageVersion(withBase(thumbnail.src))} alt={thumbnail.alt} width="720" height="405" loading="lazy" decoding="async" />
								)}
								{thumbnail.type === 'image' && (
											<Image width={720} height={360} src={thumbnail.src} alt={post.data.title} />
										)}
										{thumbnail.type === 'pinterest' && (
											<img
												src={withBase(`/pinterest/${thumbnail.slug}-1.jpg`)}
												alt={post.data.title}
												width="720"
												height="360"
												loading="lazy"
												style="object-fit: cover; object-position: top;"
											/>
										)}
										{thumbnail.type === 'generated' && (
											<img
												src={withImageVersion(withBase(getGeneratedThumbnailPath(post.id.replace(/\.mdx?$/, '')).replace('.png', '.webp')))}
												alt={post.data.title}
												width="720"
												height="360"
												loading="lazy"
											/>
										)}
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											{post.data.updatedDate ? (
												<>
													Mis à jour le <FormattedDate date={post.data.updatedDate} />
												</>
											) : (
												<>
													Publié le <FormattedDate date={post.data.pubDate} />
												</>
											)}
										</p>
									</a>
									{post.data.categories?.length ? (
										<div class="post-categories">
											{post.data.categories.map((cat) => (
												<a href={withBase(`/categorie/${categoryToSlug(cat)}/`)}>{cat}</a>
											))}
										</div>
									) : null}
								</li>
							);
						})}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
